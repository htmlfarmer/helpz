#!/bin/bash

# shellcheck source=.helpz_log.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.helpz_log.sh"
# xyzoservicesz - Mask PM2-managed services and reconfigure Example systemd units
#
# Idempotent: re-running is safe — already-applied changes are skipped.
# Backups: any file modified is copied to ./xyzoservicesz-backups/<ts>/
#          before edit (depth fix — previously no rollback path existed).
#
# Flags:
#   --help / -h / help / ?   Show this help
#   --dry-run                Show what would change without applying
#   --yes                    Skip interactive confirmation prompt
set -e

show_help() {
    cat << 'EOF'

  ╔══════════════════════════════════════════════════════════════════╗
  ║  xyzoservicesz — Example systemd unit reconfigurer                ║
  ╚══════════════════════════════════════════════════════════════════╝

DESCRIPTION
  Mask PM2-managed systemd units, add memory limits to fetcher services,
  fix known typos in app-api.service, and restart the affected units.

  Idempotent — running twice is safe. Modifies only files that need it.
  Backs up every touched file to:
    ./xyzoservicesz-backups/<timestamp>/

USAGE
  ./xyzoservicesz                Apply changes (prompts for confirmation)
  ./xyzoservicesz --yes          Apply without confirmation
  ./xyzoservicesz --dry-run      Show what would change, no edits
  ./xyzoservicesz --help / -h    Show this help

AFFECTED UNITS
  app-pm2-api.service              → masked (PM2 owns it)
  app-fetcher.service          → memory drop-in (1G max, 800M high)
  app-fast-fetcher.service     → memory drop-in (1G max, 800M high)
  app-api.service              → StartLimitIntervalSec → StartLimitInterval fix

ROLLBACK
  cp ./xyzoservicesz-backups/<ts>/* /etc/systemd/system/
  sudo systemctl daemon-reload

EOF
}

DRY_RUN=0
ASSUME_YES=0
AI_VERDICT=0
for arg in "$@"; do
    case "$arg" in
        --help|-h|help|\?) show_help; exit 0 ;;
        --dry-run)        DRY_RUN=1 ;;
        --yes|-y)         ASSUME_YES=1 ;;
        --ai)             AI_VERDICT=1 ;;
        --no-ai)          AI_VERDICT=0 ;;
        *) echo "Unknown arg: $arg (try --help)"; exit 2 ;;
    esac
done

if declare -f run_comparison_init >/dev/null 2>&1; then run_comparison_init "xyzoservicesz" "DRY_RUN=$DRY_RUN" 2>/dev/null; fi

# ---------- AI hook (opt-in via --ai) ----------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$SCRIPT_DIR/lib/run_comparison.sh" ]]; then source "$SCRIPT_DIR/lib/run_comparison.sh"; fi
if [[ "${AI_VERDICT:-}" == "1" ]]; then
    # shellcheck source=lib/ai.sh
    source "$SCRIPT_DIR/lib/ai.sh" 2>/dev/null || true
fi

# Backup helper — copies a file/dir to timestamped backup dir before mutation.
backup_path() {
    local path="$1"
    [[ -e "$path" ]] || return 0
    local ts; ts=$(date +%Y%m%d-%H%M%S)
    local bd="${SCRIPT_DIR}/xyzoservicesz-backups/$ts"
    mkdir -p "$bd"
    cp -a "$path" "$bd/$(echo "$path" | tr '/' '_')"
    echo "[backup] $path → $bd/$(basename "$bd")"
}

# Idempotent file-write helper — only writes if content differs.
write_if_changed() {
    local target="$1"
    local content="$2"
    if [[ -f "$target" ]] && diff -q <(printf '%s' "$content") "$target" >/dev/null 2>&1; then
        echo "[skip]   $target already matches desired content"
        return 0
    fi
    if [[ $DRY_RUN -eq 1 ]]; then
        echo "[would]  $target"
        return 0
    fi
    backup_path "$target"
    printf '%s' "$content" | sudo tee "$target" >/dev/null
    echo "[ok]     $target updated"
}

echo "=== Fixing Example Systemd Services ==="
if [[ $DRY_RUN -eq 1 ]]; then
    echo "(dry-run mode — no edits will be made)"
fi

# 1. Force-mask app-pm2-api (it's PM2-managed anyway)
echo "[1/6] Masking app-pm2-api.service..."
if [[ -L /etc/systemd/system/app-pm2-api.service ]] && \
   [[ "$(readlink /etc/systemd/system/app-pm2-api.service 2>/dev/null)" == "/dev/null" ]]; then
    echo "[skip]   app-pm2-api.service already masked"
else
    if [[ $DRY_RUN -eq 0 ]]; then
        backup_path /etc/systemd/system/app-pm2-api.service
        sudo ln -sf /dev/null /etc/systemd/system/app-pm2-api.service
        sudo systemctl daemon-reload
    fi
    echo "[ok]     app-pm2-api.service masked"
fi

# 2. Add memory limits to app-fetcher via drop-in
echo "[2/6] Adding memory limits to app-fetcher..."
write_if_changed /etc/systemd/system/app-fetcher.service.d/memory.conf "[Service]
MemoryMax=1G
MemoryHigh=800M
"

# 3. Add memory limits to app-fast-fetcher via drop-in
echo "[3/6] Adding memory limits to app-fast-fetcher..."
write_if_changed /etc/systemd/system/app-fast-fetcher.service.d/memory.conf "[Service]
MemoryMax=1G
MemoryHigh=800M
"

# 4. Fix StartLimitIntervalSec -> StartLimitInterval in app-api
echo "[4/6] Fixing app-api StartLimitIntervalSec..."
XYZO_API=/etc/systemd/system/app-api.service
if [[ -r "$XYZO_API" ]] && grep -q '^StartLimitIntervalSec=' "$XYZO_API"; then
    if [[ $DRY_RUN -eq 0 ]]; then
        backup_path "$XYZO_API"
        sudo sed -i 's/^StartLimitIntervalSec=/StartLimitInterval=/' "$XYZO_API"
    fi
    echo "[ok]     app-api.service patched"
elif [[ -r "$XYZO_API" ]] && grep -q '^StartLimitInterval=' "$XYZO_API"; then
    echo "[skip]   app-api.service already has StartLimitInterval (no StartLimitIntervalSec to fix)"
else
    echo "[skip]   app-api.service not found or pattern absent"
fi

# 5. Reload systemd
echo "[5/6] Reloading systemd..."
if [[ $DRY_RUN -eq 0 ]]; then
    sudo systemctl daemon-reload
fi

# 6. Restart services
echo "[6/6] Restarting services..."
if [[ $DRY_RUN -eq 0 ]]; then
    sudo systemctl restart app-fetcher.service app-fast-fetcher.service app-api.service
fi

echo ""
echo "=== Status Check ==="
if [[ $DRY_RUN -eq 0 ]]; then
    systemctl status app-fetcher.service --no-pager 2>/dev/null | head -5 || true
    echo ""
    systemctl status app-fast-fetcher.service --no-pager 2>/dev/null | head -5 || true
    echo ""
    systemctl status app-api.service --no-pager 2>/dev/null | head -5 || true
fi
echo ""
echo "Done!"

# ---------- Run Comparison Finalize ----------
if declare -f run_comparison_finalize >/dev/null 2>&1; then run_comparison_finalize 2>/dev/null; fi

# ---------- AI verdict (opt-in via --ai) ----------
if [[ "${AI_VERDICT:-}" == "1" ]]; then
    ai_emit_verdict "summary" "xyzoservicesz run complete: dry_run=$DRY_RUN yes=$ASSUME_YES" 2>/dev/null || true
fi
