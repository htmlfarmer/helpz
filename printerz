#!/usr/bin/env bash

# shellcheck source=.helpz_log.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.helpz_log.sh"

# ============================================================================
# printerz - Printer Log Scanner & Debugger
# ----------------------------------------------------------------------------
# Checks CUPS logs, systemd journal, USB ports, network ports, and provides
# comprehensive printer diagnostics, job management, and service control.
#
# Usage:
#   ./printerz                          # Full diagnostic scan
#   ./printerz --deep                   # Deep log analysis (all CUPS logs)
#   ./printerz --manual                 # Manual testing instructions
#   ./printerz --ports                  # Check listening ports
#   ./printerz --usb                    # USB device scan
#   ./printerz --full-lpstat           # Complete lpstat output
#   ./printerz --jobs                  # Manage print jobs (list/cancel)
#   ./printerz --services              # Start/stop/restart CUPS services
#   ./printerz --poem                 # Send a fun test poem to printer
#   ./printerz --sharing              # Debug printer sharing issues
#   ./printerz --tail 100              # Last N error lines (default 50)
#   ./printerz --since "1 hour ago"    # Custom time window
#   ./printerz --no-color              # Plain output
#   ./printerz --json                  # Machine-readable summary
#   ./printerz --debug                  # Verbose debug mode
#
# Quick tests:
#   lpstat -t          # Show all printers and their status
#   lpstat -v          # Show printer devices/URIs
#   lpstat -a          # Show acceptance status
#   lpstat -r          # Show CUPS scheduler status
#   sudo ss -tlnp | grep 631  # Verify CUPS is listening on port 631
# ============================================================================

set -o pipefail

# ---------- Configuration ----------
SINCE="24 hours ago"
TAIL_LINES=50
NO_COLOR=0
JSON_OUT=0
DEBUG_MODE=0
DEEP_SCAN=0
MANUAL_MODE=0
PORTS_MODE=0
USB_MODE=0
FULL_LPSTAT=0
JOBS_MODE=0
SERVICES_MODE=0
POEM_MODE=0
SHARING_MODE=0
HOSTNAME_SHORT=$(hostname -s 2>/dev/null || echo "host")
START_TS=$(date +%s)
WARNINGS=0
CRITICAL=0

# ---------- Color init ----------
C_RESET=""; C_BOLD=""; C_DIM=""
C_RED=""; C_GREEN=""; C_YELLOW=""; C_CYAN=""; C_MAGENTA=""

init_colors() {
    if [[ -t 1 ]] && [[ "$NO_COLOR" -eq 0 ]]; then
        C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
        C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'
        C_CYAN=$'\033[36m'; C_MAGENTA=$'\033[35m'
    fi
}
init_colors

# ---------- Helpers ----------
have() { command -v "$1" >/dev/null 2>&1; }

debug() {
    [[ $DEBUG_MODE -eq 1 ]] && echo "  [DEBUG] $1" || true
}

section() {
    echo ""
    echo "━━━ $1 ━━━"
}

warn() {
    local msg="$1"
    local suggestion="${2:-}"
    WARNINGS=$((WARNINGS + 1))
    echo "  ! $msg"
    [[ -n "$suggestion" ]] && echo "    → $suggestion"
}

crit() {
    local msg="$1"
    local fix="${2:-}"
    CRITICAL=$((CRITICAL + 1))
    echo "  ✗ $msg"
    [[ -n "$fix" ]] && echo "    → $fix"
}

ok() {
    echo "  ✓ $1"
}

info() {
    echo "  · $1"
}

# ---------- Args ----------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --since=*)     SINCE="${1#--since=}" ;;
        --last=*)      SINCE="${1#--last=}" ;;
        --tail=*)      TAIL_LINES="${1#--tail=}" ;;
        --tail)        TAIL_LINES="${2:-50}"; shift ;;
        --no-color)    NO_COLOR=1; init_colors ;;
        --json)        JSON_OUT=1 ;;
        --debug)       DEBUG_MODE=1 ;;
        --deep)        DEEP_SCAN=1 ;;
        --manual)      MANUAL_MODE=1 ;;
        --ports)       PORTS_MODE=1 ;;
        --usb)         USB_MODE=1 ;;
        --full-lpstat) FULL_LPSTAT=1 ;;
        --jobs)        JOBS_MODE=1 ;;
        --services)    SERVICES_MODE=1 ;;
        --poem)        POEM_MODE=1 ;;
        --sharing)     SHARING_MODE=1 ;;
        -h|--help)
            sed -n '10,40p' "$0"
            exit 0
            ;;
        --) shift; break ;;
        -*) echo "Unknown flag: $1" >&2; exit 2 ;;
        *)  SINCE="$1" ;;
    esac
    shift
done

# ---------- USB Device Scan ----------
scan_usb() {
    section "USB DEVICE SCAN"

    if ! have lsusb; then
        crit "lsusb not available" "Install usbutils package"
        return
    fi

    local found_printer=0

    echo "  ┌────────────────────────────────────────────────────────────────────────┐"
    echo "  │                    USB PRINTER DEVICES                                  │"
    echo "  └────────────────────────────────────────────────────────────────────────┘"
    echo ""

    local patterns=("printer" "laser" "ink" "brother" "canon" "hp" "epson" "samsung" "xerox" "lexmark" "zebra" "dymo")

    for pattern in "${patterns[@]}"; do
        local matches
        matches=$(lsusb 2>/dev/null | grep -i "$pattern" || true)
        if [[ -n "$matches" ]]; then
            found_printer=1
            echo "  $matches"
            echo ""

            local bus_dev
            bus_dev=$(echo "$matches" | awk '{print $2 "/" $4}')
            echo "    Bus:Device: $bus_dev"

            local usb_speed
            usb_speed=$(lsusb -s "$bus_dev" 2>/dev/null | xxd -p -r 2>/dev/null | strings | grep -i "speed" | head -1 || true)
            [[ -z "$usb_speed" ]] && usb_speed=$(dmesg 2>/dev/null | grep -i "usb.*$bus_dev" | grep -i "speed" | head -1 || true)
            [[ -n "$usb_speed" ]] && echo "    Speed: $usb_speed"
        fi
    done

    if [[ $found_printer -eq 0 ]]; then
        info "No printer-related USB devices found"
    fi

    echo ""
    echo "  ┌────────────────────────────────────────────────────────────────────────┐"
    echo "  │                    USB TROUBLESHOOTING GUIDE                            │"
    echo "  └────────────────────────────────────────────────────────────────────────┘"
    echo ""

    echo "  COMMON USB PRINTER ISSUES & FIXES:"
    echo ""
    echo "  1. CABLE LENGTH LIMITATIONS"
    echo "     ├─ USB 2.0 max: 5 meters (16 ft)"
    echo "     ├─ USB 3.0 max: 3 meters (9 ft)"
    echo "     └─ Solution: Use cable < 3 meters for USB 2.0 reliability"
    echo ""
    echo "  2. USB POWER ISSUES"
    echo "     ├─ Symptoms: Printer keeps disconnecting, partial responses"
    echo "     ├─ Some USB ports provide limited power"
    echo "     └─ Solution: Use powered USB hub or direct port with more power"
    echo ""
    echo "  3. USB HUB ISSUES"
    echo "     ├─ Hub may not provide enough power/bandwidth"
    echo "     ├─ Try connecting printer directly to PC USB port"
    echo "     └─ If using hub, ensure it's powered"
    echo ""
    echo "  4. LOOSE OR DAMAGED CABLE"
    echo "     ├─ Intermittent connection can cause partial failures"
    echo "     ├─ Try different USB cable"
    echo "     └─ Inspect cable ends for damage"
    echo ""
    echo "  5. PORT EXHAUSTION"
    echo "     ├─ Too many devices on same controller"
    echo "     ├─ Try different USB port (preferably back panel)"
    echo "     └─ Some controllers share bandwidth between ports"
    echo ""

    echo "  ┌────────────────────────────────────────────────────────────────────────┐"
    echo "  │                    QUICK USB DIAGNOSTIC COMMANDS                       │"
    echo "  └────────────────────────────────────────────────────────────────────────┘"
    echo ""

    local usb_printer_bus
    usb_printer_bus=$(lsusb 2>/dev/null | grep -iE "printer|brother|laser|ink" | awk '{print $2 "/" $4}' | head -1)

    if [[ -n "$usb_printer_bus" ]]; then
        local usb_vendor_id
        usb_vendor_id=$(lsusb 2>/dev/null | grep -iE "printer|brother|laser|ink" | awk '{print $6}' | head -1)

        echo "  ┌────────────────────────────────────────────────────────────────────────┐"
        echo "  │                    DETAILED USB DEVICE INFO                             │"
        echo "  └────────────────────────────────────────────────────────────────────────┘"
        echo ""

        echo "  Verbose lsusb -v output:"
        echo ""
        lsusb -v -d "$usb_vendor_id" 2>/dev/null | head -60 | while IFS= read -r line; do
            echo "    $line"
        done

        echo ""
        echo "  ┌────────────────────────────────────────────────────────────────────────┐"
        echo "  │                    QUICK DIAGNOSTIC COMMANDS                             │"
        echo "  └────────────────────────────────────────────────────────────────────────┘"
        echo ""
        echo "  # Full verbose output (run manually for complete info):"
        echo "    sudo lsusb -v -d $usb_vendor_id"
        echo ""
        echo "  # Check USB errors in kernel log:"
        echo "    sudo dmesg | grep -i 'usb.*$usb_printer_bus' | tail -20"
        echo ""
        echo "  # Check USB tree structure:"
        echo "    lsusb -t"
        echo ""
        echo "  # Monitor USB device events:"
        echo "    sudo udevadm monitor --subsystem match=usb --property"
        echo ""
        echo "  # Check device descriptor:"
        echo "    sudo lsusb -v -s $usb_printer_bus 2>/dev/null | head -40"
    else
        echo "  # Check all recent USB events:"
        echo "    sudo dmesg | grep -i usb | tail -30"
        echo ""
        echo "  # Full USB tree:"
        echo "    lsusb -t"
    fi

    echo ""
    echo "  ┌────────────────────────────────────────────────────────────────────────┐"
    echo "  │                    TEST WITH SHORTER CABLE                            │"
    echo "  └────────────────────────────────────────────────────────────────────────┘"
    echo ""
    echo "  If you're experiencing intermittent issues, try:"
    echo "  1. A different USB cable (preferably < 2 meters / 6 ft)"
    echo "  2. Direct connection to PC (bypass any hubs)"
    echo "  3. Different USB port on the computer"
    echo ""
    echo "  Note: USB over longer cables can cause:"
    echo "  - Partial/complete signal degradation"
    echo "  - Timeouts and retries"
    echo "  - Corrupted print data"
    echo "  - Intermittent disconnections"
}

# ---------- Port Check ----------
check_ports() {
    section "NETWORK PORT STATUS (CUPS port 631)"

    if have ss; then
        echo "  Checking port 631 (IPP):"
        local cups_listen
        cups_listen=$(ss -tlnp 2>/dev/null | grep ":631" || true)
        if [[ -n "$cups_listen" ]]; then
            echo "$cups_listen" | while IFS= read -r line; do
                echo "    • $line"
            done
        else
            warn "CUPS is NOT listening on port 631" "CUPS may not be running or configured"
        fi

        echo ""
        echo "  All listening TCP ports:"
        ss -tlnp 2>/dev/null | grep LISTEN | head -20 | while IFS= read -r line; do
            echo "    $line"
        done
    elif have netstat; then
        echo "  Using netstat (ss not available):"
        netstat -tlnp 2>/dev/null | grep ":631" || warn "CUPS not listening on 631"
    else
        info "Neither ss nor netstat available"
    fi

    echo ""
    echo "  Common print-related ports:"
    for port in 631 9100 515 721 722 723 724; do
        local binding
        binding=$(ss -tlnp 2>/dev/null | grep ":$port " || true)
        if [[ -n "$binding" ]]; then
            echo "    Port $port: $binding"
        fi
    done
}

# ---------- Full lpstat Output ----------
full_lpstat() {
    section "COMPLETE LPSTAT OUTPUT"

    if ! have lpstat; then
        crit "lpstat not available" "Install cups-client package"
        return
    fi

    echo "  ┌─────────────────────────────────────────────────────────────┐"
    echo "  │ lpstat -t  (Full status of all printers)                   │"
    echo "  └─────────────────────────────────────────────────────────────┘"
    lpstat -t 2>&1 | while IFS= read -r line; do
        echo "    $line"
    done

    echo ""
    echo "  ┌─────────────────────────────────────────────────────────────┐"
    echo "  │ lpstat -v  (Printer device URIs)                            │"
    echo "  └─────────────────────────────────────────────────────────────┘"
    lpstat -v 2>&1 | while IFS= read -r line; do
        echo "    $line"
    done

    echo ""
    echo "  ┌─────────────────────────────────────────────────────────────┐"
    echo "  │ lpstat -a  (Accepting status)                               │"
    echo "  └─────────────────────────────────────────────────────────────┘"
    lpstat -a 2>&1 | while IFS= read -r line; do
        echo "    $line"
    done

    echo ""
    echo "  ┌─────────────────────────────────────────────────────────────┐"
    echo "  │ lpstat -r  (CUPS scheduler running?)                        │"
    echo "  └─────────────────────────────────────────────────────────────┘"
    lpstat -r 2>&1 | while IFS= read -r line; do
        echo "    $line"
    done

    echo ""
    echo "  ┌─────────────────────────────────────────────────────────────┐"
    echo "  │ lpstat -s  (Summary)                                        │"
    echo "  └─────────────────────────────────────────────────────────────┘"
    lpstat -s 2>&1 | while IFS= read -r line; do
        echo "    $line"
    done

    echo ""
    echo "  ┌─────────────────────────────────────────────────────────────┐"
    echo "  │ lpinfo -v  (Available devices)                              │"
    echo "  └─────────────────────────────────────────────────────────────┘"
    lpinfo -v 2>&1 | head -30 | while IFS= read -r line; do
        echo "    $line"
    done

    echo ""
    echo "  ┌─────────────────────────────────────────────────────────────┐"
    echo "  │ lpinfo -m  (Available drivers)                              │"
    echo "  └─────────────────────────────────────────────────────────────┘"
    lpinfo -m 2>&1 | head -20 | while IFS= read -r line; do
        echo "    $line"
    done
}

# ---------- CUPS Service Status ----------
check_cups_service() {
    section "CUPS SERVICE STATUS"

    if have systemctl; then
        local cups_active
        cups_active=$(systemctl is-active cups 2>/dev/null || echo "unknown")
        local cups_enabled
        cups_enabled=$(systemctl is-enabled cups 2>/dev/null || echo "unknown")

        if [[ "$cups_active" == "active" ]]; then
            ok "CUPS service is ACTIVE"
        else
            crit "CUPS service is NOT active (status: $cups_active)" "Run: sudo systemctl start cups"
        fi

        echo "  Enabled: $cups_enabled"

        echo ""
        echo "  Service details:"
        systemctl status cups 2>/dev/null | head -10 | while IFS= read -r line; do
            echo "    $line"
        done
    else
        if pgrep -x cupsd >/dev/null 2>&1; then
            ok "cupsd process is running"
        else
            crit "cupsd process is NOT running"
        fi
    fi

    echo ""
    if pgrep -x cups-browsed >/dev/null 2>&1; then
        ok "CUPS browser daemon (cups-browsed) is running"
    else
        warn "CUPS browser daemon is NOT running" "Network printer discovery may not work"
    fi
}

# ---------- Printer Detection ----------
detect_printers() {
    section "DETECTED PRINTERS"

    if have lpstat; then
        local printers
        printers=$(lpstat -a 2>/dev/null | awk '{print $1}' | sort -u)
        if [[ -n "$printers" ]]; then
            while IFS= read -r printer; do
                [[ -z "$printer" ]] && continue
                echo "  • $printer"
                local status
                status=$(lpstat -p "$printer" 2>/dev/null | head -1)
                [[ -n "$status" ]] && echo "    $status"
                local default_printer
                default_printer=$(lpstat -d 2>/dev/null | awk '{print $NF}')
                if [[ "$printer" == "$default_printer" ]]; then
                    echo "    → DEFAULT PRINTER"
                fi
            done <<< "$printers"
        else
            warn "No printers found in lpstat"
        fi
    fi

    echo ""
    echo "  Network Printers (via avahi):"
    if have avahi-browse; then
        local network_printers
        network_printers=$(avahi-browse -rt _ipp._tcp 2>/dev/null | grep "=" | head -10 || true)
        if [[ -n "$network_printers" ]]; then
            echo "$network_printers" | while IFS= read -r line; do
                echo "    • $line"
            done
        else
            echo "    None discovered"
        fi
    fi
}

# ---------- Queue Status ----------
check_queues() {
    section "PRINT QUEUE STATUS"

    if ! have lpstat; then
        warn "lpstat not available"
        return
    fi

    local queued_jobs
    queued_jobs=$(lpstat -W not-completed 2>/dev/null | wc -l)
    echo "  Pending jobs: $queued_jobs"

    if [[ "$queued_jobs" -gt 0 ]]; then
        echo ""
        echo "  Job details:"
        lpstat -W not-completed 2>/dev/null | while IFS= read -r line; do
            echo "    • $line"
        done
    fi

    local completed_jobs
    completed_jobs=$(lpstat -W completed 2>/dev/null | tail -10 | wc -l)
    echo "  Recent completed jobs: $completed_jobs"
}

# ---------- Deep Log Analysis ----------
deep_log_scan() {
    section "DEEP LOG ANALYSIS"

    echo "  Scanning ALL CUPS log locations..."

    local log_locations=(
        "/var/log/cups/access_log"
        "/var/log/cups/error_log"
        "/var/log/cups/page_log"
        "/var/log/cups/access_log-*.gz"
        "/var/log/cups/error_log-*.gz"
    )

    local total_errors=0

    for log_path in "${log_locations[@]}"; do
        if ls $log_path 2>/dev/null | head -1 | grep -qE "\.gz$"; then
            echo ""
            echo "  Gzipped logs found (sample):"
            ls -la $log_path 2>/dev/null | head -5 | while IFS= read -r line; do
                echo "    $line"
            done
        fi
    done

    echo ""
    echo "  Recent 100 lines from error_log:"
    if [[ -f "/var/log/cups/error_log" ]]; then
        local errors
        errors=$(tail -n 100 "/var/log/cups/error_log" 2>/dev/null)
        if [[ -n "$errors" ]]; then
            echo "$errors" | head -50 | while IFS= read -r line; do
                if echo "$line" | grep -qiE "error|fail|denied"; then
                    echo "    ✗ $line"
                elif echo "$line" | grep -qiE "warn"; then
                    echo "    ! $line"
                else
                    echo "    $line"
                fi
            done
        fi
    else
        info "Cannot read /var/log/cups/error_log (may need sudo)"
    fi

    echo ""
    echo "  Access log analysis (recent 50 lines):"
    if [[ -f "/var/log/cups/access_log" ]]; then
        tail -n 50 "/var/log/cups/access_log" 2>/dev/null | while IFS= read -r line; do
            if echo "$line" | grep -qiE "403|500|denied|error"; then
                echo "    ! $line"
            else
                echo "    $line"
            fi
        done
    fi

    echo ""
    echo "  Journalctl CUPS errors (last 100 lines):"
    if have journalctl; then
        local journal_errors
        journal_errors=$(journalctl -u cups --since "$SINCE" --no-pager 2>/dev/null | grep -iE "error|fail|denied|refused" | tail -30 || true)
        if [[ -n "$journal_errors" ]]; then
            echo "$journal_errors" | while IFS= read -r line; do
                echo "    ✗ $line"
            done
        else
            ok "No errors in CUPS journal"
        fi
    fi

    echo ""
    echo "  Kernel printer messages:"
    if [[ -f "/var/log/kern.log" ]]; then
        tail -n 50 "/var/log/kern.log" 2>/dev/null | grep -iE "printer|cups|usb.*print" | while IFS= read -r line; do
            echo "    • $line"
        done
    fi
}

# ---------- Manual Testing ----------
manual_testing() {
    section "MANUAL TESTING GUIDE"
    echo ""
    echo "  ┌────────────────────────────────────────────────────────────────────┐"
    echo "  │                    MANUAL PRINTER TESTING                          │"
    echo "  └────────────────────────────────────────────────────────────────────┘"
    echo ""
    echo "  STEP 1: Verify CUPS is running"
    echo "  ──────────────────────────────"
    echo "    sudo systemctl status cups"
    echo "    sudo systemctl restart cups    # if not running"
    echo ""
    echo "  STEP 2: Check if CUPS is listening on port 631"
    echo "  ───────────────────────────────────────────────"
    echo "    sudo ss -tlnp | grep 631"
    echo "    # You should see: *:631 or 0.0.0.0:631"
    echo ""
    echo "  STEP 3: Test lpstat commands"
    echo "  ──────────────────────────"
    echo "    lpstat -t                  # Full status"
    echo "    lpstat -v                  # Show device URIs"
    echo "    lpstat -a                  # Show accepting status"
    echo "    lpstat -r                  # Check scheduler"
    echo "    lpstat -W not-completed     # Pending jobs"
    echo ""
    echo "  STEP 4: Find your printer's IP/hostname"
    echo "  ───────────────────────────────────────"
    echo "    lpstat -v | grep ipp"
    echo "    # Extract IP from URI: ipp://192.168.x.x:631/printers/..."
    echo "    ping -c 1 192.168.x.x     # Test connectivity"
    echo "    nc -zv 192.168.x.x 631    # Test IPP port"
    echo "    nc -zv 192.168.x.x 9100   # Test raw port (JetDirect)"
    echo ""
    echo "  STEP 5: Send a test page"
    echo "  ────────────────────────"
    echo "    lp -d PRINTER_NAME /usr/share/cups/data/testprint"
    echo "    echo 'Hello Printer' | lp -d PRINTER_NAME"
    echo "    # Or via CUPS web interface: http://localhost:631"
