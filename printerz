    echo "  STEP 6: Check printer state"
    echo "  ──────────────────────────"
    echo "    lpstat -p PRINTER_NAME    # Specific printer status"
    echo "    cupsenable PRINTER_NAME   # Enable if disabled"
    echo "    cupsdisable PRINTER_NAME  # Disable printer"
    echo "    reject PRINTER_NAME       # Reject new jobs"
    echo "    accept PRINTER_NAME       # Accept new jobs"
    echo ""
    echo "  STEP 7: Cancel stuck jobs"
    echo "  ─────────────────────────"
    echo "    lpstat -W not-completed   # List pending jobs"
    echo "    cancel JOB_ID             # Cancel specific job"
    echo "    cancel -a PRINTER_NAME    # Cancel all jobs for printer"
    echo ""
    echo "  STEP 8: Debug with lpinfo"
    echo "  ─────────────────────────"
    echo "    lpinfo -v                 # List available devices"
    echo "    lpinfo -m                 # List available drivers"
    echo "    lpinfo --device-id        # Get printer device ID"
    echo ""
    echo "  STEP 9: View live CUPS logs"
    echo "  ──────────────────────────"
    echo "    tail -f /var/log/cups/error_log"
    echo "    journalctl -u cups -f     # Follow CUPS journal"
    echo ""
    echo "  STEP 10: Common fixes"
    echo "  ─────────────────────"
    echo "    # Restart CUPS"
    echo "    sudo systemctl restart cups"
    echo ""
    echo "    # Re-add a printer"
    echo "    sudo lpadmin -p PRINTER_NAME -E -v ipp://IP/printers/NAME -m driver.ppd"
    echo ""
    echo "    # Set default printer"
    echo "    lpstat -d"
    echo "    lpoptions -d PRINTER_NAME"
    echo ""
    echo "  ┌────────────────────────────────────────────────────────────────────┐"
    echo "  │                    COMMON ERROR CODES                               │"
    echo "  └────────────────────────────────────────────────────────────────────┘"
    echo ""
    echo "    client-error-not-found       → Printer URI wrong or printer offline"
    echo "    client-error-forbidden       → Authentication failed or access denied"
    echo "    client-error-busy            → Printer is busy, try again later"
    echo "    server-error-service-unavailable → CUPS not running or unreachable"
    echo "    server-error-internal-error  → CUPS internal error, check logs"
    echo ""
}

# ---------- Tail Mode ----------
tail_mode() {
    echo "=== Last $TAIL_LINES CUPS error lines ==="

    if [[ -f "/var/log/cups/error_log" ]]; then
        tail -n $TAIL_LINES "/var/log/cups/error_log" 2>/dev/null || echo "  Cannot read error log"
    else
        if have journalctl; then
            journalctl -u cups --since "1 hour ago" --no-pager 2>/dev/null | tail -$TAIL_LINES || \
                echo "  No recent CUPS journal entries"
        else
            echo "  CUPS error log not accessible"
        fi
    fi
}

# ---------- Network Printer Connectivity ----------
check_network() {
    section "NETWORK PRINTER CONNECTIVITY"

    if ! have lpstat; then
        return
    fi

    echo "  Printer URIs from lpstat -v:"
    lpstat -v 2>/dev/null | grep -E "ipp|http|socket" | while IFS= read -r line; do
        echo "  • $line"

        local uri
        uri=$(echo "$line" | awk '{print $NF}')
        local host
        host=$(echo "$uri" | sed -E 's|.*://([^:/]+).*|\1|')
        local port
        port=$(echo "$uri" | sed -E 's|.*:([0-9]+)/.*|\1|' || echo "631")

        if [[ -n "$host" ]]; then
            echo "    Testing connectivity to $host:$port..."
            if have nc; then
                if nc -z -w 3 "$host" "$port" 2>/dev/null; then
                    ok "  $host:$port is reachable"
                else
                    warn "  $host:$port is NOT reachable"
                fi
            elif have ping; then
                if ping -c 1 -W 2 "$host" 2>/dev/null | grep -q "1 packets transmitted"; then
                    ok "  $host is reachable (but port $port may be blocked)"
                else
                    warn "  $host is NOT reachable"
                fi
            fi
        fi
    done
}

# ---------- CUPS Sharing Diagnostics ----------
check_sharing() {
    section "CUPS PRINTER SHARING DIAGNOSTICS"

    local my_hostname
    my_hostname=$(hostname)
    local my_domain="${my_hostname}.local"

    local sharing_enabled
    sharing_enabled=$(cupsctl 2>/dev/null | grep "^Browsing" | awk -F= '{print $2}' || echo "unknown")
    local share_printers
    share_printers=$(cupsctl 2>/dev/null | grep "^SharePrinters" | awk -F= '{print $2}' || echo "unknown")

    echo "  ┌────────────────────────────────────────────────────────────────────────┐"
    echo "  │                    CUPS SHARING SETTINGS                               │"
    echo "  └────────────────────────────────────────────────────────────────────────┘"
    echo ""
    echo "  Your hostname: $my_hostname"
    echo "  Your domain:   $my_domain"
    echo "  Your IPs:     $(hostname -I 2>/dev/null | awk '{print $1}')"
    echo ""
    echo "  CUPS Sharing (Browsing):  $sharing_enabled"
    echo "  Share Printers:          $share_printers"

    if [[ "$sharing_enabled" != "on" ]]; then
        warn "CUPS sharing is DISABLED"
    else
        ok "CUPS sharing is enabled"
    fi

    echo ""
    echo "  ┌────────────────────────────────────────────────────────────────────────┐"
    echo "  │                    PRINTERS ON THIS MACHINE                            │"
    echo "  └────────────────────────────────────────────────────────────────────────┘"

    local printer_count=0
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        printer_count=$((printer_count + 1))

        local printer_name
        printer_name=$(echo "$line" | sed -E 's/device for //' | sed 's/:.*//')
        local_uri=$(echo "$line" | awk '{print $NF}')

        echo ""
        echo "  [$printer_count] $printer_name"
        echo "      Local URI:  $local_uri"

        case "$local_uri" in
            usb://*)
                echo "      Connection: USB (local)"
                ;;
            ipp://*)
                echo "      Connection: IPP (network)"
                ;;
            ipps://*)
                echo "      Connection: IPP over SSL (network encrypted)"
                ;;
            socket://*)
                echo "      Connection: JetDirect (network)"
                ;;
            lpd://*)
                echo "      Connection: LPD (legacy network)"
                ;;
            dnssd://*|mdns://*)
                echo "      Connection: DNS-SD/mDNS discovery"
                ;;
            *)
                echo "      Connection: Unknown"
                ;;
        esac

        local remote_uri="ipps://${my_domain}:631/printers/${printer_name}"
        echo "      Remote URI: $remote_uri"
        echo "      Remote Alt: ipp://${my_domain}:631/printers/${printer_name}"

        local accept_status
        accept_status=$(lpstat -a "$printer_name" 2>/dev/null | awk '{print $2}' | tr -d '()')
        local printer_enabled
        printer_enabled=$(lpstat -p "$printer_name" 2>/dev/null | grep -q "enabled" && echo "yes" || echo "no")

        echo "      Accepting:   $accept_status"
        echo "      Enabled:     $printer_enabled"

        if [[ "$sharing_enabled" != "on" ]]; then
            echo "      ⚠ Sharing DISABLED"
        elif [[ "$accept_status" != "accepted" ]]; then
            echo "      ⚠ Not accepting jobs"
        elif [[ "$printer_enabled" != "yes" ]]; then
            echo "      ⚠ Printer DISABLED"
        else
            echo "      ✓ Ready for network access"
        fi

    done < <(lpstat -v 2>/dev/null | grep -v "file:/" | grep "device for")

    [[ $printer_count -eq 0 ]] && info "No printers configured"

    echo ""
    echo "  ┌────────────────────────────────────────────────────────────────────────┐"
    echo "  │                    DISCOVERED ON NETWORK (mDNS)                        │"
    echo "  └────────────────────────────────────────────────────────────────────────┘"

    if have avahi-browse; then
        echo ""
        avahi-browse -rt _ipp._tcp 2>/dev/null | grep "^=" | grep -iE "brother|printer|laser|hp|canon|epson" | head -5 | while IFS= read -r line; do
            local iface
            iface=$(echo "$line" | sed -E 's/= ([^ ]+).*/\1/')
            local proto
            proto=$(echo "$line" | sed -E 's/.*IPv([46]).*/\1/')
            local name
            name=$(echo "$line" | sed -E 's/.*@ //' | awk '{print $1, $2, $3}')
            local host
            host=$(echo "$line" | sed -E 's/.*@ ([^ ]+).*/\1/')
            echo "  • $name ($iface/IPv$proto) @ $host"
        done
        echo ""
        echo "  (Full mDNS info shows printer is advertised on multiple interfaces)"
    else
        info "avahi-browse not available"
    fi

    echo ""
    echo "  ┌────────────────────────────────────────────────────────────────────────┐"
    echo "  │                    FIREWALL STATUS                                      │"
    echo "  └────────────────────────────────────────────────────────────────────────┘"

    if have ufw; then
        local ufw_active
        ufw_active=$(sudo ufw status 2>/dev/null | head -1 | grep -q "Status: active" && echo "yes" || echo "no")
        if [[ "$ufw_active" == "yes" ]]; then
            warn "UFW firewall is ACTIVE"
            echo "  Clients may be blocked from port 631!"
            echo ""
            echo "  To fix, run:"
            echo "    sudo ufw allow 631/tcp"
            echo "    sudo ufw allow from 192.168.0.0/16 to any port 631 proto tcp"
        else
            ok "UFW firewall not blocking"
        fi
    fi

    if have ss; then
        local ipp_listening
        ipp_listening=$(ss -tlnp 2>/dev/null | grep ":631" | grep LISTEN | head -1)
        if [[ -n "$ipp_listening" ]]; then
            ok "CUPS listening on port 631"
        else
            crit "CUPS NOT listening on port 631!"
        fi
    fi

    echo ""
    echo "  ┌────────────────────────────────────────────────────────────────────────┐"
    echo "  │                    DYNAMIC FIX COMMANDS                               │"
    echo "  └────────────────────────────────────────────────────────────────────────┘"

    echo ""
    echo "  ═══════════════════════════════════════════════════════════════════════"
    echo "  ON THIS MACHINE ($my_hostname) - Run these commands here:"
    echo "  ═══════════════════════════════════════════════════════════════════════"
    echo ""

    if [[ "$sharing_enabled" != "on" ]]; then
        echo "  # Enable CUPS printer sharing:"
        echo "  sudo cupsctl --share-printers"
        echo "  sudo systemctl restart cups"
        echo ""
    fi

    echo "  # Verify sharing is on:"
    echo "  cupsctl --remote-printers 2>/dev/null || echo 'Sharing may need manual enable'"
    echo ""

    echo ""
    echo "  ═══════════════════════════════════════════════════════════════════════"
    echo "  ON CLIENT MACHINE (e.g., yalla) - Run these commands:"
    echo "  ═══════════════════════════════════════════════════════════════════════"
    echo ""

    while IFS= read -r line; do
        [[ -z "$line" ]] && continue

        local printer_name
        printer_name=$(echo "$line" | sed -E 's/device for //' | sed 's/:.*//')
        local remote_uri="ipps://${my_domain}:631/printers/${printer_name}"
        local alt_uri="ipp://${my_domain}:631/printers/${printer_name}"

        echo "  # Fix for: $printer_name"
        echo "  sudo lpadmin -x $printer_name 2>/dev/null || true"
        echo "  sudo lpadmin -p ${printer_name}_${my_hostname} \\"
        echo "    -E -v $remote_uri \\"
        echo "    -m everywhere"
        echo "  sudo lpoptions -d ${printer_name}_${my_hostname}"
        echo "  echo 'Test print from $printer_name' | lp -d ${printer_name}_${my_hostname}"
        echo ""

    done < <(lpstat -v 2>/dev/null | grep -v "file:/" | grep "device for")

    echo "  # Alternative: Use DNS-SD auto-discovery on client:"
    echo "  # (No URI needed - client discovers automatically)"
    echo "  sudo lpadmin -p ${printer_name}_${my_hostname} -E -D 'Brother via $my_hostname'"
    echo ""

    echo "  ┌────────────────────────────────────────────────────────────────────────┐"
    echo "  │           REMOTE CONNECTIVITY TESTS (run on CLIENT machine)            │"
    echo "  └────────────────────────────────────────────────────────────────────────┘"
    echo ""
    echo "  From client machine (e.g., yalla), run these to test connectivity:"
    echo ""
    echo "  # Test 1: Ping the printer server"
    echo "    ping -c 2 $my_domain"
    echo ""
    echo "  # Test 2: Check IPP endpoint (this printer)"
    echo "    curl -skI https://$my_domain:631/printers/${printer_name}"
    echo ""
    echo "  # Test 3: Get printer status via IPP"
    echo "    ipptool -tvf ipp://$my_domain:631/printers/${printer_name} get-printer-attributes.test"
    echo ""
    echo "  # Test 4: Check what printers client sees"
    echo "    lpstat -a"
    echo "    lpstat -v"
    echo ""
    echo "  # Test 5: Verbose printer status"
    echo "    lpstat -l -p ${printer_name}"
    echo ""

    echo "  ┌────────────────────────────────────────────────────────────────────────┐"
    echo "  │           DEBUG PRINTER ISSUES (if printer not responding)               │"
    echo "  └────────────────────────────────────────────────────────────────────────┘"
    echo ""
    echo "  If you get 'client-error-not-found' or printer doesn't respond:"
    echo ""
    echo "  ON SERVER (ashy) - check/fix printer status:"
    echo "    # Check if printer is accepting jobs"
    echo "    lpstat -a $printer_name"
    echo ""
    echo "    # Enable printer if disabled"
    echo "    sudo cupsenable $printer_name"
    echo "    sudo cupsaccept $printer_name"
    echo ""
    echo "    # Restart CUPS"
    echo "    sudo systemctl restart cups"
    echo ""
    echo "  ON CLIENT (yalla) - if printer disappeared:"
    echo "    # Remove old entry"
    echo "    sudo lpadmin -x ${printer_name}_${my_hostname} 2>/dev/null || true"
    echo "    sudo lpadmin -x ${printer_name} 2>/dev/null || true"
    echo ""
    echo "    # Re-add with correct driver"
    echo "    sudo lpadmin -p ${printer_name} \\"
    echo "      -E -v ipps://${my_domain}:631/printers/${printer_name} \\"
    echo "      -m everywhere"
    echo ""
    echo "    # Or specify driver manually if 'everywhere' doesn't work:"
    echo "    # Find driver: lpinfo -m | grep -i brother"
    echo "    # Then use: -m 'openprinting-ppds:...'"
    echo ""
    echo "    # Enable and test"
    echo "    sudo cupsenable ${printer_name}"
    echo "    echo 'Test from ${my_domain}' | lp -d ${printer_name}"
    echo ""
}

# ---------- Common Issues ----------
declare -A PRINTER_ISSUES=(
    ["connection refused"]="CUPS may not be running. Run: sudo systemctl start cups"
    ["client-error-forbidden"]="Authentication failed or access denied. Check CUPS permissions"
    ["client-error-not-found"]="Printer URI wrong or printer offline. Verify with lpinfo -v"
    ["client-error-busy"]="Printer is busy. Wait or cancel stuck jobs with: cancel -a"
    ["printer not responding"]="Check physical connection, network, and power"
    ["unable to connect"]="Network printer unreachable. Check IP and firewall rules"
    ["ipp error"]="IPP protocol issue. Try: sudo systemctl restart cups"
    ["timeout"]="Connection timeout. Check network path and printer availability"
)

check_common_issues() {
    section "COMMON ISSUE DETECTION"

    local found_issue=0

    for issue in "${!PRINTER_ISSUES[@]}"; do
        local resolution="${PRINTER_ISSUES[$issue]}"

        local matches
        if [[ -f "/var/log/cups/error_log" ]]; then
            matches=$(grep -il "$issue" "/var/log/cups/error_log" 2>/dev/null || true)
        fi

        if [[ -n "$matches" ]]; then
            found_issue=1
            crit "$issue" "$resolution"
        fi
    done

    [[ $found_issue -eq 0 ]] && ok "No common printer issues detected in logs"
}

