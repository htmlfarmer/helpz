# ---------- Detect Connection Type ----------
detect_connection() {
    local uri="$1"
    case "$uri" in
        usb://*)      echo "USB" ;;
        ipp://*|ipps://*)  echo "Network (IPP)" ;;
        socket://*)  echo "Network (JetDirect)" ;;
        lpd://*)     echo "Network (LPD)" ;;
        serial://*)   echo "Serial" ;;
        bluetooth://*) echo "Bluetooth" ;;
        dnssd://*|mdns://*) echo "Network (Discovery)" ;;
        *)           echo "Unknown" ;;
    esac
}

