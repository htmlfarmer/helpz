# ---------- Print Job Management ----------
manage_jobs() {
    section "PRINT JOB MANAGEMENT"

    if ! have lpstat; then
        crit "lpstat not available" "Install cups-client package"
        return
    fi

    echo "  ┌────────────────────────────────────────────────────────────────────┐"
    echo "  │                         PRINT JOBS                                  │"
    echo "  └────────────────────────────────────────────────────────────────────┘"
    echo ""

    echo "  ACTIVE/QUEUED JOBS:"
    echo "  ───────────────────"
    local pending_jobs
    pending_jobs=$(lpstat -W not-completed 2>/dev/null)
    if [[ -n "$pending_jobs" ]]; then
        echo "$pending_jobs" | while IFS= read -r line; do
            echo "    $line"
        done
    else
        ok "No pending jobs"
