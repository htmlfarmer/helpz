# ---------- Send Poem Test Page ----------
send_poem() {
    section "PRINTING TEST POEM"

    if ! have lp; then
        crit "lp command not available" "Install cups-client package"
        return
    fi

    local default_printer
    default_printer=$(lpstat -d 2>/dev/null | awk '{print $NF}' || true)

    if [[ -z "$default_printer" || "$default_printer" == "none" ]]; then
        crit "No default printer configured"
        info "Set one with: lpoptions -d PRINTER_NAME"
        return
    fi

    echo "  Sending poetic test page to: $default_printer"
    echo ""

    # Gather real printer data
    local printer_status
    printer_status=$(lpstat -p "$default_printer" 2>/dev/null | head -1 || echo "unknown")
    local cups_active
    cups_active=$(systemctl is-active cups 2>/dev/null || echo "unknown")
    local cups_port
    cups_port=$(ss -tlnp 2>/dev/null | grep ":631" | head -1 | awk '{print $4}' || echo "not listening")
    local pending_jobs
    pending_jobs=$(lpstat -W not-completed 2>/dev/null | wc -l)
    local printer_uri
    printer_uri=$(lpstat -v 2>/dev/null | grep "$default_printer" | awk '{print $NF}' || echo "unknown")

    local all_printers
    all_printers=$(lpstat -a 2>/dev/null | awk '{print $1}' | head -5 | tr '\n' '|')

    local local_ip
    local_ip=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "unknown")

    local poem
    poem="
================================================================================
              PRINTERZ TEST PAGE - System Details
================================================================================

  Computer Name:    $(hostname)
  Local IP:        $local_ip
  Default Printer: $default_printer
  Printer URI:     $printer_uri
  Cups Status:     $cups_active
  Cups Port:       $cups_port
  Pending Jobs:    $pending_jobs
  Available Printers: $(echo "$all_printers" | tr '|' ' ')

================================================================================
           A PRINT JOB FOR THE COSMOS - Generated by printerz
================================================================================

  There once was a packet called IP,       REALITY: Printer: $default_printer
  That traveled the network with flip.        URI: $printer_uri
  It routed and hopped,                       Status: $printer_status
  Till the printer it stopped,              Cups: $cups_active on $cups_port

  The user pressed print with hope,          REALITY: Pending jobs: $pending_jobs
  Their document began to grope,             Hostname: $(hostname)
  Through queues and spins,                   Kernel: $(uname -r | cut -d- -f1)
  Till paper emerged with great scope.       Local IP: $local_ip

  Oh router, dear switch, and hub,           REALITY: The universe runs on
  You carry my bytes through the slub,       print jobs and cosmic dust.
  Of cat6 and fiber,                         From chaos comes order,
  Making data flow proper.                   And pages from pixels and trust.

  We print because we believe,               REALITY: If you read this, IT WORKS!
  That meaning is what we receive,           Your print pipeline is functional.
  From electrons dancing,                     Paper from binary dance.
  On paper, our thoughts conceive.           Another successful print instance!

================================================================================
  Printed: $(date) | Cups: $cups_active | Default: $default_printer
================================================================================
"

    echo "$poem" | lp -d "$default_printer" 2>&1

    if [[ $? -eq 0 ]]; then
        ok "Poem sent to $default_printer!"
        echo ""
        echo "  Check your printer output in a few seconds..."
        echo "  Then verify with: lpstat -W not-completed"
    else
        crit "Failed to send poem"
    fi
}

