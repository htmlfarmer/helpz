        connection_type=$(detect_connection "$printer_uri")
    fi

    printf "  %-15s %s\n" "Host:" "$HOSTNAME_SHORT ($local_ip)"
    printf "  %-15s %s\n" "Cups:" "$cups_active on $cups_port"
    printf "  %-15s %s\n" "Default Printer:" "$default_printer"
    if [[ "$default_printer" != "none" ]]; then
        printf "  %-15s %s\n" "Connection:" "$connection_type"
        printf "  %-15s %s\n" "URI:" "$printer_uri"
    fi
    printf "  %-15s %s\n" "Pending Jobs:" "$pending"
    printf "  %-15s %s\n" "Total Printers:" "$printer_count"

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
}

# ---------- Main ----------
main() {

    if [[ $MANUAL_MODE -eq 1 ]]; then
        manual_testing
        exit 0
    fi

    if [[ $USB_MODE -eq 1 ]]; then
        scan_usb
        exit 0
    fi

    if [[ $PORTS_MODE -eq 1 ]]; then
        check_ports
        exit 0
    fi

    if [[ $JOBS_MODE -eq 1 ]]; then
        manage_jobs
        exit 0
    fi

    if [[ $SERVICES_MODE -eq 1 ]]; then
        manage_services
        exit 0
    fi

    if [[ $POEM_MODE -eq 1 ]]; then
        send_poem
        exit 0
    fi

    if [[ $SHARING_MODE -eq 1 ]]; then
        check_sharing
        exit 0
    fi

    if [[ $FULL_LPSTAT -eq 1 ]]; then
        full_lpstat
        exit 0
    fi

    if [[ $TAIL_LINES -ne 50 ]] || [[ "${1:-}" == "--tail" ]]; then
        tail_mode
        exit 0
    fi

    check_cups_service
    detect_printers
    check_queues
    check_ports
    check_network

    if [[ $DEEP_SCAN -eq 1 ]]; then
        deep_log_scan
    else
        scan_cups_error_log
        scan_journal
    fi

    check_common_issues

    print_summary_header

    section "VERDICT"
    if (( CRITICAL > 0 )); then
        echo "  CRITICAL: $CRITICAL critical, $WARNINGS warnings"
    elif (( WARNINGS > 0 )); then
        echo "  WARNING: $WARNINGS warnings"
    else
        echo "  HEALTHY: no issues detected"
    fi

    echo "  Scan completed in $(($(date +%s) - START_TS))s"
    echo ""
    echo "  Run './printerz --manual' for testing instructions"

    if [[ "$JSON_OUT" == "1" ]]; then
        json_output
    fi

    if (( CRITICAL > 0 )); then
        exit 2
    elif (( WARNINGS > 0 )); then
        exit 1
    fi
    exit 0
}

# ---------- Individual scan functions for targeted runs ----------
scan_cups_error_log() {
    section "CUPS ERROR LOG (last 50 lines)"

    if [[ -f "/var/log/cups/error_log" ]]; then
        local log_errors
        log_errors=$(tail -n 50 "/var/log/cups/error_log" 2>/dev/null | grep -iE "error|warn|fail|denied|timeout|refused" || true)

        if [[ -n "$log_errors" ]]; then
            echo "$log_errors" | head -20 | while IFS= read -r line; do
                echo "    ✗ $line"
            done
        else
            ok "No errors in CUPS error log"
        fi
    else
        info "Cannot read /var/log/cups/error_log (may need sudo)"
    fi
}

scan_journal() {
    section "SYSTEMD JOURNAL (CUPS)"

    if ! have journalctl; then
        info "journalctl not available"
        return
    fi

    local journal_errors
    journal_errors=$(journalctl -u cups --since "$SINCE" --no-pager 2>/dev/null | grep -iE "error|fail|denied" | tail -20 || true)

    if [[ -n "$journal_errors" ]]; then
        echo "$journal_errors" | while IFS= read -r line; do
            echo "    ✗ $line"
        done
    else
        ok "No errors in CUPS journal"
    fi
}

main
