vendor_name() {
  local vid="$1"
  for v in "${VENDOR_NAMES[@]}"; do
    if [[ "${v%%:*}" == "$vid" ]]; then
      echo "${v#*:}"
      return
    fi
  done
  echo "Vendor 0x$vid"
}

if [[ -n "$VENDOR_COUNTS" ]]; then
  printf "  ${C_DIM}%-40s %6s${C_RESET}\n" "Vendor" "Devices"
  printf "  ${C_DIM}%-40s %6s${C_RESET}\n" "----------------------------------------" "------"
  printf '%s\n' "$VENDOR_COUNTS" | head -10 | while IFS= read -r line; do
    cnt=$(echo "$line" | awk '{print $1}')
    vid=$(echo "$line" | awk '{print $2}')
    name=$(vendor_name "$vid")
    printf "  %-40s ${C_CYAN}%6d${C_RESET}\n" "$name" "$cnt"
  done
else
  info "Could not enumerate vendors"
fi

# ============================================================================
# SECTION 7: Device Detail (top devices)
# ============================================================================
section "DEVICE DETAIL (top 10 by class frequency)"

# Capture `lspci -k` output once so we can show the kernel driver in use
# alongside each device's description (DRIVER column).
LSPCI_K=$(lspci -k 2>/dev/null)
if [[ -n "$LSPCI_K" ]]; then
  printf "  ${C_DIM}%-10s %-50s %s${C_RESET}\n" "BDF" "DESCRIPTION" "KERNEL DRIVER"
  printf "  ${C_DIM}%-10s %-50s %s${C_RESET}\n" "----------" "--------------------------------------------------" "----------------"
  # Walk lspci -k BDF-by-BDF: each header line begins with "<bdf> <desc>",
  # subsequent indented lines can include "Kernel driver in use: <name>".
  awk_cur_bdf=""
  awk_cur_desc=""
  awk_cur_drv=""
  printf '%s\n' "$LSPCI_K" | head -120 | awk -v c_dim="" '
    /^[[:xdigit:]]{2}:[[:xdigit:]]{2}\.[[:xdigit:]]/ {
      if (awk_cur_bdf != "") print awk_cur_bdf "|" awk_cur_desc "|" awk_cur_drv
      awk_cur_bdf = $1
      # Description is everything after "XX:XX.X " on that line
      sub(/^[[:xdigit:]]{2}:[[:xdigit:]]{2}\.[[:xdigit:]] +/, "")
      awk_cur_desc = $0
      awk_cur_drv = "(none)"
      next
    }
    /Kernel driver in use:/ {
      sub(/.*Kernel driver in use:[[:space:]]*/, "", $0)
      sub(/[[:space:]]*$/, "", $0)
      awk_cur_drv = $0
      next
    }
    /^$/ {
      if (awk_cur_bdf != "") {
        print awk_cur_bdf "|" awk_cur_desc "|" awk_cur_drv
        awk_cur_bdf = ""; awk_cur_desc = ""; awk_cur_drv = ""
      }
      next
    }
    END { if (awk_cur_bdf != "") print awk_cur_bdf "|" awk_cur_desc "|" awk_cur_drv }
  ' | head -10 | while IFS='|' read -r bdf desc drv; do
    [[ -z "$bdf" ]] && continue
    printf "  ${C_CYAN}%-10s${C_RESET} ${C_DIM}%-50s${C_RESET} %s\n" \
      "$bdf" "$(truncate "$desc" 48)" "$(truncate "$drv" 30)"
  done
fi

# ============================================================================
# SECTION 8: PCI Headline box
# ============================================================================
section "PCI HEADLINE"

# Find widest line
H1="Devices:        $TOTAL_DEVICES total"
H2="Classes:        $(printf '%s\n' "$CLASS_COUNTS" | wc -l) distinct"
H3="Fastest link:   $([[ $FASTEST_GEN -gt 0 ]] && echo "PCIe Gen$FASTEST_GEN" || echo "(unknown)")"
H4="Downgraded:     $DOWNGRADED link(s) below max"
H5="IOMMU groups:   $([[ -d /sys/kernel/iommu_groups ]] && find /sys/kernel/iommu_groups -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l || echo "0")"

# Compute visible width (strip ANSI for measurement)
strip_ansi() { printf '%s' "$1" | sed -E 's/\x1b\[[0-9;]*[a-zA-Z]//g'; }
widest=0
for line in "$H1" "$H2" "$H3" "$H4" "$H5"; do
  w=${#line}
  (( w > widest )) && widest=$w
done
BOX_W=$(( widest + 4 ))
[[ $BOX_W -lt 56 ]] && BOX_W=56
[[ $BOX_W -gt 72 ]] && BOX_W=72

# Print box (raw bytes for box-drawing to avoid UTF-8 mangling)
TOP="╔$(printf '═%.0s' $(seq 1 $BOX_W))╗"
BOT="╚$(printf '═%.0s' $(seq 1 $BOX_W))╝"

printf "  ${C_BOLD}${C_MAGENTA}%s${C_RESET}\n" "$TOP"
printf "  ${C_BOLD}${C_MAGENTA}║${C_RESET}%-${BOX_W}s  ${C_BOLD}${C_MAGENTA}║${C_RESET}\n" ""
printf "  ${C_BOLD}${C_MAGENTA}║${C_RESET}   %-$((BOX_W-3))s ${C_BOLD}${C_MAGENTA}║${C_RESET}\n" "$H1"
printf "  ${C_BOLD}${C_MAGENTA}║${C_RESET}   %-$((BOX_W-3))s ${C_BOLD}${C_MAGENTA}║${C_RESET}\n" "$H2"
printf "  ${C_BOLD}${C_MAGENTA}║${C_RESET}   %-$((BOX_W-3))s ${C_BOLD}${C_MAGENTA}║${C_RESET}\n" "$H3"
printf "  ${C_BOLD}${C_MAGENTA}║${C_RESET}   %-$((BOX_W-3))s ${C_BOLD}${C_MAGENTA}║${C_RESET}\n" "$H4"
printf "  ${C_BOLD}${C_MAGENTA}║${C_RESET}   %-$((BOX_W-3))s ${C_BOLD}${C_MAGENTA}║${C_RESET}\n" "$H5"
printf "  ${C_BOLD}${C_MAGENTA}║${C_RESET}%-${BOX_W}s  ${C_BOLD}${C_MAGENTA}║${C_RESET}\n" ""
printf "  ${C_BOLD}${C_MAGENTA}%s${C_RESET}\n" "$BOT"

# ============================================================================
# SECTION 9: Recommendations & Verdict
# ============================================================================
section "RECOMMENDATIONS"

rec() {
  printf "  ${C_CYAN}#%d${C_RESET} → %s\n" "$1" "$2"
}

rec 1 "Run \`lspci -vv\` for full register/negotiation details on any device"
rec 2 "Use \`lspci -tv\` to spot misrouted bridges or unexpected topology"
rec 3 "For VFIO passthrough: each device in its own IOMMU group is ideal"
rec 4 "Run \`sudo lshw -class pci -numeric\` for an alternate complete listing"
rec 5 "For PCIe errors: \`dmesg | grep -i pcie\` and check \`journalctl -k | grep AER\`"

if (( DOWNGRADED > 0 )); then
  rec 6 "Re-seat any device running below its max link speed (check physical slot/cable)"
fi

# ---------- Verdict ----------
section "VERDICT"

ELAPSED=$(( $(date +%s) - START_TS ))

if (( CRITICAL > 0 )); then
  printf "  ${C_RED}${C_BOLD}CRITICAL${C_RESET}: %d critical issue(s) found\n" "$CRITICAL"
  EXIT=2
elif (( WARNINGS > 0 )); then
  printf "  ${C_YELLOW}${C_BOLD}WARNINGS${C_RESET}: %d warning(s)\n" "$WARNINGS"
  EXIT=1
else
  printf "  ${C_GREEN}${C_BOLD}HEALTHY${C_RESET}: no issues detected\n"
  EXIT=0
fi

printf "  ${C_DIM}Scan completed in %ds at %s${C_RESET}\n" "$ELAPSED" "$(date '+%H:%M:%S')"

# ---------- JSON output ----------
if [[ $JSON_OUT -eq 1 ]]; then
  FIELDS=$(IFS=,; echo "${JSON_FIELDS[*]}")
  printf '{"script":"pci","host":"%s","timestamp":"%s","total_devices":%d,"fastest_gen":%d,"downgraded":%d,"warnings":%d,"critical":%d,"exit":%d}\n' \
    "$HOSTNAME_SHORT" "$TIMESTAMP" "$TOTAL_DEVICES" "$FASTEST_GEN" "$DOWNGRADED" "$WARNINGS" "$CRITICAL" "$EXIT"
fi

# ---------- AI verdict (opt-in via --ai) ----------
if [[ "${AI_VERDICT:-}" == "1" ]]; then
    ai_emit_verdict "summary" "pciz complete: total=$TOTAL_DEVICES gen=$FASTEST_GEN downgraded=$DOWNGRADED warnings=$WARNINGS critical=$CRITICAL class=$FILTER_CLASS vendor=$FILTER_VENDOR" 2>/dev/null || true
fi

# Finalize and generate comparison report
if [[ "$JSON_OUT" != "1" ]]; then
    run_comparison_finalize
fi

exit $EXIT
