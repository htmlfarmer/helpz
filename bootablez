# ---------- macOS installer media -------------------------------------------
# Apple's installers are not ISO files. A .dmg is a UDIF container wrapping a
# disk image — writing one straight to a stick gives a stick that will not
# boot, because the payload inside is compressed. And the FULL offline
# installer needs the OS payload inside the HFS+ volume, which no dd can do.
# These flags handle both, using Apple's own catalog as the source of truth.
if (( MACOS_LIST || MACOS_DOWNLOAD || MACOS_BUILD )); then
    declare -F macos_list >/dev/null 2>&1 \
        || usage_abort "this build has no macOS support (lib/macos.sh is missing)"

    if (( MACOS_BUILD )); then
        [[ -n "$MACOS_VER" ]] || usage_abort "--macos-build needs a version: --macos-build 10.13"
        section "MACOS · $MACOS_VER"
        MACOS_MEDIA_DIR=$(macos_download "$MACOS_VER") || usage_abort "could not fetch the macOS $MACOS_VER media"
        MACOS_IMG="$MACOS_MEDIA_DIR/macos-$MACOS_VER.img"
        info "assembling a bootable macOS $MACOS_VER image (recovery system + payload in one HFS+ volume)"
        macos_build "$MACOS_DIR" "$MACOS_IMG" || usage_abort "could not assemble the macOS image"
        ISO="$MACOS_IMG"
        ISO_SIZE=$(stat -c %s -- "$ISO" 2>/dev/null || echo 0)
        IMAGE_KIND="macos"
        ok "macOS $MACOS_VER image ready: $ISO ($(humansize "$ISO_SIZE"))"
        printf "  ${C_DIM}write it to a stick like any other image:${C_RESET}\n"
        printf "  ${C_BOLD}./bootablez --iso %s --device /dev/sdX --yes --verify${C_RESET}\n" "$ISO"
        if [[ -z "$TARGET" ]]; then
            add_json_field "status" "macos-image"
            emit_verdict
        fi
    elif (( MACOS_DOWNLOAD )); then
        [[ -n "$MACOS_VER" ]] || usage_abort "--macos-download needs a version: --macos-download 10.13"
        section "MACOS · $MACOS_VER"
        MACOS_MEDIA_DIR=$(macos_download "$MACOS_VER") || usage_abort "could not fetch the macOS $MACOS_VER media"
        ok "macOS $MACOS_VER media in $MACOS_MEDIA_DIR"
        add_json_field "status" "macos-downloaded"
        emit_verdict
    else
        section "MACOS INSTALLER MEDIA"
        macos_list
        add_json_field "status" "macos-list"
        emit_verdict
    fi
fi

