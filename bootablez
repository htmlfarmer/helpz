# ---------- Windows boot set -----------------------------------------------
# A Windows installer ISO does not fit on a small stick (Windows 10 is 5.2 GB,
# Windows 11 is 7.7 GB) but the BOOT SET does — about 500 MB of firmware
# files. With those, the machine boots into Windows Setup and the OS itself
# comes from the target's own disk, a network share, or the internet.
do_windows_boot_set() {
    local iso="$1" target="$2" part
    local mnt_iso=/mnt/bootablez-win-iso mnt_usb=/mnt/bootablez-win-usb
    [[ -f "$iso" ]] || { warn "no such file: $iso"; return 1; }
    command -v mkfs.vfat >/dev/null 2>&1 || { warn "needs mkfs.vfat (apt install dosfstools)"; return 1; }

    echo "--- partitioning $target (MBR + FAT32)"
    sudo_run wipefs -a "$target" >/dev/null 2>&1 || true
    printf 'label: dos\nunit: sectors\n\nstart=2048, type=0xef, bootable\n' \
        | sudo_run sfdisk --quiet "$target" || { warn "could not partition $target"; return 1; }
    part=$(lsblk -nr -o NAME "$target" | sed -n '2p')
    part="/dev/$part"
    [[ -b "$part" ]] || { warn "could not find the new partition on $target"; return 1; }
    echo "    partition: $part"

    echo "--- formatting FAT32"
    sudo_run mkfs.vfat -F 32 -n "WININST" "$part" || { warn "mkfs.vfat failed"; return 1; }

    echo "--- reading the boot files out of the ISO"
    sudo_run mkdir -p "$mnt_iso" "$mnt_usb" || return 1
    sudo_run mount -o loop,ro "$iso" "$mnt_iso" || { warn "could not mount the ISO"; return 1; }
    sudo_run mount "$part" "$mnt_usb" || { sudo_run umount "$mnt_iso"; warn "could not mount $part"; return 1; }

    # the names on a Windows ISO come out in whatever case the filesystem
    # carries — match them case-insensitively instead of guessing
    local rel dest f
    while IFS='|' read -r rel dest; do
        [[ -n "$rel" ]] || continue
        f=$(sudo_run find "$mnt_iso" -ipath "*/$rel" -print -quit 2>/dev/null | head -1)
        [[ -n "$f" ]] || { printf "    ${C_DIM}(not found: %s)${C_RESET}\n" "$rel"; continue; }
        sudo_run mkdir -p "$(dirname "$mnt_usb/$dest")" 2>/dev/null || true
        if sudo_run cp -f "$f" "$mnt_usb/$dest"; then
            printf "    ${C_GREEN}+${C_RESET} %s\n" "$dest"
        fi
    done <<'EOF'
bootmgr|bootmgr
boot/BCD|boot/BCD
sources/boot.wim|sources/boot.wim
sources/install.boot|sources/install.boot
efi/boot/bootx64.efi|efi/boot/bootx64.efi
efi/microsoft/boot/bootmgfw.efi|efi/microsoft/boot/bootmgfw.efi
EOF

    echo "--- syncing and releasing"
    sudo_run sync
    sudo_run umount "$mnt_usb"
    sudo_run umount "$mnt_iso"
    sudo_run rmdir "$mnt_iso" "$mnt_usb" 2>/dev/null || true
    return 0
}

# ---------- Windows USB, the way a real Windows USB is built ---------------
# The Windows installer ISOs have no El Torito boot record, so dd-ing one to
# a stick gives a stick that will not boot. The only layout that works is
# what Microsoft's Media Creation Tool builds: one FAT32 partition with the
# ISO's contents copied in — bootmgr, boot/BCD, sources/boot.wim, the EFI
# loader — and the payload (install.wim) split so it fits FAT32's 4 GB file
# limit.
do_windows_usb() {
    local iso="$1" target="$2" part mnt_iso=/mnt/bootablez-wusb mnt_usb=/mnt/bootablez-wusb
    [[ -f "$iso" ]] || { warn "no such file: $iso"; return 1; }
    command -v mkfs.vfat >/dev/null 2>&1 || { warn "needs mkfs.vfat (apt install dosfstools)"; return 1; }
    command -v wimlib-imagex >/dev/null 2>&1 || {
        info "installing wimlib (it splits install.wim so it fits FAT32)"
        apt-get install -y wimlib || { warn "could not install wimlib (apt install wimlib)"; return 1; }
    }

    echo "--- wiping $target and laying out one FAT32 partition"
    sudo_run wipefs -a "$target" >/dev/null 2>&1 || true
    printf 'label: dos\nunit: sectors\n\nstart=2048, type=0x0c, bootable\n' | sudo_run sfdisk --quiet "$target" || { warn "sfdisk failed"; return 1; }
    part=$(lsblk -nr -o NAME "$target" | sed -n '2p')
    part="/dev/$part"
    [[ -b "$part" ]] || { warn "no partition appeared on $target"; return 1; }
    echo "    partition: $part"
    sudo_run mkfs.vfat -F 32 -n "WINUSB" "$part" || { warn "mkfs.vfat failed"; return 1; }

    echo "--- mounting the ISO"
    sudo_run mkdir -p "$mnt_iso" "$mnt_usb" || return 1
    sudo_run mount -o loop,ro "$iso" "$mnt_iso" || { warn "could not mount the ISO (needs the udf driver)"; return 1; }
    sudo_run mount "$part" "$mnt_usb" || { sudo_run umount "$mnt_iso"; warn "could not mount $part"; return 1; }

    echo "--- copying the installer files (this takes a few minutes)"
    sudo_run cp -rT --no-preserve=xattr,ownership "$mnt_iso/." "$mnt_usb/" 2>/dev/null || true
    sudo_run rm -f "$mnt_usb/sources/install.wim" "$mnt_usb/sources/install.esd" 2>/dev/null || true

    echo "--- splitting install.wim so it fits FAT32"
    local wim
    wim=$(sudo_run find "$mnt_iso" -maxdepth 2 -iname 'install.wim' -print -quit 2>/dev/null | head -1)
    if [[ -n "$wim" ]]; then
        sudo_run wimlib-imagex split "$wim" "$mnt_usb/sources/install.swm" 4000M || {
            warn "wimlib could not split the payload"
        }
        # wimlib names the parts however it likes; Windows Setup only accepts
        # install.swm, install2.swm, install3.swm … so rename them in order
        local n=2 p first=1
        local -a parts=()
        mapfile -t parts < <(sudo_run find "$mnt_usb/sources" -maxdepth 1 -name 'install*.swm' -printf '%T@ %p\n' 2>/dev/null | sort -n | cut -d' ' -f2)
        for p in "${parts[@]}"; do
            [[ -f "$p" ]] || continue
            if (( first )); then
                [[ "$(basename "$p")" == "install.swm" ]] || sudo_run mv "$p" "$mnt_usb/sources/install.swm"
                first=0
            else
                sudo_run mv "$p" "$mnt_usb/sources/install${n}.swm" 2>/dev/null && n=$((n+1))
            fi
        done
        sudo_run ls -la "$mnt_usb/sources/" | head -8
    else
        warn "no install.wim found in the ISO — the payload may not have been copied"
    fi

    echo "--- syncing and releasing"
    sudo_run sync
    sudo_run umount "$mnt_usb"
    sudo_run umount "$mnt_iso"
    sudo_run rmdir "$mnt_iso" "$mnt_usb" 2>/dev/null || true
    return 0
}

