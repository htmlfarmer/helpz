cmd_autopsy() {
    banner
    with_spin "harvesting crash evidence" scan_all
    print_evidence
    rank_causes
    print_ranking
    print_last_words "${BOOT_FOCUS:--1}"
    print_playbook
    section "FLIGHT RECORDER"
    if [[ -s "$WATCH_LOG" ]]; then
