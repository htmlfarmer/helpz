        info "Read the last lines: tail -20 $WATCH_LOG"
    else
        info "No flight-recorder log yet — the next freeze will be silent unless you arm it:"
        printf "    ${C_GREEN}./crashz watch 5${C_RESET}  ${C_DIM}— one line per 5s: PSI stalls, temp, load, new journal errors${C_RESET}\n"
    fi
    emit_json_summary
    finish
    emit_verdict
}

cmd_why() {
    with_spin "reading the evidence" scan_all
