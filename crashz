    finish; exit 0
}

cmd_freeze() {
    banner
    with_spin "hunting freeze fingerprints" scan_all
    rank_causes
    section "FREEZE SUSPECTS (hard-freeze signatures)"
    local key any=0
    table_begin "SIGNATURE" "HITS" "WHY IT FREEZES THE BOX"
    for key in GpuHang HungTask DiskIO Thermal OOM MCE KernelPanic Unclean; do
        (( ${EV_COUNT[$key]:-0} > 0 )) || continue
        any=1
        local why=""
        case "$key" in
            GpuHang)     why="compositor waits on a GPU that never answers → everything stops" ;;
            HungTask)    why="kernel task blocked >120s in uninterruptible I/O → UI can't be scheduled" ;;
            DiskIO)      why="journal/swap stalls on a dying drive → the system freezes before it dies" ;;
            Thermal)     why="hardware thermal trip cuts clocks mid-frame → hard stop" ;;
            OOM)         why="thrashing before the kill → everything crawls, then wedges" ;;
            MCE)         why="machine-check under video load = silicon or power-supply instability" ;;
            KernelPanic) why="oops with no console output looks exactly like a freeze" ;;
            Unclean)     why="no shutdown sequence found — it died mid-session" ;;
        esac
        table_row "$(cause_title "$key")" "${EV_COUNT[$key]}" "$why"
    done
    table_end
    if (( any )); then
        print_last_words
        print_playbook
    else
        ok "No freeze signatures in the logged evidence"
        info "Video-time freezes with ZERO logs = hard lockup (power/RAM/GPU hardware)."
        printf "  ${C_DIM}Arm the recorder, then reproduce:${C_RESET} ./crashz watch 5\n"
        printf "  ${C_DIM}Test the video pipeline:${C_RESET} LIBGL_ALWAYS_SOFTWARE=1 <your browser> ${C_DIM}— freeze gone = GPU driver${C_RESET}\n"
    fi
    section "LIVE VITALS (right now)"
    live_vitals
    if [[ $HAVE_SENSORS -eq 1 ]]; then
        subsec "sensors (readings)"
        timeout 5 sensors 2>/dev/null | head -24 | while IFS= read -r l; do
            printf "  ${C_DIM}%s${C_RESET}\n" "$l"
        done
    fi
    if [[ $HAVE_SMART -eq 0 ]]; then
        info "smartctl absent — for storage-error depth: sudo apt install smartmontools"
    fi
    emit_json_summary
    finish
    emit_verdict
}

cmd_apps() {
    banner
    with_spin "counting app casualties" scan_all
    section "APP CRASH LEADERBOARD (last ${SINCE_H}h)"
    local win="$J_WIN"
    [[ -s "$win" ]] || win="$WORK/journal_0.txt"
    if [[ -s "$win" ]]; then
        local faults board
        faults=$(grep -iE 'segfault at|general protection|dumped core|core dumped' "$win" 2>/dev/null)
        if [[ -n "$faults" ]]; then
            board=$( {
                printf '%s\n' "$faults" | grep -oE '\([A-Za-z0-9_.+-]+\) of user' | sed -E 's/^\(|\) of user$//g'
                printf '%s\n' "$faults" | grep -oE '[A-Za-z0-9_.+-]+\[[0-9]+\]: (segfault|traps)' | cut -d'[' -f1
                printf '%s\n' "$faults" | grep -oE 'traps: [A-Za-z0-9_.+-]+' | sed 's/traps: //'
            } 2>/dev/null | sort | uniq -c | sort -rn | head -10 )
        fi
        if [[ -n "$board" ]]; then
            table_begin "CRASHES" "BINARY"
            while read -r n name; do
                [[ -z "${n:-}" ]] && continue
                local col="$C_CYAN"
                table_row "${C_RED}${n}${C_RESET}" "${name:-unknown}"
            done <<< "$board"
            table_end
        else
            ok "No segfault / core-dump fingerprints in the window"
        fi
    fi
    if [[ $HAVE_COREDUMP -eq 1 ]]; then
        subsec "systemd-coredump (latest 8)"
        timeout 10 coredumpctl list --no-pager 2>/dev/null | tail -9 | while IFS= read -r l; do
            printf "  ${C_DIM}%s${C_RESET}\n" "$l"
        done
    fi
    shopt -s nullglob
    local crashes=("/var/crash/"*.crash)
    shopt -u nullglob
    if [[ ${#crashes[@]} -gt 0 ]]; then
        subsec "apport crash reports (${#crashes[@]} file(s))"
        local f shown=0 ptype exe
        for f in "${crashes[@]}"; do
            (( shown >= 6 )) && break
            ptype=$(grep -m1 '^ProblemType:' "$f" 2>/dev/null | awk '{print $2}')
            exe=$(grep -m1 '^ExecutablePath:' "$f" 2>/dev/null | awk '{print $2}')
            printf "  ${C_RED}✗${C_RESET} %-16s %s\n" "${ptype:-?}" "${exe:-?}"
            shown=$((shown+1))
        done
        info "Report upstream: ubuntu-bug <package>   ·   evidence: ./crashz bundle"
    fi
    rank_causes
    emit_json_summary
    finish
    emit_verdict
}

cmd_recover() {
    banner
    with_spin "building the recovery plan" scan_all
    rank_causes
    section "IMMEDIATE ACTIONS"
    if (( APPLY == 1 )); then
        sync 2>/dev/null || true
        ok "sync — dirty pages flushed to storage"
        if [[ $EUID -eq 0 ]]; then
            systemctl reset-failed 2>/dev/null && ok "systemctl reset-failed — failed-unit ledger cleared"
        else
            info "reset-failed needs root: sudo systemctl reset-failed"
        fi
    else
        printf "  ${C_GREEN}→${C_RESET} Re-run with ${C_BOLD}--apply${C_RESET} to execute the safe ones (sync, reset-failed)\n"
        printf "  ${C_GREEN}→${C_RESET} Arm the flight recorder before the next episode: ${C_BOLD}./crashz watch 5${C_RESET}\n"
        printf "  ${C_GREEN}→${C_RESET} Export evidence while journals are fresh: ${C_BOLD}./crashz bundle${C_RESET}\n"
    fi
    local failed
    failed=$(systemctl --no-pager --state=failed --plain 2>/dev/null | grep -c '\.service' || true)
    failed=${failed:-0}
    if (( failed > 0 )); then
        warnf "failed_service" "${failed} failed systemd unit(s) right now — aftermath cleanup" \
            "sudo systemctl reset-failed (or crashz recover --apply), then investigate survivors with logz"
        suggest_tool logz "failed units remain after the crash — logz shows their error stream"
    fi
    if [[ ${#RANKED[@]} -gt 0 ]]; then
        section "PLAYBOOKS — IN EVIDENCE ORDER"
        local entry i=0 key l
        for entry in "${RANKED[@]}"; do
            i=$((i+1)); (( i > 3 )) && break
            key="${entry#*|}"
            subsec "$i. $(cause_title "$key")"
            while IFS= read -r l; do
                [[ -z "$l" ]] && continue
                printf "    ${C_CYAN}•${C_RESET} %s\n" "$l"
            done <<< "${PLAYBOOK[$key]:-}"
        done
    else
        section "PLAYBOOK"
        ok "No crash evidence found — good news. Still arm the recorder (./crashz watch) before the next episode."
    fi
    lost_work_finder
    emit_json_summary
    finish
    emit_verdict
}

cmd_smart() {
    banner
    if [[ -n "$SMART_FROM" ]]; then
        section "PASTED SMART LOG — ${SMART_FROM}"
        local ok=0
        if [[ "$SMART_FROM" == "-" ]]; then
            smart_parse_text_stream "pasted-log" && ok=1
        else
            [[ -r "$SMART_FROM" ]] || { crit "cannot read $SMART_FROM"; finish; emit_verdict; }
            smart_parse_text_stream "$SMART_FROM" < "$SMART_FROM" && ok=1
        fi
        (( ok )) || crit "no SMART health fields recognized — paste the smartctl -A output verbatim"
        rank_causes
        if [[ ${#RANKED[@]} -gt 0 ]]; then
            subsec "Reading across from the other machine"
            info "unsafe_shutdowns is the drive's own crash counter — a high value there means those freezes were real power-loss-grade deaths"
            info "Run ./crashz there too (autopsy + watch) once it is installed; ./crashz bundle carries this analysis"
        fi
        finish; emit_verdict
    fi
    if ! declare -F smart_collect >/dev/null 2>&1; then
        crit "lib/smart.sh missing — SMART reporting unavailable"
        finish; emit_verdict
    fi
    if ! command -v smartctl >/dev/null 2>&1 && [[ ! -x /usr/sbin/smartctl ]]; then
        crit "smartctl not installed — sudo apt install smartmontools (jq also required)"
        finish; emit_verdict
    fi
    if ! with_spin "reading drive health logs" smart_collect; then
        crit "smartctl returned no parseable data — try: sudo ./crashz smart (NVMe full logs need root on most systems)"
        finish; emit_verdict
    fi
    section "DRIVE HEALTH (NVMe + ATA SMART)"
    smart_table
    info "sudo reveals more (error logs, self-tests): sudo ./crashz smart"
    # findings + the Unclean corroboration hook, same rules as the autopsy
    if [[ $HAVE_JOURNAL -eq 1 ]]; then
        SMART_UNSAFE_HOOK=_smart_unclean_hook
    else
        SMART_UNSAFE_HOOK=""
    fi
    smart_findings
    rank_causes
    if [[ ${#RANKED[@]} -gt 0 ]]; then
        section "READ — THE DRIVE'S SIDE OF THE STORY"
        local row dev kind model health temp used spare spareth unsafe merr realloc pending crc uncorr poh pc errlog critwarn
        for row in "${SMART_ROWS[@]}"; do
            IFS=$'\t' read -r dev kind model health temp used spare spareth unsafe merr realloc pending crc uncorr poh pc errlog critwarn <<< "$row"
            [[ "$kind" == "?" ]] && continue
            subsec "$dev ($kind) ${model:0:28}"
            if [[ "$kind" == "NVMe" ]]; then
                info "wear ${used:-?}% · spare ${spare:-?}% (thresh ${spareth:-?}%) · temp ${temp:-?}°C"
                info "unsafe_shutdowns ${unsafe:-?} vs power_cycles ${pc:-?} — every unsafe entry = one death without a clean shutdown"
                info "media_errors ${merr:-?} · err-log entries ${errlog:-?} · power-on ${poh:-?}h · critical_warning ${critwarn:-0}"
            else
                info "realloc ${realloc:-0} · pending ${pending:-0} · CRC(link) ${crc:-0} · uncorrectable ${uncorr:-0} · temp ${temp:-?}°C · power-on ${poh:-?}h"
            fi
        done
        print_playbook
    else
        ok "Drives report no crash-relevant SMART findings — storage likely not your freeze cause"
    fi
    add_json_field "smart_drives" "${#SMART_ROWS[@]}" 1
    finish; emit_verdict
}

cmd_bundle() {
    banner
    with_spin "collecting the evidence" scan_all
    rank_causes
    local stage="$WORK/bundle" host ts dir out
    host=$(hostname -s 2>/dev/null || echo host)
    ts=$(date '+%Y%m%d-%H%M%S')
    dir="${SECURITY_LOG_DIR:-$HOME/.security-logs}/bundles"
    mkdir -p "$dir" 2>/dev/null || true
    out="$dir/crashz-${host}-${ts}.tar.gz"
    mkdir -p "$stage" 2>/dev/null || { crit "cannot create $dir"; exit 1; }

    { echo "crashz evidence bundle — $(date)"
      echo "kernel: $(uname -sr)   host: $host   focus: ${BOOT_FOCUS:-current+previous}   since: ${SINCE_H}h"
      echo "cmdline: $(cat /proc/cmdline 2>/dev/null)"
      echo "boot mode: $( [[ -d /sys/firmware/efi ]] && echo UEFI || echo legacy-BIOS )"
      echo "uptime: $(uptime 2>/dev/null)"; } > "$stage/00-meta.txt"
    journalctl --list-boots --no-legend 2>/dev/null | tail -10 > "$stage/01-boots.txt"
    tail -4000 "$WORK/journal_-1.txt" > "$stage/02-journal-previous.txt" 2>/dev/null || : > "$stage/02-journal-previous.txt"
    tail -4000 "$WORK/journal_0.txt"  > "$stage/03-journal-current.txt"  2>/dev/null || : > "$stage/03-journal-current.txt"
    ( dmesg -T 2>/dev/null || journalctl -k -b --no-pager 2>/dev/null ) | tail -800 > "$stage/04-dmesg.txt"
    { echo "== apt history (tail) =="; tail -120 /var/log/apt/history.log 2>/dev/null
      echo "== kernel/graphics packages =="
      dpkg -l 2>/dev/null | grep -iE 'linux-image|nvidia|mesa|libgl|xserver|firmware' | tail -40; } > "$stage/05-packages.txt"
    { echo "== VGA =="; lspci -nn 2>/dev/null | grep -iE 'vga|3d|display'
      echo "== block =="; lsblk -o NAME,SIZE,MODEL,ROTA,STATE 2>/dev/null
      echo "== mem ==";  free -h
      echo "== smart summary =="
      if declare -F smart_collect >/dev/null 2>&1 && smart_collect; then
          smart_dump
          echo "== smartctl -a (full where permitted) =="
          local d
          for d in $(lsblk -dnrpo NAME,TYPE 2>/dev/null | awk '$2=="disk"{print $1}' | head -4); do
              echo "--- $d ---"; timeout 15 smartctl -a "$d" 2>/dev/null | head -70; echo
          done
      else echo "smartmontools/jq not available"; fi; } > "$stage/06-hardware.txt"
    cp "$WORK/pstore.txt" "$stage/07-pstore.txt" 2>/dev/null || : > "$stage/07-pstore.txt"
    last -Fx 2>/dev/null | head -40 > "$stage/08-last.txt"
    tail -200 "$WATCH_LOG" > "$stage/09-watch-log.txt" 2>/dev/null || : > "$stage/09-watch-log.txt"
    { local entry key
      echo "crashz ranked findings ($(date))"
      for entry in "${RANKED[@]:-}"; do
          [[ -z "$entry" ]] && continue
          echo "  score ${entry%%|*}  $(cause_title "${entry#*|}")  hits=${EV_COUNT[${entry#*|}]}"
      done
      for key in "${CAUSE_ORDER[@]}"; do
          (( ${EV_COUNT[$key]:-0} > 0 )) || continue
          echo; echo "== $key sample =="; echo "${EV_SAMPLE[$key]:-}"
      done; } > "$stage/10-findings.txt"
    if [[ $HAVE_COREDUMP -eq 1 ]]; then
        timeout 10 coredumpctl list --no-pager 2>/dev/null | tail -50 > "$stage/11-coredumps.txt" || true
    fi
    if command -v tar >/dev/null 2>&1; then
        tar czf "$out" -C "$stage" . 2>/dev/null
    else
        crit "tar not found — cannot bundle"
        finish; exit 1
    fi

    section "EVIDENCE BUNDLE"
    if [[ -s "$out" ]]; then
        ok "Written: $out ($(humansize "$(stat -c%s "$out" 2>/dev/null || echo 0)"))"
        info "Attach to bug reports / RMA / a colleague: journals, pstore, SMART, packages, findings."
        echo
    else
        crit "bundle write failed — check permissions on $dir"
        finish; exit 1
    fi
    finish; exit 0
}

cmd_watch() {
    local interval="$WATCH_SECONDS"
    [[ "$interval" =~ ^[0-9]+$ ]] || interval=5
    (( interval < 1 )) && interval=1
    banner
    printf "  ${C_BOLD}FLIGHT RECORDER ARMED${C_RESET} — one vital line every ${interval}s to:\n"
    printf "  ${C_DIM}%s${C_RESET}\n\n" "$WATCH_LOG"
    printf "  ${C_DIM}Leave it running. If the box freezes, the LAST LINE of that file is the moment of death.${C_RESET}\n"
    printf "  ${C_DIM}Log is sync'd every tick so a hard freeze can't eat the trail.  Ctrl+C stops.${C_RESET}\n\n"
    local tick=0
    trap 'printf "\n  ${C_DIM}watch stopped after %s tick(s) — inspect: tail -40 %s${C_RESET}\n\n" "$tick" "$WATCH_LOG"; exit 0' INT TERM
    while :; do
        tick=$((tick+1))
        local now pc pm pi temp="" t tz load topcpu terr
        now=$(date '+%Y-%m-%d %H:%M:%S')
        pc=$(awk -F'[= ]' '/^some/{print $3}' /proc/pressure/cpu 2>/dev/null)
        pm=$(awk -F'[= ]' '/^some/{print $3}' /proc/pressure/memory 2>/dev/null)
        pi=$(awk -F'[= ]' '/^some/{print $3}' /proc/pressure/io 2>/dev/null)
        for tz in /sys/class/thermal/thermal_zone*/temp; do
            [[ -r "$tz" ]] || continue
            t=$(( $(cat "$tz" 2>/dev/null || echo 0) / 1000 ))
            [[ -z "$temp" || $t -gt $temp ]] && temp=$t
        done
        load=$(cut -d' ' -f1 /proc/loadavg 2>/dev/null)
        topcpu=$(ps -eo pcpu,comm --sort=-pcpu --no-headers 2>/dev/null | head -1 | awk '{printf "%s%% %s", $1, $2}')
        terr=$(timeout 5 journalctl --no-pager -p err --since "-${interval}s" 2>/dev/null | grep -c . || true)
        terr=${terr:-0}
        printf '%s | psi cpu=%s mem=%s io=%s | temp=%s | load=%s | top=%s | new_err=%s\n' \
            "$now" "${pc:-?}" "${pm:-?}" "${pi:-?}" "${temp:-?}" "${load:-?}" "${topcpu:-?}" "$terr" >> "$WATCH_LOG"
        sync 2>/dev/null || true
        if [[ "${JSON_OUT:-0}" -eq 0 ]]; then
            local col="$C_DIM"
            awk -v x="${pc:-0}" 'BEGIN{exit !(x+0>15)}' 2>/dev/null && col="$C_YELLOW"
            [[ -n "$temp" ]] && (( temp > 80 )) && col="$C_RED"
            printf "  ${col}%s${C_RESET}\n" "$(tail -1 "$WATCH_LOG")"
        fi
        (( tick % 200 == 0 )) && tail -4000 "$WATCH_LOG" > "$WORK/wl" 2>/dev/null && mv "$WORK/wl" "$WATCH_LOG"
        sleep "$interval"
    done
}

