# DISPATCH
# ============================================================================
case "$COMMAND" in
    autopsy) cmd_autopsy ;;
    why)     cmd_why ;;
    freeze)  cmd_freeze ;;
    apps)    cmd_apps ;;
    recover) cmd_recover ;;
    smart)   cmd_smart ;;
    bundle)  cmd_bundle ;;
    watch)   cmd_watch ;;
    *)       echo "crashz: unknown command '$COMMAND' (try --help)" >&2; exit 64 ;;
esac
