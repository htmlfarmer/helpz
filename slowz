# ---------- PSI BOTTLENECK RANKING — what's actually slowing you down ----------
section "PSI BOTTLENECK RANKING — WHAT'S ACTUALLY SLOWING YOU DOWN?"
info "${C_DIM}Pressure Stall Information (PSI): percent of wall-clock time at least one task${C_RESET}"
info "${C_DIM}was waiting on each subsystem. Higher % = the real bottleneck.${C_RESET}"
echo ""

psi_field() {
    local file="$1" kind="$2" field="$3"
    [[ -r "$file" ]] || { echo ""; return; }
    awk -v k="$kind" -v f="$field" '$1==k { for (i=2; i<=NF; i++) if ($i ~ ("^"f"=")) { split($i,a,"="); print a[2]; exit } }' "$file"
}
psi_color() {
    local v=${1%.*}
    [[ -z "$v" || "$v" -lt 5 ]]  && { echo "$C_GREEN";  return; }
    [[ "$v" -lt 15 ]]             && { echo "$C_YELLOW"; return; }
    echo "$C_RED"
}

CPU_10=$(psi_field /proc/pressure/cpu    some avg10)
IO_10=$(psi_field  /proc/pressure/io     some avg10)
MEM_10=$(psi_field /proc/pressure/memory some avg10)
CPU_60=$(psi_field /proc/pressure/cpu    some avg60); [[ -z "$CPU_60" ]] && CPU_60="$CPU_10"
IO_60=$(psi_field  /proc/pressure/io     some avg60); [[ -z "$IO_60"  ]] && IO_60="$IO_10"
MEM_60=$(psi_field /proc/pressure/memory some avg60); [[ -z "$MEM_60" ]] && MEM_60="$MEM_10"

printf "  ${C_DIM}%-22s  %7s  %7s  %7s${C_RESET}\n" "SUBSYSTEM" "10s" "60s" "5m"
printf "  ${C_DIM}──────────────────────────────────────────────────${C_RESET}\n"
printf "  ${C_DIM}%-22s${C_RESET}  " "CPU pressure"
c=$(psi_color "$CPU_10"); printf "${c}%7s${C_RESET}  " "${CPU_10:-—}%"
c=$(psi_color "$CPU_60"); printf "${c}%7s${C_RESET}  " "${CPU_60:-—}%"
c=$(psi_color "$CPU_60"); printf "${c}%7s${C_RESET}\n" "${CPU_60:-—}%"
printf "  ${C_DIM}%-22s${C_RESET}  " "I/O pressure"
c=$(psi_color "$IO_10"); printf "${c}%7s${C_RESET}  " "${IO_10:-—}%"
c=$(psi_color "$IO_60"); printf "${c}%7s${C_RESET}  " "${IO_60:-—}%"
c=$(psi_color "$IO_60"); printf "${c}%7s${C_RESET}\n" "${IO_60:-—}%"
printf "  ${C_DIM}%-22s${C_RESET}  " "Memory pressure"
c=$(psi_color "$MEM_10"); printf "${c}%7s${C_RESET}  " "${MEM_10:-—}%"
c=$(psi_color "$MEM_60"); printf "${c}%7s${C_RESET}  " "${MEM_60:-—}%"
c=$(psi_color "$MEM_60"); printf "${c}%7s${C_RESET}\n" "${MEM_60:-—}%"
echo ""

# Rank
RANKING=$(awk -v cpu="${CPU_60:-0}" -v io="${IO_60:-0}" -v mem="${MEM_60:-0}" \
    'BEGIN { printf "CPU %s\nIO  %s\nMEM %s\n", cpu+0, io+0, mem+0 }' | sort -k2 -nr)
PRIMARY=$(head -1 <<< "$RANKING" | awk '{print $1}')
PRIMARY_PCT=$(head -1 <<< "$RANKING" | awk '{print $2}')
info "  ${C_BOLD}Primary bottleneck:${C_RESET} ${C_RED}${PRIMARY}${C_RESET} subsystem at ~${PRIMARY_PCT}% avg60"

case "$PRIMARY" in
    IO)
        info "  ${C_DIM}Tasks are waiting on storage. The CPU is starving.${C_RESET}"
        info "  ${C_DIM}Suspects: swap traffic, runaway log writes, DB writes, slow disk.${C_RESET}"
        ;;
    CPU)
        info "  ${C_DIM}CPU is saturated. Tasks are waiting for compute.${C_RESET}"
        info "  ${C_DIM}Suspects: runaway process, single-threaded workload, thermal throttle.${C_RESET}"
        ;;
    MEM)
        info "  ${C_DIM}Tasks are waiting on memory pages. System is RAM-starved.${C_RESET}"
        info "  ${C_DIM}Suspects: heavy process, leaky service, undersized RAM.${C_RESET}"
        ;;
esac
echo ""

# ---------- Smart Recommendations ----------
section "RECOMMENDATIONS"
rec_count=0
rec_high=0
rec_med=0
rec_low=0

# Helper to print a color-coded recommendation
print_rec() {
  local severity=$1   # "high", "med", "low"
  local label=$2
  local reason=$3
  local cmd=$4
  local color sym
  case "$severity" in
    high) color="$C_RED";    sym="▶▶"; rec_high=$((rec_high + 1)) ;;
    med)  color="$C_YELLOW"; sym="▶";  rec_med=$((rec_med + 1))  ;;
    low)  color="$C_DIM";    sym="·";  rec_low=$((rec_low + 1))  ;;
  esac
  emit "  ${color}${sym} ${C_BOLD}%s${C_RESET}  ${C_DIM}—${C_RESET} %s\n" "$label" "$reason"
  [[ -n "$cmd" ]] && emit "    ${C_CYAN}\$ %s${C_RESET}\n" "$cmd"
  rec_count=$((rec_count + 1))
}

# Override the swap-based warning: PSI is the real metric
IO_PCT=${IO_60%.*}
MEM_PCT=${MEM_60%.*}
if [[ -n "$IO_PCT" && "$IO_PCT" -ge 15 ]]; then
    print_rec "high" "Disk I/O pressure is ${IO_60}% — top wall-clock bottleneck" \
        "Every second ~${IO_60}% of CPU time is wasted waiting on disk. No amount of CPU tuning fixes this." \
        "Find the culprit: 'sudo iotop -aoP' or scan /proc/[0-9]*/io for biggest writers. Common causes: runaway logs in /var/log, swap activity, DB write storms, slow HDD on a busy workload."
fi
if [[ -n "$MEM_PCT" && "$MEM_PCT" -ge 10 ]]; then
    print_rec "med" "Memory pressure is ${MEM_60}% — RAM is the bottleneck" \
        "Tasks stall waiting for memory pages." \
        "Identify top consumers: 'ps aux --sort=-%mem | head'. Stop heavy non-essential services. Long-term: lower vm.swappiness, add more RAM."
fi

# Build recommendations based on observed symptoms
if [[ -n "$PKG_TEMP" ]] && (( PKG_TEMP >= 90 )); then
  print_rec "high" "Thermal throttling" \
    "Package at ${PKG_TEMP}°C — CPU is being pinned by something. Stop the process on the hottest core to recover boost clocks." \
    "ps -eo pid,pcpu,comm --sort=-pcpu | head -5; sudo kill -15 <PID>"

  if [[ -n "$HOT_CORE" ]]; then
    print_rec "high" "Investigate core $HOT_CORE" \
      "Core $HOT_CORE at ${HOT_PCT}% — likely culprit of thermal throttling" \
      "ps -eLo pid,pcpu,comm | sort -k2 -gr | head"
  fi
fi

# Only flag swap as a problem if PSI memory pressure confirms it
PSI_MEM_PCT=$(awk '$1=="some" { for (i=2;i<=NF;i++) if ($i ~ /^avg60=/) { split($i,a,"="); print a[2]+0; exit } }' /proc/pressure/memory 2>/dev/null)
PSI_MEM_PCT=${PSI_MEM_PCT%.*}; PSI_MEM_PCT=${PSI_MEM_PCT:-0}
if (( SWAP_USED > 256 )) && [[ "${PSI_MEM_PCT:-0}" -ge 5 ]]; then
  print_rec "high" "Swap + memory pressure" \
    "${SWAP_USED} MB swapped AND memory PSI ${PSI_MEM_PCT}% — RAM is overcommitted and pages are actively churning." \
    "Top RSS consumers: 'ps aux --sort=-rss | head -5'. Free RAM by stopping heavy services or 'sudo swapoff -a; sudo swapon -a' to evict parked pages."
elif (( SWAP_USED > 256 )); then
  info "  ${C_DIM}[skip]${C_RESET} ${SWAP_USED} MB parked in swap, but memory PSI is only ${PSI_MEM_PCT}% — pages are idle, not actively used"
fi

if (( LOAD1 > CPU_COUNT )); then
  print_rec "med" "High load" \
    "Load ${LOAD1} exceeds $CPU_COUNT cores. Check top CPU consumers and consider stopping non-essential work." \
    "ps aux --sort=-%cpu | head"
fi

if (( USED_PCT >= 85 )); then
  print_rec "med" "Memory pressure" \
    "${USED_PCT}% RAM used. Close unused applications or browser tabs." \
    "ps aux --sort=-%mem | head"
fi

if (( OOM_COUNT > 0 )); then
  print_rec "high" "OOM kills" \
    "$OOM_COUNT OOM event(s) in last 24h. Identify the leaked process and restart it with a memory limit." \
    "sudo journalctl -k --since '24 hours ago' | grep -i 'out of memory' -B 5 -A 5"
fi

while read -r fs size used avail pct target; do
  pct_num=$(echo "$pct" | tr -d '%')
  if (( pct_num >= 90 )); then
    print_rec "med" "Disk $target at ${pct}" \
      "Almost full — find what's eating space and clean up." \
      "sudo du -sh $target/* 2>/dev/null | sort -hr | head -10"
  fi
done < <(df -h --output=source,size,used,avail,pcent,target 2>/dev/null | awk 'NR>1 && $1 ~ /^\/dev/')

# Root process heuristic — already surfaced in SUSPICIOUS PROCESSES, but
# remind here with a generic command
ROOT_NOND=$(ps -eo user,comm --no-headers 2>/dev/null \
  | awk -v sysd="$SYSTEM_DAEMON_RE" '$1=="root" && !($2 ~ sysd) {print $2}' \
  | sort -u | head -5 | wc -l)
if (( ROOT_NOND > 0 )); then
  print_rec "med" "Non-daemon root processes" \
    "$ROOT_NOND non-system process(es) running as root. Verify they're legitimate." \
    "ps -eo user,pid,comm | awk '\$1==\"root\"' | grep -vE 'systemd|init|kthread'"
fi

if (( rec_count == 0 )); then
  ok "No specific actions recommended — system looks healthy"
fi

# Donut chart: recommendations by severity
if (( rec_count > 0 )); then
  subsec "Recommendations by severity"
  R_TOTAL=$rec_count
  R_PALETTE=("$C_RED" "$C_YELLOW" "$C_CYAN" "$C_GREEN")
  R_LABELS=("High (act now)" "Medium (consider)" "Low (informational)")
  R_COUNTS=("$rec_high" "$rec_med" "$rec_low")
  printf "${C_BOLD}Recommendations (%d total):${C_RESET}\n" "$R_TOTAL"
  for ri in 0 1 2; do
    cnt=${R_COUNTS[$ri]}
    (( cnt == 0 )) && continue
    pct=$(( cnt * 100 / R_TOTAL ))
    arc_len=$(( cnt * 20 / R_TOTAL ))
    (( arc_len == 0 )) && arc_len=1
    bar_s=""
    for (( j=0; j<arc_len; j++ )); do bar_s+="█"; done
    col="${R_PALETTE[$ri]}"
    printf "  ${col}%-25s${C_RESET} ${col}%-20s${C_RESET} ${C_BOLD}%3d${C_RESET} ${C_DIM}(%d%%)${C_RESET}\n" \
      "${R_LABELS[$ri]}" "$bar_s" "$cnt" "$pct"
  done
fi

