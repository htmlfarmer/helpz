#!/usr/bin/env bash

# shellcheck source=.helpz_log.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.helpz_log.sh"
# ============================================================================
# xyzothinthreadsz - Reduces app-fast-fetcher.service thread footprint
# ----------------------------------------------------------------------------
# Reduces app-fast-fetcher.service thread footprint from ~44 → ~22.
#
# What it does:
#   1. Backs up the service file
#   2. Adds three env vars to shrink thread pools:
#        APP_FETCH_CONCURRENT=4   (was 8 → drops 8 fetch worker threads → 4)
#        APP_GEOCODE_WORKERS=2    (was 4 → drops 4 geocode threads → 2)
#        APP_DB_POOL_MAX=4         (was 8 → drops ~5 psycopg threads)
#   3. Waits for the current cycle to finish (or times out after 6 min)
#   4. daemon-reload + restart
#   5. Reports the new thread count + CPU%
#
# Companion edits already applied (no sudo needed):
#   - worker/fetch.py   — httpx.Limits(max_connections=4, max_keepalive=2)
#   - worker/geocode.py — same httpx.Limits treatment (two sites)
#
# MUST be run with sudo:
#   sudo ./xyzothinthreadsz
# ============================================================================

set -euo pipefail

SERVICE=/etc/systemd/system/app-fast-fetcher.service
BACKUP="${SERVICE}.bak.$(date +%s)"
MAX_WAIT_S=360   # 6 min — generous upper bound for the cycle
POLL_INTERVAL_S=5
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

red()    { printf '\033[31m%s\033[0m\n' "$*"; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }
bold()   { printf '\033[1m%s\033[0m\n' "$*"; }
dim()    { printf '\033[2m%s\033[0m\n' "$*"; }

# ─── Flags ──────────────────────────────────────────────────────────────────
DRY_RUN=0
for arg in "$@"; do
    case "$arg" in
        --help|-h|help|\?)
            cat << 'EOF'

  ╔══════════════════════════════════════════════════════════════════╗
  ║  xyzothinthreadsz — shrink app-fast-fetcher thread pool      ║
  ╚══════════════════════════════════════════════════════════════════╝

Reduces app-fast-fetcher.service thread footprint from ~44 → ~22 by adding:
  APP_FETCH_CONCURRENT=4   (was 8)
  APP_GEOCODE_WORKERS=2    (was 4)
  APP_DB_POOL_MAX=4         (was 8)

USAGE
  sudo ./xyzothinthreadsz           Apply changes + restart
  sudo ./xyzothinthreadsz --dry-run Show what would change, no edits
  ./xyzothinthreadsz --help         Show this help

Idempotent — already-applied env vars are skipped. Backs up $SERVICE.bak.<ts>
before edit. Rollback: cp <backup> $SERVICE && systemctl daemon-reload.

EOF
            exit 0 ;;
        --dry-run)
            DRY_RUN=1 ;;
        --yes|-y)
            : ;; # accept for symmetry with other tools; no interactive prompt anyway
        --ai)
            AI_VERDICT=1 ;;
        --no-ai)
            AI_VERDICT=0 ;;
        *)
            echo "Unknown arg: $arg (try --help)" >&2; exit 2 ;;
    esac
done

if declare -f run_comparison_init >/dev/null 2>&1; then run_comparison_init "xyzothinthreadsz" "DRY_RUN=$DRY_RUN" 2>/dev/null; fi

# ---------- AI hook (opt-in via --ai) ----------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$SCRIPT_DIR/lib/run_comparison.sh" ]]; then source "$SCRIPT_DIR/lib/run_comparison.sh"; fi
if [[ "${AI_VERDICT:-}" == "1" ]]; then
    # shellcheck source=lib/ai.sh
    source "$SCRIPT_DIR/lib/ai.sh" 2>/dev/null || true
fi

if [[ $EUID -ne 0 ]]; then
  red "ERROR: must be run with sudo"
  echo "  sudo $0"
  exit 1
fi

bold "═══ xyzothinthreadsz @ $TIMESTAMP ═══"
if [[ $DRY_RUN -eq 1 ]]; then
    dim "(dry-run mode — no edits, no restart, no rollback needed)"
fi
echo

# ----- Step 1: backup --------------------------------------------------------
if [[ $DRY_RUN -eq 0 ]]; then
    cp -p "$SERVICE" "$BACKUP"
    green "✓ backed up to $BACKUP"
    # Cleanup: keep only the 5 most recent backups to avoid /etc/systemd/system bloat.
    mapfile -t OLD_BACKUPS < <(ls -1t "${SERVICE}".bak.* 2>/dev/null | tail -n +6 || true)
    if (( ${#OLD_BACKUPS[@]} > 0 )); then
        dim "  pruning ${#OLD_BACKUPS[@]} old backup(s) (keeping latest 5)"
        rm -f "${OLD_BACKUPS[@]}"
    fi
else
    dim "[would backup] $SERVICE → $BACKUP"
fi

# ----- Step 2: edit the service file ----------------------------------------
# Idempotent: check if APP_FETCH_CONCURRENT already exists before adding.
if grep -q "^Environment=APP_FETCH_CONCURRENT" "$SERVICE"; then
  yellow "! env vars already present in $SERVICE — skipping edit"
  dim "  (delete them manually and re-run if you want to re-apply)"
else
  if [[ $DRY_RUN -eq 0 ]]; then
    # Insert env-var lines before the StandardOutput line so they sit with
    # the other Environment= entries (more readable diff).
    python3 - "$SERVICE" <<'PYEOF'
import sys, re
path = sys.argv[1]
with open(path) as f:
    src = f.read()

new_env = (
    "# Thread-shrinking: this box is shared with interactive work.\n"
    "# Halved 2026-09-10 — was 8+4+8=20 worker threads + 24 library threads = 44.\n"
    "Environment=APP_FETCH_CONCURRENT=4\n"
    "Environment=APP_GEOCODE_WORKERS=2\n"
    "Environment=APP_DB_POOL_MAX=4\n"
)

# Insert before the first StandardOutput= line (keeps the [Service] block tidy).
out, n = re.subn(
    r"(?m)^(StandardOutput=)",
    new_env + r"\1",
    src,
    count=1,
)
if n != 1:
    sys.stderr.write(f"could not find StandardOutput= anchor in {path}\n")
    sys.exit(2)

with open(path, "w") as f:
    f.write(out)
PYEOF
    green "✓ added 3 env vars to $SERVICE"
  else
    dim "[would edit] $SERVICE — add 3 env vars (APP_FETCH_CONCURRENT=4, APP_GEOCODE_WORKERS=2, APP_DB_POOL_MAX=4)"
  fi
fi

echo
dim "── current [Service] block ──"
sed -n '/^\[Service\]/,/^\[/p' "$SERVICE" | sed '$d'
echo

# ----- Step 3: wait for the current cycle to finish --------------------------
RUNNING_PID=$(pgrep -f "python3 -m worker.run --fast" | head -1 || true)

if [[ -z "$RUNNING_PID" ]]; then
  green "✓ no fast-fetcher cycle currently running — proceeding immediately"
else
  yellow "• waiting for current cycle (PID $RUNNING_PID) to finish…"
  dim "  max wait: ${MAX_WAIT_S}s. Ctrl-C to abort."
  waited=0
  while (( waited < MAX_WAIT_S )) && kill -0 "$RUNNING_PID" 2>/dev/null; do
    sleep "$POLL_INTERVAL_S"
    waited=$((waited + POLL_INTERVAL_S))
    cpu=$(ps -p "$RUNNING_PID" -o pcpu= 2>/dev/null | tr -d ' ' || echo "?")
    threads=$(awk '/^Threads:/ {print $2}' "/proc/$RUNNING_PID/status" 2>/dev/null || echo "?")
    printf "    %3ds elapsed — cpu=%s%%  threads=%s\n" "$waited" "$cpu" "$threads"
  done

  if kill -0 "$RUNNING_PID" 2>/dev/null; then
    red "✗ cycle still running after ${MAX_WAIT_S}s — aborting (safe: no changes yet to live process)"
    dim "  the service file is already updated; the new thread counts will take effect"
    dim "  on the next natural restart. To force-restart now, run:"
    dim "    sudo systemctl restart app-fast-fetcher.service"
    exit 3
  else
    green "✓ cycle finished after ${waited}s"
  fi
fi

echo

# ----- Step 4: daemon-reload + restart --------------------------------------
if [[ $DRY_RUN -eq 0 ]]; then
    systemctl daemon-reload
    green "✓ daemon-reload"

    # Use restart (not start+stop) so the timer doesn't get confused.
    systemctl restart app-fast-fetcher.service
    green "✓ restarted app-fast-fetcher.service"
else
    dim "[would] systemctl daemon-reload"
    dim "[would] systemctl restart app-fast-fetcher.service"
fi

# Give it a few seconds to spin up the new worker pool.
sleep 3

# ----- Step 5: verify --------------------------------------------------------
if [[ $DRY_RUN -eq 1 ]]; then
  bold "═══ RESULT ═══"
  dim "  (dry-run — no restart performed, skipping verification)"
  dim "  would have checked: systemctl MainPID, /proc/<pid>/status Threads:"
  exit 0
fi

NEW_PID=$(systemctl show app-fast-fetcher.service --property=MainPID --value 2>/dev/null || echo "")
if [[ -z "$NEW_PID" || "$NEW_PID" == "0" ]]; then
  red "✗ could not read MainPID — service may not have started"
  systemctl status app-fast-fetcher.service --no-pager -l 2>/dev/null | head -20
  exit 4
fi

echo
bold "═══ RESULT ═══"
threads=$(awk '/^Threads:/ {print $2}' "/proc/$NEW_PID/status" 2>/dev/null || echo "?")
cpu=$(ps -p "$NEW_PID" -o pcpu= 2>/dev/null | tr -d ' ' || echo "?")
rss_mb=$(awk '/^VmRSS:/ {printf "%.0f", $2/1024}' "/proc/$NEW_PID/status" 2>/dev/null || echo "?")
etime=$(ps -p "$NEW_PID" -o etime= 2>/dev/null | tr -d ' ' || echo "?")

printf "  %-12s %s\n" "PID"     "$NEW_PID"
printf "  %-12s %s\n" "uptime"  "$etime"
printf "  %-12s %s\n" "CPU%"    "$cpu"
printf "  %-12s %s\n" "RSS(MB)" "$rss_mb"
printf "  %-12s " "threads"
if [[ "$threads" =~ ^[0-9]+$ ]] && (( threads <= 22 )); then
  green "$threads  ✓ at or below target"
elif [[ "$threads" =~ ^[0-9]+$ ]] && (( threads <= 30 )); then
  yellow "$threads  ⚠ above target of 22 — likely CUDA thread from torch import chain"
  dim "  investigate: lsof -p $NEW_PID | grep -i cuda"
else
  red "$threads  ✗ still high — env vars may not be set in the new process"
  dim "  verify: systemctl show app-fast-fetcher.service -p Environment"
fi

echo
bold "═══ NEXT STEPS ═══"
dim "  1. Wait one full cycle (~5 min) for the worker to do real work."
dim "  2. Re-check threads:"
dim "       ps -L -p $NEW_PID -o tid,pcpu,comm | wc -l"
dim "  3. If threads spiked back to 44, the env vars didn't apply:"
dim "       systemctl show app-fast-fetcher.service -p Environment | grep APP"
dim "  4. If you want to revert:"
dim "       sudo cp $BACKUP $SERVICE && sudo systemctl daemon-reload && sudo systemctl restart app-fast-fetcher.service"

# ---------- Run Comparison Finalize ----------
if declare -f run_comparison_finalize >/dev/null 2>&1; then run_comparison_finalize 2>/dev/null; fi

# ---------- AI verdict (opt-in via --ai) ----------
if [[ "${AI_VERDICT:-}" == "1" ]]; then
    ai_emit_verdict "summary" "xyzothinthreadsz complete: dry_run=$DRY_RUN service=$SERVICE backup=$BACKUP" 2>/dev/null || true
fi
