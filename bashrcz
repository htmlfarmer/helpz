#!/usr/bin/env bash

# shellcheck source=.helpz_log.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.helpz_log.sh"
# ============================================================================
# bashrcz - Put the *z suite on your PATH so any tool runs from any directory
# ----------------------------------------------------------------------------
# The suite lives in one folder of single-file Bash tools. Without that folder
# on PATH you have to type "./cpuz"; this tool makes "cpuz" work from anywhere
# by installing a small, marked, idempotent block into ~/.bashrc.
#
# It also installs a command_not_found_handle hook: if you type a suite tool
# that isn't on PATH, bash tells you exactly where it lives and how to fix the
# PATH once and for all — instead of a useless "did you mean cpu?" hint.
#
# Usage:
#   ./bashrcz                Install (or refresh) the PATH block, then verify
#   ./bashrcz --status       Show what is installed and what is live right now
#   ./bashrcz --verify       Test resolution in a fresh login shell
#   ./bashrcz --uninstall    Remove the blocks (backup kept)
#   ./bashrcz --dir DIR      Also add DIR to PATH (repeatable)
#   ./bashrcz --no-hook      Skip the command_not_found_handle hook
#
# Notes:
#   * ~/.bashrc is backed up to ~/.bashrc.bashrcz.bak before any edit.
#   * Re-running is safe — the marked block is replaced, never duplicated.
#   * A non-interactive shell never reads ~/.bashrc; use ~/.profile too, or
#     run "bashrcz --profile" to add the same block there.
# ============================================================================

set -o pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"

RC_FILE="${BASHRC_FILE:-$HOME/.bashrc}"
PROFILE_FILE="${PROFILE_FILE:-$HOME/.profile}"
MARK_BEGIN="# >>> helpz suite (bashrcz) >>>"
MARK_END="# <<< helpz suite (bashrcz) <<<"
HOOK_BEGIN="# >>> helpz command-not-found hook (bashrcz) >>>"
HOOK_END="# <<< helpz command-not-found hook (bashrcz) <<<"
BACKUP="$HOME/.bashrc.bashrcz.bak"

ACTION="install"; VERIFY_ONLY=0; NO_HOOK=0; ADD_PROFILE=0
declare -a EXTRA_DIRS=()
JSON_OUT="${JSON_OUT:-0}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --status)    ACTION="status" ;;
        --install)   ACTION="install" ;;
        --uninstall) ACTION="uninstall" ;;
        --verify)    ACTION="verify" ;;
        --no-hook)   NO_HOOK=1 ;;
        --profile)   ADD_PROFILE=1 ;;
        --dir)       shift; EXTRA_DIRS+=("${1:-}") ;;
        --dir=*)     EXTRA_DIRS+=("${1#--dir=}") ;;
        --json)      JSON_OUT=1 ;;
        --no-color)  NO_COLOR=1; init_colors ;;
        -h|--help)   sed -n '6,26p' "$0"; exit 0 ;;
        *) echo "bashrcz: unknown option $1" >&2; exit 64 ;;
    esac
    shift
done

# ── helpers ────────────────────────────────────────────────────────────────
have_block() {   # file  marker-begin  marker-end
    local f="$1" b="$2" e="$3"
    [[ -r "$f" ]] || return 1
    grep -qF -- "$b" "$f" && grep -qF -- "$e" "$f"
}

strip_block() {  # file  marker-begin  marker-end
    local f="$1" b="$2" e="$3" tmp
    [[ -r "$f" ]] || return 0
    tmp=$(mktemp) || return 1
    awk -v b="$b" -v e="$e" '
        index($0,b) { skip=1 }
        !skip      { print }
        index($0,e) { skip=0 }
    ' "$f" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
    cat "$tmp" > "$f"; rm -f "$tmp"
}

# The suite dir this copy of bashrcz lives in, plus any --dir extras.
SUITE_DIRS=("$SCRIPT_DIR")
for d in "${EXTRA_DIRS[@]:-}"; do
    [[ -n "$d" ]] && SUITE_DIRS+=("$(cd "$d" 2>/dev/null && pwd || echo "$d")")
done

# ── status ─────────────────────────────────────────────────────────────────
live_path_dirs() { bash -lc 'printf "%s" "$PATH"' 2>/dev/null; }

show_status() {
    section "PATH STATUS"
    local live; live=$(live_path_dirs)
    local d
    for d in "${SUITE_DIRS[@]}"; do
        if [[ ":$live:" == *":$d:"* ]]; then
            ok "live PATH contains $d"
        else
            critf "PATH" "$d is NOT on the live PATH" "run: ./bashrcz   (then open a new shell, or: source ~/.bashrc)"
        fi
    done
    if have_block "$RC_FILE" "$MARK_BEGIN" "$MARK_END"; then
        ok "PATH block present in $RC_FILE"
    else
        warnf "PATH" "PATH block missing from $RC_FILE" "run: ./bashrcz --install"
    fi
    if have_block "$RC_FILE" "$HOOK_BEGIN" "$HOOK_END"; then
        ok "command_not_found_handle hook present in $RC_FILE"
    else
        info "command_not_found_handle hook not installed (optional)"
    fi
    if [[ -w "$RC_FILE" ]]; then ok "$RC_FILE is writable"
    else critf "PATH" "$RC_FILE is not writable" "fix with: chmod u+w '$RC_FILE'"; fi

    section "RESOLUTION TEST (fresh login shell)"
    local probe="" p
    for p in "${SUITE_DIRS[@]}"; do
        [[ -x "$p/helpz" ]] && { probe="$p/helpz"; break; }
    done
    if [[ -n "$probe" ]]; then
        local base; base=$(basename "$probe")
        if bash -lc "command -v '$base' >/dev/null 2>&1"; then
            ok "'$base' resolves in a fresh login shell"
        else
            critf "PATH" "'$base' does NOT resolve in a fresh login shell" "open a new terminal, or: source $RC_FILE"
        fi
    fi
    emit_verdict
}

verify_only() {
    section "VERIFY"
    local live; live=$(live_path_dirs)
    local bad=0 d
    for d in "${SUITE_DIRS[@]}"; do
        [[ ":$live:" == *":$d:"* ]] || { warnf "PATH" "$d missing from live PATH" "source $RC_FILE or open a new shell"; bad=1; }
    done
    local probe="" p
    for p in "${SUITE_DIRS[@]}"; do [[ -x "$p/helpz" ]] && { probe="$p/helpz"; break; }; done
    if [[ -n "$probe" ]]; then
        local base; base=$(basename "$probe")
        bash -lc "command -v '$base' >/dev/null 2>&1" \
            && ok "'$base' resolves" \
            || { critf "PATH" "'$base' does not resolve" "source $RC_FILE"; bad=1; }
    fi
    (( bad )) && exit 1
    ok "all good — the suite is callable from anywhere"
    exit 0
}

# ── install ────────────────────────────────────────────────────────────────
install_block() {
    local f="$1" d
    [[ -f "$f" ]] || { info "skipping $f (does not exist)"; return 0; }
    [[ -w "$f" ]] || { critf "PATH" "$f is not writable" "fix with: chmod u+w '$f'"; return 1; }

    # Backup once, before the first edit of this session.
    [[ -f "$BACKUP" ]] || cp -p "$f" "$BACKUP" 2>/dev/null

    strip_block "$f" "$MARK_BEGIN" "$MARK_END"

    {
        printf '%s\n' "$MARK_BEGIN"
        printf '%s\n' "# Managed by bashrcz — edit the block between the markers, or"
        printf '%s\n' "# run 'bashrcz --uninstall' to remove it entirely."
        for d in "${SUITE_DIRS[@]}"; do
            printf 'case ":$PATH:" in\n'
            printf '    *:%s:*) ;;\n' "$d"
            printf '    *) export PATH="%s:$PATH" ;;\n' "$d"
            printf 'esac\n'
        done
        printf '%s\n' "$MARK_END"
    } >> "$f"
    ok "PATH block written to $f"
}

install_hook() {
    local f="$1"
    [[ -f "$f" ]] || return 0
    [[ -w "$f" ]] || return 0

    # Never clobber someone else's handler.
    if grep -qE '^[[:space:]]*command_not_found_handle[[:space:]]*\(\)' "$f" \
       && ! have_block "$f" "$HOOK_BEGIN" "$HOOK_END"; then
        warnf "Hook" "a command_not_found_handle already exists in $f — leaving it alone" \
               "add the helpz hint manually if you want it"
        return 0
    fi

    strip_block "$f" "$HOOK_BEGIN" "$HOOK_END"
    {
        printf '%s\n' "$HOOK_BEGIN"
        printf '%s\n' "# Typed a *z tool that isn't on PATH? Point at the real thing."
        printf '%s\n' "command_not_found_handle() {"
        printf '%s\n' "    local _cmd=\"\${1:-}\" _dir='' _c"
        printf '%s\n' "    for _c in \"\${HELPZ_SUITE_DIR:-}\" \"\$HOME/helpz\" \"\$HOME/security\"; do"
        printf '%s\n' "        [ -n \"\$_c\" ] && [ -x \"\$_c/\$_cmd\" ] && { _dir=\"\$_c\"; break; }"
        printf '%s\n' "    done"
        printf '%s\n' "    if [ -n \"\$_dir\" ]; then"
        printf '%s\n' "        printf '%s\n' \"\$_cmd: not on PATH — it lives in \$_dir\" >&2"
        printf '%s\n' "        printf '  run it now:   %s/%s\n' \"\$_dir\" \"\$_cmd\" >&2"
        printf '%s\n' "        printf '  fix for good: bashrcz --install\\n' >&2"
        printf '%s\n' "    fi"
        printf '%s\n' "    return 127"
        printf '%s\n' "}"
        printf '%s\n' "$HOOK_END"
    } >> "$f"
    ok "command_not_found_handle hook written to $f"
}

do_install() {
    section "INSTALL"
    info "suite dir(s): ${SUITE_DIRS[*]}"
    install_block "$RC_FILE" || exit 1
    (( NO_HOOK )) || install_hook "$RC_FILE"
    (( ADD_PROFILE )) && { install_block "$PROFILE_FILE"; install_hook "$PROFILE_FILE"; }
    info "backup of the previous file: $BACKUP"

    section "VERIFY"
    # Source the file in a subshell to prove the block is syntactically sound.
    if bash -n "$RC_FILE" 2>/dev/null; then
        ok "$RC_FILE parses cleanly"
    else
        critf "PATH" "$RC_FILE has a syntax error — restore from $BACKUP" "cp '$BACKUP' '$RC_FILE'"
        exit 1
    fi
    info "open a new shell (or run: source $RC_FILE) to pick the change up"
    show_status
}

do_uninstall() {
    section "UNINSTALL"
    local removed=0
    if have_block "$RC_FILE" "$MARK_BEGIN" "$MARK_END"; then
        strip_block "$RC_FILE" "$MARK_BEGIN" "$MARK_END"; ok "PATH block removed from $RC_FILE"; removed=1
    fi
    if have_block "$RC_FILE" "$HOOK_BEGIN" "$HOOK_END"; then
        strip_block "$RC_FILE" "$HOOK_BEGIN" "$HOOK_END"; ok "hook removed from $RC_FILE"; removed=1
    fi
    (( removed )) || info "no bashrcz blocks found in $RC_FILE"
    [[ -f "$BACKUP" ]] && info "previous version kept at $BACKUP"
    info "open a new shell to drop the old PATH entry"
    exit 0
}

case "$ACTION" in
    status)    show_status ;;
    verify)    verify_only ;;
    uninstall) do_uninstall ;;
    install)   do_install ;;
esac
