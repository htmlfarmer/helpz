#  SINGLE SCRIPT BENCHMARK
# ═══════════════════════════════════════════════════════════════════════════════
run_single_benchmark() {
    echo ""
    echo -e "  ${C_BOLD}Available scripts:${C_RESET}"
    echo ""
    local idx=0
    local -a available=()
    for s in securityz slowz logz cpuz memoryz diskz networkz specz portz sshauditz hardenz benchmarkz bootz gpuz powerz usbz pciz sqlz aiz abusez info.py analyzer.py my_monitor.py tracemap.py render_reports.py; do
        if [[ -f "$SCRIPT_DIR/$s" ]]; then
            ((idx += 1))
            available+=("$s")
            echo -e "    ${C_BOLD}$idx${C_RESET}) $s"
        fi
    done
    echo ""
    read -rp "  Script number: " sel
    if [[ "$sel" -ge 1 && "$sel" -le ${#available[@]} ]] 2>/dev/null; then
        local chosen="${available[$((sel - 1))]}"
        echo ""
        echo -e "  ${C_BOLD}Benchmarking $chosen (3 runs, showing average)...${C_RESET}"
        echo ""

        local total=0
        for run in 1 2 3; do
            local start end elapsed
            start=$(date +%s%N)
            if [[ "$chosen" == *.py ]]; then
                timeout 60 python3 "$SCRIPT_DIR/$chosen" &>/dev/null || true
            else
                echo "" | timeout 120 bash "$SCRIPT_DIR/$chosen" &>/dev/null || true
            fi
            end=$(date +%s%N)
            elapsed=$(( (end - start) / 1000000 ))
            total=$((total + elapsed))

            local time_str
            if [[ $elapsed -ge 1000 ]]; then
                time_str="$(echo "scale=1; $elapsed / 1000" | bc 2>/dev/null || echo "$((elapsed / 1000))")s"
            else
                time_str="${elapsed}ms"
            fi
            echo -e "    Run $run: ${C_BOLD}$time_str${C_RESET}"
        done

        local avg=$((total / 3))
        local avg_str
        if [[ $avg -ge 1000 ]]; then
            avg_str="$(echo "scale=1; $avg / 1000" | bc 2>/dev/null || echo "$((avg / 1000))")s"
        else
            avg_str="${avg}ms"
        fi
        echo ""
        echo -e "    ${C_BOLD}Average: $avg_str${C_RESET}"
    else
        echo -e "  ${C_RED}Invalid selection${C_RESET}"
    fi
}

