source "$SCRIPT_DIR/lib/common.sh" 2>/dev/null || true
if [[ -f "$SCRIPT_DIR/lib/run_comparison.sh" ]]; then source "$SCRIPT_DIR/lib/run_comparison.sh"; fi

has_cmd() { command -v "$1" &>/dev/null; }

# ─── Help ────────────────────────────────────────────────────────────────────
show_help() {
    cat << 'HELPEOF'

  ╔══════════════════════════════════════════════════════════════════╗
  ║          timingz — Script Benchmark & Usage Guide             ║
  ╚══════════════════════════════════════════════════════════════════╝

DESCRIPTION
  Benchmarks each security script (measures wall-clock execution time)
  and/or shows a detailed usage guide for every script in the suite.
  Helps you understand which scripts are fast vs slow and what each does.

USAGE
  ./timingz    Interactive — choose benchmark, usage guide, or both

OPTIONS
  -h, --help    Show this help message and exit

MODES
  1) Benchmark all scripts — measure execution times
  2) Show detailed usage guide for every script
  3) Both — benchmark + usage guide
  4) Benchmark a single script

ALTERNATIVE COMMANDS
  time ./securityz                       Time a single script
  perf stat ./cpuz                       Detailed perf counters for a script
  strace -c ./diskz                      Syscall-level profiling
  watch -n 5 ./slowz                     Re-run a script on a schedule

TIMING GUIDE
  < 3s     fast — run anytime
  3-10s    moderate — comfortable for regular use
  10-30s   slow — run when you have a moment
  > 30s    very slow — run during maintenance windows

HELPEOF
    exit 0
}

# Check for flags
MODE_ARG=""
AI_VERDICT=0
case "${1:-}" in
    -h|--help) show_help ;;
    1|--bench|--benchmark) MODE_ARG="1" ;;
    2|--guide|--usage) MODE_ARG="2" ;;
    3|--both) MODE_ARG="3" ;;
    4|--single) MODE_ARG="4" ;;
    --ai)       AI_VERDICT=1 ;;
    --no-ai)    AI_VERDICT=0 ;;
    --no-color) NO_COLOR=1; init_colors ;;
esac

if [[ "${JSON_OUT:-0}" != "1" ]] && declare -f run_comparison_init >/dev/null 2>&1; then run_comparison_init "timingz"; fi

# ---------- AI hook (opt-in via --ai) ----------
if [[ "${AI_VERDICT:-}" == "1" ]]; then
    # shellcheck source=lib/aiz
    source "$SCRIPT_DIR/lib/aiz" 2>/dev/null || true
fi

section() {
    echo ""
    echo -e "${C_BLUE}${C_BOLD}══════════════════════════════════════════════════════════════════${C_RESET}"
    echo -e "${C_BLUE}${C_BOLD}  $1${C_RESET}"
    echo -e "${C_BLUE}${C_BOLD}══════════════════════════════════════════════════════════════════${C_RESET}"
}

subsection() {
    echo ""
    echo -e "${C_CYAN}${C_BOLD}── $1 ${C_RESET}"
}

# ═══════════════════════════════════════════════════════════════════════════════
#  BANNER
# ═══════════════════════════════════════════════════════════════════════════════
echo ""
printf "${C_BOLD}${C_MAGENTA}"
cat << 'BANNER'
   ╔═══════════════════════════════════════════════════════════════╗
   ║  TIMING.SH — Script Benchmark & Usage Guide                  ║
   ║  Wall-Clock · Per-Script Speed · Guide                       ║
   ╚═══════════════════════════════════════════════════════════════╝
BANNER
printf "${C_RESET}"
printf "${C_DIM}  v%s — %s on %s${C_RESET}\n\n" \
    "$SCRIPT_VERSION" "$(date '+%Y-%m-%d %H:%M:%S %Z')" \
    "$(hostname -s 2>/dev/null || echo host)"

# ═══════════════════════════════════════════════════════════════════════════════
#  MODE SELECTION
# ═══════════════════════════════════════════════════════════════════════════════
echo ""
echo -e "  ${C_BOLD}What would you like to do?${C_RESET}"
echo ""
echo -e "    ${C_GREEN}1${C_RESET}) Benchmark all scripts (measure execution times)"
echo -e "    ${C_BLUE}2${C_RESET}) Show detailed usage guide for every script"
echo -e "    ${C_MAGENTA}3${C_RESET}) Both — benchmark + usage guide"
echo -e "    ${C_YELLOW}4${C_RESET}) Benchmark a single script"
echo ""

if [[ -n "$MODE_ARG" ]]; then
    mode="$MODE_ARG"
    echo -e "  ${C_BOLD}Auto-selected from flag:${C_RESET} $mode"
elif [[ ! -t 0 ]]; then
    mode="2"
    echo -e "  ${C_DIM}Non-interactive / piped: defaulting to mode 2 (Usage Guide).${C_RESET}"
else
