# ═══════════════════════════════════════════════════════════════════════════════
#  BENCHMARK FUNCTION
# ═══════════════════════════════════════════════════════════════════════════════
declare -a RESULTS_NAME
declare -a RESULTS_TIME
declare -a RESULTS_STATUS

benchmark_script() {
    local script="$1"
    local path="$SCRIPT_DIR/$script"

    if [[ ! -f "$path" ]]; then
        return 1
    fi

    # Skip interactive/live scripts
    if [[ "$script" == "checkz" ]]; then
        return 2
    fi

    echo -ne "  ${C_BOLD}$script${C_RESET} ... "

    local start end elapsed status
    start=$(date +%s%N)

    if [[ "$script" == *.py ]]; then
        # Python scripts — run with a timeout, skip ones that need interaction
        if [[ "$script" == "web_server.py" || "$script" == "live_leak_detector.py" ]]; then
            echo -e "${C_DIM}skipped (interactive/long-running)${C_RESET}"
            return 2
        fi
        timeout 30 python3 "$path" &>/dev/null && status="ok" || status="done"
    else
        # Shell scripts — pipe empty input to skip interactive prompts
        echo "" | timeout 120 bash "$path" &>/dev/null && status="ok" || status="done"
    fi

    end=$(date +%s%N)
    elapsed=$(( (end - start) / 1000000 ))  # milliseconds

    local color
    if [[ $elapsed -lt 5000 ]]; then
        color="$C_GREEN"
    elif [[ $elapsed -lt 15000 ]]; then
        color="$C_YELLOW"
    elif [[ $elapsed -lt 30000 ]]; then
        color="$C_BLUE"
    else
        color="$C_RED"
    fi

    local time_str
    if [[ $elapsed -ge 1000 ]]; then
        time_str="$(echo "scale=1; $elapsed / 1000" | bc 2>/dev/null || echo "$((elapsed / 1000))")s"
    else
        time_str="${elapsed}ms"
    fi

    echo -e "${color}${C_BOLD}$time_str${C_RESET}"

    RESULTS_NAME+=("$script")
    RESULTS_TIME+=("$elapsed")
    RESULTS_STATUS+=("$status")
}

# ═══════════════════════════════════════════════════════════════════════════════
#  BENCHMARK MODE
# ═══════════════════════════════════════════════════════════════════════════════
run_benchmark() {
    echo ""
    echo -e "${C_BLUE}${C_BOLD}══════════════════════════════════════════════════════════════════${C_RESET}"
    echo -e "${C_BLUE}${C_BOLD}  BENCHMARKING ALL SCRIPTS${C_RESET}"
    echo -e "${C_BLUE}${C_BOLD}══════════════════════════════════════════════════════════════════${C_RESET}"
    echo ""
    echo -e "  ${C_DIM}Running each script and measuring wall-clock time...${C_RESET}"
    echo -e "  ${C_DIM}This may take a few minutes.${C_RESET}"
    echo ""

    RESULTS_NAME=()
    RESULTS_TIME=()
    RESULTS_STATUS=()

    local total_start total_end
    total_start=$(date +%s)

    # Shell scripts
    echo -e "  ${C_CYAN}${C_BOLD}── Shell Scripts ──${C_RESET}"
    echo ""
    for s in securityz slowz logz cpuz memoryz diskz networkz specz portz sshauditz hardenz benchmarkz bootz gpuz powerz usbz pciz sqlz aiz abusez; do
        if [[ -f "$SCRIPT_DIR/$s" ]]; then
            benchmark_script "$s" || true
        fi
    done

    echo ""
    echo -e "  ${C_CYAN}${C_BOLD}── Python Scripts ──${C_RESET}"
    echo ""
    for s in info.py analyzer.py live_leak_detector.py my_monitor.py tracemap.py web_server.py render_reports.py; do
        if [[ -f "$SCRIPT_DIR/$s" ]]; then
            benchmark_script "$s" || true
        fi
    done

    total_end=$(date +%s)
    local total_elapsed=$(( total_end - total_start ))

    # ─── Results Table ───────────────────────────────────────────────────
    echo ""
    echo -e "${C_BLUE}${C_BOLD}══════════════════════════════════════════════════════════════════${C_RESET}"
    echo -e "${C_BLUE}${C_BOLD}  TIMING RESULTS${C_RESET}"
    echo -e "${C_BLUE}${C_BOLD}══════════════════════════════════════════════════════════════════${C_RESET}"
    echo ""

    # Sort by time (bubble sort for bash)
    local n=${#RESULTS_NAME[@]}
    for ((i = 0; i < n; i++)); do
        for ((j = 0; j < n - i - 1; j++)); do
            if [[ ${RESULTS_TIME[$j]} -gt ${RESULTS_TIME[$((j+1))]} ]]; then
                # Swap
                tmp="${RESULTS_TIME[$j]}"; RESULTS_TIME[$j]="${RESULTS_TIME[$((j+1))]}"; RESULTS_TIME[$((j+1))]="$tmp"
                tmp="${RESULTS_NAME[$j]}"; RESULTS_NAME[$j]="${RESULTS_NAME[$((j+1))]}"; RESULTS_NAME[$((j+1))]="$tmp"
                tmp="${RESULTS_STATUS[$j]}"; RESULTS_STATUS[$j]="${RESULTS_STATUS[$((j+1))]}"; RESULTS_STATUS[$((j+1))]="$tmp"
            fi
        done
    done

    printf "  ${C_BOLD}%-35s %12s %10s${C_RESET}\n" "SCRIPT" "TIME" "RATING"
    echo -e "  ───────────────────────────────── ──────────── ──────────"

    local fastest=${RESULTS_TIME[0]:-0}
    local slowest=${RESULTS_TIME[$((n-1))]:-0}

    for ((i = 0; i < n; i++)); do
        local ms=${RESULTS_TIME[$i]}
        local name=${RESULTS_NAME[$i]}

        local time_str
        if [[ $ms -ge 1000 ]]; then
            time_str="$(echo "scale=1; $ms / 1000" | bc 2>/dev/null || echo "$((ms / 1000))")s"
        else
            time_str="${ms}ms"
        fi

        local rating rating_color
        if [[ $ms -lt 3000 ]]; then
            rating="fast"; rating_color="$C_GREEN"
        elif [[ $ms -lt 10000 ]]; then
            rating="moderate"; rating_color="$C_YELLOW"
        elif [[ $ms -lt 30000 ]]; then
            rating="slow"; rating_color="$C_BLUE"
        else
            rating="very slow"; rating_color="$C_RED"
        fi

        printf "  %-35s " "$name"
        echo -ne "${rating_color}${C_BOLD}${time_str}${C_RESET}"
        # Pad
        local pad=$((12 - ${#time_str}))
        for ((p = 0; p < pad; p++)); do echo -n " "; done
        echo -e " ${rating_color}${rating}${C_RESET}"
    done

    echo ""
    echo -e "  ${C_DIM}Fastest: ${RESULTS_NAME[0]} (${fastest}ms)${C_RESET}"
    echo -e "  ${C_DIM}Slowest: ${RESULTS_NAME[$((n-1))]} (${slowest}ms)${C_RESET}"
    echo -e "  ${C_DIM}Total wall time: ${total_elapsed}s${C_RESET}"
    echo ""

    # ─── Bar Chart: visualize script execution times ─────────────────────
    echo -e "${C_BOLD}${C_CYAN}━━━ Execution-Time Bar Chart ━━━${C_RESET}"
    local _tc_max=${slowest:-0}
    (( _tc_max == 0 )) && _tc_max=1
    local _tc_total=0
    for _ms in "${RESULTS_TIME[@]}"; do _tc_total=$((_tc_total + _ms)); done
    echo -e "  ${C_DIM}bar length scaled to slowest (${slowest}ms) — total measured ${_tc_total}ms${C_RESET}"
    local _i=0
    while (( _i < n )); do
        local ms=${RESULTS_TIME[$_i]}
        local name=${RESULTS_NAME[$_i]}
        local pct=$(( ms * 100 / _tc_max ))
        (( pct < 2 )) && pct=2
        local color="$C_GREEN"
        (( pct >= 30 )) && color="$C_YELLOW"
        (( pct >= 60 )) && color="$C_BLUE"
        (( pct >= 90 )) && color="$C_RED"
        local filled=$(( pct * 40 / 100 ))
        local bar=""
        for (( j=0; j<filled; j++ )); do bar+="█"; done
        printf "  %-32s ${color}%-40s${C_RESET} %dms\n" "$name" "$bar" "$ms"
        _i=$((_i + 1))
    done
    echo ""

    # ─── Timing Legend ──────────────────────────────────────────────────
    echo -e "  ${C_BOLD}Timing guide:${C_RESET}"
    echo -e "    ${C_GREEN}< 3s${C_RESET}     fast — run anytime"
    echo -e "    ${C_YELLOW}3-10s${C_RESET}    moderate — comfortable for regular use"
    echo -e "    ${C_BLUE}10-30s${C_RESET}   slow — run when you have a moment"
    echo -e "    ${C_RED}> 30s${C_RESET}    very slow — run during maintenance windows"
    echo ""
}

