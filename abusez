    ip = ""
    method = ""
    path = ""
    
    # Try to extract IP - look for first field that looks like an IP
    for (i = 1; i <= NF && i <= 5; i++) {
        if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
            ip = $i
            break
        }
    }
    
    # Try to extract method and path from quoted section
    for (i = 1; i <= NF; i++) {
        if ($i ~ /^[A-Z]+$/ && i+1 <= NF) {
            method = $i
            path = $(i+1)
            break
        }
    }
    
    if (ip == "" || ip == "--" || ip == "-") next
    
    count[ip]++
    
    # Detect attack types
    if (path ~ /\/admin|\.env|wp-admin|phpmyadmin|\/config|backup|\.sql|\.git|\/\.htaccess|wp-login|xmlrpc|wp-config/) {
        sensitive_hits[ip]++
        sensitive_paths[ip] = sensitive_paths[ip] " " path
    }
    if (path ~ /\047.*(OR|UNION|SELECT|INSERT|DROP|DELETE|UPDATE)/i) {
        sqli_hits[ip]++
    }
    if (path ~ /<script|javascript:|onerror=|onload=/i) {
        xss_hits[ip]++
    }
    if (path ~ /\.\.\/|\.\.%2F|%2e%2e/) {
        traversal_hits[ip]++
    }
    if (toupper($0) ~ /NIKTO|SQLMAP|DIRBUSTER|GOBUSTER|METASPLOIT|BURP|NMAP/) {
        scanner_hits[ip]++
    }
    if ($NF ~ /404|403/) {
        error_hits[ip]++
        error_paths[ip] = error_paths[ip] " " path
    }
    
    # Track user agents
    if (match($0, /"([^"]*)"$/, ua_arr)) {
        ua = ua_arr[1]
        ua_count[ip, ua]++
    }
}
END {
    PROCINFO["sorted_in"] = "@val_num_desc"
    n = 0
    for (ip in count) {
        n++
        total = count[ip]
        sen = sensitive_hits[ip] + 0
        sqli = sqli_hits[ip] + 0
        xss = xss_hits[ip] + 0
        trav = traversal_hits[ip] + 0
        scan = scanner_hits[ip] + 0
        err = error_hits[ip] + 0
        
        print "\n[HTTP] Attacker: " ip " | Total Requests: " total
