#!/bin/bash

# shellcheck source=.helpz_log.sh
. "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/.helpz_log.sh"
if [[ -f "$SCRIPT_DIR/lib/run_comparison.sh" ]]; then source "$SCRIPT_DIR/lib/run_comparison.sh"; fi
# abusez - SSH forensic / abuse-pattern report
# ==========================================
# SSH Forensic Report: Global Calibration Edition
# Fixed: Global Timeframe Math & Campaign Density
# ==========================================

# ─── Help ────────────────────────────────────────────────────────────────────
show_help() {
    cat << 'HELPEOF'

  ╔══════════════════════════════════════════════════════════════════╗
  ║          abusez — SSH Forensic Abuse Reporter                 ║
  ╚══════════════════════════════════════════════════════════════════╝

DESCRIPTION
  Analyzes SSH brute-force attack logs and generates forensic dossiers
  on the top 30 attacker IPs. For each attacker, it:
  - Counts attempts, rate, duration, and peak attack hours
  - Queries WHOIS for abuse contacts and organization info
  - Checks reverse DNS, latency, and SSH banner
  - Analyzes attack patterns (robotic vs human cadence)
  - Generates pre-formatted abuse complaint emails
  - Cross-references AbuseIPDB for prior reports

USAGE
  ./abusez                  Generate SSH abuse reports (needs sudo for logs)
  sudo ./abusez             Full access to SSH journal logs
  ./abusez --ip <IP>        Search logs for a specific attacker IP
  ./abusez --time <DATE>    Search logs for a specific date (MM/DD/YYYY)

OPTIONS
  -h, --help           Show this help message and exit
  --ip <IP>            Filter logs to show only attacks from specific IP
  --time <DATE>        Filter logs to show only attacks on specific date (MM/DD/YYYY)

EXAMPLES
  ./abusez --ip 192.168.1.1      Show all attacks from 192.168.1.1
  ./abusez --time 6/10/2016      Show all attacks on June 10, 2016
  ./abusez --ip 10.0.0.5 --time 3/15/2024   Attacks from IP on specific date

OUTPUT FILES
  ssh_abuse_report.txt         Main report with all attacker dossiers
  <IP>.txt                     Filtered report when using --ip (e.g., 192_168_1_1.txt)
  attacks_MM_DD_YYYY.txt       Filtered report when using --time only
  /tmp/abuse_stats.tsv         Per-IP statistics (TSV)
  /tmp/abuse_samples.tsv       Attack timestamp samples
  /tmp/abuse_globals.txt       Global attack rate statistics

FEATURES
  --ip flag also performs:
    - Reverse DNS lookup for the attacker
    - Domain analysis to find related attackers from same network
    - WHOIS information lookup
    - Saves detailed report to IP-named file (e.g., 192_168_1_1.txt)

ALTERNATIVE COMMANDS
  last                             Show recent successful logins
  lastb                            Show recent failed logins (needs root)
  sudo faillog -a                  Failed login counts per user
  grep "Failed password" /var/log/auth.log | awk '{print $(NF-3)}' | sort | uniq -c | sort -rn
                                   Top attacking IPs from auth.log
  geoiplookup <IP>                 Geolocate an IP (needs geoip-bin)
  whois <IP>                       Full WHOIS record for an IP
  dig -x <IP> +short              Reverse DNS lookup
  curl https://ipinfo.io/<IP>/json  IP geolocation via API
  sudo journalctl -u ssh --no-pager | grep "Failed password" | wc -l
                                   Total failed SSH attempts

WARNING → INVESTIGATION COMMANDS
  High attack rate detected        →  sudo journalctl -u ssh -n 10000 | grep "Failed" | awk '{print $NF}' | sort | uniq -c | sort -rn | head
  Specific IP attacking            →  sudo grep "<IP>" /var/log/auth.log | tail -20
  Want to block an IP              →  sudo ufw deny from <IP>  or  sudo iptables -A INPUT -s <IP> -j DROP
  Check if IP is known bad         →  curl -s https://www.abuseipdb.com/check/<IP>
  Find attacker's organization     →  whois <IP> | grep -i 'org\|org-name\|organization'
  Find abuse contact               →  whois <IP> | grep -i 'abuse'
  Check SSH login success from IP  →  grep "<IP>" /var/log/auth.log | grep -i "accepted\|session opened"
  See what usernames were tried    →  grep "Failed password" /var/log/auth.log | grep "<IP>" | awk '{for(i=1;i<=NF;i++) if($i=="for") print $(i+1)}' | sort | uniq -c | sort -rn
  ─────────────────────────────────────────────────────────────────────────────────
  FIND THE ATTACKER ON YOUR NETWORK (include VICTIM and TIME details):
  ─────────────────────────────────────────────────────────────────────────────────
  Search logs with victim IP       →  grep "<ATTACKER_IP>" /var/log/auth.log | grep "ashys.org\|<YOUR_IP>" | head -20
  Search with timestamp window     →  sudo journalctl --since "Apr 8 11:00" --until "Apr 8 12:00" | grep "<ATTACKER_IP>"
  Search all logs for attacker     →  grep -r "<ATTACKER_IP>" /var/log/ 2>/dev/null | grep -v "whois\|abuseipdb"
  Search all logs for victim       →  grep -r "ashys.org\|<YOUR_IP>" /var/log/ 2>/dev/null | grep "<ATTACKER_IP>"
  Find via SSH banner/username     →  grep "sshd.*<ATTACKER_IP>" /var/log/auth.log /var/log/secure 2>/dev/null | tail -20
  See who logged in FROM attacker  →  last | grep "<ATTACKER_IP>"  ;  who | grep "<ATTACKER_IP>"
  Check if attacker succeeded      →  grep "<ATTACKER_IP>" /var/log/auth.log | grep -i "accepted\|session opened\|break-in"
  See victim's failed logins       →  grep "Failed password.*<ATTACKER_IP>" /var/log/auth.log | tail -20
  Get victim's IP if unknown       →  hostname -I | awk '{print $1}'  OR  curl -s https://ipinfo.io/ip

HELPEOF
    exit 0
}

# ─── Parse Arguments ─────────────────────────────────────────────────────────
FILTER_IP=""
FILTER_DATE=""
AI_VERDICT=0
THREAT_CONTEXT=""
JSON_OUT=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            ;;
        --ip)
            if [[ -z "${2:-}" ]]; then
                echo "Error: --ip requires an IP address argument"
                exit 1
            fi
            FILTER_IP="$2"
            shift 2
            ;;
        --time)
            if [[ -z "${2:-}" ]]; then
                echo "Error: --time requires a date argument (MM/DD/YYYY)"
                exit 1
            fi
            FILTER_DATE="$2"
            shift 2
            ;;
        --json)
            JSON_OUT=1
            shift

            json_stdout_only
            ;;

        --ai)
            AI_VERDICT=1
            shift
            ;;
        --no-ai)
            AI_VERDICT=0
            shift
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# In JSON mode the report goes to stderr and stdout carries only the JSON.
# fd 4 (not fd 3) — lib/run_comparison.sh claims fd 3 as the real stdout.
# An EXIT trap guarantees the object is emitted on EVERY exit path, including
# the early "no matching attacks found" exits.
if [[ "${JSON_OUT:-0}" -eq 1 ]]; then
    exec 1>&4
    exec 4>&1 1>&2
    trap _abusez_json EXIT
    exec 1>&2
fi

# Defined unconditionally: the EXIT traps below chain to it, and it is a
# no-op unless JSON mode is on.
_abusez_json() {
    [[ "${JSON_OUT:-0}" -eq 1 ]] || return 0
    printf '{"tool":"abusez","host":"%s","timestamp":"%s","filter_ip":"%s","filter_date":"%s","attempts":%s,"critical":%s,"warnings":%s}\n' \
        "${HOSTNAME_SHORT:-unknown}" "${TIMESTAMP:-}" "${FILTER_IP:-}" "${FILTER_DATE:-}" \
        "${TOTAL_ATTEMPTS:-0}" "${CRITICAL:-0}" "${WARNINGS:-0}" >&4 2>/dev/null || true
}

export TZ=America/Los_Angeles

if declare -f run_comparison_init >/dev/null 2>&1; then run_comparison_init "abusez" "JSON_OUT=$JSON_OUT QUICK=$QUICK" 2>/dev/null; fi

# ---------- Colors ----------
if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
  RESET="\033[0m"; BOLD="\033[1m"; DIM="\033[2m"
  RED="\033[31m"; GREEN="\033[32m"; YELLOW="\033[33m"
  BLUE="\033[34m"; MAGENTA="\033[35m"; CYAN="\033[36m"
else
  RESET=""; BOLD=""; DIM=""
  RED=""; GREEN=""; YELLOW=""; BLUE=""; MAGENTA=""; CYAN=""
fi

MY_IP=$(curl -s --connect-timeout 3 --max-time 5 https://ipinfo.io/ip 2>/dev/null || echo "")
SCRIPT_VERSION="1.0.0"
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S %Z')
HOSTNAME_SHORT=$(hostname -s 2>/dev/null || echo "host")
MY_NAME="${ABUSE_NAME:-Your Name}"
MY_EMAIL="${ABUSE_EMAIL:-you@example.com}"
MY_LOCATION="${ABUSE_LOCATION:-Your City, Your Country}"
MY_OS=$(lsb_release -ds 2>/dev/null || echo "Linux/Debian System")
CONTACT_INFO="${ABUSE_PHONE:-773-321-8181}"
DATE_STR=$(date +%Y%m%d)
EMAIL_FILE="ssh_abuse_report.txt"

# Secure temporary directory with automatic cleanup on exit
TMP_DIR=$(mktemp -d "/tmp/abuse_XXXXXX")
STATS_TSV="$TMP_DIR/abuse_stats.tsv"
SAMPLES_TSV="$TMP_DIR/abuse_samples.tsv"
GLOBALS_TXT="$TMP_DIR/abuse_globals.txt"
# Confine persistent reports to the suite directory per project security policy
REPORTS_DIR="${SCRIPT_DIR}/abusez-reports"

LOG_TEMP=$(mktemp -p "$TMP_DIR")
FILTERED_LOG=""

cleanup_abuse() {
    rm -rf "$TMP_DIR"
    [[ -n "${FILTERED_LOG:-}" ]] && rm -f "$FILTERED_LOG"
}
trap 'cleanup_abuse; _abusez_json' EXIT

# Privilege detection
SUDO=""
if [[ $EUID -eq 0 ]]; then
    SUDO=""
elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    SUDO="sudo"
elif command -v sudo >/dev/null 2>&1 && [[ -t 0 ]]; then
    if sudo -v 2>/dev/null; then
        SUDO="sudo"
    fi
fi

# ─── Banner ────────────────────────────────────────────────────────────────
if [[ ${JSON_OUT:-0} -eq 0 ]]; then
    printf "${BOLD}${MAGENTA}"
    cat << 'BANNER'
   ╔═══════════════════════════════════════════════════════════════╗
   ║  ABUSE.SH — SSH Forensic Abuse Reporter                       ║
   ║  Top Attackers · WHOIS · Abuse Contacts                       ║
   ╚═══════════════════════════════════════════════════════════════╝
BANNER
    printf "${RESET}\n"
    printf "${DIM}  v${SCRIPT_VERSION} — %s on %s${RESET}\n\n" \
        "$TIMESTAMP" "$HOSTNAME_SHORT"
fi

printf "${MAGENTA}${BOLD}Calculating the Global Pressure on the sanctuary, %s...${RESET}\n\n" "${MY_NAME%% *}"

# Collect SSH logs from systemd journal or auth.log fallback
if command -v journalctl >/dev/null 2>&1 && $SUDO journalctl -u ssh -n 100000 --no-pager 2>&1 | grep -E "Failed password|Invalid user" > "$LOG_TEMP"; then
    printf "  ${GREEN}${BOLD}✓${RESET} ${GREEN}SSH logs collected successfully via journalctl${RESET}\n"
    TOTAL_ATTEMPTS=$(wc -l < "$LOG_TEMP")
    if [ "$TOTAL_ATTEMPTS" -eq 0 ]; then
        printf "  ${YELLOW}!${RESET} ${YELLOW}No SSH attacks found in logs${RESET}\n"
    fi
elif [[ -r /var/log/auth.log ]] && grep -E "Failed password|Invalid user" /var/log/auth.log > "$LOG_TEMP" 2>/dev/null; then
    printf "  ${GREEN}${BOLD}✓${RESET} ${GREEN}SSH logs collected successfully from /var/log/auth.log${RESET}\n"
    TOTAL_ATTEMPTS=$(wc -l < "$LOG_TEMP")
else
    printf "  ${RED}✗${RESET} ${RED}Could not read SSH logs${RESET}\n"
    printf "  ${DIM}Creating empty log file to continue...${RESET}\n"
    : > "$LOG_TEMP"
    TOTAL_ATTEMPTS=0
fi

# ─── Apply Filters ───────────────────────────────────────────────────────────
FILTER_REPORT_FILE=""
DOMAIN_NAME=""
DOMAIN_IPS=""

if [[ -n "$FILTER_IP" ]] || [[ -n "$FILTER_DATE" ]]; then
    FILTER_TEMP=$(mktemp)
    FILTERED_COUNT=0

    if [[ -n "$FILTER_IP" ]]; then
        printf "\n${CYAN}${BOLD}Filtering logs for IP: ${FILTER_IP}${RESET}\n"
        grep -F "$FILTER_IP" "$LOG_TEMP" > "$FILTER_TEMP" || true
        FILTERED_COUNT=$(wc -l < "$FILTER_TEMP")
        mv "$FILTER_TEMP" "$LOG_TEMP"

        # Set report filename based on IP (replace dots with underscores)
        FILTER_REPORT_FILE="${FILTER_IP//./_}.txt"

        # ─── DNS Reverse Lookup ───────────────────────────────────────────
        printf "\n${MAGENTA}${BOLD}Performing DNS reverse lookup for ${FILTER_IP}...${RESET}\n"
        RDNS_RESULT=$(timeout 5 dig -x "$FILTER_IP" +short +time=2 +tries=1 2>/dev/null | sed 's/\.$//')

        if [[ -n "$RDNS_RESULT" ]]; then
            printf "  ${GREEN}${BOLD}✓${RESET} ${GREEN}Reverse DNS: ${RDNS_RESULT}${RESET}\n"
            DOMAIN_NAME=$(echo "$RDNS_RESULT" | awk -F'.' '{print $(NF-1)"."$NF}')

            # ─── Search for other IPs from same domain ────────────────────
            printf "\n${MAGENTA}${BOLD}Searching for other attackers from domain: ${DOMAIN_NAME}...${RESET}\n"

            # Check top 30 attackers to avoid unbounded sequential DNS lookups
            ALL_IPS=$(awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {print $i; break}}' "$LOG_TEMP" | sort | uniq -c | sort -rn | head -30 | awk '{print $2}')

            # Check each IP's reverse DNS for same domain
            DOMAIN_ATTACKERS=""
            DOMAIN_ATTACK_COUNT=0

            while IFS= read -r ip; do
                if [[ -n "$ip" ]] && [[ "$ip" != "$FILTER_IP" ]]; then
                    ip_rdns=$(timeout 3 dig -x "$ip" +short +time=2 +tries=1 2>/dev/null | sed 's/\.$//')
                    if [[ "$ip_rdns" == *"$DOMAIN_NAME"* ]]; then
                        ip_attempts=$(grep -cF "$ip" "$LOG_TEMP" 2>/dev/null || echo "0")
                        DOMAIN_ATTACKERS="${DOMAIN_ATTACKERS}\n  ${ip} - ${ip_rdns} (${ip_attempts} attempts)"
                        DOMAIN_ATTACK_COUNT=$((DOMAIN_ATTACK_COUNT + 1))
                    fi
                fi
            done <<< "$ALL_IPS"

            if [[ $DOMAIN_ATTACK_COUNT -gt 0 ]]; then
                printf "  ${YELLOW}${BOLD}⚠ Found ${DOMAIN_ATTACK_COUNT} other attacker(s) from ${DOMAIN_NAME}:${RESET}\n"
                echo -e "$DOMAIN_ATTACKERS"
            else
                printf "  ${GREEN}✓ No other attackers found from ${DOMAIN_NAME}${RESET}\n"
            fi
        else
            printf "  ${YELLOW}!${RESET} ${YELLOW}No reverse DNS found for ${FILTER_IP}${RESET}\n"
            DOMAIN_NAME="unknown"
        fi
    fi

    if [[ -n "$FILTER_DATE" ]]; then
        # Convert MM/DD/YYYY to journalctl format (Mon DD)
        FILTER_MONTH=$(echo "$FILTER_DATE" | cut -d'/' -f1 | sed 's/^0//')
        FILTER_DAY=$(echo "$FILTER_DATE" | cut -d'/' -f2 | sed 's/^0//')
        FILTER_YEAR=$(echo "$FILTER_DATE" | cut -d'/' -f3)

        # Map month number to abbreviation
        case "$FILTER_MONTH" in
            1)  MONTH_ABBR="Jan" ;;
            2)  MONTH_ABBR="Feb" ;;
            3)  MONTH_ABBR="Mar" ;;
            4)  MONTH_ABBR="Apr" ;;
            5)  MONTH_ABBR="May" ;;
            6)  MONTH_ABBR="Jun" ;;
            7)  MONTH_ABBR="Jul" ;;
            8)  MONTH_ABBR="Aug" ;;
            9)  MONTH_ABBR="Sep" ;;
            10) MONTH_ABBR="Oct" ;;
            11) MONTH_ABBR="Nov" ;;
            12) MONTH_ABBR="Dec" ;;
            *)  echo "Invalid month: $FILTER_MONTH"; exit 1 ;;
        esac

        printf "\n${CYAN}${BOLD}Filtering logs for date: ${FILTER_DATE} (${MONTH_ABBR} ${FILTER_DAY})${RESET}\n"
        grep -E "^${MONTH_ABBR} +${FILTER_DAY} " "$LOG_TEMP" > "$FILTER_TEMP" || true
        FILTERED_COUNT=$(wc -l < "$FILTER_TEMP")
        mv "$FILTER_TEMP" "$LOG_TEMP"

        # If no IP filter, set report filename based on date
        if [[ -z "$FILTER_REPORT_FILE" ]]; then
            FILTER_REPORT_FILE="attacks_${FILTER_MONTH}_${FILTER_DAY}_${FILTER_YEAR}.txt"
        fi
    fi

    TOTAL_ATTEMPTS=$(wc -l < "$LOG_TEMP")
    printf "  ${GREEN}${BOLD}✓${RESET} ${GREEN}Filtered to ${TOTAL_ATTEMPTS} matching log entries${RESET}\n"

    if [ "$TOTAL_ATTEMPTS" -eq 0 ]; then
        printf "  ${YELLOW}!${RESET} ${YELLOW}No matching attacks found for the specified filter${RESET}\n"
        printf "  ${DIM}Try a different IP or date range${RESET}\n"
        rm "$LOG_TEMP"
        exit 0
    fi
fi

# --- GLOBAL TIMEFRAME CALCULATION ---
if [ "$TOTAL_ATTEMPTS" -gt 0 ]; then
    FIRST_LOG_TS=$(head -n 1 "$LOG_TEMP" | awk '{print $1" "$2" "$3}')
    LAST_LOG_TS=$(tail -n 1 "$LOG_TEMP" | awk '{print $1" "$2" "$3}')
    F_SEC=$(date -d "$FIRST_LOG_TS 2026" +%s 2>/dev/null || echo "0")
    L_SEC=$(date -d "$LAST_LOG_TS 2026" +%s 2>/dev/null || echo "0")
    DIFF_SECS=$((L_SEC - F_SEC))
    [ $DIFF_SECS -lt 3600 ] && DIFF_SECS=3600
else
    FIRST_LOG_TS="No data"
    LAST_LOG_TS="No data"
    DIFF_SECS=3600
fi

TOTAL_HOURS=$(echo "scale=2; $DIFF_SECS / 3600" | bc)
GLOBAL_ATTACKS_PER_HOUR=$(echo "scale=2; $TOTAL_ATTEMPTS / $TOTAL_HOURS" | bc)
HIGH_RATE=$(echo "$GLOBAL_ATTACKS_PER_HOUR > 10000" | bc)
MED_RATE=$(echo "$GLOBAL_ATTACKS_PER_HOUR > 100" | bc)
if [ "$HIGH_RATE" -eq 1 ]; then
    GLOBAL_RATE_DISPLAY=$(echo "scale=2; $TOTAL_ATTEMPTS / $DIFF_SECS" | bc)"/sec"
elif [ "$MED_RATE" -eq 1 ]; then
    GLOBAL_RATE_DISPLAY=$(echo "scale=2; $TOTAL_ATTEMPTS / ($TOTAL_HOURS * 60)" | bc)"/min"
else
    GLOBAL_RATE_DISPLAY="${GLOBAL_ATTACKS_PER_HOUR}/hr"
fi

# ─── Bar Chart: top attacker IPs by attempt count ──────────────────────────
if [ "$TOTAL_ATTEMPTS" -gt 0 ]; then
    TOP_ROWS=$(awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {print $i; break}}' "$LOG_TEMP" \
        | sort | uniq -c | sort -rn | head -10)
    if [ -n "$TOP_ROWS" ]; then
        CHART_MAX=$(printf '%s\n' "$TOP_ROWS" | awk 'NR==1{print $1}')
        CHART_SUM=$(printf '%s\n' "$TOP_ROWS" | awk '{s+=$1} END {print s+0}')
        printf "\n  ${BOLD}${CYAN}Top 10 attackers by attempts (shown=%s of %s):${RESET}\n" \
            "$CHART_SUM" "$TOTAL_ATTEMPTS"
        while read -r cnt ip; do
            [ -z "$ip" ] && continue
            pct=$(( cnt * 100 / (CHART_MAX > 0 ? CHART_MAX : 1) ))
            color="$GREEN"; [ "$pct" -ge 60 ] && color="$YELLOW"; [ "$pct" -ge 85 ] && color="$RED"
            filled=$(( pct * 40 / 100 ))
            [ "$filled" -eq 0 ] && [ "$cnt" -gt 0 ] && filled=1
            bar=""
            for (( j=0; j<filled; j++ )); do bar+="█"; done
            for (( j=filled; j<40; j++ )); do bar+=" "; done
            printf "    %-18s ${color}%s${RESET} %d\n" "$ip" "$bar" "$cnt"
        done <<< "$TOP_ROWS"
        printf "\n"
    fi
fi

{
    echo "=== SSH MULTI-IP FORENSIC DOSSIER ($MY_NAME) - $DATE_STR ==="
    echo "Report Origin: $MY_LOCATION | System: $MY_OS"
    echo "Global Campaign Context:"
    echo " - Total Logged Attempts: $TOTAL_ATTEMPTS"
    echo " - Observation Window: $TOTAL_HOURS hours"
    echo " - Global Pressure: $GLOBAL_RATE_DISPLAY"
    echo "----------------------------------------------------------"
} > "$EMAIL_FILE"

# ============================================================================
# Speed: pre-fetch all per-IP network lookups in parallel.
#
# Previously awk did 7 sequential `cmd | getline` per IP inside its END block,
# which serialised 30 IPs × ~13s of network calls = ~6.5 minutes. We now
# extract the top-30 IP list, fire all 7 lookups per IP in a single
# backgrounded subshell, and write results to /tmp/.abusez_lookup.$$ so
# awk reads from disk instead of doing the network itself.
#
# Layout: ip<TAB>emails<TAB>rdns<TAB>latency<TAB>ssh_banner<TAB>org<TAB>abuse_c<TAB>tz
# ============================================================================
TOP_IPS_FILE=$(mktemp -p "$TMP_DIR")
LOOKUP_FILE=$(mktemp -p "$TMP_DIR")
trap 'rm -f "$TOP_IPS_FILE" "$LOOKUP_FILE"; _abusez_json' EXIT

# Build the top-30 IP list once
awk -v log="$LOG_TEMP" '
    {
        match($0, /from ([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)/, m)
        if (m[1] != "") count[m[1]]++
    }
    END {
        n = asorti(count, sorted, "@val_num_desc")
        for (i = 1; i <= n && i <= 30; i++) print sorted[i]
    }
' "$LOG_TEMP" > "$TOP_IPS_FILE"

# Fire all per-IP lookups in parallel. 30 IPs × 7 fields, all at once.
# Each IP gets one ( ip ) & job that writes its 7 fields into the lookup file
# under a single flock-guarded append.
(
    flock 9
    fetch_ip() {
        local ip="$1"
        local emails rdns latency ssh_banner org abuse_c tz
        # Cache whois once per IP (was being called 3x before).
        local whois_out
        whois_out=$(timeout 5 whois "$ip" 2>/dev/null)
        emails=$(printf '%s' "$whois_out" \
            | grep -Eio "[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}" \
            | sort -u | paste -sd, - | sed 's/,/, /g')
        [[ -z "$emails" ]] && emails="none"
        org=$(printf '%s' "$whois_out" \
            | grep -Ei "^(org-name|organization|descr)" | head -1 | sed 's/^[^:]*:[[:space:]]*//')
        abuse_c=$(printf '%s' "$whois_out" \
            | grep -Ei "^(abuse-mailbox|abuse-c|% Abuse contact)" | head -1 | sed 's/^[^:]*:[[:space:]]*//')
        rdns=$(timeout 3 dig +short +time=2 +tries=1 -x "$ip" 2>/dev/null | head -1 | sed 's/\.$//')
        [[ -z "$rdns" ]] && rdns="(no PTR)"
        latency=$(timeout 2 ping -c 1 -W 1 "$ip" 2>&1 | grep -oE 'time=[0-9.]+' | cut -d= -f2)
        [[ -z "$latency" ]] && latency="timeout"
        # NOTE: removed nc banner-grab to attacker :22 — that discloses our
        # IP to the very attacker we are reporting. Pure passive lookups only.
        ssh_banner="(not probed — passive-only)"
        tz=$(timeout 5 curl -s "https://ipinfo.io/${ip}/json" 2>/dev/null \
            | grep -oE '"timezone":[[:space:]]*"[^"]+"' | cut -d'"' -f4)
        [[ -z "$tz" ]] && tz="unknown"
        # Tab-separated, single line per IP. awk will read this file directly.
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$ip" "$emails" "$rdns" "$latency" "$ssh_banner" "$org" "$abuse_c" "$tz" \
            >> "$LOOKUP_FILE"
    }
    export -f fetch_ip
    export LOOKUP_FILE
    while IFS= read -r ip; do
        [[ -z "$ip" ]] && continue
        ( fetch_ip "$ip" ) &
    done < "$TOP_IPS_FILE"
    wait
) 9>"$TMP_DIR/.abusez_lookup.lock"

if [[ -s "$LOOKUP_FILE" ]]; then
    printf ">>> Pre-fetched per-IP lookups in parallel for %d IPs\n" \
        "$(wc -l < "$LOOKUP_FILE" | tr -d ' ')"
fi

# The Analyzer
awk -v email="$EMAIL_FILE" -v my_ip="$MY_IP" -v my_gmail="$MY_EMAIL" -v my_name="$MY_NAME" -v contact="$CONTACT_INFO" -v loc="$MY_LOCATION" -v os="$MY_OS" -v global_avg="$GLOBAL_RATE_DISPLAY" -v lookup="$LOOKUP_FILE" '
BEGIN {
    # Load pre-fetched per-IP lookups (see /tmp/.abusez_lookup.*).
    # Format: ip<TAB>emails<TAB>rdns<TAB>latency<TAB>ssh_banner<TAB>org<TAB>abuse_c<TAB>tz
    while ((getline line < lookup) > 0) {
        n = split(line, parts, "\t")
        if (n >= 8) {
            ip = parts[1]
            L_email[ip]    = parts[2]
