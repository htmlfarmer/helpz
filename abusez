        print "\n--- HTTP ATTACK DETAILS FOR " ip " ---" >> http_abuse
        print "Total Requests: " total >> http_abuse
        print "Sensitive Path Hits: " sen >> http_abuse
        print "SQL Injection Attempts: " sqli >> http_abuse
        print "XSS Attempts: " xss >> http_abuse
        print "Path Traversal Attempts: " trav >> http_abuse
        print "Scanner/Bot Signatures: " scan >> http_abuse
        print "404/403 Errors: " err >> http_abuse
        
        if (sensitive_paths[ip] != "") {
            print "\nSensitive Paths Queried:" >> http_abuse
            print sensitive_paths[ip] | "sort -u >> " http_abuse
        }
        if (error_paths[ip] != "") {
            print "\n404/403 Paths Queried:" >> http_abuse
            print error_paths[ip] | "sort -u >> " http_abuse
        }
        
        print "\nTop User Agents:" >> http_abuse
        for (key in ua_count) {
            split(key, parts, SUBSEP)
            if (parts[1] == ip) {
                print "  " ua_count[key] "x: " parts[2] >> http_abuse
            }
        }
        
        print "\nWHOIS Info:" >> http_abuse
        if (ip != "" && ip != "--" && ip != "-") {
            whois_cmd = "whois " ip " | grep -Ei \"org-name|organization|abuse-c\" | head -5 >> " http_abuse
            system(whois_cmd)
        } else {
            print "  IP not available" >> http_abuse
        }
        print "----------------------------------------------------------" >> http_abuse
        fflush(http_abuse)
    }
    print "\nTotal unique HTTP attackers analyzed: " n >> http_abuse
}' "$HTTP_LOG_TEMP"

