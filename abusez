    if (rel_count == 0) print "  No correlated IPs found"
    fflush()
    
    # Global peak hour analysis
    print ""
    print "═══════════════════════════════════════════════════════════"
    print " [GLOBAL PEAK ATTACK TIME ANALYSIS]"
    print "═══════════════════════════════════════════════════════════"
    global_peak_hour = -1
    global_peak_count = 0
    for (h = 0; h < 24; h++) {
        if (global_hour_count[h] > global_peak_count) {
            global_peak_count = global_hour_count[h]
            global_peak_hour = h
        }
    }
    print "  Peak attack hour for all attackers: " global_peak_hour ":00 to " global_peak_hour ":59 PST"
    print "  Attacks during this hour: " global_peak_count
    print "  "
    print "  Hour-by-hour distribution:"
    for (h = 0; h < 24; h++) {
        c = global_hour_count[h]+0
        if (c > 0) {
            bar = ""
            bar_max = 40
            attacks_per_bar = 1
            if (c > bar_max) attacks_per_bar = int(c / bar_max)
            for (i = 0; i < int(c / attacks_per_bar); i++) bar = bar "="
            printf "  %02d:00 | %4d | %s\n", h, c, bar
        }
    }
    fflush()
}' "$LOG_TEMP"

