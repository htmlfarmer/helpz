        ;;
    4)
        echo ""
        echo -e "  ${BLUE}${BOLD}Enter script numbers separated by spaces (e.g. 1 3 5):${NC}"
        echo ""
        # Build numbered list of runnable scripts
        ALL_SCRIPTS=()
        IDX=0
        for s in securityz portz slowz logz sshauditz specz cpuz memoryz diskz networkz bootz gpuz powerz usbz pciz sqlz ai.sh hardenz benchmarkz timingz abusez checkz info.py analyzer.py live_leak_detector.py my_monitor.py tracemap.py web_server.py render_reports.py; do
            if [[ -f "$SCRIPT_DIR/$s" ]]; then
                ((IDX += 1))
                ALL_SCRIPTS+=("$s")
                echo -e "    ${BOLD}$IDX${NC}) $s"
            fi
        done
        echo ""
        read -rp "  Scripts to run: " selections || selections=""
        for num in $selections; do
            if [[ "$num" -ge 1 && "$num" -le ${#ALL_SCRIPTS[@]} ]] 2>/dev/null; then
                target_script="${ALL_SCRIPTS[$((num - 1))]}"
                if [[ "$target_script" == "securityz" ]]; then
                    run_script "$target_script"
                elif [[ "$target_script" == "hardenz" ]]; then
                    run_script "$target_script" "--dry-run"
                else
                    run_script "$target_script"
                fi
            else
                echo -e "  ${RED}Skipping invalid selection: $num${NC}"
            fi
        done
        ;;
    q|quit|exit|"")
        echo ""
        echo -e "  ${DIM}Exiting — review recommendations above.${NC}"
        ;;
    *)
        echo -e "  ${RED}Unknown choice: $choice${NC}"
        ;;
esac

echo ""
echo -e "  ${BOLD}Orchestrator completed at: $(date '+%Y-%m-%d %H:%M:%S %Z')${NC}"
echo ""

# ---------- Run Comparison Finalize ----------
if declare -f run_comparison_finalize >/dev/null 2>&1; then run_comparison_finalize 2>/dev/null; fi

# ---------- AI verdict (opt-in via --ai) ----------
if [[ "${AI_VERDICT:-}" == "1" ]]; then
    ai_emit_verdict "summary" "allz complete: batch=$BATCH quick=$QUICK run_target=${RUN_TARGET:-all}" 2>/dev/null || true
fi
