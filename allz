    echo -e "${MAGENTA}${BOLD}────────────────────────────────────────────────────────────${NC}"
    if [[ "$script" == *.py ]]; then
        python3 "$path" "$@" </dev/null 2>&1 || true
    else
        bash "$path" "$@" </dev/null 2>&1 || true
    fi
    echo -e "${MAGENTA}${BOLD}◀◀◀ Done: $script ${NC}"
    echo ""
}

