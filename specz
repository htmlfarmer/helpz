    [[ -n "$MAX_CAPACITY" ]] && Q_RAM+=" | max ${MAX_CAPACITY}"
    [[ -n "$NUM_DEVICES" ]] && Q_RAM+=" | ${NUM_DEVICES} slots"
    DDR_TYPE_Q=$(dmi "memory" 2>/dev/null | awk '/^[[:space:]]*Type:/ && !/Detail|Error/ {sub(/^[^:]*:[[:space:]]*/, ""); print; exit}')
    [[ -n "$DDR_TYPE_Q" ]] && Q_RAM+=" | $DDR_TYPE_Q"
    [[ -n "$CONF_SPEED" ]] && Q_RAM+=" | running at $CONF_SPEED"
    DDR_SPEED_Q=$(dmi "memory" 2>/dev/null | awk '/^[[:space:]]*Speed:/ && !/Configured/ {sub(/^[^:]*:[[:space:]]*/, ""); print; exit}')
    [[ -z "$CONF_SPEED" && -n "$DDR_SPEED_Q" ]] && Q_RAM+=" | $DDR_SPEED_Q"
    DDR_VOLT=$(dmi "memory" 2>/dev/null | awk '/Configured Voltage/ {sub(/^[^:]*:[[:space:]]*/, ""); print; exit}')
    [[ -n "$DDR_VOLT" ]] && Q_RAM+=" | $DDR_VOLT"
    DDR_FORM=$(dmi "memory" 2>/dev/null | awk '/Form Factor/ {sub(/^[^:]*:[[:space:]]*/, ""); print; exit}')
    [[ -n "$DDR_FORM" ]] && Q_RAM+=" | $DDR_FORM"
    [[ -n "$MEM_ERR_CORR" ]] && Q_RAM+=" | ECC: $MEM_ERR_CORR"
  else
    Q_RAM+=" | run with sudo for DDR type/speed/slots"
  fi

  # GPU details
  Q_GPU=""
  if [[ $HAVE_NVIDIA -eq 1 ]]; then
    Q_GPU=$(nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader 2>/dev/null | head -1)
    Q_GPU=$(echo "$Q_GPU" | sed 's/, / | /g')
  fi
  if [[ -z "$Q_GPU" && -n "$GPU_LIST" ]]; then
    Q_GPU=$(echo "$GPU_LIST" | head -1 | sed 's/^[^ ]* //')
  fi
  # Re-resolve GPU BDF for copy-paste section (avoid variable clobber)
  Q_GPU_BDF_LINE=$(lspci 2>/dev/null | grep -iE 'VGA|3D' | grep -iv 'Intel' | head -1)
  [[ -z "$Q_GPU_BDF_LINE" ]] && Q_GPU_BDF_LINE=$(lspci 2>/dev/null | grep -iE 'VGA|3D|Display' | head -1)
  Q_GPU_BDF=$(echo "$Q_GPU_BDF_LINE" | awk '{print $1}')
  if [[ -n "$Q_GPU_BDF" && -d "/sys/bus/pci/devices/0000:${Q_GPU_BDF}" ]]; then
    Q_GPUSPD_CUR=$(cat "/sys/bus/pci/devices/0000:${Q_GPU_BDF}/current_link_speed" 2>/dev/null)
    Q_GPUSPD_WID=$(cat "/sys/bus/pci/devices/0000:${Q_GPU_BDF}/current_link_width" 2>/dev/null)
    Q_GPUSPD_MAX=$(cat "/sys/bus/pci/devices/0000:${Q_GPU_BDF}/max_link_speed" 2>/dev/null)
    Q_GPUSPD_MAXW=$(cat "/sys/bus/pci/devices/0000:${Q_GPU_BDF}/max_link_width" 2>/dev/null)
    if [[ -n "$Q_GPUSPD_CUR" && "$Q_GPUSPD_CUR" != "Unknown" ]]; then
      Q_GPU+=" | PCIe ${Q_GPUSPD_CUR} x${Q_GPUSPD_WID}"
      if [[ -n "$Q_GPUSPD_MAX" && "$Q_GPUSPD_MAX" != "Unknown" ]]; then
        Q_GPU+=" (slot max: ${Q_GPUSPD_MAX} x${Q_GPUSPD_MAXW})"
      fi
    fi
  fi

  # iGPU
  Q_IGPU=""
  IGPU_LINE=$(echo "$GPU_LIST" | grep -i 'Intel\|AMD\|Radeon\|UHD\|Iris' | head -1)
  if [[ -n "$IGPU_LINE" ]]; then
    Q_IGPU=$(echo "$IGPU_LINE" | sed 's/^[^ ]* //' | sed 's/.*controller: //')
  fi

  # Storage details
  Q_STORAGE=""
  for devdir in /sys/block/*; do
    [[ -d "$devdir" ]] || continue
    name=$(basename "$devdir")
    [[ "$name" == loop* || "$name" == ram* || "$name" == sr* ]] && continue
    size_sectors=$(cat "$devdir/size" 2>/dev/null)
    [[ -z "$size_sectors" || "$size_sectors" == "0" ]] && continue
    size_bytes=$((size_sectors * 512))
    rot=$(cat "$devdir/queue/rotational" 2>/dev/null)
    model=$(cat "$devdir/device/model" 2>/dev/null | sed 's/^ *//;s/ *$//')
    vendor=$(cat "$devdir/device/vendor" 2>/dev/null | sed 's/^ *//;s/ *$//')
    s_type="SSD"
    s_proto="SATA"
    if [[ "$name" == nvme* ]]; then
      s_type="NVMe"
      s_proto="PCIe NVMe"
    elif [[ "$rot" == "0" ]]; then
      s_type="SSD"
      s_proto="SATA"
    else
      s_type="HDD"
      s_proto="SATA"
    fi
    [[ -n "$Q_STORAGE" ]] && Q_STORAGE+=$'\n'
    Q_STORAGE+="/dev/${name} | ${vendor} ${model} | $(humansize $size_bytes) ${s_type} | ${s_proto}"
  done

  # Network details
  Q_NET=""
  [[ -n "$ETH_SPEED" ]] && Q_NET+="Ethernet ${ETH_SPEED} Mbps"
  ETH_DUPLEX=$(cat /sys/class/net/eno1/duplex 2>/dev/null)
  [[ -n "$ETH_DUPLEX" ]] && Q_NET+=" | ${ETH_DUPLEX}"
  [[ -n "$WIFI_IFACE" ]] && {
    WIFI_DRIVER=""
    [[ -L "/sys/class/net/${WIFI_IFACE}/device/driver" ]] && \
      WIFI_DRIVER=$(basename "$(readlink "/sys/class/net/${WIFI_IFACE}/device/driver" 2>/dev/null)" 2>/dev/null)
    WIFI_BAND=$(iw dev "$WIFI_IFACE" info 2>/dev/null | awk '/width/ {print $2 " " $3; exit}')
    Q_NET+=" | Wi-Fi: ${WIFI_IFACE}"
    [[ -n "$WIFI_DRIVER" ]] && Q_NET+=" (${WIFI_DRIVER})"
    [[ -n "$WIFI_BAND" ]] && Q_NET+=" | ${WIFI_BAND}"
  }

  # Bluetooth details
  Q_BT="Not detected"
  if [[ $BT_FOUND -eq 1 ]]; then
    Q_BT="${BT_NAME:-adapter}"
    [[ -n "$BT_VERSION" ]] && Q_BT+=" | HCI $BT_VERSION"
    [[ -n "$BT_ADDR" ]] && Q_BT+=" | ${BT_ADDR}"
  fi

  # Audio details
  Q_AUDIO=""
  if [[ -r /proc/asound/cards ]]; then
    while IFS= read -r line; do
      [[ "$line" =~ ^[[:space:]]*[0-9] ]] || continue
      card_info=$(echo "$line" | sed 's/^[[:space:]]*//')
      [[ -n "$Q_AUDIO" ]] && Q_AUDIO+=$'\n'
      Q_AUDIO+="$card_info"
    done < /proc/asound/cards
  fi
  [[ -n "$PA_SERVER" ]] && Q_AUDIO+=" | Server: $PA_SERVER"

  # Display details
  Q_DISP=""
  if has_cmd xrandr && [[ -n "${DISPLAY:-}" ]]; then
    while IFS= read -r line; do
      [[ "$line" == *" connected"* ]] || continue
      disp_res=$(echo "$line" | grep -oE '[0-9]+x[0-9]+\+[0-9]+\+[0-9]+' | head -1)
      [[ -z "$disp_res" ]] && continue
      disp_name=$(echo "$line" | awk '{print $1}')
      disp_res=${disp_res%%+*}
      disp_mm=$(echo "$line" | grep -oE '[0-9]+mm x [0-9]+mm' | head -1)
      disp_diag=""
      if [[ -n "$disp_mm" ]]; then
        mm_w=$(echo "$disp_mm" | awk '{print $1}')
        mm_h=$(echo "$disp_mm" | awk '{print $3}')
        diag_mm=$(echo "scale=0; sqrt($mm_w * $mm_w + $mm_h * $mm_h)" | bc 2>/dev/null)
        [[ -n "$diag_mm" ]] && disp_diag=" | $((diag_mm / 25))\" ($diag_mm mm)"
      fi
      [[ -n "$Q_DISP" ]] && Q_DISP+=$'\n'
      Q_DISP+="${disp_name} | ${disp_res}${disp_diag}"
    done <<< "$(xrandr --query 2>/dev/null)"
  fi

  # Motherboard / BIOS
  Q_MB="${MB_MANUF:-Unknown} ${MB_NAME:-}"
  [[ -n "$MB_VER" ]] && Q_MB+=" (rev ${MB_VER})"
  [[ -n "$BIOS_VER" ]] && Q_MB+=" | BIOS ${BIOS_VER}"
  [[ -n "$BIOS_DATE" ]] && Q_MB+=" (${BIOS_DATE})"
  Q_MB+=" | $(if [[ -d /sys/firmware/efi ]]; then echo "UEFI"; else echo "Legacy BIOS"; fi)"

  # USB controllers
  Q_USB=""
  if [[ $HAVE_LSPCI -eq 1 ]]; then
    Q_USB=$(lspci 2>/dev/null | grep -i 'USB' | sed 's/^[^ ]* //' | head -3 | tr '\n' '|' | sed 's/|/ | /g; s/ | $//')
  fi
  [[ $HAVE_LSUSB -eq 1 ]] && Q_USB+=" | ${USB_COUNT:-0} devices connected"

  # OS
  Q_OS="${OS_PRETTY:-Unknown} | Kernel ${KERNEL} | $(uname -m)"

  # Power
  Q_POWER=""
  if [[ $(echo "$TOTAL_WATTS > 0" | bc -l 2>/dev/null) == "1" ]]; then
    if [[ $ESTIMATED -eq 1 ]]; then
      Q_POWER="~${TOTAL_WATTS}W idle (est)"
    else
      Q_POWER="${TOTAL_WATTS}W draw"
    fi
    Q_POWER+=" | \$${COST_PER_DAY}/day / \$${COST_PER_MONTH}/month / \$${COST_PER_YEAR}/year"
    [[ -n "$MAX_WATTS" && $(echo "$MAX_WATTS > 0" | bc -l 2>/dev/null) == "1" ]] && \
      Q_POWER+=" / max ~${MAX_WATTS}W"
  fi

  # ─── Print the table ───
  printf "\n"
  printf "  ${C_BOLD}%-14s  %-42s  %s${C_RESET}\n" "COMPONENT" "SPEC" "PROTOCOL / SPEED / DETAILS"
  printf "  ${C_DIM}%-14s  %-42s  %s${C_RESET}\n" "──────────────" "──────────────────────────────────────────" "────────────────────────────────────────────────"

  # CPU
  printf "  ${C_CYAN}%-14s${C_RESET}  %-42s  %s\n" "CPU" \
    "$(echo "$Q_CPU" | cut -d'|' -f1 | sed 's/^ *//;s/ *$//')" \
    "$(echo "$Q_CPU" | cut -d'|' -f2- | sed 's/^ *//;s/ *$//' | tr '|' '/')"

  # RAM
  printf "  ${C_GREEN}%-14s${C_RESET}  %-42s  %s\n" "MEMORY (RAM)" \
    "$(echo "$Q_RAM" | cut -d'|' -f1 | sed 's/^ *//;s/ *$//')" \
    "$(echo "$Q_RAM" | cut -d'|' -f2- | sed 's/^ *//;s/ *$//' | tr '|' '/')"

  # GPU
  if [[ -n "$Q_GPU" ]]; then
    printf "  ${C_MAGENTA}%-14s${C_RESET}  %-42s  %s\n" "GPU" \
      "$(echo "$Q_GPU" | cut -d'|' -f1 | sed 's/^ *//;s/ *$//')" \
      "$(echo "$Q_GPU" | cut -d'|' -f2- | sed 's/^ *//;s/ *$//' | tr '|' '/')"
  fi

  # iGPU
  if [[ -n "$Q_IGPU" ]]; then
    printf "  ${C_DIM}%-14s${C_RESET}  %-42s  %s\n" "iGPU" \
      "$(echo "$Q_IGPU" | cut -c1-42)" \
      "Integrated (shares system RAM)"
  fi

  # Motherboard
  printf "  ${C_CYAN}%-14s${C_RESET}  %-42s  %s\n" "MOTHERBOARD" \
    "$(echo "$Q_MB" | cut -d'|' -f1 | sed 's/^ *//;s/ *$//')" \
    "$(echo "$Q_MB" | cut -d'|' -f2- | sed 's/^ *//;s/ *$//' | tr '|' '/')"

  # Storage — may be multi-line
  FIRST_STORE=1
  while IFS= read -r sline; do
    [[ -z "$sline" ]] && continue
    if (( FIRST_STORE )); then
      printf "  ${C_GREEN}%-14s${C_RESET}  %-42s  %s\n" "STORAGE" \
        "$(echo "$sline" | awk -F'|' '{print $1 " " $2}' | sed 's/^ *//;s/ *$//' | cut -c1-42)" \
        "$(echo "$sline" | awk -F'|' '{print $3 " | " $4}' | sed 's/^ *//;s/ *$//')"
      FIRST_STORE=0
    else
      printf "  ${C_DIM}%-14s${C_RESET}  %-42s  %s\n" "" \
        "$(echo "$sline" | awk -F'|' '{print $1 " " $2}' | sed 's/^ *//;s/ *$//' | cut -c1-42)" \
        "$(echo "$sline" | awk -F'|' '{print $3 " | " $4}' | sed 's/^ *//;s/ *$//')"
    fi
  done <<< "$Q_STORAGE"

  # Network
  printf "  ${C_CYAN}%-14s${C_RESET}  %-42s  %s\n" "NETWORK" \
    "$(echo "$Q_NET" | cut -d'|' -f1 | sed 's/^ *//;s/ *$//')" \
    "$(echo "$Q_NET" | cut -d'|' -f2- | sed 's/^ *//;s/ *$//' | tr '|' '/')"

  # Bluetooth
  printf "  ${C_BLUE}%-14s${C_RESET}  %-42s  %s\n" "BLUETOOTH" \
    "$(echo "$Q_BT" | cut -d'|' -f1 | sed 's/^ *//;s/ *$//')" \
    "$(echo "$Q_BT" | cut -d'|' -f2- | sed 's/^ *//;s/ *$//' | tr '|' '/')"

  # Audio
  FIRST_AUD=1
  while IFS= read -r aline; do
    [[ -z "$aline" ]] && continue
    if (( FIRST_AUD )); then
      printf "  ${C_DIM}%-14s${C_RESET}  %-42s  %s\n" "AUDIO" \
        "$(echo "$aline" | cut -c1-42)" \
        "$(echo "$aline" | sed 's/.*]: //' | cut -c1-50)"
      FIRST_AUD=0
    else
      printf "  ${C_DIM}%-14s${C_RESET}  %-42s  %s\n" "" \
        "$(echo "$aline" | cut -c1-42)" \
        "$(echo "$aline" | sed 's/.*]: //' | cut -c1-50)"
    fi
  done <<< "$Q_AUDIO"

  # USB
  printf "  ${C_CYAN}%-14s${C_RESET}  %-42s  %s\n" "USB" \
    "$(echo "$Q_USB" | cut -d'|' -f1 | sed 's/^ *//;s/ *$//' | cut -c1-42)" \
    "$(echo "$Q_USB" | cut -d'|' -f2- | sed 's/^ *//;s/ *$//' | tr '|' '/')"

  # Display
  FIRST_DISP=1
  while IFS= read -r dline; do
    [[ -z "$dline" ]] && continue
    if (( FIRST_DISP )); then
      printf "  ${C_MAGENTA}%-14s${C_RESET}  %-42s  %s\n" "DISPLAY" \
        "$(echo "$dline" | awk -F'|' '{print $1}' | sed 's/^ *//;s/ *$//' | cut -c1-42)" \
        "$(echo "$dline" | awk -F'|' '{print $2}' | sed 's/^ *//;s/ *$//')"
      FIRST_DISP=0
    else
      printf "  ${C_DIM}%-14s${C_RESET}  %-42s  %s\n" "" \
        "$(echo "$dline" | awk -F'|' '{print $1}' | sed 's/^ *//;s/ *$//' | cut -c1-42)" \
        "$(echo "$dline" | awk -F'|' '{print $2}' | sed 's/^ *//;s/ *$//')"
    fi
  done <<< "$Q_DISP"

  # Power
  if [[ -n "$Q_POWER" ]]; then
    printf "  ${C_YELLOW}%-14s${C_RESET}  %-42s  %s\n" "POWER" \
      "$(echo "$Q_POWER" | cut -d'|' -f1 | sed 's/^ *//;s/ *$//')" \
      "$(echo "$Q_POWER" | cut -d'|' -f2- | sed 's/^ *//;s/ *$//' | tr '|' '/')"
  fi

  # OS
  printf "  ${C_DIM}%-14s${C_RESET}  %-42s  %s\n" "OPERATING SYS" \
    "$(echo "$Q_OS" | cut -d'|' -f1 | sed 's/^ *//;s/ *$//')" \
    "$(echo "$Q_OS" | cut -d'|' -f2- | sed 's/^ *//;s/ *$//' | tr '|' '/')"

  printf "  ${C_DIM}%-14s  %-42s  %s${C_RESET}\n" "──────────────" "──────────────────────────────────────────" "────────────────────────────────────────────────"
  printf "\n"
fi

# ============================================================================
# VERDICT
# ============================================================================
section "VERDICT"
END_TS=$(date +%s); ELAPSED=$((END_TS - START_TS))

if [[ $JSON_OUT -eq 1 ]]; then
  exec 1>&3
  exec 3>&-
  printf '{"timestamp":"%s","hostname":"%s"' "$TIMESTAMP" "$HOSTNAME_SHORT"
  for f in "${JSON_FIELDS[@]}"; do printf ',%s' "$f"; done
  printf ',"warnings":%d,"critical":%d,"duration_s":%d}\n' "$WARNINGS" "$CRITICAL" "$ELAPSED"
else
  if (( CRITICAL > 0 )); then
    printf "  ${C_RED}${C_BOLD}CRITICAL${C_RESET}: %d critical, %d warnings\n" "$CRITICAL" "$WARNINGS"
  elif (( WARNINGS > 0 )); then
    printf "  ${C_YELLOW}${C_BOLD}WARNINGS${C_RESET}: %d warnings\n" "$WARNINGS"
  else
    printf "  ${C_GREEN}${C_BOLD}COMPLETE${C_RESET}: full spec report generated\n"
  fi
  printf "  ${C_DIM}Scan completed in %ds at %s${C_RESET}\n" "$ELAPSED" "$(date '+%H:%M:%S')"
  chart_findings
  echo ""
  printf "  ${C_DIM}Tip: run with ${C_BOLD}sudo${C_RESET} for full memory/BIOS/chassis details${C_RESET}\n"
  printf "  ${C_DIM}Tip: run with ${C_BOLD}--ai${C_RESET} for a compact key:value dump to paste into AI${C_RESET}\n"
  # Display one-liner explanations for any critical/warning issues logged
  show_verdict_one_liners
fi

if [[ "$JSON_OUT" != "1" ]] && declare -f run_comparison_finalize >/dev/null 2>&1; then run_comparison_finalize 2>/dev/null || true; fi

echo ""
if (( CRITICAL > 0 )); then exit 2
elif (( WARNINGS > 0 )); then exit 1
else exit 0
fi
