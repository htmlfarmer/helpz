section "DEVICE CATEGORY SUMMARY"

# Gather counts per category (best-effort from sysfs + tracked vars)
COUNT_CPU="${CPU_CPUS:-0}"
[[ -z "$CPU_CPUS" || "$CPU_CPUS" == "?" ]] && COUNT_CPU=0
[[ "$COUNT_CPU" =~ ^[0-9]+$ ]] || COUNT_CPU=0

# Memory devices: count populated DIMM slots if dmidecode was available;
# otherwise count memory blocks reported by the kernel (one per ~128MB section).
COUNT_MEM=0
if [[ -n "${NUM_POPULATED:-}" ]]; then
  COUNT_MEM=$(echo "$NUM_POPULATED" | grep -oE '[0-9]+' | head -1)
  [[ -z "$COUNT_MEM" ]] && COUNT_MEM=0
  [[ "$COUNT_MEM" =~ ^[0-9]+$ ]] || COUNT_MEM=0
fi
if (( COUNT_MEM == 0 )) && [[ -d /sys/devices/system/memory ]]; then
  COUNT_MEM=$(find /sys/devices/system/memory -maxdepth 1 -type d -name 'memory[0-9]*' 2>/dev/null | wc -l)
  # Memory blocks are per ~128MB section — collapse to a smaller-but-meaningful number
  COUNT_MEM=$(( (COUNT_MEM + 7) / 8 ))
fi

COUNT_GPU=${GPU_COUNT:-0}
[[ -z "$GPU_COUNT" ]] && COUNT_GPU=0

# Storage block devices (excluding loop/ram/sr)
COUNT_STORAGE=0
for d in /sys/block/*; do
  [[ -d "$d" ]] || continue
  n=$(basename "$d")
  [[ "$n" == loop* || "$n" == ram* || "$n" == sr* ]] && continue
  COUNT_STORAGE=$((COUNT_STORAGE + 1))
done

# Network interfaces (excluding lo)
COUNT_NET=0
for d in /sys/class/net/*; do
  [[ -d "$d" ]] || continue
  n=$(basename "$d")
  [[ "$n" == lo* ]] && continue
  COUNT_NET=$((COUNT_NET + 1))
done

COUNT_USB=${USB_COUNT:-0}

# Services / system daemons (top of inventory)
COUNT_SVC=0
if has_cmd systemctl; then
  COUNT_SVC=$(systemctl list-unit-files --state=enabled --type=service --no-legend 2>/dev/null | wc -l)
fi

# Chrome / Chromium renderer count + tabs estimate (renderer ≈ 4 tabs/site-isolation).
# Counts processes whose command line contains "--type=renderer" — portable across
# google-chrome, chromium, chromium-browser, msedge.
RENDERERS_TOTAL=0
RENDERERS_BREAKDOWN=""
if [[ -r /proc ]] && has_cmd ps; then
  while IFS= read -r browser; do
    [[ -z "$browser" ]] && continue
    cnt=$(ps -eo args= 2>/dev/null | grep -c -- "--type=renderer" | head -1 || echo 0)
    [[ -z "$cnt" || ! "$cnt" =~ ^[0-9]+$ ]] && cnt=0
    if (( cnt > 0 )); then
      tabs=$(( cnt / 4 ))
      RENDERERS_BREAKDOWN+="${C_DIM}${browser}:${C_RESET} ${C_BOLD}${cnt}${C_RESET} renderers ≈ ${tabs} tabs (÷4 site-isolation)  "
      RENDERERS_TOTAL=$((RENDERERS_TOTAL + cnt))
    fi
  done < <(ps -eo args= 2>/dev/null | grep -oE '/usr/(bin|lib)/?(google-)?(chrome|chromium|chromium-browser|msedge)' | sort -u)
fi
if (( RENDERERS_TOTAL > 0 )); then
  printf "  ${C_DIM}Browser renderers (site-isolation heuristic: 1 tab ≈ 4 renderers):${C_RESET}\n"
  printf "  %s\n" "$RENDERERS_BREAKDOWN"
fi

TOTAL_DEVICES=$(( COUNT_CPU + COUNT_MEM + COUNT_GPU + COUNT_STORAGE + COUNT_NET + COUNT_USB + COUNT_SVC ))
[[ $TOTAL_DEVICES -eq 0 ]] && TOTAL_DEVICES=1

printf "${C_BOLD}${C_CYAN}━━━ Devices per category (donut chart) ━━━${C_RESET}\n"
printf "  ${C_DIM}%d enabled systemd services · %d renderers (Chrome/Chromium/Edge)${C_RESET}\n\n" "$COUNT_SVC" "$RENDERERS_TOTAL"

donut_chart() {
  local title="$1"
  shift
  local total=0; local -a labels=() counts=()
  for rec in "$@"; do
    [[ -z "$rec" ]] && continue
    local lbl="${rec%%|*}" cnt="${rec##*|}"
    labels+=("$lbl"); counts+=("$cnt"); total=$(( total + cnt ))
  done
  [[ $total -eq 0 ]] && { printf "  ${C_DIM}No data${C_RESET}\n"; return; }
  printf "  ${C_BOLD}%-12s${C_RESET}\n" "$title"
  local colors=("$C_CYAN" "$C_GREEN" "$C_MAGENTA" "$C_YELLOW" "$C_BLUE" "$C_RED" "$C_DIM")
  local i
  for i in "${!labels[@]}"; do
    local pct=$(( counts[i] * 100 / total ))
    local arc=$(( counts[i] * 22 / total )); (( arc == 0 )) && arc=1
    local bar=""; for (( j=0; j<arc; j++ )); do bar+="█"; done
    local c="${colors[$(( i % 7 ))]}"
    printf "  ${c}%-12s${C_RESET} ${c}%-24s${C_RESET} ${C_BOLD}%3d${C_RESET} ${C_DIM}(%d%%)${C_RESET}\n" \
      "${labels[i]}" "$bar" "${counts[i]}" "$pct"
  done
  printf "  ${C_DIM}total devices = %d${C_RESET}\n" "$total"
}
donut_chart "Categories" \
  "CPU|${COUNT_CPU}" \
  "Memory|${COUNT_MEM}" \
  "GPU|${COUNT_GPU}" \
  "Storage|${COUNT_STORAGE}" \
  "Network|${COUNT_NET}" \
  "USB|${COUNT_USB}" \
  "Other|${COUNT_SVC}"

# ─── Systemd services (top 8 by unit type) with ExecStart + FragmentPath ──
if has_cmd systemctl; then
  subsec "Top enabled systemd services (ExecStart · FragmentPath)"
  printf "  ${C_DIM}%-32s %-44s %s${C_RESET}\n" "UNIT" "EXECSTART" "UNIT-FRAGMENT-PATH"
  printf "  ${C_DIM}%-32s %-44s %s${C_RESET}\n" "--------------------------------" "--------------------------------------------" "----------------------------------------"
  systemctl list-unit-files --state=enabled --type=service --no-legend 2>/dev/null \
    | awk '{print $1}' | head -8 | while IFS= read -r unit; do
      [[ -z "$unit" ]] && continue
      esc=$(systemctl show "$unit" -p ExecStart --value 2>/dev/null | sed 's/[{}\/]//g; s/^  *//; s/  *$//' | cut -c1-44)
      fr=$(systemctl show "$unit" -p FragmentPath --value 2>/dev/null)
      printf "  ${C_CYAN}%-32s${C_RESET} ${C_DIM}%-44s${C_RESET} ${C_DIM}%s${C_RESET}\n" \
        "$(echo "$unit" | cut -c1-32)" "$esc" "$(echo "$fr" | cut -c1-60)"
  done
fi

