section "UPGRADE PATH"

REC_NUM=0
rec() {
  REC_NUM=$((REC_NUM+1))
  if [[ $AI_MODE -eq 1 ]]; then
    printf "UPGRADE_%d: %s\n" "$REC_NUM" "$1"
  else
    printf "  ${C_CYAN}#${REC_NUM}${C_RESET} ${C_DIM}→${C_RESET} %s\n" "$1"
  fi
}

# Memory upgrade analysis
if [[ $HAVE_DMIDECODE -eq 1 && -n "$MAX_CAPACITY" && -n "$NUM_DEVICES" && -n "$NUM_POPULATED" ]]; then
  MAX_MB=$(echo "$MAX_CAPACITY" | grep -oE '[0-9]+' | head -1)
  MAX_UNIT=$(echo "$MAX_CAPACITY" | grep -oiE 'GB|MB|TB' | head -1)
  case "$MAX_UNIT" in
    TB) MAX_MB=$((MAX_MB * 1024 * 1024)) ;;
    GB) MAX_MB=$((MAX_MB * 1024)) ;;
  esac
  POP_NUM=$(echo "$NUM_POPULATED" | grep -oE '[0-9]+' | head -1)
  TOT_NUM=$(echo "$NUM_DEVICES" | grep -oE '[0-9]+' | head -1)
  FREE_SLOTS=$((TOT_NUM - POP_NUM))

  if (( FREE_SLOTS > 0 )); then
    rec "${C_GREEN}RAM:${C_RESET} ${C_BOLD}${FREE_SLOTS} free slot(s)${C_RESET} available — can add more memory (max total: ${MAX_CAPACITY})"
  else
    rec "${C_YELLOW}RAM:${C_RESET} All ${TOT_NUM} slots populated — must replace existing DIMMs to upgrade (max total: ${MAX_CAPACITY})"
  fi

  # Detect DDR type from first DIMM
  DDR_TYPE=$(dmi "memory" 2>/dev/null | awk '/^[[:space:]]*Type:/ && !/Detail|Error/ {sub(/^[^:]*:[[:space:]]*/, ""); print; exit}')
  if [[ -n "$DDR_TYPE" ]]; then
    rec "Current memory type: ${C_BOLD}${DDR_TYPE}${C_RESET} — any new DIMMs must match this type"
  fi
fi

# GPU upgrade
if [[ $HAVE_LSPCI -eq 1 ]]; then
  GPU_PCI_LINE=$(lspci 2>/dev/null | grep -iE 'VGA|3D' | grep -iv 'Intel' | head -1)
  [[ -z "$GPU_PCI_LINE" ]] && GPU_PCI_LINE=$(lspci 2>/dev/null | grep -iE 'VGA|3D|Display' | head -1)
  if [[ -n "$GPU_PCI_LINE" ]]; then
    GPU_DESC=$(echo "$GPU_PCI_LINE" | sed 's/^[^ ]* //' | sed 's/.*controller: //')
    rec "${C_MAGENTA}GPU:${C_RESET} Current: ${C_BOLD}${GPU_DESC}${C_RESET}"
    if [[ -n "$GPU_BDF" && -d "/sys/bus/pci/devices/0000:${GPU_BDF}" ]]; then
      GPU_MAX_SPD=$(cat "/sys/bus/pci/devices/0000:${GPU_BDF}/max_link_speed" 2>/dev/null)
      GPU_MAX_WID=$(cat "/sys/bus/pci/devices/0000:${GPU_BDF}/max_link_width" 2>/dev/null)
      if [[ -n "$GPU_MAX_SPD" && "$GPU_MAX_SPD" != "Unknown" ]]; then
        rec "GPU slot: ${C_BOLD}${GPU_MAX_SPD} x${GPU_MAX_WID}${C_RESET} — PCIe is backward/forward compatible"
      fi
    fi
    if [[ $HAVE_NVIDIA -eq 1 ]]; then
      rec "For GPU upgrade: check PSU wattage, physical slot size, and power connector requirements"
    fi
  else
    rec "${C_MAGENTA}GPU:${C_RESET} No discrete GPU — add a PCIe GPU if your motherboard has an x16 slot"
  fi
fi

# Storage upgrade
if [[ $HAVE_LSBLK -eq 1 ]]; then
  HAS_NVME=0
  HAS_SSD=0
  HAS_HDD=0
  for devdir in /sys/block/*; do
    [[ -d "$devdir" ]] || continue
    name=$(basename "$devdir")
    [[ "$name" == loop* || "$name" == ram* || "$name" == sr* ]] && continue
    size_sectors=$(cat "$devdir/size" 2>/dev/null)
    [[ -z "$size_sectors" || "$size_sectors" == "0" ]] && continue
    rot=$(cat "$devdir/queue/rotational" 2>/dev/null)
    if [[ "$name" == nvme* ]]; then HAS_NVME=1
    elif [[ "$rot" == "0" ]]; then HAS_SSD=1
    else HAS_HDD=1; fi
  done
  if (( HAS_HDD )); then
    rec "${C_GREEN}Storage:${C_RESET} HDD detected — upgrading to SSD/NVMe will dramatically improve performance"
  elif (( HAS_SSD && ! HAS_NVME )); then
    rec "${C_GREEN}Storage:${C_RESET} SSD detected — consider adding NVMe for even faster storage (check M.2 slot)"
  elif (( HAS_NVME )); then
    rec "${C_GREEN}Storage:${C_RESET} NVMe present — add more drives if M.2/SATA slots available"
  fi
fi

# Network upgrade
if [[ -z "$WIFI_IFACE" ]]; then
  rec "${C_BLUE}Network:${C_RESET} No Wi-Fi — add a USB or PCIe Wi-Fi adapter for wireless"
fi
if [[ -n "$ETH_SPEED" ]] && (( ETH_SPEED < 1000 )); then
  rec "${C_BLUE}Network:${C_RESET} Ethernet at ${ETH_SPEED} Mbps — upgrade NIC or cable for Gigabit"
fi

# Bluetooth
if [[ $BT_FOUND -eq 0 ]]; then
  rec "${C_BLUE}Bluetooth:${C_RESET} No Bluetooth detected — add a USB Bluetooth 5.x adapter"
fi

# General
rec "${C_YELLOW}PSU:${C_RESET} Check your power supply wattage before adding GPU or drives"
rec "${C_YELLOW}BIOS:${C_RESET} Update BIOS before major hardware changes for best compatibility"

