section "LISTENING SERVICES"

LISTEN_OUT=$(run ss -tulnp 2>/dev/null || run netstat -tulnp 2>/dev/null)
if [[ -n "$LISTEN_OUT" ]]; then
  # Count by protocol
  TCP_COUNT=$(printf '%s\n' "$LISTEN_OUT" | grep -cE '^tcp' 2>/dev/null || echo 0)
  UDP_COUNT=$(printf '%s\n' "$LISTEN_OUT" | grep -cE '^udp' 2>/dev/null || echo 0)
  TOTAL=$((TCP_COUNT + UDP_COUNT))
  info "Total listeners: ${C_BOLD}${C_CYAN}$TOTAL${C_RESET}  (TCP: ${C_BOLD}$TCP_COUNT${C_RESET}, UDP: ${C_BOLD}$UDP_COUNT${C_RESET})"

  # Histogram of listening ports by service
  subsec "Top listening services"
  printf '%s\n' "$LISTEN_OUT" | grep -oE ':[0-9]+[[:space:]]' | sort | uniq -c | sort -rn | head -10 | \
    while read -r count port; do
      portnum="${port//[!0-9]/}"
      service=$(getent services "$portnum" 2>/dev/null | awk '{print $1}' | head -1)
      [[ -z "$service" ]] && service="unknown"
      printf "  ${C_DIM}%-4s${C_RESET} ${C_CYAN}%-15s${C_RESET} %s\n" "$count" "port $portnum" "$service"
    done
else
  warn "Could not enumerate listening sockets (needs root for full view)"
fi

# ============================================================================
# SECTION 8: Active connections
# ============================================================================
section "ACTIVE CONNECTIONS"

CONN_OUT=$(run ss -tan state established 2>/dev/null || run netstat -tan 2>/dev/null | grep ESTABLISHED)
if [[ -n "$CONN_OUT" ]]; then
  TOTAL_CONN=$(printf '%s\n' "$CONN_OUT" | grep -cE 'ESTAB|tcp' || echo 0)
  info "Established: ${C_BOLD}${C_CYAN}$TOTAL_CONN${C_RESET}"

  subsec "Top remote peers"
  printf '%s\n' "$CONN_OUT" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(:[0-9]+)?' | \
    awk '{print $1}' | sort | uniq -c | sort -rn | head -10 | \
    while read -r count ip; do
      # Skip local
      if [[ "$ip" =~ ^(127\.|0\.0\.0\.0|192\.168\.|10\.|172\.(1[6-9]|2[0-9]|3[01])\.|169\.254\.) ]]; then
        continue
      fi
      printf "  ${C_DIM}%-4s${C_RESET} ${C_CYAN}%-22s${C_RESET}\n" "$count" "$ip"
    done
else
  info "No established connections"
fi

# Connection state histogram (visual)
subsec "Connection state distribution"
STATE_DATA=$(run ss -tan 2>/dev/null | grep -oE '\b(LISTEN|ESTAB|TIME-WAIT|CLOSE-WAIT|FIN-WAIT|CLOSING|LAST-ACK|SYN-SENT|SYN-RECV|NONE)\b' | sort | uniq -c | sort -rn)
if [[ -n "$STATE_DATA" ]]; then
  STATE_TOTAL=$(printf '%s\n' "$STATE_DATA" | awk '{s+=$1} END {print s}')
  printf "  ${C_BOLD}%-15s %8s   %s${C_RESET}\n" "State" "Count" "Distribution"
  printf "  ${C_DIM}%-15s %8s   %s${C_RESET}\n" "-----" "-----" "------------"
  while read -r count state; do
    pct=$(( count * 100 / (STATE_TOTAL > 0 ? STATE_TOTAL : 1) ))
    printf "  ${C_BOLD}%-15s${C_RESET} ${C_DIM}%8d${C_RESET}   %s\n" \
      "$state" "$count" "$(hbar $pct 30)"
  done <<< "$STATE_DATA"
fi

# ============================================================================
# SECTION 9: Packet sniff (optional)
# ============================================================================
section "PACKET SNIFF"

if [[ $SNIFF_SECS -gt 0 ]]; then
  if ! command -v tcpdump >/dev/null 2>&1; then
    crit "tcpdump not installed"
  elif [[ -z "$SUDO" && $EUID -ne 0 ]]; then
    crit "Sniff requires root/sudo"
  else
    # Resolve interface if not given
    SNIFF_TARGET="${SNIFF_IFACE:-$IFACE}"
    if [[ -z "$SNIFF_TARGET" ]]; then
      SNIFF_TARGET=$(ip route show default 2>/dev/null | awk 'NR==1 {for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}')
    fi
    if [[ -z "$SNIFF_TARGET" ]]; then
      warn "No interface for sniff - use --iface"
    else
      PCAP="/tmp/network_sniff_$(date +%s).pcap"
      info "Capturing ${C_BOLD}${SNIFF_SECS}s${C_RESET} on ${C_BOLD}${C_CYAN}${SNIFF_TARGET}${C_RESET}"
      info "Output: ${C_DIM}$PCAP${C_RESET}"
      printf "\n"
      $SUDO timeout "$SNIFF_SECS" tcpdump -i "$SNIFF_TARGET" -nn -c 100 \
        -w "$PCAP" 2>&1 | head -5 | sed 's/^/    /'
      echo ""
      if [[ -f "$PCAP" ]]; then
        ok "Capture saved to $PCAP"
        PCAP_SIZE=$(stat -c%s "$PCAP" 2>/dev/null)
        info "Size: ${C_BOLD}$(numfmt --to=iec --suffix=B "$PCAP_SIZE" 2>/dev/null || echo "${PCAP_SIZE}B")${C_RESET}"
        subsec "Top talkers (from capture)"
        $SUDO tcpdump -nn -r "$PCAP" 2>/dev/null | awk '{print $3}' | \
          grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | sort | uniq -c | sort -rn | head -8 | \
          while read -r count ip; do
            printf "  ${C_DIM}%-4s${C_RESET} ${C_CYAN}%-22s${C_RESET}\n" "$count" "$ip"
          done
        subsec "Top protocols"
        $SUDO tcpdump -nn -r "$PCAP" 2>/dev/null | awk '{print $2}' | sort | uniq -c | sort -rn | head -5 | \
          while read -r count proto; do
            printf "  ${C_DIM}%-4s${C_RESET} ${C_BOLD}%-15s${C_RESET}\n" "$count" "$proto"
          done
      fi
    fi
  fi
else
  info "${C_DIM}Skipped (no --sniff flag)${C_RESET}"
  info "Run ${C_BOLD}./networkz --sniff 30${C_RESET} to capture 30s on the default interface"
  info "Run ${C_BOLD}./networkz --sniff 5 -i wlx...${C_RESET} for a specific interface"
fi

# ============================================================================
# SECTION 10: MTU / Path
# ============================================================================
section "MTU & PATH"

MTU_V4=$(ip route show default 2>/dev/null | grep -oE 'mtu [0-9]+' | awk '{print $2}' | head -1)
[[ -z "$MTU_V4" ]] && MTU_V4="1500 (default)"
info "Default interface MTU: ${C_BOLD}${C_CYAN}$MTU_V4${C_RESET}"

# IPv4 connectivity check — fire all four MTU probes in parallel,
# then pick the largest one that succeeded (saves up to 6s worst case).
MTU_TMP=$(mktemp -d)
declare -a _MTU_PIDS=()
declare -A _MTU_OK=()
for SIZE in 1472 1464 1400 1280; do
    ( run ping -c 1 -W 2 -M do -s "$SIZE" 8.8.8.8 >/dev/null 2>&1 \
        && echo "$SIZE" > "$MTU_TMP/$SIZE" ) &
    _MTU_PIDS+=($!)
done
for pid in "${_MTU_PIDS[@]}"; do wait "$pid" 2>/dev/null; done
if [[ -s "$MTU_TMP/1472" ]]; then
    ok "MTU 1500 path (standard Ethernet)"
elif [[ -s "$MTU_TMP/1464" ]]; then
    ok "MTU 1492 path (PPPoE)"
elif [[ -s "$MTU_TMP/1400" ]]; then
    ok "MTU 1428 path (VPN/tunnel)"
elif [[ -s "$MTU_TMP/1280" ]]; then
    ok "MTU 1300 path (IPv6 minimum)"
else
    warn "Path MTU discovery failing - possible fragmentation issues"
fi
rm -rf "$MTU_TMP"

# IPv6 check
if run ping -6 -c 1 -W 2 2606:4700:4700::1111 >/dev/null 2>&1; then
  ok "IPv6 reachable (Cloudflare)"
else
  info "${C_DIM}IPv6 not reachable or disabled${C_RESET}"
fi

# ============================================================================
# SECTION 11: Recommendations
# ============================================================================
section "RECOMMENDATIONS"

REC_NUM=0
rec() { REC_NUM=$((REC_NUM+1)); printf "  ${C_CYAN}#${REC_NUM}${C_RESET} ${C_DIM}→${C_RESET} %s\n" "$1"; }

# Generate recommendations based on findings
[[ $PRIV_LEVEL == "no-sudo" ]] && rec "Re-run with sudo for full visibility (listening PIDs, packet capture)"

if (( CRITICAL > 0 )); then
  rec "${C_RED}${C_BOLD}Address critical issues first${C_RESET} - internet may be impaired"
fi

if (( WARNINGS > 3 )); then
  rec "Many warnings - review section by section"
fi

# If speed is slow
if [[ -n "$MAX_SPEED" ]] && is_lt "$MAX_SPEED" 10; then
  rec "Bandwidth below 10 Mbps — check with ISP or re-test with a bigger pull: ${C_BOLD}curl -o /dev/null https://speed.cloudflare.com/__down?bytes=100000000${C_RESET}"
fi

# Multiple defaults
# strip any trailing newlines from numeric vars
DEFAULT_COUNT=${DEFAULT_COUNT//[!0-9]/}
DEFAULT_COUNT=${DEFAULT_COUNT:-0}
TOTAL_CONN=${TOTAL_CONN//[!0-9]/}
TOTAL_CONN=${TOTAL_CONN:-0}

if (( DEFAULT_COUNT > 1 )); then
  rec "Multiple default routes detected - verify which is preferred (lower metric)"
fi

# High connection count
if (( TOTAL_CONN > 200 )); then
  rec "$TOTAL_CONN established connections - check for runaway apps with ${C_BOLD}ss -tanp | grep <pid>${C_RESET}"
fi

# Always-available suggestions
rec "Test from another device to isolate (this-box vs ISP issues)"
rec "Capture with ${C_BOLD}./networkz --sniff 60 -i ${IFACE:-eth0}${C_RESET} for deeper analysis"
rec "Check ${C_BOLD}/etc/resolv.conf${C_RESET} if DNS is slow (use 1.1.1.1 or 8.8.8.8)"

# ============================================================================
# VERDICT
# ============================================================================
DURATION=$(($(date +%s) - START_TS))

if [[ $JSON_OUT -eq 0 ]]; then
  printf "\n${C_BOLD}${C_BLUE}━━━ VERDICT ━━━${C_RESET}\n"
  if (( CRITICAL > 0 )); then
    printf "  ${C_RED}${C_BOLD}CRITICAL${C_RESET}: %d critical, %d warnings\n" "$CRITICAL" "$WARNINGS"
    printf "  ${C_RED}Network impaired - investigate the flagged issues${C_RESET}\n"
  elif (( WARNINGS > 0 )); then
    printf "  ${C_YELLOW}${C_BOLD}WARNING${C_RESET}: %d warnings, no critical issues\n" "$WARNINGS"
    printf "  ${C_YELLOW}Network usable but review above${C_RESET}\n"
  else
    printf "  ${C_GREEN}${C_BOLD}HEALTHY${C_RESET}: no issues detected\n"
    printf "  ${C_GREEN}Network looks solid${C_RESET}\n"
  fi
  printf "\n${C_DIM}Scan completed in ${DURATION}s at $(date '+%H:%M:%S')${C_RESET}\n"

  # Display one-liner explanations for any critical/warning issues logged
  show_verdict_one_liners
else
  # JSON output
  exec 1>&3
  exec 3>&-
  printf '{"timestamp":"%s","hostname":"%s","public_ip":"%s","iface":"%s","warnings":%d,"critical":%d,"duration_s":%d,"priv":"%s"}\n' \
    "$TIMESTAMP" "$HOSTNAME_SHORT" "${PUBLIC_IP:-}" "$IFACE" \
    "$WARNINGS" "$CRITICAL" "$DURATION" "$PRIV_LEVEL"
fi

# ---------- AI verdict (opt-in via --ai) ----------
if [[ "${AI_VERDICT:-}" == "1" ]]; then
    _NW_SUMMARY="iface=$IFACE warnings=$WARNINGS critical=$CRITICAL duration=${DURATION}s public_ip=${PUBLIC_IP:-?}"
    ai_emit_verdict "top_issue" "$_NW_SUMMARY" 2>/dev/null || true
fi

# Finalize and generate comparison report
if [[ "$JSON_OUT" != "1" ]]; then
    run_comparison_finalize
fi

# Exit code
if (( CRITICAL > 0 )); then exit 2
elif (( WARNINGS > 0 )); then exit 1
else exit 0
fi
