section_snapshot() {
    section "KERNEL SNAPSHOT"
    local arch up
    arch=$(uname -m)
    up=$(uptime -p 2>/dev/null || uptime | sed 's/^ *//')
    printf "  ${C_BOLD}Running:${C_RESET}      Linux %s (%s) — package %s %s%s\n" \
        "$REL" "$arch" "${CUR_PKG:-unknown}" "$CUR_VER" "$( [[ $CUR_HELD -eq 1 ]] && printf ' [HELD]' )"
    printf "  ${C_DIM}Built:${C_RESET}        %s\n" "$(uname -v)"
    printf "  ${C_DIM}Uptime:${C_RESET}       %s\n" "$up"
    printf "  ${C_DIM}Cmdline:${C_RESET}      %s\n" "$(cat /proc/cmdline 2>/dev/null)"
    add_json_field kernel_release "$REL"
    add_json_field kernel_package "${CUR_PKG:-}"
    add_json_field kernel_version "$CUR_VER"
    add_json_field kernel_held "$([[ $CUR_HELD -eq 1 ]] && echo true || echo false)" 1

    subsec "Installed kernels"
    local pkg ver stat mark
    while IFS=$'\t' read -r pkg ver stat; do
        mark=""
        [[ "$pkg" == "$CUR_PKG" ]] && mark=" ${C_BOLD}${C_GREEN}◀ running${C_RESET}"
        [[ "$stat" == h* ]] && mark="$mark ${C_MAGENTA}[held]${C_RESET}"
        printf "  %-32s %-16s %s%b\n" "$pkg" "$ver" "$stat" "$mark"
    done < <(installed_image_pkgs)

    subsec "Available in repositories"
    if [[ -n "$META_CAND" ]]; then
        add_json_field meta_package "$META_PKG"
        add_json_field apt_candidate "$META_CAND"
        if [[ $UPDATE -eq 1 ]]; then
            printf "  ${C_MAGENTA}${C_BOLD}UPDATE AVAILABLE${C_RESET}  %s → %s  (via %s)\n" "$CUR_VER" "$META_CAND" "$META_PKG"
            printf "  ${C_DIM}Next: %s upgrade   (safe, with GRUB fallback)${C_RESET}\n" "${0##*/}"
        elif ver_ge "$CUR_VER" "$META_CAND"; then
            printf "  ${C_GREEN}Up to date${C_RESET} — running %s ≥ repo candidate %s\n" "$CUR_VER" "$META_CAND"
            [[ $IN_REPO -eq 0 ]] && printf "  ${C_DIM}Note: %s is a custom kernel not tracked by %s; repo max is %s${C_RESET}\n" "$CUR_PKG" "$META_PKG" "$META_CAND"
        fi
        printf "  ${C_DIM}Headers:  ${HDR_PKG:-n/a} → ${HDR_CAND:-n/a}${C_RESET}\n"
        printf "  ${C_DIM}(this is apt's view — the BEST KERNEL section below is the tested one)${C_RESET}\n"
    else
        info "No kernel meta-package found in repositories"
    fi
    add_json_field update_available "$([[ $UPDATE -eq 1 ]] && echo true || echo false)" 1
}

section_grub() {
    section "BOOT LOADER (GRUB)"
    local mode gdefault cfg nentries gv
    gv=$(dpkg-query -W -f='${Version}' grub-efi-amd64 2>/dev/null || dpkg-query -W -f='${Version}' grub-pc 2>/dev/null || echo '?')
    [[ -d /sys/firmware/efi ]] && mode="UEFI (grub $gv)" || mode="BIOS/Legacy (grub $gv)"
    gdefault=$(grep -E '^GRUB_DEFAULT=' /etc/default/grub 2>/dev/null | cut -d= -f2- | tr -d '"')
    printf "  ${C_DIM}Mode:${C_RESET}    %s\n" "$mode"
    printf "  ${C_DIM}Default:${C_RESET} GRUB_DEFAULT=%s\n" "${gdefault:-<unset>}"
    add_json_field boot_mode "$([[ -d /sys/firmware/efi ]] && echo efi || echo bios)"
    add_json_field grub_default "${gdefault:-unset}"

    if grub-editenv /boot/grub/grubenv list 2>/dev/null | grep -qE '^(saved_entry|next_entry)='; then
        grub-editenv /boot/grub/grubenv list 2>/dev/null | grep -E '^(saved_entry|next_entry)=' \
            | while IFS= read -r l; do info "$l"; done
    fi

    cfg=$(read_grubcfg)
    if [[ -z "$cfg" ]]; then
        info "/boot/grub/grub.cfg needs root (mode 600) — run 'sudo ./kernelz' for per-kernel entry check"
        nentries=$(ls /boot/vmlinuz-* 2>/dev/null | wc -l)
        printf "  ${C_DIM}Kernels present in /boot:${C_RESET} %s\n" "$nentries"
        return 0
    fi
    nentries=$(grub_entries "$cfg" | wc -l)
    printf "  ${C_DIM}Menu entries:${C_RESET}     %s\n" "$nentries"
    local rel id
    while read -r rel; do
        [[ -z "$rel" ]] && continue
        read -r -a toks <<< "$(entry_tokens "$rel")"
        if id=$(grub_entry_id_for "$cfg" "${toks[@]}"); then
            ok "kernel $rel → entry $id"
        else
            critf "GrubEntry" "No GRUB menu entry for installed kernel $rel" "sudo update-grub"
        fi
    done < <(ls /boot/vmlinuz-* 2>/dev/null | sed 's|.*/vmlinuz-||')
}

# ============================================================================
# BEST KERNEL — what you run vs what you should be running
# ----------------------------------------------------------------------------
# The rule: NOT the very latest (it just landed, it is untested), but the
# newest kernel that has had time to bake — and not the long-term branch
# unless nothing else is on offer.
# ============================================================================
section_best() {
    ensure_best
    section "BEST KERNEL — what you run vs what you should run"
    if ! declare -f kb_recommend >/dev/null 2>&1; then
        info "kernelbest module unavailable — skipping the comparison"
        return 0
    fi
    if [[ -z "$KB_BEST_PKG" ]]; then
        info "no kernel images found in the repositories — nothing to compare against"
        add_json_field kernel_best_version ""
        return 0
    fi

    local kzl
    kzl() { printf "  ${C_DIM}%-15s${C_RESET} %s\n" "$1" "$2"; }

    # ---- what you are running ----
    local rser rup rdate rnote reol
    rser=$(kb_running_series)
    rup=$(kb_running_upstream)
    reol=$(kb_series_is_eol "$rser")
    kzl "Running" "${C_BOLD}$REL${C_RESET}${rser:+  (series $rser)}"
    if [[ -n "$rup" ]]; then
        rdate=$(kb_upstream_date "$rup") || rdate=""
        if [[ -n "$rdate" ]]; then
            kzl "Upstream build" "$rup · released $(kb_fmt_date "$rdate") · $(kb_fmt_age "$rdate") old"
        else
            kzl "Upstream build" "$rup · release date unknown"
        fi
    else
        kzl "Upstream build" "not an upstream release number — custom/local kernel"
    fi
    if [[ "$reol" == "1" ]]; then
        kzl "Series state" "${C_RED}${C_BOLD}END-OF-LIFE${C_RESET} — upstream no longer fixes series $rser"
        warnf "KernelEOL" "running series $rser is end-of-life upstream — no more security fixes will be published for it" \
            "move to a supported kernel: kernelz latest (newest upstream) · kernelz best (newest your distro ships)"
    elif [[ -n "$rser" ]] && [[ "$(kb_series_is_lts "$rser")" == "1" ]]; then
        kzl "Series state" "long-term branch — supported for years, but not the newest"
    else
        kzl "Series state" "${C_GREEN}supported upstream${C_RESET}${rser:+ (series $rser)}"
    fi
    if [[ -n "$CUR_PKG" && $IN_REPO -eq 0 ]]; then
        kzl "Source" "${C_YELLOW}custom build${C_RESET} — your distro's security updates never reach it"
    elif [[ -n "$CUR_PKG" ]]; then
        kzl "Source" "distro package $CUR_PKG"
    fi
    printf "\n"

    # ---- upstream landscape ----
    if [[ "$KB_UPSTREAM_OK" -eq 1 ]]; then
        kzl "Upstream stable" "${C_BOLD}${KB_STABLE_VER:-?}${C_RESET} · released ${KB_STABLE_ISO:-?} · $(kb_fmt_age "$KB_STABLE_DATE") old"
        if [[ -n "$KB_LTS_LIST" ]]; then
            kzl "Long-term" "${C_DIM}${KB_LTS_LIST}${C_RESET}"
        fi
        printf "\n"
        # Does the distro package upstream's current stable branch at all?
        if [[ -n "$KB_STABLE_SER" ]]; then
            local i have=0
            for ((i = 0; i < ${#KB_C_SERIES[@]}; i++)); do
                [[ "${KB_C_SERIES[i]}" == "$KB_STABLE_SER" ]] && { have=1; break; }
            done
            if (( have == 0 )); then
                local sage; sage=$(kb_series_age_days "$KB_STABLE_SER" 2>/dev/null || echo 0)
                if (( sage >= KB_SETTLE_DAYS )); then
                    warnf "KernelGap" "your distro does not package upstream's current stable branch ($KB_STABLE_SER, open ${sage} days)" \
                        "take the newest: ${0##*/} latest (apt if the distro ships it, source build if not — same GRUB safety net)"
                else
                    info "your distro does not package upstream's current stable branch ($KB_STABLE_SER) yet — it opened ${sage} day(s) ago"
                fi
            fi
        fi
    else
        info "upstream release table unavailable (offline?) — using repository data only"
        printf "\n"
    fi

    # ---- what the repositories offer ----
    local rows=() i
    for ((i = 0; i < ${#KB_C_PKG[@]}; i++)); do
        rows+=("$(printf '%s\t%s\t%s\t%s\t%s\t%s' "${KB_C_TIER[i]}" "${KB_C_DATE[i]:-0}" "${KB_C_PKG[i]}" "${KB_C_VER[i]}" "${KB_C_SERIES[i]}" "${KB_C_NOTE[i]}")")
    done
    if [[ ${#rows[@]} -gt 0 ]]; then
        subsec "Kernels available in your repositories"
        printf "  ${C_DIM}%-5s %-30s %-14s %-6s %-6s %-11s %-9s %s${C_RESET}\n" \
            "tier" "package" "version" "series" "branch" "released" "age" "note"
        while IFS=$'\t' read -r t d pkg ver ser note; do
            local mark="" col="$C_DIM"
            [[ "$pkg" == "$KB_BEST_PKG" && "$ver" == "$KB_BEST_VER" ]] && { mark=" ${C_GREEN}${C_BOLD}★ recommended${C_RESET}"; col="$C_GREEN"; }
            [[ "$pkg" == "$KB_NEW_PKG" && "$ver" == "$KB_NEW_VER" ]] && [[ -z "$mark" ]] && mark=" ${C_YELLOW}(newest in repos)${C_RESET}"
            local age="unknown" released="unknown"
            if [[ "$d" =~ ^[0-9]+$ ]] && (( d > 0 )); then
                age=$(kb_fmt_age "$d"); released=$(kb_fmt_date "$d")
            fi
            printf "  %-5s ${col}%-30s %-14s %-6s %-6s %-11s %-9s${C_RESET} %-30s%b\n" \
                "$t" "$pkg" "$ver" "$ser" \
                "$( [[ "$(kb_series_is_lts "$ser")" == "1" ]] && echo "LTS" || echo "stable" )" \
                "$released" "$age" "$note" "$mark"
        done < <(printf '%s\n' "${rows[@]}" | sort -t$'\t' -k1,1n -k2,2nr | head -8)
        [[ ${#rows[@]} -gt 8 ]] && info "$(( ${#rows[@]} - 8 )) older candidate(s) not shown"
        printf "\n"
    fi

    # ---- the verdict ----
    # The headline is the TARGET (what an upgrade will install). The distro's
    # own pick is shown underneath as the fallback it would use instead.
    local tierlbl
    tierlbl=$(kb_tier_label "$KB_BEST_TIER")
    local bage; bage=$(kb_series_age_days "$KB_BEST_SERIES" 2>/dev/null || echo "")
    if kb_plan_target; then
        if [[ "$KB_PLAN_ROUTE" == "build" ]]; then
            printf "  ${C_BOLD}${C_BLUE}TARGET${C_RESET}        ${C_BOLD}${KB_PLAN_VER}${C_RESET}  ${C_DIM}(series ${KB_PLAN_SERIES})${C_RESET}\n"
            printf "  ${C_DIM}route:${C_RESET}       ${C_BOLD}built from source${C_RESET} ${C_DIM}— your distro does not package series ${KB_PLAN_SERIES}${C_RESET}\n"
        else
            printf "  ${C_BOLD}${C_BLUE}TARGET${C_RESET}        ${C_BOLD}${KB_PLAN_VER}${C_RESET}  ${C_DIM}(series ${KB_PLAN_SERIES}, via apt${KB_PLAN_UP:+, upstream $KB_PLAN_UP})${C_RESET}\n"
            printf "  ${C_DIM}route:${C_RESET}       ${C_BOLD}${KB_PLAN_PKG}${C_RESET} ${C_DIM}— installed by your distro, security-updated${C_RESET}\n"
        fi
    fi
    printf "  ${C_DIM}distro ships${C_RESET} ${KB_BEST_VER} ${C_DIM}(series ${KB_BEST_SERIES}) — ${tierlbl}${C_RESET}\n"
    case "$KB_BEST_TIER" in
        1)
            printf "      ${C_DIM}the newest regular stable kernel your distro ships — the %s branch${C_RESET}\n" "$KB_BEST_SERIES"
            printf "      ${C_DIM}has been out %s days, so it has had time to be tested${C_RESET}\n" "$bage"
            ;;
        2)
            printf "      ${C_DIM}the newest regular stable kernel your distro ships, but the %s branch${C_RESET}\n" "$KB_BEST_SERIES"
            printf "      ${C_DIM}only opened %s days ago — it settles in about %d more day(s)${C_RESET}\n" \
                "$bage" "$(( KB_SETTLE_DAYS - ${bage:-0} ))"
            ;;
        3)
            printf "      ${C_DIM}your distro ships no regular stable kernel, so this long-term branch is${C_RESET}\n"
            printf "      ${C_DIM}the newest thing here with a real track record${C_RESET}\n"
            ;;
    esac
    if [[ -n "$KB_STABLE_VER" && -n "$KB_STABLE_SER" && "$KB_BEST_SERIES" != "$KB_STABLE_SER" ]]; then
        local sage; sage=$(kb_series_age_days "$KB_STABLE_SER" 2>/dev/null || echo 0)
        if (( sage < KB_SETTLE_DAYS )); then
            printf "      ${C_DIM}upstream's newer stable branch %s (%s) opened only %d day(s) ago —${C_RESET}\n" \
                "$KB_STABLE_SER" "$KB_STABLE_VER" "$sage"
            printf "      ${C_DIM}it settles in about %d more day(s)${C_RESET}\n" "$(( KB_SETTLE_DAYS - sage ))"
        else
            printf "      ${C_DIM}upstream's newer stable branch %s (%s) opened %d day(s) ago —${C_RESET}\n" \
                "$KB_STABLE_SER" "$KB_STABLE_VER" "$sage"
            printf "      ${C_DIM}it is settled, so it is the target above${C_RESET}\n"
        fi
    fi
    printf "\n"

    # ---- are we actually behind? ----
    if [[ -z "$KB_BEST_VER" ]]; then
        :
    elif [[ "$KB_BEST_VER" == "$CUR_VER" && "$KB_BEST_PKG" == "$CUR_PKG" ]]; then
        printf "  ${C_GREEN}${C_BOLD}You are running the recommended kernel${C_RESET} ${C_DIM}($CUR_VER)${C_RESET}\n\n"
    elif series_gt "$KB_BEST_SERIES" "$rser"; then
        printf "  ${C_MAGENTA}${C_BOLD}UPGRADE SUGGESTED${C_RESET}  %s → %s   ${C_DIM}(series %s, %s old, %s)${C_RESET}\n" \
            "$CUR_VER" "$KB_BEST_VER" "$KB_BEST_SERIES" "$(kb_fmt_age "$KB_BEST_DATE")" "$(kb_tier_label "$KB_BEST_TIER")"
        printf "  ${C_DIM}Next: %s upgrade   (safe — the new kernel boots once, GRUB falls back)${C_RESET}\n\n" "${0##*/}"
    elif [[ "$KB_BEST_SERIES" == "$rser" ]]; then
        if ver_gt "$KB_BEST_VER" "$CUR_VER"; then
            printf "  ${C_MAGENTA}${C_BOLD}UPGRADE SUGGESTED${C_RESET}  %s → %s   ${C_DIM}(same series, %s old)${C_RESET}\n" \
                "$CUR_VER" "$KB_BEST_VER" "$(kb_fmt_age "$KB_BEST_DATE")"
            printf "  ${C_DIM}Next: %s upgrade   (safe — the new kernel boots once, GRUB falls back)${C_RESET}\n\n" "${0##*/}"
        else
            printf "  ${C_GREEN}You are ahead of the recommended kernel${C_RESET} ${C_DIM}(running $CUR_VER, recommended $KB_BEST_VER)${C_RESET}\n\n"
        fi
    else
        # The repos' best tested kernel belongs to an OLDER branch than the
        # one in use — that is the long-term fallback, not a step forward.
        printf "  ${C_YELLOW}${C_BOLD}OLDER BRANCH AVAILABLE${C_RESET}  your distro's tested kernel is %s (series %s) —\n" \
            "$KB_BEST_VER" "$KB_BEST_SERIES"
        printf "  ${C_DIM}an older branch than the %s you run. That is the long-term fallback, not a step forward.${C_RESET}\n" "$rser"
        printf "  ${C_DIM}Next: %s latest   (the newest upstream kernel — apt if the distro ships it, build if not)${C_RESET}\n\n" "${0##*/}"
    fi

    # ---- how to actually do it ----
    section_howto_upgrade

    # ---- JSON ----
    add_json_field kernel_best_package "$KB_BEST_PKG"
    add_json_field kernel_best_version "$KB_BEST_VER"
    add_json_field kernel_best_series "$KB_BEST_SERIES"
    add_json_field kernel_best_upstream "$KB_BEST_UP"
    add_json_field kernel_best_tier "$KB_BEST_TIER"
    add_json_field kernel_best_note "$KB_BEST_NOTE"
    add_json_field kernel_best_age_days "$(kb_age_days "$KB_BEST_DATE")" 1
    add_json_field kernel_newest_version "$KB_NEW_VER"
    add_json_field kernel_running_series "$rser"
    add_json_field kernel_running_upstream "$rup"
    add_json_field kernel_running_eol "$( [[ "$reol" == "1" ]] && echo true || echo false )" 1
    add_json_field kernel_upstream_stable "$KB_STABLE_VER"
    add_json_field kernel_upstream_stable_series "$KB_STABLE_SER"
    add_json_field kernel_upstream_stable_age_days "$(kb_age_days "$KB_STABLE_DATE")" 1
    add_json_field kernel_upstream_lts "$KB_LTS_LIST"
    add_json_field kernel_settle_days "$KB_SETTLE_DAYS" 1
}

# ============================================================================
# HOW TO UPGRADE — the exact commands, and what keeps apt from undoing it
# ============================================================================
section_howto_upgrade() {
    local cmd="${0##*/}"
    local path; path="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
    # sudo does not always inherit your PATH, so the copy-pasteable command
    # uses the absolute path; the short form is used when it resolves.
    local call="sudo $path"
    command -v "$cmd" >/dev/null 2>&1 && call="sudo $cmd"
    subsec "How to upgrade (copy-paste these)"

    # 1 — the upgrade itself
    printf "  ${C_BOLD}1.${C_RESET} install the tested kernel and arm the GRUB fallback:\n"
    printf "       ${C_CYAN}%s upgrade${C_RESET}\n" "$call"
    if [[ -n "$KB_BEST_PKG" ]]; then
        printf "       ${C_BOLD}→ will install:${C_RESET} %s %s   ${C_DIM}(series %s, %s old)${C_RESET}\n" \
            "$KB_BEST_PKG" "$KB_BEST_VER" "$KB_BEST_SERIES" "$(kb_fmt_age "$KB_BEST_DATE")"
        if [[ -n "$META_CAND" && "$KB_BEST_VER" != "$META_CAND" ]]; then
            printf "       ${C_DIM}→ NOT the repo's newest (%s) — that one is only %d day(s) old, still untested${C_RESET}\n" \
                "$META_CAND" "$(kb_age_days "$KB_NEW_DATE")"
        fi
    else
        printf "       ${C_DIM}(no recommended kernel found — the repos have nothing to install)${C_RESET}\n"
    fi
    printf "       ${C_DIM}the new kernel boots ONCE; if it fails, the next reboot lands back on %s${C_RESET}\n" "$REL"

    # 1b — the distro's pick is not always a step FORWARD: when it belongs to
    #      an older branch than the kernel already running, say so and point
    #      at the other route before the reader installs a downgrade.
    if [[ -n "$KB_BEST_SERIES" ]]; then
        local hser; hser=$(kb_running_series)
        if [[ -n "$hser" && "$KB_BEST_SERIES" != "$hser" ]] && ! series_gt "$KB_BEST_SERIES" "$hser"; then
            printf "       ${C_YELLOW}that is your distro's tested pick — but an OLDER branch than the %s you run.${C_RESET}\n" "$hser"
            printf "       ${C_DIM}want the newest upstream instead (apt when the distro ships that series,\n"
            printf "       ${C_DIM}source build when it does not — same GRUB fallback)?${C_RESET}\n"
            printf "       ${C_CYAN}%s latest${C_RESET}\n" "$call"
        fi
    fi

    # 2 — reboot
    printf "  ${C_BOLD}2.${C_RESET} reboot into it:\n"
    printf "       ${C_CYAN}sudo reboot${C_RESET}\n"

    # 3 — promote it
    printf "  ${C_BOLD}3.${C_RESET} after the reboot, promote it to the permanent default:\n"
    printf "       ${C_CYAN}%s verified${C_RESET}   ${C_DIM}(only after the new kernel proved healthy)${C_RESET}\n" "$call"
    printf "       ${C_DIM}until this runs the new kernel boots ONLY ONCE — the next reboot goes${C_RESET}\n"
    printf "       ${C_DIM}back to %s. 'kernelz' will offer to promote it for you.${C_RESET}\n" "$REL"

    # 4 — the same steps without the wrapper
    printf "\n  ${C_BOLD}Doing it by hand instead?${C_RESET}\n"
    printf "       ${C_DIM}sudo apt-get install -y %s${C_RESET}\n" "${KB_BEST_PKG:-$META_PKG}"
    printf "       ${C_DIM}sudo update-grub && sudo grub-reboot \"Advanced options for ...\"${C_RESET}\n"
    printf "       ${C_DIM}(kernelz does this for you, and records the known-good kernel first)${C_RESET}\n"

    # 5 — keeping apt from undoing any of it
    printf "\n  ${C_BOLD}Keeping a later 'sudo apt upgrade' from undoing that:${C_RESET}\n"
    printf "       ${C_CYAN}%s protect${C_RESET}   ${C_DIM}(meta-package + apt-mark manual/hold + removal proof)${C_RESET}\n" "$call"
    printf "       ${C_DIM}%s upgrade already runs protect for you — you only need it${C_RESET}\n" "$cmd"
    printf "       ${C_DIM}when you install a kernel by hand.${C_RESET}\n"

    # what protect actually guarantees
    local removed
    printf "\n  ${C_DIM}What that buys you:${C_RESET}\n"
    if [[ "$PKG_MGR" == deb ]]; then
        removed=$(kernels_apt_would_remove)
        printf "       ${C_DIM}· the kernel meta-package stays installed, so apt keeps tracking kernels${C_RESET}\n"
        printf "       ${C_DIM}· every installed kernel is marked 'manual' — autoremove cannot reap it${C_RESET}\n"
        printf "       ${C_DIM}· out-of-repo kernels are 'hold' — upgrade/full-upgrade/autoremove skip them${C_RESET}\n"
        if [[ -n "$removed" ]]; then
            printf "       ${C_YELLOW}· apt currently plans to remove: %s — 'protect' holds these${C_RESET}\n" "$(tr '\n' ' ' <<< "$removed")"
        else
            printf "       ${C_GREEN}· simulation: apt's upgrade, full-upgrade and autoremove would remove NO kernel${C_RESET}\n"
        fi
    else
        removed=""
        printf "       ${C_DIM}· the kernel meta-package stays installed, so %s keeps tracking kernels${C_RESET}\n" "${PKG_UPGRADE_CMD##* }"
        printf "       ${C_DIM}· out-of-repo kernels are held (${PKG_MGR}: %s) — upgrades skip them${C_RESET}\n" \
            "$( [[ "$PKG_MGR" == pacman ]] && printf 'IgnorePkg' || printf 'versionlock' )"
        printf "       ${C_DIM}· 'protect' also proves the GRUB menu still boots every installed kernel${C_RESET}\n"
    fi
    printf "\n"
}

# ============================================================================
# NETWORK SAFETY — will this box still be reachable after the reboot?
# ----------------------------------------------------------------------------
# On a remote box the network IS the lifeline: if the new kernel cannot drive
# the NIC that carries your default route, the machine comes back and you
# cannot reach it. Most NIC drivers are in-tree and therefore always present,
# but some are not: Realtek's r8168 and most USB wireless dongles live in
# DKMS and have to be REBUILT for every kernel. A box whose only route runs
# over such a driver loses the network on the next boot if the rebuild is
# missing. So: find the lifeline, find its driver, and prove the driver
# exists for the kernel we are about to boot.
# ============================================================================
section_network_safety() {   # section_network_safety [target_release]
    local target="${1:-}"
    section "NETWORK SAFETY · will this box still be online after the reboot?"

    # The interface that carries the default route is the lifeline.
    local lifeline
    lifeline=$(ip route show default 2>/dev/null \
               | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
    if [[ -n "$lifeline" ]]; then
        printf "    ${C_BOLD}lifeline${C_RESET}  %s %s\n" "$lifeline" \
            "${C_DIM}(carries the default route — this is what keeps you connected)${C_RESET}"
    else
        printf "    ${C_YELLOW}!${C_RESET} no default route found — check the network before rebooting\n"
    fi

    local any=0 lif_ok=1 target_ok=1
    local i n drv kind target_ok_one is_life
    local dkms_list
    dkms_list=$(timeout 20 dkms status 2>/dev/null | awk '{print $1}' | sort -u)
    for i in /sys/class/net/*; do
        n="${i##*/}"
        [[ "$n" == "lo" ]] && continue
        case "$n" in docker*|br-*|veth*|virbr*|cni*|flannel*|cali*|kube*|tun*|tap*|sit*|gre*|ip6tnl*|erspan*) continue ;; esac
        [[ -e "$i/device" || -d "$i/wireless" ]] || continue
        drv=$(basename "$(readlink -f "$i/device/driver" 2>/dev/null)" 2>/dev/null)
        [[ -z "$drv" ]] && continue
        any=1
        kind="wired"
        [[ -d "$i/wireless" ]] && kind="wireless"
        is_life=0
        [[ "$n" == "$lifeline" ]] && is_life=1

        printf "    %-9s %-8s driver %-14s" "$n" "$kind" "$drv"
        if printf '%s\n' "$dkms_list" | grep -qx "$drv"; then
            printf " ${C_YELLOW}(DKMS — out-of-tree, rebuilt per kernel)${C_RESET}"
        else
            printf " ${C_DIM}(in-tree — present in every kernel)${C_RESET}"
        fi
        printf "\n"

        if [[ -n "$target" ]]; then
            if modinfo -k "$target" "$drv" >/dev/null 2>&1; then
                printf "              ${C_GREEN}✓${C_RESET} driver present for %s\n" "$target"
            else
                target_ok=0
                printf "              ${C_RED}✗${C_RESET} driver MISSING for %s — this interface dies on the new kernel${C_RESET}\n" "$target"
                (( is_life == 1 )) && lif_ok=0
            fi
        fi
    done
    (( any == 0 )) && info "no physical network interfaces found"

    # Wireless gets its own line: a box whose only link is wifi needs the
    # dongle's driver rebuilt just as much.
    local wifs
    wifs=$(ls -d /sys/class/net/*/wireless 2>/dev/null | sed 's|/wireless||')
    if [[ -z "$wifs" ]]; then
        printf "    ${C_DIM}wireless: none present${C_RESET}\n"
    else
        for i in $wifs; do
            printf "    ${C_DIM}wireless:${C_RESET} %s\n" "${i##*/}"
        done
    fi

    if [[ -n "$target" && ! -d "/lib/modules/$target" ]]; then
        printf "    ${C_DIM}%s is not installed yet — the driver check runs once it is on disk${C_RESET}\n\n" "$target"
        return 0
    fi
    if [[ -n "$target" ]] && (( lif_ok == 0 )); then
        warnf "NetworkSafety" "the NIC carrying your default route ($lifeline) has no driver for $target" \
            "you will LOSE NETWORK ACCESS after the reboot — build it first: sudo dkms autoinstall -k $target && sudo depmod -a $target"
    elif [[ -n "$target" ]] && (( target_ok == 0 )); then
        warnf "NetworkSafety" "a network driver in use is missing for $target" \
            "build it: sudo dkms autoinstall -k $target && sudo depmod -a $target"
    elif [[ -n "$target" ]]; then
        ok "every network driver in use is available for $target"
    fi
    printf "\n"
}

# ============================================================================
# GRAPHICS — will the display still work on the new kernel?
# ----------------------------------------------------------------------------
# A kernel that boots fine can still come up with no display, because the
# video driver was not carried over: the proprietary driver is a DKMS module
# (rebuilt per kernel), and on a hybrid laptop the display may be driven by
# the OTHER adapter. So: what is connected, what drives it, and will the new
# kernel have that driver?
# ============================================================================
KB_VIDEO_MODS="nvidia nvidia_drm amdgpu amdgpu_kms i915 nouveau radeon radeon_drm virtio_gpu vmwgfx ast mga qxl vboxvideo modesetting"

section_graphics() {   # section_graphics [target_release]
    local target="${1:-}"
    section "GRAPHICS · adapters, outputs and drivers"
    local adapters
    adapters=$(lspci 2>/dev/null | grep -iE "vga compatible controller|3d controller|display controller" | sed 's/^[0-9a-f:.]* //')
    if [[ -n "$adapters" ]]; then
        printf '%s\n' "$adapters" | sed 's/^/    /'
    else
        info "no display adapters reported by lspci"
    fi

    # which card drives what, and what is plugged in
    local card name drv conn mode connected=0
    # card[0-9] exactly — card0-HDMI-A-1 is a SYMLINK to card0 and would
    # otherwise be listed as a card of its own
    for card in /sys/class/drm/card[0-9]; do
        [[ -d "$card" ]] || continue
        name="${card##*/}"
        drv=$(basename "$(readlink -f "$card/device/driver" 2>/dev/null)" 2>/dev/null)
        printf "    ${C_BOLD}%-10s${C_RESET} driver: %s\n" "$name" "${drv:-unknown}"
        for conn in "$card"-*/status; do
            [[ -r "$conn" ]] || continue
            [[ "$(cat "$conn" 2>/dev/null)" == "connected" ]] || continue
            connected=1
            mode=$(head -1 "$(dirname "$conn")/modes" 2>/dev/null)
            printf "      ${C_GREEN}│${C_RESET} %-16s ${C_BOLD}connected${C_RESET}  %s\n" \
                "$(basename "$(dirname "$conn")")" "${mode:-mode unknown}"
        done
    done
    (( connected == 0 )) && info "no display output is currently connected"

    # the modules that are actually in use right now
    local loaded=""
    for m in $KB_VIDEO_MODS; do
        grep -qE "^$m " /proc/modules 2>/dev/null && loaded="$loaded $m"
    done
    if [[ -n "$loaded" ]]; then
        printf "    ${C_DIM}in use now:${C_RESET}%s\n" "$loaded"
    fi

    # will the new kernel have them?
    if [[ -n "$target" && ! -d "/lib/modules/$target" ]]; then
        printf "\n"
        info "$target is not installed yet — the driver check runs once it is on disk"
    elif [[ -n "$target" ]]; then
        printf "\n"
        local m ok_all=1
        for m in $KB_VIDEO_MODS; do
            grep -qE "^$m " /proc/modules 2>/dev/null || continue
            if modinfo -k "$target" "$m" >/dev/null 2>&1; then
                printf "    ${C_GREEN}✓${C_RESET} %-14s available for %s\n" "$m" "$target"
            else
                printf "    ${C_RED}✗${C_RESET} %-14s NOT available for %s\n" "$m" "$target"
                ok_all=0
            fi
        done
        if (( ok_all == 0 )); then
            warnf "VideoDriver" "a video driver in use is missing from $target — the display may come up black" \
                "rebuild it for the new kernel: sudo dkms autoinstall -k $target && sudo depmod -a $target"
        fi
    fi
    printf "\n"
}

# ============================================================================
# DKMS AUDIT — are the third-party modules built for THIS kernel?
# ----------------------------------------------------------------------------
# The proprietary drivers (nvidia and friends) are DKMS modules: they are
# compiled AGAINST one kernel and do not work on another. A new kernel
# without them boots to a black screen, or a desktop with no CUDA.
#
# This is the check that answers "will my GPU still work after the reboot?"
# — and it must run on BOTH routes:
#   * the apt route  (a distro kernel package)
#   * the build route (a kernel compiled from source)
# The apt route used to skip it entirely, so a machine with an NVIDIA card
# could be told "reboot now" while the driver for the new kernel was never
# built. That is exactly the failure this function now prevents.
#
# The kernel package's own postinst hook tries to build the modules, but it
# SILENTLY SKIPS when the matching headers package is not installed. So the
# check also asks: are the headers for THIS kernel present?
# ============================================================================
dkms_audit() {   # dkms_audit <target_release>
    local target="${1:-}"
    [[ -z "$target" ]] && return 0
    heading "── third-party modules (DKMS) for $target ──"

    if ! command -v dkms >/dev/null 2>&1; then
        info "dkms not installed — no third-party modules to rebuild"
        return 0
    fi

    local dk_all dk_new dk_missing
    dk_all=$(timeout 30 dkms status 2>/dev/null)
    dk_new=$(printf '%s\n' "$dk_all" | grep -F "$target" || true)
    # Per module: every DKMS module that exists for some other kernel
    # should exist for the new one too. nvidia is the one that matters.
    # "dkms status" prints "name/version, kernel, arch: state" - the
    # commas are part of the fields, so strip them before comparing.
    dk_missing=$(printf '%s\n' "$dk_all" | awk -v k="$target" '
        { gsub(/,/, "", $1); gsub(/,/, "", $2)
          mods[$1]=1; if ($2==k) built[$1]=1 }
        END { for (m in mods) if (!(m in built)) printf "%s ", m }')

    # The headers are what the module is compiled against. Without them the
    # package hook skips the build SILENTLY — this is why "it installed the
    # kernel but the GPU stopped working" happens.
    if [[ ! -d "/lib/modules/$target/build" ]]; then
        warnf "Headers" "the headers for $target are not installed" \
            "the DKMS modules cannot be built without them: sudo apt-get install linux-headers-$target"
    fi

    # Only modules that are actually IN USE matter. A DKMS module that
    # was skipped for this kernel (BUILD_EXCLUSIVE) is not a problem
    # unless something is using it right now.
    local dk_missing_inuse="" _m _base
    for _m in $dk_missing; do
        _base="${_m%%/*}"
        if grep -qE "^${_base} " /proc/modules 2>/dev/null; then
            dk_missing_inuse="${dk_missing_inuse} ${_m}"
        fi
    done
    if [[ -z "$dk_all" ]]; then
        info "dkms reports no modules at all"
    elif [[ -n "$dk_missing_inuse" ]]; then
        warnf "Dkms" "DKMS module(s) in use are not built for $target:${dk_missing_inuse}" \
            "build them now: sudo dkms autoinstall -k $target && sudo depmod -a $target"
        printf "      ${C_DIM}without them the box boots without that driver (black screen / no 3D / no CUDA)${C_RESET}\n"
    elif [[ -n "$dk_missing" ]]; then
        info "DKMS module(s) not built for $target:${dk_missing} — they are not in use, and DKMS skipped them"
        info "  (BUILD_EXCLUSIVE: the module does not apply to this kernel/config)"
    else
        ok "every DKMS module is built for $target:"
        printf '%s\n' "$dk_new" | sed "s|^|      ${C_DIM}│${C_RESET} |"
    fi

    # An "installed" DKMS module for the new kernel still has to have
    # produced its .ko — that is what the module loader actually needs.
    local ko_missing="" mod ver inst
    while read -r mod ver inst; do
        [[ -z "$mod" ]] && continue
        [[ "$inst" != "installed" ]] && continue
        [[ "$ver" != "$target" ]] && continue
        if ! ls /lib/modules/"$target"/updates/dkms/"$mod"*.ko >/dev/null 2>&1; then
            ko_missing="$ko_missing $mod"
        fi
    done < <(dkms status 2>/dev/null | awk '{print $1, $2, $3}')
    if [[ -n "$ko_missing" ]]; then
        warnf "Dkms" "DKMS module(s) installed but no .ko in /lib/modules/$target/updates/dkms/:${ko_missing}" \
            "rebuild them: sudo dkms autoinstall -k $target && sudo depmod -a $target"
    fi
    # A running nvidia GPU makes this a hard requirement, not a nicety.
    if command -v nvidia-smi >/dev/null 2>&1 && pgrep -x nvidia-smi >/dev/null 2>&1; then
        printf "      ${C_DIM}an nvidia GPU is in use on this box — its driver MUST build for ${target}${C_RESET}\n"
    fi
    return 0
}

# ============================================================================
# GPU HEALTH — is the graphics driver actually working on THIS kernel?
# ----------------------------------------------------------------------------
# A new kernel can boot perfectly and still come up with a dead GPU: the
# proprietary driver is a DKMS module compiled against a specific kernel,
# and if it was never built for the new one, the adapter is simply gone.
# The symptom is confusing — the machine boots, the desktop appears, but
# the GPU "disappeared" and CUDA is gone.
#
# This runs after the reboot (kernelz verified) and answers it plainly.
# ============================================================================
verify_gpu_health() {   # verify_gpu_health <running_release>
    local rel="${1:-$REL}"
    section "GPU HEALTH · is the graphics driver working on $rel?"

    # The display adapters this kernel can see.
    local adapters found=0
    adapters=$(lspci 2>/dev/null | grep -iE "vga compatible controller|3d controller|display controller")
    if [[ -z "$adapters" ]]; then
        info "no display adapters reported by lspci"
    else
        printf '%s\n' "$adapters" | sed 's/^/    /'
        found=1
    fi

    # Every DRM card the kernel exposes — these ARE the drivers that bound.
    local card nm drv
    for card in /sys/class/drm/card[0-9]; do
        [[ -d "$card" ]] || continue
        nm="${card##*/}"
        drv=$(basename "$(readlink -f "$card/device/driver" 2>/dev/null)" 2>/dev/null)
        printf "    ${C_DIM}%-8s driver: %s${C_RESET}\n" "$nm" "${drv:-none}"
    done

    # nvidia is the one that matters: it is out-of-tree and per-kernel.
    if command -v nvidia-smi >/dev/null 2>&1; then
        local nvdrv nvver
        nvdrv=$(lsmod 2>/dev/null | awk '$1=="nvidia"{print $1}')
        if [[ -z "$nvdrv" ]]; then
            if ls /lib/modules/"$rel"/updates/dkms/nvidia*.ko >/dev/null 2>&1; then
                critf "GpuDriver" "the nvidia module is built for $rel but is NOT loaded" \
                    "load it: sudo modprobe nvidia   (check: dmesg | grep -i nvidia)"
            else
                critf "GpuDriver" "the nvidia module was NOT built for $rel — the GPU is unusable on this kernel" \
                    "build it: sudo dkms autoinstall -k $rel && sudo depmod -a $rel   (then reboot)"
            fi
        else
            nvver=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1)
            if [[ -n "$nvver" ]]; then
                ok "nvidia driver loaded and working (version $nvver)"
            else
                warnf "GpuDriver" "the nvidia module is loaded but nvidia-smi cannot talk to the GPU" \
                    "check: dmesg | grep -i nvidia"
            fi
        fi
    elif (( found == 1 )); then
        info "no nvidia-smi on this box — using the in-kernel drivers only"
    fi

    # DKMS modules in general, for this exact kernel.
    if command -v dkms >/dev/null 2>&1; then
        local dk_for_rel
        dk_for_rel=$(timeout 30 dkms status 2>/dev/null | grep -cF "$rel")
        if (( dk_for_rel > 0 )); then
            ok "$dk_for_rel DKMS module(s) built for $rel"
        else
            warnf "Dkms" "no DKMS modules are built for $rel" "sudo dkms autoinstall -k $rel"
        fi
    fi
    printf "\n"
}

# ============================================================================
# WHY UPGRADE · WHAT IS FIXED
# ============================================================================
section_fixes() {
    ensure_best
    section "WHY UPGRADE · WHAT IS FIXED"
    if [[ -z "$KB_BEST_PKG" ]]; then
        info "no recommended kernel to compare against"
        return 0
    fi

    local rser rup reol reasons=()
    rser=$(kb_running_series)
    rup=$(kb_running_upstream)
    reol=$(kb_series_is_eol "$rser")

    subsec "Why you might want to upgrade"
    if [[ "$reol" == "1" ]]; then
        reasons+=("${C_RED}your series $rser is END-OF-LIFE upstream${C_RESET} — no more fixes will ever be published for it")
    fi
    if [[ -n "$CUR_PKG" && $IN_REPO -eq 0 ]]; then
        reasons+=("you run a custom kernel — your distro's security patches never reach it")
    fi
    if [[ -n "$KB_BEST_VER" && "$KB_BEST_VER" != "$CUR_VER" ]]; then
        if series_gt "$KB_BEST_SERIES" "$rser"; then
            reasons+=("a newer, already-tested kernel is available: ${C_BOLD}${KB_BEST_VER}${C_RESET} (series $KB_BEST_SERIES, out $(kb_fmt_age "$KB_BEST_DATE"))")
        elif [[ "$KB_BEST_SERIES" == "$rser" ]] && ver_gt "$KB_BEST_VER" "$CUR_VER"; then
            reasons+=("a newer patch of the same series is available: ${C_BOLD}${KB_BEST_VER}${C_RESET} (out $(kb_fmt_age "$KB_BEST_DATE"))")
        fi
    fi
    # behind inside your own series?
    local latest_in_series="${KB_SER_LATEST[$rser]:-}"
    if [[ -n "$rup" && -n "$latest_in_series" ]] && ver_gt "$latest_in_series" "$rup"; then
        reasons+=("you are behind inside series $rser: running $rup, upstream's last release of that series was $latest_in_series")
    fi
    # unmitigated CPU vulnerabilities
    local cvuln=0
    for f in /sys/devices/system/cpu/vulnerabilities/*; do
        [[ -r "$f" ]] || continue
        grep -q '^Vulnerable' "$f" 2>/dev/null && cvuln=$(( cvuln + 1 ))
    done
    (( cvuln > 0 )) && reasons+=("${cvuln} CPU vulnerability class(es) are unmitigated on this kernel — newer kernels add mitigations")

    if [[ ${#reasons[@]} -eq 0 ]]; then
        ok "no strong reason to move — you are on the recommended kernel"
    else
        local r
        for r in "${reasons[@]}"; do printf "    ${C_YELLOW}▸${C_RESET} %b\n" "$r"; done
    fi
    # the "neither branch is right" case: say what to do instead.
    # The settle window is measured against the BRANCH's birth (the X.Y.0
    # release) everywhere else in kernelz — the patch's own age would
    # understate how long this branch has been tested (7.3 opened 25 days
    # ago even though 7.3.4 itself is 3 days old).
    if [[ "$reol" == "1" && -n "$KB_STABLE_VER" ]]; then
        local sage; sage=$(kb_series_age_days "$KB_STABLE_SER" 2>/dev/null || echo 0)
        printf "\n"
        if (( sage < KB_SETTLE_DAYS )); then
            printf "    ${C_CYAN}▸${C_RESET} upstream's current stable %s (series %s) opened only %d day(s) ago — it settles in about %d day(s).\n" \
                "$KB_STABLE_VER" "$KB_STABLE_SER" "$sage" "$(( KB_SETTLE_DAYS - sage ))"
            printf "    ${C_CYAN}▸${C_RESET} until then: %s latest (takes it now, with the GRUB fallback) or stay on a supported LTS.\n" "${0##*/}"
        else
            printf "    ${C_CYAN}▸${C_RESET} upstream's current stable %s is settled — its branch has been open %d days — but your distro does not package it.\n" \
                "$KB_STABLE_VER" "$sage"
            printf "    ${C_CYAN}▸${C_RESET} %s latest gets it for you — apt when the distro ships that series, build when it does not.\n" "${0##*/}"
        fi
    fi
    printf "\n"

    subsec "What the recommended kernel carries"
    if [[ -z "$KB_BEST_UP" ]]; then
        info "could not map ${KB_BEST_VER} to an upstream release — no changelog comparison possible"
        return 0
    fi
    local facts commits testers cves cl scope
    facts=$(kb_release_facts "$KB_BEST_UP") || facts="0|0|"
    commits="${facts%%|*}"; testers="${facts#*|}"; testers="${testers%%|*}"
    cves="${facts##*|}"
    scope=$(kb_changelog_is_series "$KB_BEST_UP")
    kvline() { printf "    ${C_DIM}%-14s${C_RESET} %s\n" "$1" "$2"; }
    if [[ "$scope" == "1" ]]; then
        kvline "upstream" "${KB_BEST_SERIES} branch ${C_DIM}(this build's ABI is $KB_BEST_UP — the exact upstream patch is not published)${C_RESET}"
    else
        kvline "upstream" "$KB_BEST_UP"
    fi
    kvline "commits" "$commits"
    kvline "tested by" "${testers} upstream tester(s) ${C_DIM}(the stable tree's own Tested-by roster)${C_RESET}"
    if [[ -n "$cves" ]]; then
        kvline "CVE fixes" ""
        printf '%s\n' "$cves" | tr ',' '\n' | while read -r c; do
            [[ -z "$c" ]] && continue
            printf "      ${C_RED}%s${C_RESET}\n" "$c"
        done
    else
        kvline "CVE fixes" "none referenced in its changelog"
    fi

    cl=$(kb_release_changelog "$KB_BEST_UP") || cl=""
    if [[ -n "$cl" ]]; then
        local highlights
        highlights=$(kb_highlights "$cl")
        if [[ -n "$highlights" ]]; then
            if [[ "$scope" == "1" ]]; then
                printf "\n    ${C_DIM}notable fixes in the %s branch:${C_RESET}\n" "$KB_BEST_SERIES"
            else
                printf "\n    ${C_DIM}notable fixes in this release:${C_RESET}\n"
            fi
            printf '%s\n' "$highlights" | head -8 | while IFS= read -r s; do
                printf "      ${C_GREEN}•${C_RESET} %s\n" "$s"
            done
        fi
    fi
    printf "\n"

    # If the repo also has a newer (but less settled) kernel, say what it adds.
    if [[ -n "$KB_NEW_VER" && "$KB_NEW_VER" != "$KB_BEST_VER" && -n "$KB_NEW_UP" ]]; then
        local nfacts ncves
        nfacts=$(kb_release_facts "$KB_NEW_UP") || nfacts="0|0|"
        ncves="${nfacts##*|}"
        printf "  ${C_YELLOW}${C_BOLD}NOTE${C_RESET}  the repos also carry ${C_BOLD}${KB_NEW_VER}${C_RESET}, which is newer but only"
        printf " %s day(s) old — not yet trusted.\n" "$(kb_age_days "$KB_NEW_DATE")"
        if [[ -n "$ncves" ]]; then
            printf "        ${C_DIM}it does carry: %s${C_RESET}\n" "$(printf '%s' "$ncves" | tr ',' ' ')"
            printf "        ${C_DIM}take it with --newest if you want those fixes now${C_RESET}\n"
        fi
        printf "\n"
    fi
    return 0
}

run_risk_checks() {
    section "UPDATE RISK STUDY"
    local bfree rfree bmount
    bfree=$(boot_free_kb); rfree=$(root_free_kb)
    bmount=$(df -Pk /boot 2>/dev/null | awk 'NR==2{print $6}')
    local bmb=${bfree:-0} rmb=${rfree:-0}
    bmb=$((bmb/1024)); rmb=$((rmb/1024))
    local bwhere="/boot"
    [[ "$bmount" == "/" ]] && bwhere="/boot (shares the root partition)"
    add_json_field boot_free_mb "$bmb" 1
    add_json_field root_free_mb "$rmb" 1
    if (( bmb < 250 )); then
        critf "BootSpace" "$bwhere only ${bmb}MB free — a kernel install may fail midway" "purge old kernels: sudo apt purge linux-image-<old> (kernelz cleanup shows candidates)"
    elif [[ "$bmount" == "/boot" && $bmb -lt 500 ]]; then
        warnf "BootSpace" "/boot low (${bmb}MB free)" "consider 'kernelz cleanup' before upgrading"
    else
        ok "$bwhere has ${bmb}MB free"
    fi
    if (( rmb < 2048 )); then
        warnf "RootSpace" "root filesystem low (${rmb}MB free)" "apt needs room for image+headers+initramfs"
    else
        ok "root filesystem has $(( rmb/1024 ))GB free"
    fi

    # Kernel meta package: without it `apt upgrade` stops tracking kernels
    if [[ -n "$META_PKG" ]] && [[ "$(pkg_state "$META_PKG")" != ii* ]]; then
        if (( WANT_META == 0 )); then
            info "$META_PKG not installed — on purpose for a source-built kernel (apt would pull the distro kernel in too)"
        else
            warnf "KernelMeta" "$META_PKG not installed — 'sudo apt upgrade' will NOT track kernel updates" "kernelz protect installs it"
        fi
    elif [[ -n "$META_PKG" ]]; then
        ok "$META_PKG installed — apt upgrade keeps pulling kernel updates"
    fi

    # Custom (out-of-repo) running kernel
    if [[ -n "$CUR_PKG" && $IN_REPO -eq 0 ]]; then
        warnf "CustomKernel" "$CUR_PKG is not from the repositories — no security updates via apt" "keep it held (kernelz protect) and plan migration to a repo kernel, or use kernelz study CVE list on repo kernels"
        if [[ $CUR_HELD -eq 1 ]]; then
            ok "$CUR_PKG is apt-mark held — 'apt upgrade' cannot touch/remove it"
        else
            critf "HoldMissing" "$CUR_PKG is NOT held — 'sudo apt upgrade' could replace or remove it" "kernelz protect (applies apt-mark hold + manual)"
        fi
    fi

    # initrd per kernel
    local rel
    while read -r rel; do
        [[ -z "$rel" ]] && continue
        if [[ -f "/boot/initrd.img-$rel" ]]; then ok "initrd present for $rel"
        else critf "Initrd" "Missing /boot/initrd.img-$rel — that kernel cannot boot root filesystem" "sudo apt-get install --reinstall linux-image-$rel"
        fi
    done < <(ls /boot/vmlinuz-* 2>/dev/null | sed 's|.*/vmlinuz-||')

    # Secure Boot vs custom modules
    local sb="unknown"
    if command -v mokutil >/dev/null 2>&1; then
        sb=$(mokutil --sb-state 2>/dev/null | awk '{print $1}')
    fi
    add_json_field secure_boot "$sb"
    if [[ "$sb" == "enabled" ]]; then
        if [[ $IN_REPO -eq 0 ]]; then
            critf "SecureBoot" "Secure Boot is ON with an unsigned/custom kernel — modules may be refused" "enroll key with mokutil, or disable Secure Boot in firmware, or boot a signed repo kernel"
        else
            ok "Secure Boot on, running a distro-signed kernel"
        fi
    else
        info "Secure Boot: $sb"
    fi

    # dkms modules need a rebuild per new kernel
    if command -v dkms >/dev/null 2>&1; then
        local dk
        dk=$(timeout 10 dkms status 2>/dev/null | head -5)
        if [[ -n "$dk" ]]; then
            warnf "Dkms" "dkms modules present — they rebuild on kernel install" "watch for build errors during kernelz upgrade; verify after boot: dkms status"
        fi
    fi

    # Pending upgrade from a previous run
    local pt pr
    pr=$(pending_get TARGET_REL)
    if [[ -n "$pr" ]]; then
        pt=$(pending_get TS)
        if [[ "$pr" == "$REL" ]]; then
            warnf "Pending" "New kernel $pr booted but was never verified/promoted" "run: kernelz verified"
        elif [[ "$BOOT_EPOCH" -gt "${pt:-0}" ]]; then
            critf "Pending" "Kernel $pr was installed but system is back on $REL — update failed" "run: kernelz verified (shows why), then kernelz recover or kernelz study"
        else
            info "Kernel $pr installed — waiting for reboot (GRUB armed with fallback)"
        fi
        add_json_field pending_kernel "$pr"
    else
        add_json_field pending_kernel ""
    fi

    # last boot errors (best-effort, no sudo prompt)
    local perr
    perr=$(journalctl -q -b -1 -p err --no-pager 2>/dev/null | wc -l)
    if [[ -n "$perr" ]] && (( perr > 0 )); then
        warnf "PriorBoot" "$perr error lines in the previous boot" "journalctl -b -1 -p err   (or ./bootz --boot -1)"
    fi
}

# ── about: describe the RUNNING kernel's setup ─────────────────────────────
#
# `study` reports on kernels that are AVAILABLE; `best` picks one. Neither
# answers the question "what is the thing I am actually running built
# with, how is it configured, and how does it differ from stock?" — so
# this does.
#
# Everything here is read from /proc and /sys, and every read degrades to
# "needs root" rather than failing: only /sys/kernel/debug/sched/preempt
# requires privileges, and without it we fall back to the CONFIG_PREEMPT_*
# flags in the config file.
cmd_about() {
    gather_kernel_facts
    record_boot

    local rel; rel=$(uname -r)
    local vfile; vfile=$(cat /proc/version 2>/dev/null)
    # /proc/version: "Linux version <rel> (<builder>) (<compiler>) #N <flavour> <date>"
    # The compiler field contains NESTED parens (gcc (Debian ...) 12.2.0), so
    # naive non-greedy sed stops at the wrong one — take the first paren
    # group as the builder, then everything up to ") #" as the compiler.
    local rest builder compiler flavour build_date
    rest="${vfile#Linux version ${rel} }"
    rest="${rest#(}";  builder="${rest%%)*}"
    rest="${rest#*) }"
    compiler="${rest%%\) #*}"; compiler="${compiler#(}"
    # date is a fixed 6-token tail: "Sat Nov 14 04:07:17 PST 2026"
    build_date=$(grep -oE '[A-Z][a-z]{2} [A-Z][a-z]{2} [0-9]+ [0-9:]+ [A-Z]+ [0-9]{4}' <<<"$vfile" | head -1)
    flavour=$(sed -E "s/^.*#1 //; s/ *${build_date}.*$//" <<<"$vfile")

    section "KERNEL IDENTITY"
    kpi "release"     "$rel"
    kpi "flavour"     "${flavour:-unknown}   (SMP + preemption model)"
    kpi "built by"    "${builder:-unknown}"
    kpi "compiler"    "${compiler:-unknown}"
    kpi "built"       "${build_date:-unknown}"
    kpi "package"     "${CUR_PKG:-not a package kernel} ${CUR_VER:+($CUR_VER)}"
    [[ "${CUR_HELD:-0}" == "1" ]] && kpi "held" "yes — apt upgrade will not replace it"

    # localversion is appended by the build (echo '-kz' > localversion-kernelz)
    local lv=""
    [[ -r "/boot/config-$rel" ]] && lv=$(grep -E "^CONFIG_LOCALVERSION=" "/boot/config-$rel" 2>/dev/null | cut -d= -f2- | tr -d '"')
    # The -kz suffix comes from `echo -kz > localversion-kernelz` in the
    # build, NOT from CONFIG_LOCALVERSION (which is empty) — showing
    # CONFIG_LOCALVERSION alone as "localversion" was contradictory.
    kpi "uname suffix"  "-${rel##*-}   (appended by localversion-kernelz at build)"
    kpi "CONFIG_LOCALVERSION" "${lv:-<empty>}"
    ok "uname -r = $rel"

    # ── command line, annotated ───────────────────────────────────────────
    section "COMMAND LINE"
    local cmd; cmd=$(cat /proc/cmdline 2>/dev/null)
    emit "  ${C_DIM}%s${C_RESET}\n" "$cmd"
    local tok
    for tok in $cmd; do
        case "$tok" in
            transparent_hugepage=never)
                ok "THP disabled — removes synchronous-compaction stalls (kcompactd/compact_stall)" ;;
            preempt=*)
                ok "preemption pinned to '${tok#preempt=}' (PREEMPT_DYNAMIC: switchable at boot)" ;;
            mitigations=*)
                warn "explicit mitigations= override: ${tok#mitigations=}" "kernel defaults are safer unless you measured a reason" ;;
            nopti|nosmap|nosmep|nokaslr|noibrs|noibpb)
                crit "security mitigation disabled: $tok" "re-enable unless you own the threat model" ;;
            swapfile=*) : ;;
        esac
    done
    grep -q "preempt=" <<<"$cmd" \
        || info "no preempt= set — using the build default (see PREEMPTION below)"

    # ── preemption ────────────────────────────────────────────────────────
    section "PREEMPTION"
    local pm=""
    # tr/sed strip the trailing newline+padding so the value is clean in
    # both the table and the JSON ("full (lazy)" not "full (lazy) ").
    pm=$(sudo -n cat /sys/kernel/debug/sched/preempt 2>/dev/null | tr -d '\n' | sed 's/[[:space:]]*$//') || true
    if [[ -n "$pm" ]]; then
        kpi "active model" "$pm"
    else
        info "active model: needs root (cat /sys/kernel/debug/sched/preempt)"
    fi
    local cfg="/boot/config-$rel"
    if [[ -r "$cfg" ]]; then
        local dyn lazy
        dyn=$(grep -c "^CONFIG_PREEMPT_DYNAMIC=y" "$cfg" 2>/dev/null || echo 0)
        lazy=$(grep -c "^CONFIG_PREEMPT_LAZY=y" "$cfg" 2>/dev/null || echo 0)
        if (( dyn > 0 )); then
            ok "CONFIG_PREEMPT_DYNAMIC=y — model switchable at boot via preempt=, NO rebuild needed"
            kpi "switchable to" "none · voluntary · lazy · full"
        else
            warn "no CONFIG_PREEMPT_DYNAMIC — preemption model is baked into .config" "changing it costs a full rebuild"
        fi
        (( lazy > 0 )) && info "CONFIG_PREEMPT_LAZY=y — lazy preemption accounting (lower overhead)"
    fi

    # ── memory (the knobs this machine actually runs) ─────────────────────
    section "MEMORY SETUP"
    kpi "swappiness"        "$(sysctl -n vm.swappiness 2>/dev/null)"
    kpi "overcommit"        "$(sysctl -n vm.overcommit_memory 2>/dev/null)  ($( [[ "$(sysctl -n vm.overcommit_memory 2>/dev/null)" == 1 ]] && echo 'always' || echo 'heuristic'))"
    kpi "min_free_kbytes"   "$(sysctl -n vm.min_free_kbytes 2>/dev/null)"
    kpi "dirty_ratio"       "$(sysctl -n vm.dirty_ratio 2>/dev/null)"
    kpi "page-cluster"      "$(sysctl -n vm.page-cluster 2>/dev/null)"
    local thp; thp=$(cat /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null | grep -oE "\[[a-z]+\]" | tr -d '[]')
    kpi "THP"               "${thp:-unknown}"
    if [[ "${thp:-}" == "never" ]]; then
        ok "THP off — no compact_stall stalls"
    else
        warn "THP = ${thp:-unknown} — can cause compact_stall stalls under load" "echo never > /sys/kernel/mm/transparent_hugepage/enabled"
    fi
    local zs; zs=$(cat /sys/module/zswap/parameters/enabled 2>/dev/null)
    local zc; zc=$(cat /sys/module/zswap/parameters/compressor 2>/dev/null)
    kpi "zswap"             "$([ "$zs" = Y ] && echo "on (${zc:-?})" || echo off)"
    kpi "zram"              "$(swapon --show --noheadings 2>/dev/null | awk '/zram/{print $3" @"$5}' | head -1 || echo none)"

    # ── hardening ─────────────────────────────────────────────────────────
    section "HARDENING"
    local kp; kp=$(sysctl -n kernel.kptr_restrict 2>/dev/null)
    local dm; dm=$(sysctl -n kernel.dmesg_restrict 2>/dev/null)
    local as; as=$(sysctl -n kernel.randomize_va_space 2>/dev/null)
    local yp; yp=$(sysctl -n kernel.yama.ptrace_scope 2>/dev/null)
    local ub; ub=$(sysctl -n kernel.unprivileged_bpf_disabled 2>/dev/null)
    kpi "kptr_restrict"  "${kp:-?}  ($( (( ${kp:-0} >= 1 )) && echo ok || echo 'kernel pointers visible'))"
    kpi "dmesg_restrict" "${dm:-?}  ($( (( ${dm:-0} >= 1 )) && echo ok || echo 'world-readable dmesg'))"
    kpi "ASLR"           "${as:-?}  ($( (( ${as:-0} == 2 )) && echo 'full' || echo 'partial'))"
    kpi "yama ptrace"    "${yp:-?}  ($( (( ${yp:-0} >= 1 )) && echo ok || echo 'any process may ptrace'))"
    kpi "unpriv BPF"     "${ub:-?}  ($( [[ "$ub" == 2 || "$ub" == 1 ]] && echo disabled || echo ALLOWED))"
    # mitigations are ON by default unless the cmdline turns them off
    if grep -qE "nopti|nosmap|nosmep|nokaslr|mitigations=off" <<<"$cmd"; then
        crit "one or more CPU mitigations disabled on the command line"
    else
        ok "CPU mitigations at kernel defaults (no nopti/nosmap/nosmep/nokaslr/mitigations=off)"
    fi

    # ── storage ───────────────────────────────────────────────────────────
    section "STORAGE"
    local rootdev; rootdev=$(findmnt -no SOURCE / 2>/dev/null)
    local rootfstype; rootfstype=$(findmnt -no FSTYPE / 2>/dev/null)
    local rootopts; rootopts=$(findmnt -no OPTIONS / 2>/dev/null)
    kpi "root"          "${rootdev:-?} (${rootfstype:-?})"
    kpi "mount opts"    "${rootopts:-?}"
    # rootdev is a PARTITION (/dev/sda2) but the scheduler lives on the
    # whole disk (/sys/block/sda/...). `${rootdev%%[0-9]*}` left the
    # "/dev/" prefix in place, so the path never existed and this always
    # printed "unknown". lsblk's pkname gives the parent for any scheme
    # (sda2 → sda, nvme0n1p2 → nvme0n1).
    local rootblk sched
    rootblk=$(lsblk -no pkname "$rootdev" 2>/dev/null | head -1 | tr -d '[:space:]')
    [[ -z "$rootblk" ]] && rootblk=${rootdev#/dev/}
    sched=$(cat "/sys/block/$rootblk/queue/scheduler" 2>/dev/null | tr -d '\n' | sed 's/[[:space:]]*$//')
    kpi "root disk"      "$rootblk"
    kpi "I/O scheduler"  "${sched:-unknown}"
    if grep -q "noatime" <<<"$rootopts"; then
        ok "root mounted noatime"
    elif grep -q "relatime" <<<"$rootopts"; then
        info "root mounted relatime (the modern default — fine)"
    fi

    # ── drivers ───────────────────────────────────────────────────────────
    section "DRIVERS"
    local nvmod nvuser
    nvmod=$(awk '/NVRM version/{for(i=1;i<=NF;i++) if($i ~ /^[0-9]+\.[0-9]+\.[0-9]+$/) {print $i; exit}}' /proc/driver/nvidia/version 2>/dev/null)
    nvuser=$(ls /usr/lib/x86_64-linux-gnu/libnvidia-ml.so.* 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+$' | head -1)
    if [[ -n "$nvmod" ]]; then
        if [[ -n "$nvuser" && "$nvmod" != "$nvuser" ]]; then
            crit "NVIDIA: kernel module $nvmod != userspace $nvuser" "DKMS rebuild + reboot — this is what breaks nvidia-smi"
        else
            ok "NVIDIA kernel module $nvmod matches userspace"
        fi
    else
        info "no NVIDIA kernel module loaded"
    fi
    if command -v dkms >/dev/null 2>&1; then
        local dks; dks=$(dkms status 2>/dev/null | grep -cF "$rel")
        kpi "DKMS for this kernel" "$dks module(s) built"
        (( dks == 0 )) && warn "no DKMS modules built for $rel" "run: sudo dkms autoinstall -k $rel"
    fi

    # ── how this differs from the distro stock kernel ─────────────────────
    section "DELTA VS STOCK"
    local stock
    stock=$(ls -1 /boot/config-6.* 2>/dev/null | grep -v -- "-kz" | sort -V | tail -1)
    if [[ -n "$stock" && -r "$stock" && -r "$cfg" ]]; then
        kpi "stock ref"  "$(basename "$stock")"
        local added removed
        added=$(comm -13 <(grep -E "^(CONFIG_|# CONFIG_)" "$stock" 2>/dev/null | sort) \
                         <(grep -E "^(CONFIG_|# CONFIG_)" "$cfg" 2>/dev/null | sort) | wc -l)
        removed=$(comm -23 <(grep -E "^(CONFIG_|# CONFIG_)" "$stock" 2>/dev/null | sort) \
                           <(grep -E "^(CONFIG_|# CONFIG_)" "$cfg" 2>/dev/null | sort) | wc -l)
        kpi "options changed" "$added added / $removed removed vs stock"
        if [[ "${added:-0}" -eq 0 && "${removed:-0}" -eq 0 ]]; then
            info "config is identical to the stock kernel"
        else
            info "full diff: diff <(grep CONFIG $stock) <(grep CONFIG $cfg)"
        fi
    else
        info "no stock kernel config available to compare against"
    fi

    emit "\n  ${C_DIM}Tip: kernelz study = available kernels · kernelz bench = this boot's speed${C_RESET}\n"

    # Same contract as the other subcommands: a verdict block in human mode,
    # a JSON object in --json mode, and an exit code reflecting findings.
    # Without this, `about --json` printed NOTHING — section()/kpi()/ok()
    # are all no-ops when JSON_OUT=1 and this function emitted no JSON of
    # its own.
    add_json_field kernel_release "$rel"
    add_json_field preempt_model "${pm:-unknown}"
    add_json_field thp_mode "${thp:-unknown}"
    add_json_field nvidia_module "${nvmod:-none}"
    add_json_field io_scheduler "${sched:-unknown}"
    emit_verdict
}

cmd_status() {
    gather_kernel_facts
    record_boot
    emit "\n  ${C_BOLD}${C_BLUE}╔═══════════════════════════════════════════════════════════════╗
  ║  KERNELZ — kernel study · upgrade · recovery · bench          ║
  ╚═══════════════════════════════════════════════════════════════╝${C_RESET}\n"
    emit "  ${C_DIM}v%s · %s · %s${C_RESET}\n" "$SCRIPT_VERSION" "$TIMESTAMP" "$HOSTNAME_SHORT"

    json_muffle
    section_snapshot
    section_best
    section_grub
    run_risk_checks
    section_fixes
    # The lifeline check: does the kernel on disk right now still have the
    # driver that carries your default route?
    section_network_safety ""
    json_unmuffle

    if declare -f run_comparison_finalize >/dev/null 2>&1 && [[ "$JSON_OUT" -eq 0 ]]; then
        run_comparison_finalize 2>/dev/null || true
    fi

    # The whole point of the tool: check, then OFFER to do it. The old
    # kernel stays installed and bootable either way.
    offer_pending
    offer_upgrade
    emit_verdict
}

# ============================================================================
# OFFER PENDING — finish or roll back an upgrade that is half-done
# ----------------------------------------------------------------------------
# After `kernelz upgrade` the new kernel boots exactly ONCE and GRUB's
# permanent default still points at the old one. So the story is only
# finished once the new kernel is promoted. If the new kernel died, the
# machine came back on the old one by itself — the job is to say so and
# clean up.
# ============================================================================
offer_pending() {
    [[ "$JSON_OUT" -eq 1 ]] && return 0
    [[ "$COMMAND" != "status" && "$COMMAND" != "check" ]] && return 0
    local pr pts prev
    pr=$(pending_get TARGET_REL)
    [[ -z "$pr" ]] && return 0
    pts=$(pending_get TS); prev=$(pending_get PREV_REL)

    # ---- case 1: the new kernel booted and is running right now ----
    if [[ "$pr" == "$REL" ]]; then
        section "PENDING — the new kernel is running"
        printf "  ${C_GREEN}${C_BOLD}%s booted successfully${C_RESET} ${C_DIM}(installed %s)${C_RESET}\n" \
            "$REL" "$(date -d "@${pts:-0}" '+%Y-%m-%d %H:%M' 2>/dev/null || echo '?')"
        printf "  ${C_DIM}GRUB's permanent default still points at %s — until the new kernel is${C_RESET}\n" "$prev"
        printf "  ${C_DIM}promoted, the next reboot goes back to it.${C_RESET}\n\n"

        local cmd="${0##*/}"
        local path; path="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
        local call="sudo $path"
        command -v "$cmd" >/dev/null 2>&1 && call="sudo $cmd"

        if [[ ! -t 0 ]]; then
            printf "  ${C_DIM}→ confirm it now:  ${C_BOLD}%s verified${C_RESET}\n\n" "$call"
            return 0
        fi
        if (( ASSUME_YES == 1 )); then
            printf "  ${C_GREEN}→${C_RESET} --yes given: promoting it.\n\n"
            cmd_verify
            return 0
        fi
        printf "  ${C_GREEN}→${C_RESET} mark %s as verified and make it the permanent default?  ${C_DIM}[y/N]${C_RESET} " "$REL"
        local a; read -r a || a=""
        printf "\n"
        if [[ "${a,,}" == y* ]]; then
            cmd_verify
        else
            info "not promoting — '$call verified' when you are satisfied with this kernel"
            printf "  ${C_DIM}the old kernel stays the default until then${C_RESET}\n\n"
        fi
        return 0
    fi

    # ---- case 2: the new kernel is gone and we are back on the old one ----
    if [[ "$BOOT_EPOCH" -gt "${pts:-0}" ]]; then
        section "PENDING — the upgrade did not stick"
        printf "  ${C_RED}${C_BOLD}%s was installed but the system came back on %s${C_RESET}\n" "$pr" "$REL"
        printf "  ${C_DIM}the GRUB fallback worked exactly as designed — you are safe on the old kernel.${C_RESET}\n"
        printf "  ${C_DIM}previous boot errors (the likely cause):${C_RESET}\n"
        journalctl -q -b -1 -p err --no-pager 2>/dev/null | tail -8 | sed 's/^/      /' \
            || info "journalctl not readable without sudo"
        printf "\n"
        local cmd="${0##*/}"
        local path; path="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
        local call="sudo $path"
        command -v "$cmd" >/dev/null 2>&1 && call="sudo $cmd"
        printf "  ${C_DIM}→${C_RESET} what to do:\n"
        printf "       ${C_BOLD}%s verified${C_RESET}  ${C_DIM}diagnose the failed boot (full analysis)${C_RESET}\n" "$call"
        printf "       ${C_BOLD}%s recover${C_RESET}   ${C_DIM}pin GRUB to %s and clear the pending record${C_RESET}\n" "$call" "$REL"
        printf "       ${C_DIM}%s stays installed, so you can retry any time${C_RESET}\n\n" "$REL"
    fi
    return 0
}

# ============================================================================
# OFFER — "you are behind; want me to upgrade it?"
# ============================================================================
offer_upgrade() {
    [[ "$JSON_OUT" -eq 1 ]] && return 0
    [[ "$COMMAND" != "status" && "$COMMAND" != "check" ]] && return 0
    [[ -z "$KB_BEST_VER" ]] && return 0

    # Decide whether an upgrade is actually warranted.
    local rser reol
    rser=$(kb_running_series)
    reol=$(kb_series_is_eol "$rser")
    local newer=0
    if [[ "$KB_BEST_PKG" == "$CUR_PKG" && "$KB_BEST_VER" == "$CUR_VER" ]]; then
        newer=0                                   # already on it
    elif [[ "$KB_BEST_SERIES" == "$rser" ]]; then
        ver_gt "$KB_BEST_VER" "$CUR_VER" && newer=1
    elif series_gt "$KB_BEST_SERIES" "$rser"; then
        newer=1
    fi

    # Nothing to offer when we are on the best kernel, or when the only
    # option is an older branch (that is a downgrade, not an upgrade).
    if (( newer == 0 )); then
        if [[ "$reol" == "1" && -n "$KB_STABLE_VER" ]]; then
            local sage; sage=$(kb_age_days "$KB_STABLE_DATE")
            if (( sage >= KB_SETTLE_DAYS )); then
                section "RECOMMENDED ACTION"
                printf "  ${C_YELLOW}▸${C_RESET} your series %s is end-of-life, but upstream's current stable %s\n" "$rser" "$KB_STABLE_VER"
                printf "    ${C_DIM}has settled. Your distro does not package it — compile it yourself:${C_RESET}\n"
                printf "      ${C_CYAN}sudo %s build --apply${C_RESET}\n" "${0##*/}"
            fi
        fi
        return 0
    fi

    section "RECOMMENDED ACTION"
    printf "  ${C_MAGENTA}${C_BOLD}UPGRADE AVAILABLE${C_RESET}  %s → %s   ${C_DIM}(%s, %s old)${C_RESET}\n" \
        "$CUR_VER" "$KB_BEST_VER" "$KB_BEST_SERIES" "$(kb_fmt_age "$KB_BEST_DATE")"
    printf "  ${C_DIM}The old kernel stays installed and bootable — if the new one fails,${C_RESET}\n"
    printf "  ${C_DIM}the next reboot lands back on %s automatically.${C_RESET}\n" "$REL"
    printf "\n"

    # Automatic path only for a real terminal; never in a pipe or a cron job.
    local cmd="${0##*/}"
    local path; path="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
    local call="sudo $path"
    command -v "$cmd" >/dev/null 2>&1 && call="sudo $cmd"

    if (( ASSUME_YES == 1 )); then
        printf "  ${C_GREEN}→${C_RESET} --yes given: upgrading now.\n"
        printf "  ${C_DIM}%s upgrade${C_RESET}\n\n" "$call"
        cmd_upgrade
        return 0
    fi
    if [[ ! -t 0 ]]; then
        printf "  ${C_DIM}→${C_RESET} upgrade when ready:  ${C_BOLD}%s upgrade${C_RESET}\n" "$call"
        printf "\n"
        return 0
    fi

    if (( DRY_RUN == 1 )); then
        printf "  ${C_DIM}→${C_RESET} ${C_BOLD}%s upgrade --dry-run${C_RESET}  ${C_DIM}(preview — change nothing)${C_RESET}\n" "$call"
        printf "\n"
        return 0
    fi

    printf "  ${C_GREEN}→${C_RESET} upgrade now?  ${C_DIM}[y/N]${C_RESET} "
    local a; read -r a || a=""
    if [[ "${a,,}" == y* ]]; then
        printf "\n"
        cmd_upgrade
    else
        printf "\n"
        info "not upgrading — run '$call upgrade' whenever you are ready"
        printf "  ${C_DIM}nothing was changed; the current kernel stays exactly as it is${C_RESET}\n\n"
    fi
    return 0
}

# ============================================================================
# STUDY  (deeper dive)
# ============================================================================
study_hardening() {
    section "HARDENING STUDY — /boot/config-$REL"
    local cfg="/boot/config-$REL"
    if [[ ! -r "$cfg" ]]; then
        info "no readable kernel config for $REL"
        return 0
    fi
    local opt
    for opt in CONFIG_RANDOMIZE_BASE CONFIG_RANDOMIZE_MEMORY CONFIG_STACKPROTECTOR_STRONG \
               CONFIG_HARDENED_USERCOPY CONFIG_FORTIFY_SOURCE CONFIG_INIT_ON_ALLOC_DEFAULT_ON \
               CONFIG_STRICT_KERNEL_RWX CONFIG_MODULE_SIG CONFIG_DEBUG_SET_MODULE_RONX; do
        if grep -qE "^${opt}=y" "$cfg"; then ok "$opt=y"
        elif grep -qE "^${opt}=m" "$cfg"; then info "$opt=m"
        else warnf "KernelConfig" "$opt is not enabled" "cosmetic for study: prefer kernels built with $opt=y"
        fi
    done
}

study_cpu_vulns() {
    section "CPU MITIGATION STATUS"
    local dir=/sys/devices/system/cpu/vulnerabilities f vuln=0 mit=0 name val
    [[ -d $dir ]] || { info "sysfs vulnerabilities not exposed"; return 0; }
    for f in "$dir"/*; do
        [[ -e "$f" ]] || continue
        name=${f##*/}; val=$(cat "$f" 2>/dev/null)
        case "$val" in
            "Mitigation"*) mit=$((mit+1));  printf "  ${C_YELLOW}!${C_RESET} %-32s %s\n" "$name" "$val" ;;
            "Not affected"*)                printf "  ${C_GREEN}✓${C_RESET} %-32s %s\n" "$name" "$val" ;;
            "Vulnerable"*)   vuln=$((vuln+1)); printf "  ${C_RED}✗${C_RESET} %-32s ${C_BOLD}%s${C_RESET}\n" "$name" "$val" ;;
            *)                              printf "  ${C_DIM}·${C_RESET} %-32s %s\n" "$name" "$val" ;;
        esac
    done
    (( vuln > 0 )) && critf "CpuVuln" "$vuln CPU vulnerabilit$([[ $vuln -eq 1 ]] && echo y || echo ies) unmitigated — new kernels usually add mitigations" "kernelz upgrade; check 'cat /sys/devices/system/cpu/vulnerabilities/*'"
    add_json_field cpu_vulnerable "$vuln" 1
    info "$mit mitigated via software, $vuln vulnerable"
}

study_changelog() {
    section "UPDATE DIGEST — changelog & CVEs ($META_PKG → $META_CAND)"
    [[ -z "$META_PKG" ]] && { info "no repo kernel meta-package"; return 0; }
    local cl
    cl=$(timeout 30 apt-get changelog "$META_PKG" 2>/dev/null)
    if [[ -z "$cl" ]]; then
        warnf "Changelog" "Could not fetch changelog (offline?)" "apt-get changelog $META_PKG"
        return 0
    fi
    local cves
    cves=$(grep -Eo 'CVE-[0-9]{4}-[0-9]{4,7}' <<< "$cl" | sort -u)
    local n; n=$( [[ -n "$cves" ]] && printf '%s\n' "$cves" | wc -l || echo 0 )
    info "changelog mentions $n unique CVE id(s) in available history"
    if [[ -n "$cves" ]]; then
        printf '%s\n' "$cves" | tail -12 | sed 's/^/      /'
    fi
    subsec "most recent changelog entries"
    printf '%s\n' "$cl" | head -25 | sed 's/^/      /'
}

study_boots() {
    section "BOOT LEDGER (per-kernel boot history)"
    if [[ -r "$LEDGER" ]]; then
        printf "  ${C_DIM}boot                            kernel                    boot-time${C_RESET}\n"
        sort -t$'\t' -k3,3nr "$LEDGER" | head -12 | while IFS=$'\t' read -r id rel ep sec; do
            local tag=""
            [[ "$rel" == "$REL" ]] && tag=" ${C_GREEN}◀ current${C_RESET}"
            printf "  %-31s %-25s %s%b\n" "${id:0:8}… ($(date -d "@$ep" '+%m-%d %H:%M' 2>/dev/null || echo "$ep"))" "$rel" "$([[ "$sec" != "0" && -n "$sec" ]] && printf '%ss' "$sec" || printf '?')" "$tag"
        done
        local nrel
        nrel=$(cut -f2 "$LEDGER" | sort -u | tr '\n' ' ')
        info "kernels seen across boots: $nrel"
    else
        info "no ledger yet — it records automatically on every kernelz run"
    fi
}

cmd_study() {
    gather_kernel_facts
    record_boot
    json_muffle
    section_snapshot
    section_best
    section_grub
    run_risk_checks
    section_fixes
    section "KERNEL IDENTITY"
    printf "  %s\n" "$(uname -a)"
    [[ -r /proc/version ]] && printf "  ${C_DIM}%s${C_RESET}\n" "$(cat /proc/version)"
    local taint; taint=$(cat /proc/sys/kernel/tainted 2>/dev/null || echo 0)
    if [[ "$taint" != "0" ]]; then
        warnf "Tainted" "kernel taint value $taint (out-of-tree or unsigned modules)" "expected for custom kernels like $REL; not a boot risk"
    else
        ok "kernel untainted"
    fi
    add_json_field tainted "$taint" 1
    info "loaded modules: $(lsmod 2>/dev/null | awk 'NR>1' | wc -l) · module trees: $(ls -d /lib/modules/* 2>/dev/null | wc -l)"
    study_hardening
    study_cpu_vulns
    study_changelog
    study_boots
    json_unmuffle
    if declare -f run_comparison_finalize >/dev/null 2>&1 && [[ "$JSON_OUT" -eq 0 ]]; then
        run_comparison_finalize 2>/dev/null || true
    fi
    emit_verdict
}

