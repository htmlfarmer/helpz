case "$COMMAND" in
    help)    show_help ;;
    status|check) cmd_status ;;
    study)   cmd_study ;;
    upgrade|update) cmd_upgrade ;;
    build)   cmd_build ;;
    verify)  cmd_verify ;;
    recover) cmd_recover ;;
    protect) cmd_protect ;;
    bench)   cmd_bench "${ARGS[@]+"${ARGS[@]}"}" ;;
    fix)     cmd_fix ;;
    cleanup) cmd_cleanup ;;
    history) cmd_history ;;
    *)       show_help ;;
esac
