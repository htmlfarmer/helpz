# ============================================================================
# UPGRADE  (kernelz upgrade | kernelz update)
# ============================================================================
run_cmd() {
    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf "  ${C_DIM}[dry-run] \$ %s %s${C_RESET}\n" "$SUDO" "$*"
        return 0
    fi
    printf "  ${C_DIM}\$ %s %s${C_RESET}\n" "$SUDO" "$*"
    # shellcheck disable=SC2068
    $SUDO "$@"
}

# ── Preemption profile (server vs desktop) ────────────────────────────────
#
# A kernel built for a headless server wants a different preemption model
# than one driving a desktop:
#
#   server  → preempt=none     no kernel preemption at all; a task in
#                              kernel mode runs to the next explicit
#                              cond_resched(). Highest raw throughput for
#                              batch work, worst wake-up latency.
#   desktop → preempt=full     preemptible kernel; lowest wake-up latency
#                              and the snappiest UI/audio. ~1-3% throughput
#                              overhead from preemption bookkeeping.
#   balanced→ preempt=voluntary  preempts only at explicit points.
#
# IMPORTANT: with CONFIG_PREEMPT_DYNAMIC=y the model is chosen at BOOT via
# the `preempt=` kernel command line, so it costs one GRUB edit — no
# rebuild. Without it the choice is baked into .config and costs a full
# 30-90 minute compile. Always prefer the cmdline path when available.
#
# Also important: the cmdline lands on the machine that runs `--apply`.
# Building a server kernel on your desktop and applying it here would
# put `preempt=none` on the desktop. detect_profile() exists so the
# common case (build for this box) is right by default, and so we can
# WARN loudly when the requested profile disagrees with this machine.

detect_profile() {
    # an explicit --profile flag always wins
    [[ -n "${BUILD_PROFILE:-}" ]] && { printf '%s' "$BUILD_PROFILE"; return 0; }
    local def_target graphical xsock
    def_target=$(systemctl get-default 2>/dev/null || true)
    graphical=$(systemctl is-active graphical.target 2>/dev/null || true)
    xsock=$(ls /tmp/.X11-unix 2>/dev/null | wc -l); xsock=${xsock//[[:space:]]/}
    if [[ "$def_target" == "graphical.target" || "$graphical" == "active" || "${xsock:-0}" -gt 0 ]]; then
        printf 'desktop'
    else
        printf 'server'
    fi
}

profile_preempt() {          # profile_preempt <profile> → the preempt= value
    case "${1:-}" in
        server)   printf 'none' ;;
        balanced) printf 'voluntary' ;;
        *)        printf 'full' ;;
    esac
}

has_preempt_dynamic() {      # reads the BASE config this build will start from
    local cfg=""
    if [[ -r /proc/config.gz ]]; then
        cfg=$(zcat /proc/config.gz 2>/dev/null || true)
    elif [[ -n "${REL:-}" && -r "/boot/config-$REL" ]]; then
        cfg=$(cat "/boot/config-$REL" 2>/dev/null || true)
    fi
    [[ "$cfg" == *"CONFIG_PREEMPT_DYNAMIC=y"* ]]
}

write_preempt_cmdline() {
    local profile detected mode f=/etc/default/grub.d/60-preempt.cfg
    profile=$(detect_profile)
    detected=$(BUILD_PROFILE= detect_profile)
    mode=$(profile_preempt "$profile")

    if ! has_preempt_dynamic; then
        warnf "Preempt" "base config has no CONFIG_PREEMPT_DYNAMIC — preempt=$mode cannot be set on the command line" \
            "it must go into .config before the build (costs a full rebuild), or rebuild with CONFIG_PREEMPT_DYNAMIC=y"
        return 1
    fi

    # Overriding what this machine actually is means the kernel is for a
    # different box — say so rather than silently mis-configuring GRUB here.
    if [[ "$profile" != "$detected" ]]; then
        warnf "Preempt" "profile '$profile' overrides this machine's detected profile '$detected'" \
            "the preempt= cmdline is written to THIS box's GRUB; on a different target machine set it there instead"
    fi

    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf "  ${C_DIM}[dry-run] would write %s (preempt=%s for profile=%s)${C_RESET}\n" "$f" "$mode" "$profile"
        return 0
    fi

    $SUDO mkdir -p "$(dirname "$f")" 2>/dev/null || true
    # Build the file in memory, then install with `tee` (the same pattern
    # the rest of this script uses for root-owned files). The shell
    # EXPANDS \${GRUB_CMDLINE_LINUX_DEFAULT} at write time unless it is
    # escaped, so it must reach the file as a literal ${...} for grub to
    # expand it when sourcing the drop-in.
    local content
    content="# Written by kernelz — preemption profile: ${profile} (preempt=${mode})
# CONFIG_PREEMPT_DYNAMIC=y lets this be chosen at boot; no rebuild needed.
# Delete this file and re-run grub-mkconfig to revert to the build default.
GRUB_CMDLINE_LINUX_DEFAULT=\"\${GRUB_CMDLINE_LINUX_DEFAULT} preempt=${mode}\"
"
    if ! printf '%s' "$content" | $SUDO tee "$f" >/dev/null; then
        warnf "Preempt" "could not write $f" "run: sudo kernelz build --apply (needs root for GRUB)"
        return 1
    fi
    info "preempt=${mode} (profile: ${profile}) → ${f}"
    PREEMPT_MODE="$mode"
    PREEMPT_PROFILE="$profile"
    return 0
}

ensure_grub_savedefault() {
    local f=/etc/default/grub changed=0 line
    [[ -r "$f" ]] || { critf "GrubCfg" "/etc/default/grub missing/unreadable" "install grub-common"; return 1; }
    grep -qE '^GRUB_DEFAULT=saved$' "$f" || {
        line=$(grep -E '^GRUB_DEFAULT=' "$f" | head -1 || true)
        if [[ -n "$line" ]]; then
            run_cmd sed -i -E "s|^GRUB_DEFAULT=.*|GRUB_DEFAULT=saved|" "$f" || return 1
        else
            [[ "$DRY_RUN" -eq 1 ]] || printf '%s\n' "GRUB_DEFAULT=saved" | $SUDO tee -a "$f" >/dev/null || return 1
            printf "  ${C_DIM}[dry-run] append GRUB_DEFAULT=saved${C_RESET}\n"
        fi
        changed=1
    }
    # Make sure the menu is visible for manual recovery
    grep -qE '^GRUB_TIMEOUT=[5-9]|^GRUB_TIMEOUT=[0-9]{2}' "$f" || {
        run_cmd sed -i -E "s|^GRUB_TIMEOUT=.*|GRUB_TIMEOUT=5|" "$f" || true; changed=1; }
    if [[ $changed -eq 1 ]]; then
        info "GRUB_DEFAULT → saved (default = last known good kernel)"
    fi

    # Preemption profile (server/desktop) → `preempt=` on the command line.
    # With CONFIG_PREEMPT_DYNAMIC=y this is a GRUB edit, not a rebuild.
    # Returns 1 when the base config cannot accept a cmdline choice — that
    # is informational (the warning is already printed), not fatal here.
    if write_preempt_cmdline; then
        changed=1
    fi

    if [[ $changed -eq 1 ]]; then
        grub_regen || warnf "UpdateGrub" "GRUB config regeneration failed" "run update-grub / grub-mkconfig manually"
    fi
    return 0
}

cmd_upgrade() {
    gather_kernel_facts
    if [[ $EUID -ne 0 && -z "$SUDO" ]]; then
        critf "Privileges" "no root and no sudo available" "run as root"
        emit_verdict
    fi
    # preflight: don't build on a broken package database
    if [[ "$PKG_MGR" == deb ]] && dpkg --audit 2>/dev/null | grep -qiE 'half-installed|half-configured|not fully installed'; then
        warnf "Preflight" "dpkg database has unfinished installs — kernel postinst hooks may fail mid-upgrade" "run 'kernelz fix --apply' first (or continue; install will show the same error)"
    elif [[ "$PKG_MGR" == pacman ]] && [[ -n "$(pacman -Dk 2>&1)" ]]; then
        warnf "Preflight" "pacman reports database problems — the kernel install may fail" "run 'pacman -Dk' and fix, then re-run"
    fi

    section_snapshot
    ensure_best

    # =====================================================================
    # WHICH KERNEL?
    # The goal is upstream's CURRENT STABLE branch — the newest code that
    # has had time to bake. Not the long-term branch (the safe fallback),
    # and not a branch that opened five minutes ago.
    #
    #   distro packages that branch  -> install it through apt (tested + patched)
    #   distro does not package it    -> compile it, same GRUB one-shot net
    #   --apt-only                    -> never compile; take the distro's own
    # =====================================================================
    if [[ -z "$TO_PKG" ]] && (( APT_ONLY == 0 )); then
        local mode="stable"; (( BUILD_LTS )) && mode="lts"
        if with_spin "checking kernel.org" kb_latest_trusted "$mode"; then
            local tser="$KB_LATEST_SER" tgt="$KB_LATEST_VER"
            if (( KB_LATEST_FRESH == 1 )); then
                printf "  ${C_YELLOW}·${C_RESET} upstream's current stable branch %s opened only %d day(s) ago — not trusted yet\n" \
                    "$tser" "$(( KB_SETTLE_DAYS - KB_LATEST_WAIT ))"
                printf "  ${C_DIM}  falling back to your distro's tested kernel. Use --settle=0 to take it anyway.${C_RESET}\n"
            elif kb_repo_pick_for "$tser"; then
                printf "  ${C_GREEN}✓${C_RESET} your distro packages series %s — installing it through apt\n" "$tser"
                printf "    ${C_DIM}target: %s %s%s\n" "$KB_PICK_PKG" "$KB_PICK_VER" \
                    "$( [[ -n "$KB_PICK_UP" ]] && printf ' (upstream %s)' "$KB_PICK_UP" )"
                TO_PKG="$KB_PICK_PKG"
                add_json_field upgrade_target_series "$tser"
                add_json_field upgrade_target_version "$KB_PICK_VER"
                add_json_field upgrade_route "apt"
            else
                printf "  ${C_YELLOW}·${C_RESET} your distro does not package series %s (newest it ships: %s)\n" \
                    "$tser" "${KB_BEST_VER:-nothing}"
                printf "  ${C_DIM}  compiling %s from source instead — same GRUB one-shot net:%s\n" "$tgt" "${C_RESET}"
                printf "  ${C_DIM}  %s boots once; if it fails, the next reboot lands back on %s by itself.${C_RESET}\n\n" "$tgt" "$REL"
                BUILD_VER="$tgt"
                WANT_META=0
                # An upgrade request means DO it — compile, install, arm the
                # GRUB net. Without this the build route stopped after printing
                # a plan and handed the user a second command to run.
                (( DRY_RUN )) || APPLY_FIX=1
                add_json_field upgrade_target_series "$tser"
                add_json_field upgrade_target_version "$tgt"
                add_json_field upgrade_route "build"
                kz_hist "upgrade target=$tgt route=build series=$tser"
                cmd_build
                return 0
            fi
        else
            info "could not read kernel.org — using your distro's own kernel"
        fi
    fi

    heading "── PLAN ──"
    local target_pkg="" target_rel="" downgrade=0 target_pin=""
    if [[ -n "$TO_PKG" ]]; then
        if [[ "$PKG_MGR" == deb ]]; then
            [[ "$TO_PKG" == linux-* ]] && target_pkg="$TO_PKG" || target_pkg="linux-image-$TO_PKG"
        else
            target_pkg="$TO_PKG"    # pacman/dnf: pass the package name as-is
        fi
        local cand search_hint="apt-cache search linux-image"
        case "$PKG_MGR" in pacman) search_hint="pacman -Ss '^linux'" ;; rpm) search_hint="dnf search kernel" ;; esac
        cand=$(apt_candidate "$target_pkg")
        [[ -z "$cand" || "$cand" == "(none)" ]] && { critf "Target" "$target_pkg not available in repositories" "$search_hint"; exit 2; }
        if ver_gt "$CUR_VER" "${cand}" && [[ $FORCE -eq 0 ]]; then
            critf "Downgrade" "requested $target_pkg ($cand) is older than running $CUR_VER — use --force to allow" "kernelz status shows what you run"
            exit 2
        fi
        downgrade=1
    elif [[ $UPDATE -eq 1 ]]; then
        target_pkg="$META_PKG"
        # The "latest best" kernel is not always the newest package in the
        # repos: a release that landed days ago is still untested. When the
        # recommended kernel carries an OLDER upstream release than the meta
        # candidate, install that exact package instead of the meta (which
        # would pull the fresh one).
        local meta_up="" best_up=""
        meta_up=$(kb_pkg_upstream "$META_CAND" 2>/dev/null) || meta_up=""
        best_up="$KB_BEST_UP"
        if [[ "$WANT_NEWEST" -eq 0 && -n "$KB_BEST_PKG" && -n "$best_up" && -n "$meta_up" \
              && "$best_up" != "$meta_up" && "$KB_BEST_TIER" != "4" ]] \
           && ver_gt "$meta_up" "$best_up"; then
            target_pkg="$KB_BEST_PKG"
            target_pin="=$KB_BEST_VER"
            info "targeting the tested kernel $KB_BEST_VER (series $KB_BEST_SERIES, $(kb_fmt_age "$KB_BEST_DATE") old)"
            info "the repo also has $META_CAND (upstream $meta_up), but it is only $(kb_age_days "$KB_NEW_DATE") day(s) old — use --newest to take it"
        fi
        # dnf's install syntax is name-version, not pkg=version — no pin there
        [[ "$PKG_MGR" == rpm ]] && target_pin=""
    else
        ok "Running kernel $CUR_VER is already the newest (repo candidate: ${META_CAND:-n/a})"
        if [[ -n "$KB_BEST_VER" && "$KB_BEST_VER" != "$CUR_VER" ]]; then
            info "the tested kernel your distro ships is $KB_BEST_VER — run 'kernelz best' for the full picture"
        fi
    fi

    local pkgs_to_install=()
    [[ -n "$target_pkg" ]] && pkgs_to_install+=("${target_pkg}${target_pin}")
    if [[ -n "$target_pkg" && -n "$HDR_PKG" ]]; then pkgs_to_install+=("$HDR_PKG"); fi
    # The generic headers meta package tracks the DEFAULT track, not the
    # flavour being installed. When the target is a concrete kernel, add the
    # headers that MATCH it, or the DKMS build is silently skipped and the
    # new kernel boots without the NVIDIA driver.
    local match_hdr=""
    if [[ -n "$target_pkg" && "$PKG_MGR" == "deb" ]]; then
        local trel="${target_pkg#linux-image-}"
        trel="${trel%%=*}"
        [[ "$trel" == "$target_pkg" ]] && trel=""      # not an image package
        if [[ -n "$trel" ]]; then
            match_hdr=$(headers_pkg_for_release "$trel" 2>/dev/null || true)
            if [[ -n "$match_hdr" && "$match_hdr" != "$HDR_PKG" ]]; then
                pkgs_to_install+=("$match_hdr")
            fi
        fi
    fi

    # Arch replaces the kernel package in place — after -Syu the old kernel is
    # GONE from /boot. A second kernel package is the only boot fallback, so
    # offer one (the Arch equivalent of "the old kernel stays installed").
    if [[ "$PKG_MGR" == pacman && "$META_PKG" == "linux" && ! -e /boot/vmlinuz-linux-lts ]]; then
        local lts_ans="y"
        if [[ $ASSUME_YES -eq 0 ]]; then
            printf "  ${C_YELLOW}?${C_RESET} Arch swaps the kernel in place — install ${C_BOLD}linux-lts${C_RESET} as your boot fallback? [Y/n] "
            read -r lts_ans || lts_ans=y
        fi
        if [[ ! "${lts_ans:-y}" =~ ^[Nn] ]]; then
            pkgs_to_install+=(linux-lts linux-lts-headers)
            info "linux-lts will be the GRUB fallback if the new main kernel fails"
        else
            warnf "Fallback" "no fallback kernel — a bad kernel leaves the GRUB menu nothing older to pick" "sudo pacman -S linux-lts linux-lts-headers"
        fi
    fi

    # Say exactly what is about to be installed — before anything happens.
    local install_cmd="apt-get install -y"
    case "$PKG_MGR" in
        rpm)    install_cmd="$(command -v dnf >/dev/null 2>&1 && echo dnf || echo yum) install -y" ;;
        pacman) install_cmd="pacman -Syu --needed --noconfirm" ;;
    esac
    if [[ -n "$target_pkg" ]]; then
        local tver="${target_pin#=}"
        [[ -z "$tver" ]] && tver=$(apt_candidate "$target_pkg")
        printf "\n"
        printf "  ${C_BOLD}${C_BLUE}TARGET${C_RESET}   ${C_BOLD}%s${C_RESET}  %s\n" "$target_pkg" "$tver"
        printf "  ${C_DIM}currently running:${C_RESET} %s  %s\n" "$REL" "$CUR_VER"
        printf "  ${C_DIM}the old kernel stays installed and bootable — if the new one fails,${C_RESET}\n"
        printf "  ${C_DIM}the next reboot lands back on %s automatically.${C_RESET}\n" "$REL"
        printf "  ${C_DIM}will run:${C_RESET} sudo %s %s\n" "$install_cmd" "${pkgs_to_install[*]}"
        printf "\n"
    fi

    heading "── 1. Refresh & install ──"
    pkg_refresh || warnf "Refresh" "package index refresh failed (offline?)" "retry with network"
    if [[ ${#pkgs_to_install[@]} -gt 0 ]]; then
        # noninteractive prompts keep apt from asking about GRUB device lists
        pkg_install "${pkgs_to_install[@]}" \
            || { critf "Install" "package install failed — nothing changed, you are still on $REL" "re-run with network / check package manager logs"; exit 2; }
    else
        info "nothing to install — ensuring protection for current kernel instead"
    fi

    target_rel=$(newest_installed_release)
    # Arch: filename sort would rank linux-lts above linux — the primary
    # kernel is the one the meta package owns, and that is the target.
    if [[ "$PKG_MGR" == pacman && -n "$META_PKG" && -e "/boot/vmlinuz-$META_PKG" ]]; then
        target_rel="$META_PKG"
    fi
    if [[ -n "$TO_PKG" ]]; then
        # if --to was given as an ABI/version, the exact release is knowable
        local to_rel="${TO_PKG#linux-image-}"
        [[ "$TO_PKG" == linux-* ]] || to_rel="$TO_PKG"
        [[ -f "/boot/vmlinuz-$to_rel" ]] && target_rel="$to_rel"
    elif [[ -n "$target_pin" ]]; then
        # a pinned (deliberately older) target: its release name is known
        local to_rel="${target_pkg#linux-image-}"
        [[ -f "/boot/vmlinuz-$to_rel" ]] && target_rel="$to_rel"
    fi
    [[ -n "$target_rel" ]] || target_rel="$REL"
    if [[ ${#pkgs_to_install[@]} -gt 0 && ! -f "/boot/vmlinuz-$target_rel" ]]; then
        critf "Verify" "install ran but /boot/vmlinuz-$target_rel is missing" "check apt output; kernelz status to inspect"
        exit 2
    fi

    # ── will the GPU survive the reboot? ──────────────────────────────────
    # The proprietary drivers (nvidia) are DKMS modules: they are compiled
    # AGAINST each kernel. A new kernel without them boots to a black
    # screen, or a desktop with no CUDA. This is checked BEFORE the reboot,
    # not after — the apt route used to skip this entirely, so a box with
    # an NVIDIA card could be told "reboot now" while the driver for the
    # new kernel was never built.
    if [[ -n "$target_rel" && "$target_rel" != "$REL" ]]; then
        dkms_audit "$target_rel"
        section_graphics "$target_rel"
        section_network_safety "$target_rel"
    fi

    heading "── 2. Snapshot current state ──"
    local snap ts; ts=$(date +%Y%m%d-%H%M%S)
    # Pick a snapshot dir we can actually write, and make sure it exists —
    # the system dir may exist root-owned while the user fallback was never
    # created (that combination used to make these redirects fail loudly).
    local snapdir="$STATE_SYS/snapshots"
    [[ -d "$snapdir" && -w "$snapdir" ]] || snapdir="$STATE_USR/snapshots"
    [[ "$DRY_RUN" -eq 1 ]] || mkdir -p "$snapdir" 2>/dev/null || true
    [[ "$DRY_RUN" -eq 1 ]] || {
        cp /etc/default/grub "$snapdir/$ts-etc-grub" 2>/dev/null \
            || $SUDO cp /etc/default/grub "$snapdir/$ts-etc-grub" 2>/dev/null \
            || true
        read_grubcfg > "$snapdir/$ts-grub.cfg" 2>/dev/null || true
        installed_image_pkgs > "$snapdir/$ts-kernels.tsv" 2>/dev/null || true
    }
    ok "snapshots + last_good ($REL) recorded"
    state_write last_good "$REL"
    state_write last_good_pkg "$CUR_PKG"

    heading "── 3. GRUB safety net (new kernel boots ONCE, default stays known-good) ──"
    ensure_grub_savedefault || true
    local cfg good_id new_id
    cfg=$(read_grubcfg)
    if [[ -z "$cfg" ]]; then
        critf "GrubCfg" "cannot read grub.cfg" "sudo kernelz verified after reboot"
    else
        [[ -n "$target_rel" ]] || target_rel="$REL"
        if [[ "$target_rel" == "$REL" ]]; then
            # nothing new: pin current as the permanent good default
            read -r -a toks <<< "$(entry_tokens "$REL")"
            if good_id=$(grub_entry_id_for "$cfg" "${toks[@]}"); then
                grub_set_default "$good_id" && ok "permanent default = known-good entry $good_id ($REL)"
            fi
            # Arch upgrades the kernel in place: same entry, new content.
            [[ "$PKG_MGR" == pacman ]] && info "Arch swaps this entry's kernel on reboot — linux-lts is the GRUB menu fallback"
        else
            read -r -a g_toks <<< "$(entry_tokens "$REL")"
            read -r -a n_toks <<< "$(entry_tokens "$target_rel")"
            good_id=$(grub_entry_id_for "$cfg" "${g_toks[@]}")
            new_id=$(grub_entry_id_for "$cfg" "${n_toks[@]}")
            if [[ -z "$good_id" || -z "$new_id" ]]; then
                info "entry lookup failed — running update-grub and retrying"
                grub_regen || true
                cfg=$(read_grubcfg)
                good_id=$(grub_entry_id_for "$cfg" "${g_toks[@]}")
                new_id=$(grub_entry_id_for "$cfg" "${n_toks[@]}")
            fi
            if [[ -n "$good_id" && -n "$new_id" ]]; then
                grub_set_default "$good_id" || warnf "GrubDefault" "grub-set-default failed" "sudo grub-set-default $good_id"
                grub_reboot_cmd "$new_id"       || warnf "GrubReboot"  "grub-reboot failed"       "sudo grub-reboot $new_id"
                ok "default = $REL (entry $good_id) — next boot = $target_rel (entry $new_id), once only"
                printf "  ${C_DIM}If %s fails to boot, the following reboot lands back on %s automatically${C_RESET}\n" "$target_rel" "$REL"
            else
                critf "GrubEntry" "could not resolve GRUB entries for $REL / $target_rel" "sudo update-grub, then re-run kernelz upgrade"
            fi
        fi
    fi

    heading "── 4. Make the package manager unable to void the new kernel ──"
    protect_apply 1

    heading "── 5. Record pending update ──"
    if [[ -n "$target_rel" && "$target_rel" != "$REL" ]]; then
        state_write pending.conf "TARGET_REL=$target_rel
TARGET_PKG=$(pkg_for_release "$target_rel")
PREV_REL=$REL
TS=$TS_EPOCH"
        ok "pending target recorded: $target_rel"
    fi
    kz_hist "upgrade from=$REL to=${target_rel:-$REL} target_pkg=${target_pkg:-none}"

    section "NEXT STEPS"
    if [[ -n "$target_rel" && "$target_rel" != "$REL" ]]; then
        printf "  ${C_BOLD}1.${C_RESET} reboot now:            ${C_CYAN}sudo reboot${C_RESET}\n"
        printf "  ${C_BOLD}2.${C_RESET} after boot:            ${C_CYAN}%s verified${C_RESET}  (promotes new kernel to default)\n" "${0##*/}"
        printf "  ${C_BOLD}3.${C_RESET} if it fails at boot:   GRUB menu → Advanced options → %s → then %s recover\n" "$REL" "${0##*/}"
    else
        printf "  ${C_GREEN}Already on the newest kernel — protections applied, no reboot needed.${C_RESET}\n"
    fi
    printf "  ${C_DIM}You can still run '$PKG_UPGRADE_CMD' any time — kernelz protect holds the line.${C_RESET}\n"
    exit 0
}

# ============================================================================
# LATEST — move to the newest upstream kernel worth trusting
# ----------------------------------------------------------------------------
# `upgrade` answers "what does my distro test and ship?" — on this box that is
# the 6.1 long-term branch: well tested, but an OLDER branch than the kernel
# already running. `latest` answers the other question, "what is the newest
# kernel worth running?", and picks the delivery route itself:
#
#     · distro packages that branch  → apt install (distro-tested, patched)
#     · distro does not              → compile it, same GRUB one-shot net
#
# Either way the current kernel stays the permanent default until the new one
# has proved itself (`kernelz verified`), so a bad jump boots itself back.
# ============================================================================
cmd_latest() {
    gather_kernel_facts
    # A copy of the suite whose lib/ files are out of step with the tool
    # would die with a bare "command not found". Say what is actually wrong.
    kb_check_module kb_latest_trusted kb_recommend || { emit_verdict; return 0; }
    if [[ $EUID -ne 0 && -z "$SUDO" ]]; then
        critf "Privileges" "no root and no sudo available" "run as root"
        emit_verdict
    fi
    if dpkg --audit 2>/dev/null | grep -qiE 'half-installed|half-configured|not fully installed'; then
        warnf "Preflight" "dpkg database has unfinished installs — kernel hooks may fail mid-upgrade" \
            "run 'kernelz fix --apply' first (or continue; install will show the same error)"
    fi
    # `latest` means "take me there": default to the full pipeline, gated by
    # the same confirmation prompt every source build gets. --dry-run previews
    # the plan (and writes the build script) without compiling anything.
    if (( DRY_RUN )); then APPLY_FIX=0; else APPLY_FIX=1; fi

    # --ver pins an exact version, which is what `build --ver` is for. Refuse
    # rather than silently ignoring the pin and building something else.
    if [[ -n "$BUILD_VER" ]]; then
        critf "Target" "kernelz latest picks its own target — --ver pins an exact version, which is 'build --ver'" \
            "run: ${0##*/} build --ver $BUILD_VER   (or drop --ver from latest)"
        emit_verdict
    fi

    ensure_best

    local mode="stable"; (( BUILD_LTS )) && mode="lts"
    if ! with_spin "querying kernel.org" kb_latest_trusted "$mode"; then
        critf "Upstream" "cannot read kernel.org's release table (offline, and no cached copy?)" \
            "retry online — or take a distro kernel: ${0##*/} upgrade · pin one: ${0##*/} build --ver X.Y.Z"
        emit_verdict
    fi

    local tgt="$KB_LATEST_VER" tser="$KB_LATEST_SER"
    local rser rup reol
    rser=$(kb_running_series); rup=$(kb_running_upstream)
    reol=$(kb_series_is_eol "$rser")

    section "LATEST — the newest kernel worth trusting"
    kv() { emit "  ${C_DIM}%-16s${C_RESET} %s\n" "$1" "$2"; }
    kv "Running" "${C_BOLD}$REL${C_RESET}${rser:+  (series $rser)}$( [[ "$reol" == "1" ]] && printf '  %sEND-OF-LIFE upstream%s' "$C_RED$C_BOLD" "$C_RESET" )"
    if [[ -n "$KB_BEST_PKG" ]]; then
        kv "Distro ships" "${KB_BEST_VER}  (series $KB_BEST_SERIES) — $(kb_tier_label "$KB_BEST_TIER")"
    fi
    kv "Upstream stable" "${KB_STABLE_VER:-?}  (series ${KB_STABLE_SER:-?}) · released ${KB_STABLE_ISO:-?} · $(kb_fmt_age "$KB_STABLE_DATE") old"
    kv "TARGET" "${C_BOLD}${tgt}${C_RESET}  (series $tser) · $KB_LATEST_WHY"

    if [[ "$KB_LATEST_FRESH" -eq 1 ]]; then
        printf "  ${C_YELLOW}!${C_RESET} the %s branch opened only %d day(s) ago — brand new, not yet baked\n" \
            "$tser" "$(( KB_SETTLE_DAYS - KB_LATEST_WAIT ))"
        printf "  ${C_DIM}  kernelz normally waits %d days before trusting a new branch (--settle=N changes that)\n" "$KB_SETTLE_DAYS"
        printf "  ${C_DIM}  taking it anyway, because you asked for 'latest' — it boots once and falls back if unhealthy${C_RESET}\n"
    fi
    # Say plainly why this is not the 6.1 the report keeps recommending.
    if [[ -n "$KB_BEST_PKG" && "$KB_BEST_SERIES" != "$tser" ]]; then
        local bage bkind
        bage=$(kb_series_age_days "$KB_BEST_SERIES" 2>/dev/null || echo '?')
        bkind="regular stable"; [[ "$(kb_series_is_lts "$KB_BEST_SERIES")" == "1" ]] && bkind="long-term"
        printf "  ${C_DIM}why not the distro's %s?  it is the newest your repos ship, but it belongs to the\n" "$KB_BEST_VER"
        printf "  ${C_DIM}      %s %s branch (open %s days) — the safe fallback, not the newest code.%s\n" \
            "$bkind" "$KB_BEST_SERIES" "$bage" "${C_RESET}"
    fi
    printf "\n"

    # ---- already there? ----
    if ver_ge "$CUR_VER" "$tgt"; then
        if [[ "$reol" == "1" ]]; then
            warnf "KernelEOL" "you run $REL (series $rser) — end-of-life upstream — and $tgt is not newer than it" \
                "the supported move is upstream's current stable: ${0##*/} latest"
        else
            ok "already running the newest kernel worth trusting: $REL (≥ $tgt)"
        fi
        add_json_field latest_target "$tgt"
        add_json_field latest_series "$tser"
        add_json_field latest_route "none"
        kz_hist "latest target=$tgt route=none (already there)"
        emit_verdict
    fi

    # ---- route 1: the distro packages this branch → apt ----
    if kb_repo_pick_for "$tser"; then
        local cup="$KB_PICK_UP"
        [[ -z "$cup" ]] && cup=$(kb_pkg_upstream "$KB_PICK_VER" 2>/dev/null) || true
        if [[ -z "$cup" ]] || ver_gt "$cup" "$CUR_VER"; then
            ok "your distro packages series $tser — installing through apt (distro-tested + security-updated)"
            info "target: $KB_PICK_PKG $KB_PICK_VER${cup:+  (upstream $cup)}"
            # The distro's copy of the branch can be based on an OLDER
            # upstream release than upstream's current stable — Ubuntu
            # versions kernels by ABI (7.3.0-1004.4 IS the 7.3 branch, not
            # upstream 7.3.0). Without this, "TARGET 7.3.4" over
            # "install 7.3.0" reads like a downgrade, and the way to take
            # upstream's exact release stays invisible.
            if [[ -n "$cup" ]] && ver_gt "$tgt" "$cup"; then
                local gap="behind upstream's current stable ($tgt)"
                if [[ "$cup" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "$tgt" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ \
                      && "${cup%.*}" == "${tgt%.*}" ]] && (( ${tgt##*.} > ${cup##*.} )); then
                    gap="$(( ${tgt##*.} - ${cup##*.} )) stable release(s) behind $tgt"
                fi
                printf "  ${C_YELLOW}·${C_RESET} the distro's copy is based on upstream %s — %s\n" "$cup" "$gap"
                printf "  ${C_DIM}  it still carries the distro's own security backports; to take upstream's exact release:\n"
                printf "  ${0##*/} build --ver %s${C_RESET}\n" "$tgt"
            fi
            add_json_field latest_target "$tgt"
            add_json_field latest_series "$tser"
            add_json_field latest_route "apt"
            kz_hist "latest target=$tgt route=apt pkg=$KB_PICK_PKG ver=$KB_PICK_VER"
            TO_PKG="$KB_PICK_PKG"
            cmd_upgrade
            return 0
        fi
        info "your distro's copy of $tser ($KB_PICK_VER) is not newer than what you run ($CUR_VER) — building $tgt instead"
    else
        printf "  ${C_YELLOW}·${C_RESET} your distro does not package series %s (newest it ships: %s) — building it from source\n" \
            "$tser" "${KB_BEST_VER:-nothing}"
        printf "  ${C_DIM}  same GRUB one-shot net as 'kernelz upgrade': %s boots once, and a failed boot\n" "$tgt"
        printf "  ${C_DIM}  lands back on %s by itself.${C_RESET}\n" "$REL"
    fi
    printf "\n"

    # ---- route 2: build it (same safety net) ----
    BUILD_VER="$tgt"
    WANT_META=0
    add_json_field latest_target "$tgt"
    add_json_field latest_series "$tser"
    add_json_field latest_route "build"
    kz_hist "latest target=$tgt route=build fresh=$KB_LATEST_FRESH"
    cmd_build
    return 0
}

# ============================================================================
# BUILD — compile the latest mainline kernel from source (same safety net)
# ============================================================================
KERNEL_ORG_JSON="https://www.kernel.org/releases.json"
KERNEL_GIT="https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git"
BUILD_FLAVOR="deb"
TOOLCHAIN_FIX_CMD=""
TOOLCHAIN_INSTALL_HINT=""
BUILD_LOG=""
BUILD_LAST_ERR=""
CFG_CMD=""
CFG_LABEL=""
BUILD_SCRIPT=""
BUILD_HAVE_DEBS=0

build_pkg_manager() {
    if   command -v apt-get  >/dev/null 2>&1; then echo deb
    elif command -v dnf      >/dev/null 2>&1; then echo rpm
    elif command -v rpm      >/dev/null 2>&1; then echo rpm
    elif command -v pacman   >/dev/null 2>&1; then echo pacman
    else echo none; fi
}

build_derive_urls() {   # $1 = version -> UP_* set
    UP_VER="$1"
    UP_SERIES="v${UP_VER%%.*}.x"
    UP_TARBALL="linux-${UP_VER}.tar.xz"
    UP_URL="https://cdn.kernel.org/pub/linux/kernel/${UP_SERIES}/${UP_TARBALL}"
    UP_SHAURL="https://cdn.kernel.org/pub/linux/kernel/${UP_SERIES}/sha256sums.asc"
}

# kernel.org publishes a release under vX.x for the current series and under
# vX.Y for every other (long-term) branch. Its feed already carries the real
# tarball URL, so use that instead of guessing the directory.
build_adopt_source() {   # $1 = version, $2 = source url from the feed
    local v="$1" src="$2" dir tar
    [[ -z "$v" || -z "$src" ]] && return 0
    dir="${src%/*}"; tar="${src##*/}"
    [[ "$dir" == *"/pub/linux/kernel/"* ]] || return 0
    UP_SERIES="${dir##*/}"
    [[ -n "$UP_SERIES" ]] || return 0
    UP_TARBALL="$tar"
    UP_URL="$src"
    UP_SHAURL="https://cdn.kernel.org/pub/linux/kernel/${UP_SERIES}/sha256sums.asc"
    return 0
}

build_latest_query() {   # sets UP_* on success
    local json=""
    json=$(curl -fsS --max-time 15 "$KERNEL_ORG_JSON" 2>/dev/null) || json=""
    if [[ -z "$json" ]] && command -v wget >/dev/null 2>&1; then
        json=$(wget -qO- --timeout=15 "$KERNEL_ORG_JSON" 2>/dev/null) || json=""
    fi
    local v="" src=""
    if [[ -n "$json" ]] && command -v jq >/dev/null 2>&1; then
        if (( BUILD_LTS )); then
            # Long-term rows are marked either by the "longterm" moniker or
            # by a non-false .longterm field — accept both.
            v=$(printf '%s' "$json" | jq -r '
                [.releases[]
                 | select((.moniker == "longterm")
                          or (.longterm != false and .longterm != null))
                 | .version | select(test("^[0-9]+\\.[0-9]+\\.[0-9]+$"))] | .[0] // empty' 2>/dev/null)
            [[ -z "$v" ]] && warnf "SourceNet" "kernel.org feed carries no longterm markers — showing latest stable instead" \
                "pin an LTS explicitly: kernelz build --ver 6.12.x"
        fi
        if [[ -z "$v" ]]; then
            # the current stable branch — never an end-of-life one
            v=$(printf '%s' "$json" | jq -r '
                [.releases[]
                 | select(.moniker == "stable" and (.iseol != true))
                 | .version | select(test("^[0-9]+\\.[0-9]+\\.[0-9]+$"))] | .[0] // empty' 2>/dev/null)
        fi
        if [[ -z "$v" ]]; then
            v=$(printf '%s' "$json" | jq -r '
                [.releases[] | .version
                 | select(test("^[0-9]+\\.[0-9]+\\.[0-9]+$"))] | .[0] // empty' 2>/dev/null)
        fi
        if [[ -n "$v" ]]; then
            src=$(printf '%s' "$json" | jq -r --arg v "$v" '
                [.releases[] | select(.version == $v) | .source] | .[0] // empty' 2>/dev/null)
        fi
    fi
    if [[ -z "$v" ]] && command -v git >/dev/null 2>&1; then   # offline-json fallback: git tags
        v=$(timeout 30 git ls-remote --tags --refs "$KERNEL_GIT" 'v[0-9]*' 2>/dev/null \
            | awk -F/ '{print $NF}' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sed 's/^v//' \
            | sort -V | tail -1)
    fi
    [[ -n "$v" ]] || return 1
    build_derive_urls "$v"
    [[ -n "$src" ]] && build_adopt_source "$v" "$src"
    return 0
}

# The list of packages a source build needs is filled here and READ by the
# plan, the build script and the BuildFail remediation — hence globals.
TOOLCHAIN_MISSING=()
TOOLCHAIN_NEEDED=0

# toolchain_scan — pure DETECTION: fill TOOLCHAIN_MISSING[], TOOLCHAIN_FIX_CMD
# and TOOLCHAIN_NEEDED, set BUILD_FLAVOR, and return 0 when nothing is missing.
# It deliberately reports nothing: whether a gap is a dry-run finding, an
# offer to install, or an abort is the CALLER's decision. Reporting here is
# what used to let `kernelz build` print "missing build packages (5)" and then
# go on to download, unpack and fail at `flex: not found` anyway.
toolchain_scan() {
    local -a need=()
    local mgr p st
    TOOLCHAIN_MISSING=()
    TOOLCHAIN_FIX_CMD=""
    TOOLCHAIN_NEEDED=0
    TOOLCHAIN_INSTALL_HINT=""
    mgr=$(build_pkg_manager)
    case "$mgr" in
        # bindeb-pkg ends the compile with dpkg-checkbuilddeps, which demands
        # debhelper-compat (= 12) and libdw-dev:native — and dwarves only
        # pulls pahole, so neither arrives on its own. Without them the build
        # compiles for 30-90 min and then aborts at the PACKAGE step, having
        # spent all that time on a gap a 10-second scan could have seen.
        deb)    need=(build-essential bc flex bison libssl-dev libelf-dev dwarves
                      rsync cpio dpkg-dev libncurses-dev git curl
                      debhelper libdw-dev) ;;
        rpm)    need=(gcc make bc flex bison openssl-devel elfutils-libelf-devel
                      dwarves rsync cpio rpm-build ncurses-devel git) ;;
        pacman) need=(base-devel bc flex bison openssl libelf rsync cpio pahole ncurses git) ;;
        *)      warnf "BuildToolchain" "unrecognized package manager — verify gcc/make/bc/flex/bison/openssl/elf manually" \
                    "see https://docs.kernel.org/build/initializing.html"; BUILD_FLAVOR=plain; return 0 ;;
    esac
    [[ "$mgr" == "deb" ]] && BUILD_FLAVOR=deb
    [[ "$mgr" == "rpm" ]] && BUILD_FLAVOR=rpm
    [[ "$mgr" == "pacman" ]] && BUILD_FLAVOR=plain
    TOOLCHAIN_NEEDED=${#need[@]}
    # The install line for the WHOLE toolchain, missing or not: it is baked
    # into the generated build script as its preflight hint, and that script
    # can be run by hand long after this scan.
    case "$mgr" in
        deb)    TOOLCHAIN_INSTALL_HINT="sudo apt-get install -y ${need[*]}" ;;
        rpm)    TOOLCHAIN_INSTALL_HINT="sudo dnf install -y ${need[*]}" ;;
        pacman) TOOLCHAIN_INSTALL_HINT="sudo pacman -S --noconfirm ${need[*]}" ;;
    esac
    for p in "${need[@]}"; do
        case "$mgr" in
            deb)    st=$(pkg_state "$p") ;;
            rpm)    rpm -q "$p" >/dev/null 2>&1 && st="ii" || st="" ;;
            pacman) pacman -Qi "$p" >/dev/null 2>&1 && st="ii" || st="" ;;
        esac
        [[ "$st" == ii* || "$st" == hi* ]] || TOOLCHAIN_MISSING+=("$p")
    done
    (( ${#TOOLCHAIN_MISSING[@]} == 0 )) && return 0
    case "$mgr" in
        deb)    TOOLCHAIN_FIX_CMD="sudo apt-get install -y ${TOOLCHAIN_MISSING[*]}" ;;
        rpm)    TOOLCHAIN_FIX_CMD="sudo dnf install -y ${TOOLCHAIN_MISSING[*]}" ;;
        pacman) TOOLCHAIN_FIX_CMD="sudo pacman -S --noconfirm ${TOOLCHAIN_MISSING[*]}" ;;
    esac
    return 1
}

# The scan found gaps. A build started anyway cannot work — make dies at
# `flex: not found` only AFTER the tarball has been fetched and unpacked —
# so offer to install them here, before any work starts. Declining, or an
# install that does not stick, ABORTS with the exact command to run by hand.
# Returns 0 only when the toolchain is provably complete.
# Install whatever the scan found missing — no prompt, no "run this by hand
# and re-run". A missing library is not a decision for the user to make: the
# build either has it or it cannot run, so detect it, install it, verify it,
# and only then fall back to the exact line when even THAT is impossible
# (no TTY for the sudo password, or the package is not in the repos).
toolchain_provision() {
    (( ${#TOOLCHAIN_MISSING[@]} == 0 )) && return 0
    local -a pkgs=("${TOOLCHAIN_MISSING[@]}")

    info "missing build packages (${#pkgs[@]}): ${pkgs[*]} — installing them now"
    if ! pkg_install "${pkgs[@]}"; then
        # A stale (or never-updated) package list is the usual reason an
        # install refuses a package that the repos do carry — refresh once
        # and retry before giving up on the whole build.
        info "the package manager refused them — refreshing its lists and retrying once"
        pkg_refresh || true
        if ! pkg_install "${pkgs[@]}"; then
            critf "BuildToolchain" "could not install the build packages: ${pkgs[*]}" \
                "$TOOLCHAIN_FIX_CMD   (run it by hand — the manager's own error is above)"
            return 1
        fi
    fi
    if ! toolchain_scan; then
        critf "BuildToolchain" "still missing after install: ${TOOLCHAIN_MISSING[*]}" "$TOOLCHAIN_FIX_CMD"
        return 1
    fi
    ok "build toolchain complete — installed ${#pkgs[@]} package(s): ${pkgs[*]} · $TOOLCHAIN_NEEDED verified"
    return 0
}

build_resource_check() {
    local free_kb gb probe
    probe="$BUILD_DIR"
    while [[ ! -d "$probe" && "$probe" != "/" ]]; do probe=$(dirname "$probe"); done
    free_kb=$(df -Pk "$probe" 2>/dev/null | awk 'NR==2{print $4}'); free_kb=${free_kb:-0}
    gb=$(( free_kb / 1024 / 1024 ))
    if (( gb < 25 )); then
        warnf "BootSpace" "build filesystem ($probe) has ${gb}G free — source build needs ~25-30G" \
            "free space, or point at a bigger disk: kernelz build --dir=/path/to/30G+disk"
    else
        ok "build space: ${gb}G free at $probe"
    fi
    local bfree; bfree=$(( $(boot_free_kb 2>/dev/null || echo 0) / 1024 ))
    if (( bfree < 150 )); then
        warnf "BootSpace" "/boot has only ${bfree}M free — a new kernel's vmlinuz+initrd+config won't fit" \
            "kernelz cleanup previews safe purge of old kernels"
    else
        ok "/boot: ${bfree}M free"
    fi
    local mt; mt=$(awk '/MemTotal/{print $2}' /proc/meminfo 2>/dev/null)
    if (( ${mt:-0} > 0 && mt < 8388608 )); then
        info "RAM $(( mt / 1024 / 1024 ))G — for full configs consider --minimal (localmodconfig) and -j 4"
    fi
    local sw; sw=$(awk '/^SwapTotal/{print $2}' /proc/meminfo 2>/dev/null)
    (( ${sw:-0} == 0 )) && info "no swap — link steps can OOM at high -j; --minimal lowers the peak"
}

build_config_plan() {
    if [[ -r /proc/config.gz ]]; then
        CFG_LABEL="/proc/config.gz (live config of $REL)"
        CFG_CMD="zcat /proc/config.gz > .config"
    elif [[ -r "/boot/config-$REL" ]]; then
        CFG_LABEL="/boot/config-$REL"
        CFG_CMD="cp /boot/config-$REL .config"
    else
        CFG_LABEL="defconfig (no readable config of the running kernel)"
        CFG_CMD="make defconfig"
        warnf "Pending" "cannot read running kernel config — plan falls back to defconfig" \
            "install linux-cloud-tools/kernel config module, or reuse an old /boot/config-*"
    fi
    info "config base: $CFG_LABEL → make olddefconfig$( ((BUILD_MINIMAL)) && echo ' + localmodconfig (minimal)')"

    # Preemption profile: show what will be applied so a wrong
    # auto-detection is visible in the plan, before any time is spent
    # compiling.
    local prof mode
    prof=$(detect_profile)
    mode=$(profile_preempt "$prof")
    if has_preempt_dynamic; then
        info "profile: ${prof} → preempt=${mode} (PREEMPT_DYNAMIC: set at boot, no rebuild)"
    else
        info "profile: ${prof} → preempt=${mode} (no PREEMPT_DYNAMIC: must be baked into .config)"
    fi
}

build_script_write() {
    BUILD_SCRIPT="${HOME}/kernelz-build-${UP_VER}.sh"
    cat > "$BUILD_SCRIPT" <<EOS
#!/usr/bin/env bash
# kernelz build script — linux ${UP_VER} (generated $(date '+%F %T'))
# Compiles + packages ONLY. Installing and the GRUB one-shot safety net are
# applied by 'kernelz build --apply' (or follow the NEXT STEPS it prints).
set -euo pipefail
VER="${UP_VER}"; SERIES="${UP_SERIES}"; TARBALL="${UP_TARBALL}"
URL="${UP_URL}"; SHA_URL="${UP_SHAURL}"
BUILDDIR="${BUILD_DIR}"; JOBS=${JOBS_N}; MINIMAL=${BUILD_MINIMAL}; TARGET="${BUILD_FLAVOR}"
MODE="${BUILD_GIT}"; GITREPO="${KERNEL_GIT}"

# --jobs N overrides parallelism from the command line. kernelz's build
# auto-recovery uses it to retry a compile that was OOM-killed with fewer
# jobs instead of dying on the same wall again. Must be escaped in this
# heredoc: it is expanded when the script is WRITTEN, not when it runs.
if [ "\${1:-}" = "--jobs" ] && [ -n "\${2:-}" ]; then JOBS="\$2"; fi

# ── preflight ─────────────────────────────────────────────────────────────
# The compiler must exist BEFORE the download, not at the olddefconfig step,
# where a missing flex/bison used to surface 155 MB and a minute later as a
# bare "flex: not found" with no hint of what to install. This script is also
# offered for hand-running (NEXT STEPS), so it carries its own guard.
NEED_TOOLS="gcc make flex bison openssl tar xz curl"
MISSING_TOOLS=""
for _t in \$NEED_TOOLS; do
    command -v "\$_t" >/dev/null 2>&1 || MISSING_TOOLS="\$MISSING_TOOLS \$_t"
done
if [[ -n "\$MISSING_TOOLS" ]]; then
    echo "  ✗ missing build tools:\$MISSING_TOOLS" >&2
    echo "  ↳ install the build toolchain, then re-run this script:" >&2
    echo "      ${TOOLCHAIN_INSTALL_HINT:-sudo apt-get install -y build-essential flex bison libssl-dev libelf-dev dwarves libncurses-dev}" >&2
    exit 1
fi
echo "── [0/3] toolchain preflight ok (\$NEED_TOOLS)"

mkdir -p "\$BUILDDIR"
if [[ "\$MODE" == "1" ]]; then
    # ── git incremental: same tree, only changed files rebuild next version
    SRC="\$BUILDDIR/linux-git"
    echo "── [1/3] git: fetch tag v\$VER (shallow) into \$SRC"
    if [[ ! -d "\$SRC/.git" ]]; then
        git init -q "\$SRC"
        git -C "\$SRC" remote add origin "\$GITREPO"
    fi
    git -C "\$SRC" fetch --depth=1 origin tag "v\$VER"
    git -C "\$SRC" -c advice.detachedHead=false checkout -f "v\$VER"
    git -C "\$SRC" verify-tag "v\$VER" 2>/dev/null \\
        && echo "  ✓ tag signature verified against a trusted kernel maintainer key" \\
        || echo "  · tag signature not verifiable here (no keyring) — integrity rides on the tag name"
else
    SRC="\$BUILDDIR/linux-\$VER"
    cd "\$BUILDDIR"
    echo "── [1/3] fetch \$TARBALL"
    if [[ ! -s "\$TARBALL" ]]; then
        curl -fLO --retry 3 "\$URL" || wget -c "\$URL"
    fi
    echo "── [2/3] verify sha256"
    curl -fsSL --retry 3 "\$SHA_URL" -o sha256sums.asc || wget -q "\$SHA_URL" -O sha256sums.asc
    grep -F "\$TARBALL" sha256sums.asc | sha256sum -c -
    echo "── unpack"
    [[ -d "\$SRC" ]] || tar -xf "\$TARBALL"
fi
cd "\$SRC"
echo "── configure (base: ${CFG_LABEL})"
[[ -f .config ]] || { ${CFG_CMD}; }
# A distro config points at files the DISTRO's packaging ships — Ubuntu sets
#   CONFIG_SYSTEM_TRUSTED_KEYS="debian/canonical-certs.pem"
# which exists only inside its own source package. Against a vanilla tarball
# that is a dead build, before a single line of C is compiled:
#   No rule to make target 'debian/canonical-certs.pem'   (certs/)
# Clear any key path this tree does not actually have; the modules are signed
# with this build's own key anyway, so nothing of value is lost.
sanitize_distro_paths() {
    local _k _v _bad _p
    for _k in SYSTEM_TRUSTED_KEYS SYSTEM_REVOCATION_KEYS SYSTEM_EXTRA_CERTS; do
        _v=\$(sed -n -E "s/^CONFIG_\${_k}=\"(.*)\"\$/\1/p" .config 2>/dev/null || true)
        [[ -n "\$_v" ]] || continue
        _bad=""
        for _p in \$_v; do [[ -e "\$_p" ]] || _bad="\$_bad \$_p"; done
        [[ -n "\$_bad" ]] || continue
        echo "  · CONFIG_\${_k} asks for\$_bad — absent from this source tree (a distro packaging path); clearing it"
        sed -i -E "s|^CONFIG_\${_k}=.*|CONFIG_\${_k}=\"\"|" .config || return 1
    done
    return 0
}
sanitize_distro_paths
make olddefconfig
if [[ "\$MINIMAL" == "1" ]]; then make localmodconfig || true; make olddefconfig; fi
# And again AFTER settling: olddefconfig re-reads Kconfig, so a distro's
# default can walk straight back in. The value the build actually reads is
# the one that must be clean.
sanitize_distro_paths
if [[ "\$MINIMAL" == "1" ]]; then make localmodconfig || true; make olddefconfig; fi
echo '-kz' > localversion-kernelz    # uname becomes <ver>-kz: apt-proof, unmistakable in GRUB
echo "── build (-j\$JOBS; first pass 30-90 min, --git reruns only rebuild what changed)"
case "\$TARGET" in
    deb) make -j"\$JOBS" bindeb-pkg ;;
    rpm) make -j"\$JOBS" rpm-pkg ;;
    *)   echo "plain target — run as root when ready:"
         echo "  sudo make modules_install install && sudo grub-mkconfig -o /boot/grub/grub.cfg" ;;
esac
echo "── artifacts in \$BUILDDIR:"
ls -1 "\$BUILDDIR"/linux-image-*.deb "\$BUILDDIR"/linux-headers-*.deb "\$BUILDDIR"/linux-libc-dev_*.deb 2>/dev/null || true
ls -1 "\$BUILDDIR"/rpm/RPMS/*/kernel-*.rpm 2>/dev/null || true
echo
echo "Done. Install + GRUB safety net: sudo ${SCRIPT_DIR}/kernelz build --apply --ver \$VER$( ((BUILD_GIT)) && echo ' --git')"
EOS
    chmod +x "$BUILD_SCRIPT" 2>/dev/null || true
    ok "build script written: $BUILD_SCRIPT"
}

# ---------- build: log the compile, then recover from what it says ----------
# BUILD_LOG / BUILD_LAST_ERR / BUILD_MAX_TRIES are declared with the other
# build globals (see BUILD_FLAVOR) — here be only the behaviour.
#
# The compile used to stream straight to the terminal: once those 90 minutes
# scrolled away, all that remained was make's own cascade —
#
#     make[4]: *** [Makefile:2229: .] Error 2
#
# which names no cause at all, so a failure could only ever be reported as
# "read the output above". Everything is now teed to a log, the first line
# that is NOT make's cascade is pulled out of it, and the three failures with
# an obvious fix — out of memory, a missing tool, unmet build-deps — are fixed
# and RETRIED automatically. make is incremental, so a retry resumes from the
# objects already compiled instead of spending the 90 minutes again.
BUILD_MAX_TRIES=3

build_log_path() { printf '%s\n' "${BUILD_SCRIPT%.sh}.log"; }

# The first line that actually explains the failure. make's own recursion
# ("make[1]: *** [...] Error 2") and dpkg's wrapper only say a sub-make
# failed — they never say why, so they are skipped and the real line wins.
#
# Fallback: if the log holds nothing BUT that cascade (the failure happened
# where no diagnostic was printed), the FIRST cascade line is returned — it
# names the innermost failing target ("make[4]: *** [Makefile:2229: .]"),
# which is the most specific thing available. An empty "no error line
# captured" would tell the user nothing they can act on.
build_first_error() {
    local log="$1"
    [[ -s "$log" ]] || return 1
    awk '
        /^[ \t]*(make(\[[0-9]+\])?: \*\*\*|dpkg-buildpackage: error: make )/ {
            if (cascade == "") cascade=$0
            next
        }
        /error:|Error [0-9]+|[Nn]ot found|undefined reference|Killed|memory exhausted|Out of memory|unmet build dependencies/ {
            if (!found) { real=$0; found=1 }
        }
        { if ($0 !~ /^[ \t]*$/) last=$0 }
        END {
            if (found) print real
            else if (cascade != "") print cascade
            else if (last != "") print last
        }
    ' "$log"
}

# oom | deps | tool | unknown — which automatic fix is worth trying.
build_classify() {
    local log="$1" err="${2:-}"
    # The OOM killer does not always get a line into the build's own output,
    # so the kernel log is consulted too before ruling OOM out.
    if grep -qiE 'virtual memory exhausted|out of memory|cannot allocate memory|killed signal|cc1:.*[Kk]illed' "$log" 2>/dev/null; then
        printf 'oom'; return 0
    fi
    if journalctl -k --since "-45 min" --no-pager 2>/dev/null | grep -qiE 'oom-kill|Out of memory: Killed'; then
        printf 'oom'; return 0
    fi
    grep -qi 'unmet build dependencies' "$log" 2>/dev/null && { printf 'deps'; return 0; }
    # A config copied from a DISTRO kernel references files only that distro's
    # packaging ships (debian/canonical-certs.pem). Against a vanilla tree
    # make stops before compiling anything — a known cause with a known fix.
    [[ "$err" == *"No rule to make target"* ]] && { printf 'cfgpath'; return 0; }
    [[ "$err" =~ [Nn]ot\ found ]] && { printf 'tool'; return 0; }
    printf 'unknown'
}

# command name from a shell's "not found" line → the package that provides it.
build_tool_pkg() {
    case "$1" in
        flex) echo flex ;;          bison) echo bison ;;        bc) echo bc ;;
        perl) echo perl ;;          python3|python) echo python3 ;;
        make) echo make ;;          gcc|cc) echo gcc ;;
        ld|as|objcopy|nm|strip|ranlib) echo binutils ;;
        curl) echo curl ;;          cpio) echo cpio ;;
        rsync) echo rsync ;;        tar) echo tar ;;
        xz) echo xz-utils ;;        git) echo git ;;
        pahole) echo dwarves ;;
        dpkg-buildpackage|dpkg-checkbuilddeps|dpkg-architecture|dpkg-parsechangelog) echo dpkg-dev ;;
        dh|dh_*|dh_listpackages) echo debhelper ;;
        fakeroot) echo fakeroot ;;
        *) echo "" ;;
    esac
}

# The missing command's name out of "sh: 1: flex: not found" / "flex: command not found".
build_missing_cmd() {
    grep -oiE '[A-Za-z0-9_+.-]+: (command )?not found' "$1" 2>/dev/null \
        | head -1 | sed -E 's/: (command )?[Nn]ot found//'
}

# The file make could not build, out of
#   No rule to make target 'debian/canonical-certs.pem', needed by ...
build_missing_cfg_path() {
    local line="${1:-}"
    line=$(printf '%s' "$line" | sed -E $'s/\033\\[[0-9;]*[A-Za-z]//g')   # the log is teed WITH colour
    printf '%s' "$line" | sed -nE "s/.*No rule to make target '([^']+)'.*/\1/p"
}

# Where the source tree lives — recovery runs from kernelz's own cwd.
build_tree_dir() {
    if (( BUILD_GIT )); then printf '%s/linux-git' "$BUILD_DIR"
    else printf '%s/linux-%s' "$BUILD_DIR" "${UP_VER:-unknown}"; fi
}

# .config asks for a file this tree does not have — a DISTRO packaging path
# (Ubuntu's debian/canonical-certs.pem) that exists only in the distro's own
# source package. Clear the reference; the modules are signed with this
# build's own key anyway, so nothing of value is lost, and the next pass gets
# past certs/ instead of dying on the same line. Returns 0 only when it
# actually changed something — no change means a retry cannot help, and the
# loop must stop and report instead of burning passes.
build_clear_cfg_ref() {
    local want="$1" f line k v changed=0
    local -a keys=()
    f="$(build_tree_dir)/.config"
    [[ -f "$f" ]] || return 1
    while IFS= read -r line; do
        [[ "$line" == CONFIG_*'='* ]] || continue
        k="${line%%=*}"; v="${line#*=}"
        v="${v#\"}"; v="${v%\"}"
        [[ "$v" == "$want" || "$v" == *"$want"* ]] || continue
        keys+=("$k")
    done < "$f"
    (( ${#keys[@]} )) || return 1
    for k in "${keys[@]}"; do
        printf "  ${C_YELLOW}·${C_RESET} clearing %s — it references %s, which this source tree does not have\n" "$k" "$want"
        # The tree is root-owned (the build script runs under sudo), so this
        # must too — a silent sed failure here would burn a retry and then
        # report the ORIGINAL error as if nothing had been tried.
        $SUDO sed -i -E "s|^${k}=.*|${k}=\"\"|" "$f" || return 1
        changed=1
    done
    (( changed ))
}

# "unmet build dependencies: debhelper-compat (= 12) libdw-dev:native" → package
# names, with version constraints and arch qualifiers dropped. A virtual name
# (debhelper-compat) is resolved to the package that Provides it, or apt would
# refuse the very install that is meant to unblock the build.
#
# apt-cache show exits 0 for a VIRTUAL package while printing nothing, so
# output must be tested — an exit-status test alone silently passed
# debhelper-compat straight through and the recovery install then failed.
build_unmet_pkgs() {
    local line pkgs p prov out
    line=$(grep -oiE 'unmet build dependencies:.*' "$1" 2>/dev/null | head -1)
    [[ -z "$line" ]] && return 1
    line=$(printf '%s' "$line" | sed -E 's/.*unmet build dependencies:[[:space:]]*//; s/\([^)]*\)//g; s/:[A-Za-z0-9-]+//g')
    for p in $line; do
        [[ "$p" =~ ^[a-z0-9][a-z0-9+.-]*$ ]] || continue
        prov=""
        out=$(apt-cache show "$p" 2>/dev/null | head -1)
        if [[ -z "$out" ]]; then
            prov=$(apt-cache showpkg "$p" 2>/dev/null | awk '/^Reverse Provides:/{f=1;next} f && NF {print $1; exit}')
            [[ -z "$prov" ]] && continue
            p="$prov"
        fi
        pkgs="$pkgs $p"
    done
    printf '%s' "${pkgs# }"
}

# Compile with every line teed to $BUILD_LOG, then recover from the failures
# that have a known fix. Returns 0 when the packages are built.
#
# Recovery is bounded: each fix is attempted at most once, at most
# BUILD_MAX_TRIES passes run, and anything unrecognized stops immediately with
# the first real error line rather than burning another 90 minutes guessing.
# A successful recovery leaves NO critical in the verdict — the run is clean,
# because nothing is actually wrong once it has been fixed.
build_compile() {
    local jobs="${1:-$(nproc 2>/dev/null || echo 4)}"
    local rc=0 err="" kind cmd pkg newj dpkgs cpath attempt=1
    local tried_oom=0 tried_tool=0 tried_deps=0 tried_cfg=0
    local -a args=()

    BUILD_LOG=$(build_log_path)
    : > "$BUILD_LOG" 2>/dev/null || BUILD_LOG="/tmp/kernelz-build-${UP_VER:-unknown}.log"
    args=(--jobs "$jobs")

    while true; do
        (( attempt > 1 )) && info "retry #$((attempt - 1)) — resuming; make skips everything already compiled"
        printf "  ${C_DIM}\$ %s bash %s --jobs %s  ${C_DIM}(every line logged to %s)${C_RESET}\n" \
            "$SUDO" "$BUILD_SCRIPT" "$jobs" "$BUILD_LOG"
        rc=0
        # shellcheck disable=SC2086
        $SUDO bash "$BUILD_SCRIPT" "${args[@]}" 2>&1 | tee -a "$BUILD_LOG"
        rc=${PIPESTATUS[0]}
        if (( rc == 0 )); then
            (( attempt > 1 )) && ok "compile finished on retry #$((attempt - 1)) — the earlier work was reused"
            return 0
        fi

        (( attempt >= BUILD_MAX_TRIES )) && break
        err=$(build_first_error "$BUILD_LOG") || err=""
        kind=$(build_classify "$BUILD_LOG" "$err")

        case "$kind" in
            oom)
                (( tried_oom || jobs <= 2 )) && break
                tried_oom=1
                newj=$(( jobs / 2 )); (( newj < 2 )) && newj=2
                info "ran out of memory at -j$jobs — retrying with -j$newj"
                jobs=$newj; args=(--jobs "$jobs")
                attempt=$(( attempt + 1 )); continue ;;
            tool)
                (( tried_tool )) && break
                cmd=$(build_missing_cmd "$BUILD_LOG")
                pkg=$(build_tool_pkg "$cmd")
                [[ -z "$cmd" || -z "$pkg" ]] && break
                tried_tool=1
                info "tool '$cmd' is missing — installing $pkg, then retrying"
                pkg_install "$pkg" || break
                attempt=$(( attempt + 1 )); continue ;;
            deps)
                (( tried_deps )) && break
                dpkgs=$(build_unmet_pkgs "$BUILD_LOG")
                [[ -z "$dpkgs" ]] && break
                tried_deps=1
                info "build dependencies unmet — installing: $dpkgs"
                # shellcheck disable=SC2086
                pkg_install $dpkgs || break
                attempt=$(( attempt + 1 )); continue ;;
            cfgpath)
                # The config points at a file this tree does not have. This is
                # not a compile error at all: it happens before any C runs, so
                # clearing the reference loses NOTHING and the pass resumes
                # from the config instead of from zero.
                (( tried_cfg )) && break
                cpath=$(build_missing_cfg_path "$err")
                [[ -z "$cpath" ]] && break
                tried_cfg=1
                info "the config asks for '$cpath', which this source tree does not have — clearing the reference"
                build_clear_cfg_ref "$cpath" || break
                attempt=$(( attempt + 1 )); continue ;;
        esac
        break                      # unrecognized, or a fix already tried
    done

    # ---- give up: say exactly WHAT failed and WHERE the evidence is ----
    err=$(build_first_error "$BUILD_LOG") || err=""
    [[ -z "$err" ]] && err="no error line captured — see the log"
    printf "\n  ${C_RED}first error:${C_RESET} %s\n" "$err"
    printf "  ${C_DIM}full log (survives scrollback): %s${C_RESET}\n" "$BUILD_LOG"
    BUILD_LAST_ERR="$err"
    return 1
}

confirm_or_abort() {   # $1 = prompt
    (( ASSUME_YES )) && return 0
    [[ -t 0 ]] || { critf "Confirm" "non-interactive session and no -y — refusing to start a 30-90 min build" \
        "re-run with -y (or --dry-run to review the plan)"; exit 2; }
    printf "  %s [y/N] " "$1"
    local a; read -r a || a=""
    [[ "${a,,}" == y* ]] || { info "aborted — plan and script remain available"; exit 0; }
}

cmd_build() {
    gather_kernel_facts
    # A build request means DO it: compile if it is not built yet, install it,
    # and arm the GRUB fallback. --dry-run previews the plan instead. Asking
    # for a flag to actually do the thing was one step too many.
    if (( DRY_RUN )); then APPLY_FIX=0; else APPLY_FIX=1; fi
    section "SOURCE BUILD — mainline from kernel.org"

    if [[ -n "$BUILD_VER" && ! "$BUILD_VER" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; then
        critf "Target" "--ver wants X.Y or X.Y.Z (or omit for latest): got '$BUILD_VER'" \
            "kernelz build --ver 6.12.58   ·   kernelz build --lts   ·   kernelz build"
        emit_verdict
    fi

    heading "── 1. Which version? ──"
    if [[ -n "$BUILD_VER" ]]; then
        build_derive_urls "$BUILD_VER"
        info "target pinned by --ver: $UP_VER"
    else
        if ! with_spin "querying kernel.org" build_latest_query; then
            critf "SourceNet" "cannot determine latest kernel (kernel.org unreachable, no git fallback)" \
                "try: git ls-remote --tags $KERNEL_GIT 'v*' — then kernelz build --ver X.Y.Z"
            emit_verdict
        fi
        info "latest $( ((BUILD_LTS)) && echo 'LONGTERM ' )on kernel.org: ${C_BOLD}$UP_VER${C_RESET} ${DIM}(running $CUR_VER, series $UP_SERIES)${C_RESET}"
    fi
    add_json_field "build_target" "$UP_VER"
    if dpkg --compare-versions "$CUR_VER" ge "$UP_VER" 2>/dev/null && (( FORCE == 0 )); then
        ok "running $CUR_VER is already ≥ $UP_VER — nothing to build (use --force to rebuild anyway)"
    fi

    # Is this kernel already built? A re-run must not offer to compile it
    # again — the 90 minutes were already spent. It is checked HERE because
    # it decides whether the compiler toolchain matters at all: installing
    # flex/bison for a kernel whose debs already exist would be pointless.
    BUILD_HAVE_DEBS=0
    if ls "$BUILD_DIR"/linux-image-*"$UP_VER"*.deb >/dev/null 2>&1; then
        BUILD_HAVE_DEBS=1
        ok "$UP_VER is already built — found in $BUILD_DIR (the compile will be skipped)"
        local _d; for _d in "$BUILD_DIR"/linux-image-*"$UP_VER"*.deb "$BUILD_DIR"/linux-headers-*"$UP_VER"*.deb; do
            [[ -e "$_d" ]] && info "  $(basename "$_d")"
        done
    fi

    heading "── 2. Build toolchain ──"
    # A missing toolchain used to be logged and then ignored: the run went on
    # to fetch 155 MB, unpack it and die at `flex: not found` — and the fix
    # only appeared afterwards, in the verdict. Scan first, then decide:
    # nothing missing → go; already built → irrelevant; otherwise install the
    # packages now (or stop and say exactly how), but NEVER reach `make`.
    if toolchain_scan; then
        ok "build toolchain complete — $TOOLCHAIN_NEEDED packages verified"
    elif (( BUILD_HAVE_DEBS )); then
        info "toolchain not needed — $UP_VER is already built, so nothing will be compiled"
    elif (( DRY_RUN )); then
        # --dry-run previews the plan; it changes nothing, so it must not
        # install either. Report the gap and keep going — the NEXT STEPS
        # block repeats the install line.
        critf "BuildToolchain" "missing build packages (${#TOOLCHAIN_MISSING[@]}): ${TOOLCHAIN_MISSING[*]}" \
            "$TOOLCHAIN_FIX_CMD"
    elif ! toolchain_provision; then
        emit_verdict
    fi

    heading "── 3. Resources ──"
    build_resource_check
    local JOBS_N="${BUILD_JOBS:-$(nproc 2>/dev/null || echo 4)}"
    info "make -j$JOBS_N"

    heading "── 4. Config strategy ──"
    build_config_plan
    if command -v dkms >/dev/null 2>&1 && [[ -d /var/lib/dkms ]]; then
        info "dkms present — third-party modules auto-rebuild on install; verify after: dkms status (./driverz)"
    fi

    heading "── 5. The plan ──"
    local i=1 fetch_step unpack_step
    if (( BUILD_GIT )); then
        fetch_step="git shallow-fetch tag v$UP_VER into $BUILD_DIR/linux-git — tree is REUSED across versions, so a 7.2.8→7.2.9 style bump recompiles only the few changed files (minutes, not hours)"
    else
        fetch_step="download $UP_TARBALL from cdn.kernel.org + sha256 verify"
    fi
    if (( BUILD_GIT )); then
        unpack_step="checkout tag v$UP_VER inside the shared tree (previous .config + objects are kept — that's what makes it incremental)"
    else
        unpack_step="unpack into $BUILD_DIR/linux-$UP_VER"
    fi
    if (( BUILD_HAVE_DEBS )); then
        fetch_step="SKIP — $UP_VER is already built"
        unpack_step="SKIP — nothing to unpack"
    fi
    for step in \
        "$fetch_step" \
        "$unpack_step" \
        "${CFG_LABEL} → make olddefconfig$( ((BUILD_MINIMAL)) && echo ' → localmodconfig (only loaded modules — much smaller/faster)')" \
        "$( ((BUILD_HAVE_DEBS)) && echo "SKIP — already built with the -kz localversion" || echo "append -kz localversion (uname → $UP_VER-kz: apt has no idea it exists — it can never be wiped or collided with) + make -j$JOBS_N bindeb-pkg" )" \
        "sudo dpkg -i the debs (initramfs + GRUB entries are created by the package hooks)" \
        "DKMS modules (nvidia et al) are recompiled against the new kernel by the package hooks — verified before the reboot" \
        "GRUB default stays on $REL; new kernel boots ONCE via grub-reboot (same net as kernelz upgrade)" \
        "reboot → ./kernelz verified promotes it once the boot is healthy"; do
        printf "  ${C_BOLD}%d.${C_RESET} %s\n" "$i" "$step"; i=$((i+1))
    done

    build_script_write

    if (( APPLY_FIX == 0 )); then
        section "NEXT STEPS"
        # when the reader got here through `kernelz latest`, the copy-pasteable
        # way back is `latest` (it picks the same target again) — not `build`.
        local sub="build"; [[ "$COMMAND" == "latest" ]] && sub="latest"
        # Keep the version pinned for `build`: without --ver the next run
        # would pick whatever upstream published since, not the version just
        # built. `latest` REFUSES --ver (it picks its own target — see the
        # critf in cmd_latest), so its line must not carry one or the
        # copy-pasted command dies with "picks its own target".
        local vpin=""; [[ "$COMMAND" != "latest" && -n "$BUILD_VER" ]] && vpin="--ver $BUILD_VER "
        printf "  ${C_GREEN}→${C_RESET} run everything now (build + install + safety net):\n"
        printf "      ${C_BOLD}sudo %s %s %s-y${C_RESET}\n" "${0##*/}" "$sub" "$vpin"
        if ls "$BUILD_DIR"/linux-image-*"$UP_VER"*.deb >/dev/null 2>&1; then
            printf "      ${C_DIM}(the %s artifacts are already built — this installs them, it does not recompile)${C_RESET}\n" "$UP_VER"
        fi
        printf "  ${C_GREEN}→${C_RESET} or compile yourself, then let kernelz wire the safety net:\n"
        printf "      ${C_BOLD}bash %s${C_RESET}  ${C_DIM}(long part — logs in $BUILD_DIR)${C_RESET}\n" "$BUILD_SCRIPT"
        printf "      ${C_BOLD}sudo %s build --apply --ver %s${C_RESET}  ${C_DIM}(installs artifacts + grub one-shot)${C_RESET}\n" "${0##*/}" "$UP_VER"
        if [[ -n "$TOOLCHAIN_FIX_CMD" ]]; then
            printf "  ${C_YELLOW}!${C_RESET} toolchain first: ${C_BOLD}%s${C_RESET}\n" "$TOOLCHAIN_FIX_CMD"
        fi
        printf "  ${C_DIM}Recurring point releases? add --git — the tree is reused, rebuilds only touch changed files.${C_RESET}\n"
        kz_hist "build plan ver=$UP_VER flavor=$BUILD_FLAVOR apply=0"
        emit_verdict
    fi

    # ---------------- APPLY ----------------
    if (( BUILD_HAVE_DEBS )); then
        confirm_or_abort "Install the already-built $UP_VER now (no recompile — GRUB fallback net is armed)?"
    else
        confirm_or_abort "Build linux $UP_VER now (compiles up to ~90 min, then installs with GRUB fallback net)?"
    fi

    heading "── A. compile & package ──"
    if (( BUILD_HAVE_DEBS )); then
        ok "artifacts already present — skipping the compile (rebuild = delete \$BUILDDIR debs)"
    else
        local bf_fix="see the first error above (it is printed even after the terminal scrolled past it) and the log next to the build script"
        [[ -n "$TOOLCHAIN_FIX_CMD" ]] && bf_fix="missing toolchain: $TOOLCHAIN_FIX_CMD — install it, then re-run (the download and every object already built are kept)"
        [[ "$BUILD_LAST_ERR" == *"No rule to make target"* ]] && bf_fix="the config references a file this source tree does not have (a distro packaging path such as debian/canonical-certs.pem) — kernelz clears it and retries; if it still failed, set that key to \"\" by hand in $(build_tree_dir)/.config and re-run"
        build_compile "$JOBS_N" || {
            critf "BuildFail" "compile failed after ${BUILD_MAX_TRIES} attempt(s) — nothing was installed, you remain on $REL" \
                "$bf_fix"
            emit_verdict
        }
    fi

    # A re-run must not redo work that is already done: if the kernel is
    # already on disk, skip straight to the GRUB safety net.
    local already_installed=""
    for _v in /boot/vmlinuz-"$UP_VER"*; do
        [[ -e "$_v" ]] && { already_installed="${_v##*/vmlinuz-}"; break; }
    done
    if [[ -n "$already_installed" ]]; then
        heading "── B. install packages ──"
        ok "kernel $already_installed is already installed — nothing to install"
        info "going straight to the GRUB safety net"
    elif [[ "$BUILD_FLAVOR" == "deb" ]]; then
        heading "── B. install packages ──"
        shopt -s nullglob
        local -a debs=( "$BUILD_DIR"/linux-image-*"$UP_VER"*.deb "$BUILD_DIR"/linux-headers-*"$UP_VER"*.deb \
                        "$BUILD_DIR"/linux-libc-dev_*.deb )
        shopt -u nullglob
        (( ${#debs[@]} )) || { critf "BuildFail" "no debs found in $BUILD_DIR after build" "check script output"; emit_verdict; }
        local d; for d in "${debs[@]}"; do info "$(basename "$d")"; done
        run_cmd env DEBIAN_FRONTEND=noninteractive dpkg -i "${debs[@]}" || {
            # A sudo password prompt that timed out lands here too, and the
            # `|| true` below would swallow it whole — the proof-of-install
            # check after this block is what actually stops the flow.
            warnf "Dpkg" "dpkg -i did not succeed — trying apt-get -f install to repair" \
                "if the log above says 'sudo: timed out', re-run with sudo in front of kernelz"
            run_cmd apt-get -f install -y || true
        }
    else
        heading "── B. install (source-built artifacts) ──"
        critf "Pending" "$BUILD_FLAVOR artifacts produced — install + safety net for non-deb targets is manual this release" \
            "rpm: sudo rpm -ivh --force kernel-*.$UP_VER*.rpm && sudo grub-mkconfig -o /boot/grub/grub.cfg; then kernelz recover to pin last good if needed"
        emit_verdict
    fi

    # ---- proof of install: NOTHING below may run without it ----
    # dpkg can fail silently here (a timed-out sudo password, swallowed by
    # `|| true`), and the old "highest non-running /boot/vmlinuz" guess then
    # reported some unrelated leftover kernel as the new one — arming
    # grub-reboot for it and recording it as the build. The reboot would
    # downgrade instead of upgrade. Require the exact $UP_VER image.
    local _img=""
    for _v in /boot/vmlinuz-"$UP_VER"*; do
        [[ -e "$_v" ]] && { _img="$_v"; break; }
    done
    if [[ -z "$_img" ]]; then
        critf "InstallFail" "/boot/vmlinuz-$UP_VER* never appeared — the packages were NOT installed" \
            "see dpkg/sudo output above (a timed-out password prompt counts); re-run: sudo kernelz build --apply --ver $UP_VER"
        emit_verdict
    fi

    # ---- graphics: will the display still work on the new kernel? ----
    # A hybrid laptop drives the panel from one adapter while the other is
    # loaded too. If the new kernel is missing the driver that owns the
    # CONNECTED output, the reboot comes up black.
    # The release is the image just proven above ($UP_VER) — never "the
    # highest non-running vmlinuz": that heuristic happily reported an older
    # leftover kernel (7.2.8 while 7.3.4 was the target) when install failed.
    local new_rel="${_img##*/vmlinuz-}"
    ok "new kernel on disk: $new_rel"

    # ── DKMS / GPU modules ──────────────────────────────────────────────
    # The proprietary drivers (nvidia) are DKMS modules: they are compiled
    # AGAINST each kernel. A new kernel without them boots to a black
    # screen, so this is checked before the reboot, not after.
    dkms_audit "$new_rel"

    section_graphics "$new_rel"

    # ---- network: the lifeline must survive the reboot ----
    section_network_safety "$new_rel"

    heading "── C. GRUB safety net (new kernel boots ONCE, default stays known-good) ──"
    state_write last_good "$REL"
    ensure_grub_savedefault || true
    local cfg g_toks n_toks good_id new_id
    cfg=$(read_grubcfg)
    if [[ -z "$cfg" ]]; then
        critf "GrubCfg" "cannot read grub.cfg — default NOT switched" "run with sudo: sudo kernelz build --apply"
    else
        read -r -a g_toks <<< "$(entry_tokens "$REL")"
        read -r -a n_toks <<< "$(entry_tokens "$new_rel")"
        good_id=$(grub_entry_id_for "$cfg" "${g_toks[@]}")
        new_id=$(grub_entry_id_for "$cfg" "${n_toks[@]}")
        if [[ -z "$good_id" || -z "$new_id" ]]; then
            grub_regen || true
            cfg=$(read_grubcfg)
            good_id=$(grub_entry_id_for "$cfg" "${g_toks[@]}")
            new_id=$(grub_entry_id_for "$cfg" "${n_toks[@]}")
        fi
        if [[ -n "$good_id" && -n "$new_id" ]]; then
            grub_set_default "$good_id" || warnf "GrubDefault" "grub-set-default failed" "sudo grub-set-default $good_id"
            grub_reboot_cmd "$new_id" || warnf "GrubReboot" "grub-reboot failed" "sudo grub-reboot $new_id"
            ok "default = $REL (entry $good_id) — next boot = $new_rel (entry $new_id), once only"
        else
            critf "GrubEntry" "GRUB entries unresolved for $REL / $new_rel" "sudo update-grub, then: kernelz recover"
        fi
    fi

    heading "── D. pending record (so kernelz verified recognizes the source kernel) ──"
    state_write pending.conf "TARGET_REL=$new_rel
TARGET_PKG=source:$UP_VER
PREV_REL=$REL
TS=$(date +%s)"
    ok "pending: $new_rel (source:$UP_VER) — confirm it after the reboot: kernelz verified"

    heading "── E. shield the fallback line from sudo apt upgrade ──"
    WANT_META=0
    if [[ "$BUILD_FLAVOR" == "deb" ]]; then
        info "your $REL fallback IS an apt package — protect keeps 'sudo apt upgrade' from ever removing it"
        protect_apply 1
    else
        info "non-apt fallback — nothing for kernelz protect to hold; GRUB default already pins $REL"
    fi

    kz_hist "build apply ver=$UP_VER new_rel=$new_rel flavor=$BUILD_FLAVOR"

    # ---- what the machine looks like now ----
    # An earlier run may have installed a distro kernel (the meta package)
    # that was never wanted. Show every kernel that is present and what it
    # is for, so the pile is never a mystery.
    local v mark stray=""
    printf "\n  ${C_DIM}kernels on this machine now:${C_RESET}\n"
    for v in $(ls /boot/vmlinuz-* 2>/dev/null | sed 's|.*/vmlinuz-||'); do
        [[ -z "$v" ]] && continue
        mark=""
        [[ "$v" == "$REL" ]] && mark="${C_GREEN}  <- running now${C_RESET}"
        [[ "$v" == "$new_rel" ]] && mark="${C_CYAN}  <- new, boots once, then you verify it${C_RESET}"
        printf "    %-30s%s\n" "$v" "$mark"
        if [[ "$v" != "$REL" && "$v" != "$new_rel" ]]; then
            stray="$stray $v"
        fi
    done
    if [[ -n "$stray" ]]; then
        printf "  ${C_DIM}also present (not running, harmless):%s${C_RESET}\n" "$stray"
        printf "  ${C_DIM}drop them when you are happy with the new kernel: sudo %s cleanup${C_RESET}\n" "${0##*/}"
    fi
    # The distro meta package is the thing that makes apt pull the distro's
    # own kernel (the LTS) in and keep tracking it. On a box that has moved
    # to a source-built kernel it is usually a leftover worth removing.
    if [[ -n "$META_PKG" ]] && [[ "$(pkg_state "$META_PKG")" == ii* ]]; then
        printf "  ${C_YELLOW}note:${C_RESET} %s is installed — every 'sudo apt upgrade' will keep pulling the\n" "$META_PKG"
        printf "        ${C_YELLOW}distro kernel (%s) alongside your %s${C_RESET}\n" "${META_CAND:-the LTS}" "$new_rel"
        printf "        ${C_DIM}drop the meta package (the kernel itself stays as your fallback):${C_RESET}\n"
        printf "        ${C_BOLD}sudo apt-get remove %s${C_RESET}\n" "$META_PKG"
    fi

    section "NEXT STEPS"
    printf "  ${C_BOLD}1.${C_RESET} reboot now:            ${C_CYAN}sudo reboot${C_RESET}\n"
    printf "  ${C_BOLD}2.${C_RESET} after boot:            ${C_CYAN}%s verified${C_RESET}  ${C_DIM}(promotes %s to permanent default)${C_RESET}\n" "${0##*/}" "$new_rel"
    printf "  ${C_BOLD}3.${C_RESET} if it fails at boot:   the reboot falls back to %s by itself — then %s recover\n" "$REL" "${0##*/}"
    printf "  ${C_DIM}Repo apt upgrades can never touch your %s kernel (not an apt package, apt-proof -kz suffix) — and kernelz protect now holds the fallback repo kernel safe too.${C_RESET}\n" "$new_rel"
    exit 0
}

# ============================================================================
# PROTECT
# ============================================================================
PROTECT_APPLY=0
protect_apply() {   # 1 = apply fixes now
    PROTECT_APPLY="$1"
    local mgr_lbl="APT"
    [[ "$PKG_MGR" == rpm ]] && mgr_lbl="DNF"
    [[ "$PKG_MGR" == pacman ]] && mgr_lbl="PACMAN"
    section "$mgr_lbl-UPGRADE HARDENING (kernel protection)"
    local protected_now=0

    # 1) meta-package keeps the distro pulling kernels
    #
    #    Careful: the meta package is what PULLS the distro's own kernel in.
    #    On a box that is moving to a source-built kernel (-kz) that is not
    #    wanted — it is exactly how a long-term-branch kernel (6.1.x) ends
    #    up installed on a machine that never asked for it, and then every
    #    apt upgrade tracks it. So it is opt-in there.
    if [[ "$WANT_META" -eq 0 ]]; then
        info "skipping the $META_PKG meta package — your kernel is a source build, and the meta package"
        info "would only make apt keep pulling the distro kernel (${META_CAND:-the LTS}) alongside it"
        info "add --meta if you want the distro kernel tracked as well"
    elif [[ -n "$META_PKG" ]] && [[ "$(pkg_state "$META_PKG")" != ii* ]]; then
        if [[ "$PROTECT_APPLY" -eq 1 ]]; then
            if pkg_install "$META_PKG"; then
                if [[ "$DRY_RUN" -eq 1 ]]; then info "would install $META_PKG — future kernels arrive via $PKG_UPGRADE_CMD"
                else ok "installed $META_PKG — future kernels arrive via $PKG_UPGRADE_CMD"; fi
            fi
        else
            warnf "KernelMeta" "$META_PKG missing" "kernelz protect installs it"
        fi
    elif [[ -n "$META_PKG" ]]; then
        ok "$META_PKG present"
    fi

    # 2) every installed kernel: manual (never autoremove) — Debian/Ubuntu
    #    only; pacman has no autoremove and dnf's is not kernel-aware.
    local pkg ver stat
    if [[ "$PKG_MGR" == deb ]]; then
        installed_image_pkgs | while IFS=$'\t' read -r pkg ver stat; do
            if apt-mark showmanual 2>/dev/null | grep -qxF "$pkg"; then
                :
            elif [[ "$PROTECT_APPLY" -eq 1 ]]; then
                run_cmd apt-mark manual "$pkg" >/dev/null
                printf "  ${C_GREEN}✓${C_RESET} marked manual: %s (protected from autoremove)\n" "$pkg"
            else
                printf "  ${C_YELLOW}!${C_RESET} %s is auto-marked — autoremove could target it (run: kernelz protect --yes)\n" "$pkg"
            fi
        done
    else
        info "autoremove marking is Debian-specific — skipped on this distro"
    fi

    # 3) EVERY out-of-repo kernel gets held — not just the running one.
    #    Held means: apt skips it, pacman's IgnorePkg skips it, dnf's
    #    versionlock skips it — a custom kernel is never swapped out silently.
    local custom
    while read -r pkg; do
        [[ -z "$pkg" ]] && continue
        if [[ "$PROTECT_APPLY" -eq 1 ]]; then
            hold_pkg "$pkg"
        else
            local held=0
            case "$PKG_MGR" in
                deb)    apt-mark showhold 2>/dev/null | grep -qxF "$pkg" && held=1 ;;
                pacman) awk -F= '/^IgnorePkg/{print $2}' /etc/pacman.conf 2>/dev/null | grep -qw "$pkg" && held=1 ;;
                rpm)    dnf versionlock list 2>/dev/null | grep -qw "$pkg" && held=1 ;;
            esac
            if [[ $held -eq 1 ]]; then
                ok "custom kernel $pkg is held — the package manager cannot remove it"
            else
                warnf "HoldMissing" "out-of-repo kernel $pkg is not held" "kernelz protect --yes"
            fi
        fi
    done < <(installed_image_pkgs | cut -f1 | while read -r p; do
                pkg_in_repo "$p" || printf '%s\n' "$p"
             done)

    # 4) simulate what apt would do: upgrade, full-upgrade and autoremove.
    #    Anything it plans to remove is held so the plan can never run.
    local removed
    removed=$(kernels_apt_would_remove)
    if [[ "$PKG_MGR" != deb ]]; then
        info "kernel-removal simulation is Debian-specific — skipped (the holds above are the protection here)"
    elif [[ -z "$removed" ]]; then
        ok "apt simulation (upgrade + full-upgrade + autoremove): no installed kernel would be removed"
    else
        warnf "AptRemoval" "apt would remove: $(tr '\n' ' ' <<< "$removed")"
        if [[ "$PROTECT_APPLY" -eq 1 ]]; then
            local p
            for p in $removed; do
                if apt-mark showhold 2>/dev/null | grep -qxF "$p"; then
                    printf "  ${C_GREEN}✓${C_RESET} %s already held\n" "$p"
                elif run_cmd apt-mark hold "$p" >/dev/null; then
                    printf "  ${C_GREEN}✓${C_RESET} held %s against removal\n" "$p"
                fi
            done
        else
            info "kernelz protect --yes holds these automatically"
        fi
    fi

    # 5) final proof: the GRUB menu must still have an entry for every
    #    installed kernel — a kernel apt cannot remove but GRUB cannot boot
    #    is still a broken kernel.
    local cfg rel
    cfg=$(read_grubcfg)
    if [[ -z "$cfg" ]]; then
        info "/boot/grub/grub.cfg needs root — re-run 'sudo kernelz protect' for the per-kernel entry check"
    else
        while read -r rel; do
            [[ -z "$rel" ]] && continue
            read -r -a toks <<< "$(entry_tokens "$rel")"
            if grub_entry_id_for "$cfg" "${toks[@]}" >/dev/null; then
                printf "  ${C_GREEN}✓${C_RESET} GRUB entry exists for %s\n" "$rel"
            else
                warnf "GrubEntry" "no GRUB menu entry for installed kernel $rel" "sudo update-grub"
            fi
        done < <(ls /boot/vmlinuz-* 2>/dev/null | sed 's|.*/vmlinuz-||')
    fi
    return 0
}

cmd_protect() {
    gather_kernel_facts
    protect_apply "$ASSUME_YES"
    if [[ "$ASSUME_YES" -eq 0 ]]; then
        printf "  ${C_DIM}analysis-only — to apply the fixes: kernelz protect --yes (or run via sudo)${C_RESET}\n"
    fi
    emit_verdict
}

# ============================================================================
# VERIFY
# ============================================================================
cmd_verify() {
    gather_kernel_facts
    record_boot
    # A fresh verified boot is the best moment to capture evidence: score
    # this boot's log and snapshot speed + benchmarks for the new kernel.
    boot_health_scan
    speedz_record
    bench_once_per_boot
    local target prev pts
    target=$(pending_get TARGET_REL); prev=$(pending_get PREV_REL); pts=$(pending_get TS)

    if [[ -z "$target" ]]; then
        section "VERIFIED"
        local lg; lg=$(state_read last_good)
        if [[ "$REL" == "$lg" ]]; then
            ok "running $REL == last known good ($lg) — nothing pending"
        else
            warnf "Verify" "no pending update recorded; running $REL, last_good=${lg:-unknown}" "kernelz recover sets default to last_good if needed"
        fi
        add_json_field verify_result "no-pending"
        emit_verdict
    fi

    section "VERIFIED — pending kernel: $target (installed $(date -d "@${pts:-0}" '+%Y-%m-%d %H:%M' 2>/dev/null || echo '?'))"
    add_json_field verify_target "$target"

    local errs nerrs jrc=0
    errs=$(journalctl -q -b -p err --no-pager 2>/dev/null) || jrc=1
    if (( jrc )); then
        nerrs=-1
        info "journalctl unreadable for this user — run 'sudo journalctl -b -p err' to review boot errors"
    else
        nerrs=$(printf '%s\n' "$errs" | grep -c . || true)
    fi

    if [[ "$REL" == "$target" ]]; then
        ok "${C_BOLD}new kernel $REL booted successfully${C_RESET}"
        if (( nerrs > 0 )); then
            warnf "BootErrors" "$nerrs error line(s) this boot" "journalctl -b -p err   (review before trusting the kernel)"
            printf '%s\n' "$errs" | tail -5 | sed 's/^/      /'
        else
            ok "zero error-level journal entries this boot"
        fi
        # Did the GPU come back with the new kernel? A kernel can boot
        # perfectly and still have no working graphics driver — the DKMS
        # module was never built for it. That is exactly the "it installed
        # fine but my GPU is gone" case, so check it here, on the kernel
        # that is actually running.
        verify_gpu_health "$REL"
        # promote to permanent default
        local cfg id
        cfg=$(read_grubcfg)
        read -r -a toks <<< "$(entry_tokens "$REL")"
        id=$(grub_entry_id_for "$cfg" "${toks[@]}")
        if [[ -n "$id" ]]; then
            grub_set_default "$id" >/dev/null && ok "GRUB default promoted to $REL (entry $id)"
        else
            warnf "GrubDefault" "entry for $REL not found to promote" "sudo update-grub && sudo kernelz verified"
        fi
        $SUDO grub-editenv /boot/grub/grubenv unset next_entry >/dev/null 2>&1 || true
        # keep the fallback kernel around
        if [[ -f "/boot/vmlinuz-$prev" ]]; then
            ok "fallback kernel still present: $prev"
        else
            warnf "Fallback" "previous kernel $prev missing from /boot" "no automatic fallback — keep one old kernel until stable"
        fi
        state_write last_good "$REL"
        state_write last_good_pkg "$(pkg_for_release "$REL")"
        state_rm pending.conf
        kz_hist "verify-ok kernel=$REL"
        printf "  ${C_GREEN}${C_BOLD}✔ $REL is now the trusted default. 'sudo apt upgrade' is protected.${C_RESET}\n"
    elif [[ "$BOOT_EPOCH" -le "${pts:-0}" ]]; then
        info "system has not rebooted since the update — GRUB is armed: next reboot tries $target, fallback stays $prev"
        add_json_field verify_result "awaiting-reboot"
    elif [[ "$REL" == "$prev" ]]; then
        critf "VerifyFail" "$target failed to boot — fallback worked, you are safe on $REL" "run ./bootz for boot errors; try 'sudo apt install --reinstall linux-image-$target' or keep $REL and 'kernelz protect'"
        printf "  ${C_DIM}previous boot errors (likely cause):${C_RESET}\n"
        journalctl -q -b -1 -p err --no-pager 2>/dev/null | tail -8 | sed 's/^/      /' || info "journalctl not readable without sudo"
        state_append pending.conf "STATUS=failed"
        kz_hist "verify-fail target=$target fell-back=$REL"
    else
        warnf "Verify" "unexpected kernel $REL (expected $target or $prev)" "check GRUB entries: sudo kernelz"
    fi
    add_json_field verify_kernel "$REL"
    emit_verdict
}

# ============================================================================
# RECOVER
# ============================================================================
cmd_recover() {
    gather_kernel_facts
    local lg
    lg=$(state_read last_good)
    section "RECOVER → last known good: ${lg:-$REL}"
    if [[ -z "$lg" ]]; then
        lg="$REL"
        warnf "Recover" "no last_good recorded — using current $REL as known good"
    fi
    if [[ ! -f "/boot/vmlinuz-$lg" ]]; then
        critf "Recover" "/boot/vmlinuz-$lg missing — cannot recover to it" "boot any kernel, then kernelz upgrade"
        emit_verdict
    fi
    state_write last_good "$lg"
    ensure_grub_savedefault || true
    grub_regen || true
    local cfg id
    cfg=$(read_grubcfg)
    read -r -a toks <<< "$(entry_tokens "$lg")"
    id=$(grub_entry_id_for "$cfg" "${toks[@]}")
    if [[ -n "$id" ]]; then
        grub_set_default "$id" && ok "GRUB permanent default forced to $lg (entry $id)"
    else
        critf "Recover" "no menu entry for $lg after update-grub" "inspect: sudo grep menuentry /boot/grub/grub.cfg"
    fi
    grub_editenv_unset
    state_rm pending.conf
    kz_hist "recover to=$lg"
    section "MANUAL RECIPE (if you cannot boot at all)"
    cat << EOF
  1. Power on → hold ${C_BOLD}Shift${C_RESET} (BIOS) or hammer ${C_BOLD}Esc${C_RESET} (UEFI) for the GRUB menu
  2. ${C_BOLD}Advanced options${C_RESET} → pick the kernel BEFORE the bad one (${C_CYAN}$lg${C_RESET})
  3. Log in, then run: ${C_CYAN}${0##*/} recover${C_RESET}
  4. To undo the bad kernel entirely: ${C_CYAN}sudo apt-mark hold linux-image-$REL && sudo kernelz protect${C_RESET}
EOF
    emit_verdict
}

# ============================================================================
# CLEANUP
# ============================================================================
cmd_boots() {
    # Journal + ledger read only — no apt facts needed (REL/BOOT_ID/
    # BOOT_EPOCH are set at load time). json_muffle keeps the human tables
    # off stdout in --json mode, same pattern as status.
    json_muffle
    section "BOOT HISTORY — the cleanest logs win"
    local scanned=0
    if boot_health_scan; then
        scanned=$(grep -c '' "$BOOT_HEALTH" 2>/dev/null || echo 0)
        speedz_record
        bench_once_per_boot
        record_boot
    fi

    local golden; golden=$(best_boot_kernel)
    add_json_field boots_scanned "${scanned:-0}"
    add_json_field backup_kernel "$golden"

    subsec "recent boots (journal errors/warnings — lower is cleaner)"
    printf "  ${C_DIM}%-13s %-24s %6s %7s %7s %7s${C_RESET}\n" "BOOTED" "KERNEL" "ERRS" "WARNS" "SPEEDZ" "BOOT-S"
    local id krel epoch err warn score bsec ts date_s mark n=0
    while IFS=$'\t' read -r id krel epoch err warn score bsec ts; do
        n=$((n+1)); (( n > 15 )) && break
        date_s=$(date -d "@${epoch:-0}" '+%m-%d %H:%M' 2>/dev/null || echo "?")
        mark=""; [[ "$id" == "$BOOT_ID" ]] && mark=" ${C_GREEN}◀ now${C_RESET}"
        [[ -n "$golden" && "$krel" == "$golden" ]] && mark="$mark ${C_BOLD}★ backup${C_RESET}"
        printf "  %-13s %-24s %6s %7s %7s %7s%b\n" "$date_s" "$krel" "$err" "$warn" "${score:--}" "${bsec:--}" "$mark"
    done < <(sort -t$'\t' -k3,3nr "$BOOT_HEALTH" 2>/dev/null)

    subsec "per-kernel evidence (the proof for \"which kernel is best\")"
    local agg r boots ae aw sc lt bav sha mark2
    agg=$(awk -F'\t' 'BEGIN{OFS="\t"}
        $2=="?" || $4 !~ /^[0-9]+$/ { next }
        { n[$2]++; e[$2]+=$4; w[$2]+=$5; if($6!~/^[0-9]+$/){} else {s[$2]=$6; hs[$2]=1}; if($3+0>l[$2]) l[$2]=$3+0 }
        END { for (k in n) printf "%s\t%d\t%.1f\t%.1f\t%s\n", k, n[k], e[k]/n[k], w[k]/n[k], (hs[k]?s[k]:"-") }' \
        "$BOOT_HEALTH" 2>/dev/null | sort -t$'\t' -k3,3n -k4,4n)
    while IFS=$'\t' read -r r boots ae aw sc; do
        [[ -z "$r" ]] && continue
        mark2=""; [[ "$r" == "$REL" ]] && mark2=" ${C_GREEN}◀ running${C_RESET}"
        [[ -n "$golden" && "$r" == "$golden" ]] && mark2="$mark2 ${C_BOLD}★ long-term backup${C_RESET}"
        bav=""
        if [[ -f "$BENCH" ]]; then
            bav=$(bench_avg_by_kernel "$r" 2>/dev/null)
            if [[ -n "$bav" && "$bav" != "none" ]]; then
                bav=" · bench cpu=$(cut -f1 <<<"$bav")ms sha=$(cut -f2 <<<"$bav")kB/s fork=$(cut -f3 <<<"$bav")/s mem=$(cut -f4 <<<"$bav")MB/s"
            else bav=""; fi
        fi
        printf "  %-24s %2s boots · errs %s · warns %s · speedz %s%s%b\n" "$r" "$boots" "$ae" "$aw" "$sc" "$bav" "$mark2"
    done <<< "$agg"

    if [[ -n "$golden" ]]; then
        section "RECOMMENDATION"
        ok "long-term backup: $golden — the cleanest boot logs on this machine"
        info "kernelz cleanup protects it automatically — only 'kernelz cleanup --force --yes' can remove it"
        [[ "$golden" != "$REL" ]] && info "you run $REL; the backup stays installed as the proven-clean fallback"
    else
        info "not enough boot data yet — run kernelz boots after a few reboots"
    fi
    kz_hist "boots scan=$scanned best=${golden:-none}"
    json_unmuffle
    emit_verdict
}

cmd_cleanup() {
    gather_kernel_facts
    section "CLEANUP — old kernel purge preview"
    local keep_current list keep1 keep2
    keep_current="$CUR_PKG"
    # always keep the two newest installed image packages
    mapfile -t _sorted_imgs < <(installed_image_pkgs | sort -t$'\t' -k2,2Vr | cut -f1)
    keep1="${_sorted_imgs[0]:-}"; keep2="${_sorted_imgs[1]:-}"
    printf "  ${C_GREEN}keep:${C_RESET} %s (running)\n" "$keep_current"
    [[ -n "$keep1" && "$keep1" != "$keep_current" ]] && printf "  ${C_GREEN}keep:${C_RESET} %s (newest installed)\n" "$keep1"
    [[ -n "$keep2" && "$keep2" != "$keep_current" && "$keep2" != "$keep1" ]] && printf "  ${C_GREEN}keep:${C_RESET} %s (2nd newest)\n" "$keep2"
    local lg; lg=$(pkg_for_release "$(state_read last_good)")
    [[ -n "$lg" && "$lg" != "$keep_current" && "$lg" != "$keep1" && "$lg" != "$keep2" ]] && printf "  ${C_GREEN}keep:${C_RESET} %s (last known good)\n" "$lg"

    # The cleanest-boot kernel is the long-term backup: routine cleanup
    # never touches it. Only an explicit --force releases that protection —
    # and the release is stated out loud, never silent.
    local golden_rel golden_pkg="" keep_extra=""
    golden_rel=$(best_boot_kernel)
    [[ -n "$golden_rel" ]] && golden_pkg=$(pkg_for_release "$golden_rel")
    if [[ -n "$golden_pkg" ]]; then
        case " $keep_current $keep1 $keep2 $lg " in
            *" $golden_pkg "*) ;;
            *)
                if [[ "$FORCE" -eq 0 ]]; then
                    keep_extra="$golden_pkg"
                    printf "  ${C_GREEN}keep:${C_RESET} %s (cleanest boot — long-term backup; only --force removes)\n" "$golden_pkg"
                else
                    info "--force releases the long-term backup: $golden_pkg (cleanest boot logs)"
                fi
                ;;
        esac
    fi

    list=""
    local pkg ver stat
    while IFS=$'\t' read -r pkg ver stat; do
        case " $keep_current $keep1 $keep2 $lg $keep_extra $META_PKG " in *" $pkg "*) continue ;; esac
        printf "  ${C_YELLOW}remove:${C_RESET} %-36s %s %s\n" "$pkg" "$ver" "$stat"
        list="$list $pkg"
    done < <(installed_image_pkgs)

    if [[ -z "$list" ]]; then
        ok "nothing safe to remove"
        return 0
    fi
    if [[ "$ASSUME_YES" -eq 1 && "$DRY_RUN" -eq 0 ]]; then
        # header/meta packages must stay: filter them out
        local real=()
        for p in $list; do [[ "$p" == "$META_PKG" ]] || real+=("$p"); done
        run_cmd apt-get purge -y "${real[@]}" || critf "Cleanup" "purge failed" "apt-get -f install"
        grub_regen || true
        kz_hist "cleanup purged$(echo "$list")"
        ok "purged old kernels; GRUB regenerated"
    else
        printf "  ${C_DIM}to execute: kernelz cleanup --yes${C_RESET}\n"
    fi
}

# ============================================================================
# BENCH
# ============================================================================
BENCH="$STATE_USR/bench.tsv"
# format: epoch \t kernel_rel \t boot_id \t cpu_ms \t crypto_kBps \t fork_ops_s \t mem_MBps \t io_w \t io_r \t boot_s

bench_cpu_ms() {
    local t0 t1 n i=0
    t0=$(date +%s%N)
    for (( n=0; n<150000; n++ )); do i=$(( i + (n*7) % 997 )); done
    t1=$(date +%s%N)
    echo $(( (t1 - t0) / 1000000 ))
}
bench_crypto() {
    command -v openssl >/dev/null 2>&1 || { echo 0; return; }
    openssl speed -seconds 1 sha256 2>/dev/null | awk '/^sha256/{v=$NF} END{gsub(/[k,]/,"",v); print (v==""?0:v)+0}'
}
bench_fork() {
    local n t0 t1
    t0=$(date +%s%N)
    for (( n=0; n<200; n++ )); do /bin/true & done
    wait
    t1=$(date +%s%N)
    local ms=$(( (t1 - t0) / 1000000 ))
    (( ms < 1 )) && ms=1
    echo $(( 200 * 1000 / ms ))
}
bench_mem() {
    local r
    r=$(dd if=/dev/zero bs=1M count=128 2>&1 >/dev/null | grep -oE '[0-9.]+ (MB|GB|kB)/s' | tail -1)
    awk -v x="$r" 'BEGIN{ if (x ~ /GB/) {split(x,a," "); print int(a[1]*1024)} else if (x ~ /MB/) {split(x,a," "); print int(a[1])} else if (x ~ /kB/) {split(x,a," "); print int(a[1]/1024)} else print 0 }'
}
bench_io() {
    local f=/tmp/kernelz-io.$$.img r w
    w=$(dd if=/dev/zero of="$f" bs=1M count=128 conv=fdatasync 2>&1 >/dev/null | grep -oE '[0-9.]+ MB/s' | tail -1 | awk '{print $1}')
    r=$(dd if="$f" of=/dev/null bs=1M iflag=direct 2>&1 >/dev/null | grep -oE '[0-9.]+ MB/s' | tail -1 | awk '{print $1}')
    [[ -z "$r" ]] && r=$(dd if="$f" of=/dev/null bs=1M 2>&1 >/dev/null | grep -oE '[0-9.]+ MB/s' | tail -1 | awk '{print $1}')
    rm -f "$f"
    echo "${w:-0}	${r:-0}"
}
bench_boot_sec() {
    local s
    s=$(systemd-analyze time 2>/dev/null | awk '/Startup finished/{print $NF}')
    s=${s%s}          # strip trailing 's'
    s=${s%m}          # (ms totals are rare; unit-agnostic for comparisons)
    echo "${s:-0}"
}

bench_show_table() {
    [[ -r "$BENCH" ]] || { printf "  no bench data yet — run: kernelz bench\n"; return 0; }
    printf "  ${C_DIM}%-19s %-22s %7s %9s %7s %7s %6s %6s %6s${C_RESET}\n" "when" "kernel" "cpu_ms↓" "crypto↑" "fork/s↑" "mem↑" "io_w↑" "io_r↑" "boot↓"
    while IFS=$'\t' read -r ts rel bid cpu cry fkr mem iow ior bsec; do
        local mark=""
        [[ "$rel" == "$REL" ]] && mark="${C_GREEN}◀${C_RESET}" || mark=" "
        printf "  %-19s %-22s %7s %9s %7s %7s %6s %6s %6s %b\n" \
            "$(date -d "@$ts" '+%m-%d %H:%M' 2>/dev/null || echo "$ts")" "$rel" "$cpu" "$cry" "$fkr" "$mem" "$iow" "$ior" "$bsec" "$mark"
    done < <(sort -t$'\t' -k1,1n "$BENCH")
}

bench_avg_by_kernel() {   # $1=rel
    awk -F'\t' -v k="$1" '$2==k {n++; for(i=4;i<=10;i++) s[i]+=$i} END{if(!n){print "none"; exit} printf "%.0f\t%.0f\t%.0f\t%.0f\t%.0f\t%.0f\t%.1f\t%d\n", s[4]/n, s[5]/n, s[6]/n, s[7]/n, s[8]/n, s[9]/n, s[10]/n, n}' "$BENCH" 2>/dev/null
}

bench_compare() {   # $1 $2 kernel releases
    local a="$1" b="$2"
    [[ -r "$BENCH" ]] || { printf "  no bench data yet\n"; return 1; }
    local av bv
    av=$(bench_avg_by_kernel "$a"); bv=$(bench_avg_by_kernel "$b")
    if [[ "$av" == "none" || "$bv" == "none" ]]; then
        printf "  need at least one bench row per kernel ('$a': %s runs, '$b': %s runs)\n" \
            "$(awk -F'\t' -v k="$a" '$2==k{n++} END{print n+0}' "$BENCH")" \
            "$(awk -F'\t' -v k="$b" '$2==k{n++} END{print n+0}' "$BENCH")"
        return 1
    fi
    heading "── Averages: $a vs $b ──"
    local labels=("cpu_ms" "crypto_kBps" "fork_ops" "mem_MBps" "io_w" "io_r" "boot_s")
    local better=("lower" "higher" "higher" "higher" "higher" "higher" "lower")
    local i va vb pct verdict
    printf "  ${C_DIM}%-12s %-12s %-12s %-9s %s${C_RESET}\n" "metric" "$a" "$b" "Δ%" "winner"
    for i in 0 1 2 3 4 5 6; do
        va=$(cut -f$((i+1)) <<< "$av"); vb=$(cut -f$((i+1)) <<< "$bv")
        f_zero "$va" "$vb" && continue
        pct=$(awk -v x="$va" -v y="$vb" 'BEGIN{if (x+0==0) print "n/a"; else printf "%+.1f", (y-x)/x*100}')
        verdict=""
        if [[ "$pct" != "n/a" ]] && f_ne "$va" "$vb"; then
            if [[ "${better[$i]}" == "lower" ]]; then
                f_gt "$vb" "$va" && verdict="${C_GREEN}$a${C_RESET}" || verdict="${C_CYAN}$b${C_RESET}"
            else
                f_gt "$va" "$vb" && verdict="${C_GREEN}$a${C_RESET}" || verdict="${C_CYAN}$b${C_RESET}"
            fi
        fi
        printf "  %-12s %-12s %-12s %-9s %b\n" "${labels[$i]}" "$va" "$vb" "$pct" "$verdict"
    done
    info "rows: $a=$(cut -f8 <<< "$av") runs, $b=$(cut -f8 <<< "$bv") runs — lower cpu_ms/boot_s is better, higher the rest"
}

cmd_bench() {
    gather_kernel_facts
    record_boot
    case "${1:-}" in
        show)    section "BENCH HISTORY"; bench_show_table; return 0 ;;
        compare) shift
                 section "BENCH COMPARE"
                 local a b
                 a="${1:-}"; b="${2:-}"
                 if [[ -z "$a" || -z "$b" ]]; then
                     mapfile -t kernels < <(cut -f2 "$BENCH" 2>/dev/null | sort -u)
                     (( ${#kernels[@]} < 2 )) && { printf "  need ≥2 kernels benched (have: %s) — data accrues after kernelz upgrade + reboot + bench\n" "${kernels[*]:-none}"; return 0; }
                     a=${kernels[-2]}; b=${kernels[-1]}
                     info "auto-picked two most recent kernels: $a vs $b"
                 fi
                 bench_compare "$a" "$b"; return 0 ;;
    esac

    section "BENCH — kernel $REL (boot ${BOOT_ID:0:8})"
    printf "  ${C_DIM}running quick benchmarks…${C_RESET}\n"
    local cpu cry fkr mem iow ior bsec
    cpu=$(bench_cpu_ms);   ok "cpu arithmetic:   ${cpu} ms"
    cry=$(bench_crypto);   ok "sha256 speed:     ${cry} kB/s"
    fkr=$(bench_fork);     ok "fork rate:        ${fkr} ops/s"
    mem=$(bench_mem);      ok "mem bandwidth:    ${mem} MB/s"
    iow=0; ior=0
    if [[ "$WANT_IO" -eq 1 ]]; then
        read -r iow ior <<< "$(bench_io)"
        ok "disk write:       ${iow} MB/s"
        ok "disk read:        ${ior} MB/s"
    else
        info "skipping disk io (add --io)"
    fi
    bsec=$(grep -F "$BOOT_ID" "$LEDGER" 2>/dev/null | cut -f4 | tail -1)
    [[ -z "$bsec" || "$bsec" == "0" ]] && bsec=$(bench_boot_sec)
    ok "boot time:        ${bsec}s"

    mkdir -p "$STATE_USR"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$TS_EPOCH" "$REL" "$BOOT_ID" "$cpu" "$cry" "$fkr" "$mem" "$iow" "$ior" "$bsec" >> "$BENCH"
    kz_hist "bench kernel=$REL cpu=$cpu cry=$cry fork=$fkr mem=$mem boot=$bsec"

    if [[ "$BENCH_FULL" -eq 1 && -x "$SCRIPT_DIR/benchmarkz" ]]; then
        subsec "benchmarkz --full snapshot"
        local outdir="$STATE_USR/benchlogs" cur other prevf
        mkdir -p "$outdir"
        cur="$outdir/$REL-$(date +%s).txt"
        "$SCRIPT_DIR/benchmarkz" > "$cur" 2>&1 || warnf "BenchFull" "benchmarkz exited non-zero" "$SCRIPT_DIR/benchmarkz"
        other=$(ls -1t "$outdir"/*.txt 2>/dev/null | grep -v "/$(basename "$cur")$" | grep -v "/$REL-" | head -1 || true)
        if [[ -n "$other" ]]; then
            prevf=${other##*/}; prevf=${prevf%%-*}
            heading "── benchmarkz diff: $prevf (other kernel) vs $REL ──"
            diff -u "$other" "$cur" 2>/dev/null | grep -E '^[+-][^+-]' | head -40 || true
            info "full diff saved: $outdir/"
        else
            info "no benchmarkz snapshot from a different kernel yet — run 'kernelz bench --full' on each kernel to compare"
        fi
        ok "snapshot saved: $cur"
    fi

    subsec "per-kernel averages so far"
    local rels r av mark
    rels=$(cut -f2 "$BENCH" 2>/dev/null | sort -u)
    for r in $rels; do
        av=$(bench_avg_by_kernel "$r")
        [[ "$av" == "none" ]] && continue
        mark=""
        [[ "$r" == "$REL" ]] && mark=" ${C_GREEN}◀${C_RESET}"
        printf "  %-24s cpu=%s ms  sha256=%s kB/s  fork=%s/s  mem=%s MB/s  boot=%s s  ${C_DIM}(%s runs)${C_RESET}%b\n" \
            "$r" $(cut -f1,2,3,4,7,8 <<< "$av") "$mark"
        if [[ "$r" == "$REL" ]]; then
            local hist; hist=$(awk -F'\t' -v k="$REL" '$2==k{print $4}' "$BENCH" 2>/dev/null | head -40)
            [[ -n "$hist" ]] && printf "      ${C_DIM}cpu_ms history:${C_RESET} %b\n" "$(spark $hist)"
        fi
    done
    printf "  ${C_DIM}next: after a kernelz upgrade + reboot, run 'kernelz bench' again, then 'kernelz bench compare'${C_RESET}\n"
}

