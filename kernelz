cmd_history() {
    gather_kernel_facts
    section "kernelz ACTION HISTORY"
    local h
    h=$(state_read history.tsv)
    if [[ -z "$h" ]]; then
        info "no actions recorded yet"
    else
        printf '%s\n' "$h" | tail -30 | while IFS=$'\t' read -r ts cmd detail; do
            printf "  %-17s ${C_BOLD}%-9s${C_RESET} %s\n" "$(date -d "@$ts" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "$ts")" "$cmd" "$detail"
        done
    fi
    subsec "kernel identity"
    printf "  last_good: ${C_BOLD}%s${C_RESET}\n" "$(state_read last_good || echo none)"
