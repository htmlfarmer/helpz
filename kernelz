#!/usr/bin/env bash

# shellcheck source=.helpz_log.sh
. "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/.helpz_log.sh"
# ============================================================================
# kernelz - Kernel study, source builds, safe upgrade, GRUB recovery & benchmarks
# ----------------------------------------------------------------------------
# Shows what kernel you run, whether a newer one exists in the repos, and
# studies the risks of updating (/boot space, Secure Boot, dkms, GRUB
# entries, CPU mitigations, taint flags, changelog CVEs).
#
# The safety model: after `kernelz upgrade`, GRUB's permanent default stays
# on the LAST KNOWN GOOD kernel while the NEW kernel is booted exactly once
# via grub-reboot. If the new kernel fails, the next reboot falls back to
# the good one automatically. `kernelz verify` promotes the new kernel to
# the permanent default once it has booted cleanly. `kernelz protect`
# (apt-mark hold/manual + meta-package + removal simulation) makes sure a
# later `sudo apt upgrade` can never void or remove the new kernel.
#
# Usage:
#   ./kernelz                        What kernel am I on + update check + risk study
#   ./kernelz study                  Deep kernel study (config, CVEs, mitigations)
#   ./kernelz upgrade                Install latest kernel + GRUB safety net + protect
#   ./kernelz update                 Alias for upgrade
#   ./kernelz build                  Compile the latest mainline from source (toolchain audit + GRUB safety net)
#   ./kernelz verify                 After reboot: promote new kernel or report fallback
#   ./kernelz recover                Force GRUB back to the last known good kernel
#   ./kernelz protect                Ensure `sudo apt upgrade` cannot void the kernel
#   ./kernelz bench                  Benchmark this kernel+boot; compare across boots
#   ./kernelz fix                    Package doctor: which packages are missing & how to install them
#   ./kernelz cleanup                Preview safe purge of old kernels (keeps current)
#   ./kernelz history                Show past kernelz actions
# ============================================================================

set -o pipefail
# shellcheck disable=SC2086

SCRIPT_VERSION="1.0.0"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# ---------- Commands & flags ----------
COMMAND="status"
case "${1:-}" in
    status|check|study|upgrade|update|build|verify|recover|protect|bench|cleanup|history|fix|best|recommend)
        COMMAND="$1"; shift ;;
    -h|--help) COMMAND="help" ;;
    ""|-*) ;;
    *) printf 'kernelz: unknown command "%s" (try --help)\n' "$1" >&2; exit 64 ;;
esac

# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"   # resets JSON_OUT/NO_COLOR — parse AFTER sourcing

# The "latest best kernel" intelligence: upstream release table, repo
# candidates, tiering (stable-but-settled > stable-fresh > LTS > EOL).
# shellcheck source=lib/kernelbest.sh
[[ -r "$SCRIPT_DIR/lib/kernelbest.sh" ]] && source "$SCRIPT_DIR/lib/kernelbest.sh"

DRY_RUN=0; FORCE=0; ASSUME_YES=0; WANT_IO=0; BENCH_FULL=0; APPLY_FIX=0; APPLY_FIX=0
TO_PKG=""
SETTLE_DAYS=""; WANT_NEWEST=0
BUILD_VER=""; BUILD_LTS=0; BUILD_JOBS=""; BUILD_MINIMAL=0; BUILD_GIT=0
BUILD_DIR="${BUILD_DIR:-$HOME/linux-build}"
ARGS=("$@")
while [[ $# -gt 0 ]]; do
    case "$1" in
        --json)
                JSON_OUT=1
                shift
                # JSON mode: the human report goes to stderr, stdout carries only
                # the JSON object. fd 4 is opened HERE — before any output — and is
                # this tool's own real stdout. It is never inherited from a parent
                # shell, so a tool that does not source lib/common.sh still writes
                # its JSON to the right place.
                exec 4>&1 1>&2
                _JSON_FD4=1
                ;;
        --no-color)  NO_COLOR=1 ;;
        --dry-run)   DRY_RUN=1 ;;
        --force)     FORCE=1 ;;
        -y|--yes)    ASSUME_YES=1 ;;
        --apply)     APPLY_FIX=1 ;;
        --io)        WANT_IO=1 ;;
        --full)      BENCH_FULL=1 ;;
        --to)        shift; TO_PKG="${1:-}" ;;
        --to=*)      TO_PKG="${1#--to=}" ;;
        --ver)       shift; BUILD_VER="${1:-}" ;;
        --ver=*)     BUILD_VER="${1#--ver=}" ;;
        --jobs)      shift; BUILD_JOBS="${1:-}" ;;
        --jobs=*)    BUILD_JOBS="${1#--jobs=}" ;;
        --dir)       shift; BUILD_DIR="${1:-}" ;;
        --dir=*)     BUILD_DIR="${1#--dir=}" ;;
        --minimal)   BUILD_MINIMAL=1 ;;
        --git)       BUILD_GIT=1 ;;
        --lts)       BUILD_LTS=1 ;;
        --settle)    shift; SETTLE_DAYS="${1:-}" ;;
        --settle=*)  SETTLE_DAYS="${1#--settle=}" ;;
        --newest)    WANT_NEWEST=1 ;;
        -h|--help)   COMMAND="help" ;;
        show|compare) [[ "$COMMAND" == "bench" ]] && { shift; continue; }
                      printf 'kernelz: unknown option "%s" (try --help)\n' "$1" >&2; exit 64 ;;
        *) if [[ "$COMMAND" == "bench" && "$1" != -* ]]; then shift; continue; fi
           printf 'kernelz: unknown option "%s" (try --help)\n' "$1" >&2; exit 64 ;;
    esac
    shift
done
init_colors

# --settle N overrides how long a kernel must have existed before kernelz
# trusts it ("latest that is also heavily tested").
if [[ -n "$SETTLE_DAYS" ]]; then
    if [[ ! "$SETTLE_DAYS" =~ ^[0-9]+$ ]]; then
        printf 'kernelz: --settle needs a number of days (got "%s")\n' "$SETTLE_DAYS" >&2
        exit 64
    fi
    KB_SETTLE_DAYS="$SETTLE_DAYS"
fi

if [[ -f "$SCRIPT_DIR/lib/run_comparison.sh" ]]; then
    if [[ "$JSON_OUT" -eq 0 ]] && declare -f run_comparison_init >/dev/null 2>&1; then
        case "$COMMAND" in
            status|check|study|history)
                run_comparison_init "kernelz" "JSON_OUT=$JSON_OUT" ;;
        esac
    fi
fi

STATE_SYS="/var/lib/kernelz"
STATE_USR="$HOME/.kernelz"
REL="$(uname -r)"
BOOT_ID="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)"
BOOT_EPOCH="$(awk '/^btime/{print $2; exit}' /proc/stat 2>/dev/null || echo 0)"
TS_EPOCH="$(date +%s)"

SUDO=""
if [[ $EUID -ne 0 ]] && command -v sudo >/dev/null 2>&1; then
    SUDO="sudo"
fi

# Which package manager drives this system? The read paths (what is
# installed, what the repos offer) work everywhere; the write paths
# (apt-mark, apt-get) are Debian/Ubuntu-specific and degrade with a clear
# message elsewhere.
PKG_MGR="deb"
if   command -v apt-get >/dev/null 2>&1; then PKG_MGR="deb"
elif command -v dnf     >/dev/null 2>&1; then PKG_MGR="rpm"
elif command -v yum     >/dev/null 2>&1; then PKG_MGR="rpm"
elif command -v rpm     >/dev/null 2>&1; then PKG_MGR="rpm"
elif command -v pacman  >/dev/null 2>&1; then PKG_MGR="pacman"
fi

# The command a user would type for a routine distro upgrade (shown in tips).
case "$PKG_MGR" in
    deb)    PKG_UPGRADE_CMD="sudo apt upgrade" ;;
    rpm)    PKG_UPGRADE_CMD="sudo dnf upgrade" ;;
    pacman) PKG_UPGRADE_CMD="sudo pacman -Syu" ;;
esac

# Arch names kernels by file stem (vmlinuz-linux), not by uname -r, and GRUB
# titles use that stem too. Map REL to the identity GRUB and the package
# manager agree on, so entry lookup, verify and pending records line up.
if [[ "$PKG_MGR" == "pacman" ]]; then
    _kpkg=$(pacman -Qo "/lib/modules/$(uname -r)" 2>/dev/null | awk '{print $(NF-1)}')
    if [[ -n "$_kpkg" ]]; then
        _kfile=$(pacman -Ql "$_kpkg" 2>/dev/null | awk '/\/boot\/vmlinuz-/{print $2; exit}')
        [[ -n "$_kfile" ]] && REL="${_kfile##*/vmlinuz-}"
    fi
    unset _kpkg _kfile
fi

# ---------- Small utilities ----------
# Version compare that also works without dpkg (Arch/Fedora ship no dpkg).
# The dpkg path stays authoritative on Debian/Ubuntu; elsewhere we fall back
# to a numeric segment compare, which is all kernel versions ever need.
_vcmp() {   # prints -1 / 0 / 1 for $1 vs $2
    awk -v a="$1" -v b="$2" 'BEGIN{
        n=split(a,A,/[^0-9]+/); m=split(b,B,/[^0-9]+/)
        for(i=1;i<=n||i<=m;i++){ x=(i<=n?A[i]+0:0); y=(i<=m?B[i]+0:0)
            if(x!=y){ print (x>y?1:-1); exit } }
        print 0 }'
}
ver_gt() {
    if command -v dpkg >/dev/null 2>&1; then dpkg --compare-versions "$1" gt "$2"
    else [[ "$(_vcmp "$1" "$2")" == 1 ]]; fi
}
ver_ge() {
    if command -v dpkg >/dev/null 2>&1; then dpkg --compare-versions "$1" ge "$2"
    else [[ "$(_vcmp "$1" "$2")" != -1 ]]; fi
}

# compare kernel series ("7.2" vs "6.1"); 0 means $1 is the newer series
series_gt() {
    local a="$1" b="$2"
    [[ -z "$a" || -z "$b" ]] && return 1
    [[ "$a" == "$b" ]] && return 1
    local amaj amin bmaj bmin
    amaj="${a%%.*}"; amin="${a#*.}"
    bmaj="${b%%.*}"; bmin="${b#*.}"
    [[ "$amaj" =~ ^[0-9]+$ ]] || return 1
    [[ "$amin" =~ ^[0-9]+$ ]] || amin=0
    [[ "$bmaj" =~ ^[0-9]+$ ]] || return 1
    [[ "$bmin" =~ ^[0-9]+$ ]] || bmin=0
    (( amaj > bmaj )) && return 0
    (( amaj < bmaj )) && return 1
    (( amin > bmin ))
}

pkg_for_release() {
    local rel="$1" p
    case "$PKG_MGR" in
        deb)
            p=$(dpkg -S "/boot/vmlinuz-$rel" 2>/dev/null | cut -d: -f1 | tr -d ' ')
            [[ -z "$p" ]] && p=$(dpkg-query -W -f='${Package}' "linux-image-$rel" 2>/dev/null)
            ;;
        rpm)
            p=$(rpm -qf "/boot/vmlinuz-$rel" 2>/dev/null | head -1)
            p="${p%.x86_64}"; p="${p%.noarch}"; p="${p%.aarch64}"
            p="${p%-[0-9]*}"
            ;;
        pacman)
            p=$(pacman -Qo "/boot/vmlinuz-$rel" 2>/dev/null | awk '{print $NF}')
            p="${p%-[0-9]*}"
            ;;
    esac
    printf '%s' "$p"
}
pkg_version() {
    case "$PKG_MGR" in
        deb)    dpkg-query -W -f='${Version}' "$1" 2>/dev/null ;;
        rpm)    rpm -q --qf '%{VERSION}-%{RELEASE}' "$1" 2>/dev/null ;;
        pacman) pacman -Q "$1" 2>/dev/null | awk '{print $2}' ;;
    esac
}
pkg_state() {
    case "$PKG_MGR" in
        deb)    dpkg-query -W -f='${db:Status-Abbrev}' "$1" 2>/dev/null ;;
        rpm)    rpm -q "$1" >/dev/null 2>&1 && printf 'ii' ;;
        pacman) pacman -Q "$1" >/dev/null 2>&1 && printf 'ii' ;;
    esac
}
pkg_is_held() { [[ "$(pkg_state "$1")" == h* ]]; }

# ---------- Write-path helpers (one implementation per package manager) ----------
pkg_refresh() {
    case "$PKG_MGR" in
        deb)    run_cmd apt-get update ;;
        rpm)    local q; q=$(command -v dnf >/dev/null 2>&1 && echo dnf || echo yum)
                run_cmd "$q" -y makecache ;;
        pacman) info "pacman refreshes its sync db during install (-Syu)" ;;
    esac
}
pkg_install() {   # install package names with the distro's manager
    case "$PKG_MGR" in
        deb)    run_cmd env DEBIAN_FRONTEND=noninteractive apt-get install -y "$@" ;;
        rpm)    local q; q=$(command -v dnf >/dev/null 2>&1 && echo dnf || echo yum)
                run_cmd "$q" install -y "$@" ;;
        # Arch does not support partial upgrades — -Syu is the correct install.
        pacman) run_cmd pacman -Syu --needed --noconfirm "$@" ;;
    esac
}
grub_cfg_path() {
    if [[ -r /boot/grub/grub.cfg || ! -e /boot/grub2/grub.cfg ]]; then
        printf '/boot/grub/grub.cfg'
    else
        printf '/boot/grub2/grub.cfg'    # Fedora layout
    fi
}
grub_regen() {   # update-grub (Debian) · grub-mkconfig (Arch) · grub2-mkconfig (Fedora)
    local out; out=$(grub_cfg_path)
    if   command -v update-grub     >/dev/null 2>&1; then run_cmd update-grub
    elif command -v grub-mkconfig  >/dev/null 2>&1; then run_cmd grub-mkconfig -o "$out"
    elif command -v grub2-mkconfig >/dev/null 2>&1; then run_cmd grub2-mkconfig -o "$out"
    else warnf "GrubRegen" "no GRUB config generator found" "install grub (or grub2)"; return 1; fi
}
grub_set_default() {
    if   command -v grub-set-default  >/dev/null 2>&1; then run_cmd grub-set-default "$@"
    elif command -v grub2-set-default >/dev/null 2>&1; then run_cmd grub2-set-default "$@"
    else warnf "GrubDefault" "grub-set-default not found" "install grub"; return 1; fi
}
grub_reboot_cmd() {   # one-shot trial boot
    if   command -v grub-reboot  >/dev/null 2>&1; then run_cmd grub-reboot "$@"
    elif command -v grub2-reboot >/dev/null 2>&1; then run_cmd grub2-reboot "$@"
    else warnf "GrubReboot" "grub-reboot not found" "install grub"; return 1; fi
}
grub_editenv_unset() {   # clear the one-shot trial marker
    local env=/boot/grub/grubenv
    [[ -e /boot/grub2/grubenv && ! -e /boot/grub/grubenv ]] && env=/boot/grub2/grubenv
    if   command -v grub-editenv  >/dev/null 2>&1; then run_cmd grub-editenv  "$env" unset next_entry
    elif command -v grub2-editenv >/dev/null 2>&1; then run_cmd grub2-editenv "$env" unset next_entry
    else warnf "GrubEnv" "grub-editenv not found" "install grub"; return 1; fi
}
hold_pkg() {   # $1 = package — the manager's "never touch this kernel"
    case "$PKG_MGR" in
        deb)
            if apt-mark showhold 2>/dev/null | grep -qxF "$1"; then
                ok "custom kernel $1 is held — apt cannot remove it"
            elif run_cmd apt-mark hold "$1" >/dev/null; then
                ok "held $1 (out-of-repo kernel — protected from apt upgrade/full-upgrade/autoremove)"
            else
                warnf "HoldMissing" "could not hold $1" "sudo apt-mark hold $1"
            fi ;;
        pacman)
            local f=/etc/pacman.conf
            if awk -F= '/^IgnorePkg/{print $2}' "$f" 2>/dev/null | grep -qw "$1"; then
                ok "custom kernel $1 is in IgnorePkg — pacman cannot touch it"
            elif grep -q '^IgnorePkg' "$f" 2>/dev/null; then
                if run_cmd sed -i -E "s|^IgnorePkg[[:space:]]*=[[:space:]]*|IgnorePkg = $1 |" "$f"; then
                    ok "held $1 (prepended to IgnorePkg in /etc/pacman.conf)"
                else
                    warnf "HoldMissing" "could not extend IgnorePkg" "edit IgnorePkg in /etc/pacman.conf, add: $1"
                fi
            else
                if run_cmd tee -a "$f" <<<"IgnorePkg = $1" >/dev/null; then
                    ok "held $1 (IgnorePkg added to /etc/pacman.conf)"
                else
                    warnf "HoldMissing" "could not add IgnorePkg" "echo 'IgnorePkg = $1' | sudo tee -a /etc/pacman.conf"
                fi
            fi ;;
        rpm)
            if dnf versionlock list >/dev/null 2>&1; then
                if run_cmd dnf -y versionlock add "$1" >/dev/null; then
                    ok "held $1 (dnf versionlock)"
                else
                    warnf "HoldMissing" "versionlock failed for $1" "sudo dnf versionlock add $1"
                fi
            else
                warnf "HoldMissing" "dnf versionlock plugin missing — $1 not held" \
                    "sudo dnf install python3-dnf-plugin-versionlock && sudo dnf versionlock add $1"
            fi ;;
    esac
}

installed_image_pkgs() {
    case "$PKG_MGR" in
        deb)
            dpkg-query -W -f='${Package}\t${Version}\t${db:Status-Abbrev}\n' 'linux-image-*' 2>/dev/null \
                | awk -F'\t' '$3 ~ /^(ii|hi)/ {print}'
            ;;
        rpm)
            rpm -qa --qf '%{NAME}\t%{VERSION}-%{RELEASE}\tii\n' 'kernel*' 2>/dev/null \
                | grep -E '^kernel(-core|-default|-desktop|-latest)?\b'
            ;;
        pacman)
            # Arch kernels are /boot/vmlinuz-<name> files with no version in
            # the name — ask pacman who owns each one.
            local f p
            for f in /boot/vmlinuz-*; do
                [[ -e "$f" ]] || continue
                p=$(pacman -Qo "$f" 2>/dev/null | awk '{print $(NF-1)}')
                [[ -n "$p" ]] && printf '%s\t%s\tii\n' "$p" "$(pacman -Q "$p" 2>/dev/null | awk '{print $2}')"
            done | sort -u
            ;;
    esac
}

apt_candidate() {
    case "$PKG_MGR" in
        deb)    apt-cache policy "$1" 2>/dev/null | awk '/Candidate:/{print $2}' | grep -v '^$' ;;
        rpm)    local q; q=$(command -v dnf >/dev/null 2>&1 && echo dnf || echo yum)
               timeout 60 "$q" -q repoquery --available --qf '%{version}-%{release}' "$1" 2>/dev/null | head -1 ;;
        pacman) pacman -Si "$1" 2>/dev/null | awk -F': *' '/^Version/{print $2}' ;;
    esac
}

# A candidate version can exist only on this machine ("***" in the version
# table means "installed, no repository provides it"). Such a kernel gets no
# security updates from apt, so it must not count as "from the repos".
pkg_in_repo() {
    local p="$1" out ver
    case "$PKG_MGR" in
        deb)
            out=$(apt-cache policy "$p" 2>/dev/null)
            [[ -z "$out" ]] && return 1
            ver=$(awk '/Candidate:/{print $2; exit}' <<< "$out")
            [[ -z "$ver" || "$ver" == "(none)" ]] && return 1
            awk -v v="$ver" '
                /Version table:/{intab=1; next}
                intab && $1 == v && $2 ~ /^[0-9]+$/ {found=1}
                END{exit !found}
            ' <<< "$out"
            ;;
        rpm)
            local q; q=$(command -v dnf >/dev/null 2>&1 && echo dnf || echo yum)
            timeout 60 "$q" -q repoquery --available "$p" >/dev/null 2>&1
            ;;
        pacman)
            pacman -Si "$p" >/dev/null 2>&1
            ;;
        *) return 1 ;;
    esac
}

META_PKG=""; META_CAND=""; HDR_PKG=""; HDR_CAND=""
detect_meta() {
    local m v
    case "$PKG_MGR" in
        deb)
            for m in linux-image-amd64 linux-generic linux-image-generic; do
                v=$(apt_candidate "$m" 2>/dev/null)
                if [[ -n "$v" && "$v" != "(none)" ]]; then
                    META_PKG="$m"; META_CAND="$v"; break
                fi
            done
            for m in linux-headers-amd64 linux-headers-generic; do
                v=$(apt_candidate "$m" 2>/dev/null)
                if [[ -n "$v" && "$v" != "(none)" ]]; then
                    HDR_PKG="$m"; HDR_CAND="$v"; break
                fi
            done
            ;;
        rpm)
            for m in kernel kernel-core; do
                v=$(apt_candidate "$m" 2>/dev/null)
                if [[ -n "$v" ]]; then META_PKG="$m"; META_CAND="$v"; break; fi
            done
            for m in kernel-devel kernel-headers; do
                v=$(apt_candidate "$m" 2>/dev/null)
                if [[ -n "$v" ]]; then HDR_PKG="$m"; HDR_CAND="$v"; break; fi
            done
            ;;
        pacman)
            v=$(apt_candidate linux 2>/dev/null)
            [[ -n "$v" ]] && { META_PKG="linux"; META_CAND="$v"; }
            v=$(apt_candidate linux-headers 2>/dev/null)
            [[ -n "$v" ]] && HDR_PKG="linux-headers"
            ;;
    esac
}

# float compare helpers (bc-free)
f_gt()  { awk -v a="$1" -v b="$2" 'BEGIN{exit !(a+0>b+0)}'; }
f_ne()  { awk -v a="$1" -v b="$2" 'BEGIN{exit !(a+0!=b+0)}'; }
f_zero() { awk -v a="$1" -v b="$2" 'BEGIN{exit !(a+0==0 && b+0==0)}'; }

boot_free_kb() { df -Pk /boot 2>/dev/null | awk 'NR==2{print $4}'; }
root_free_kb() { df -Pk /      2>/dev/null | awk 'NR==2{print $4}'; }

newest_installed_release() {
    ls /boot/vmlinuz-* 2>/dev/null | sed 's|.*/vmlinuz-||' | sort -V | tail -1
}

# Which packages would apt take away? The three ways a plain "apt upgrade"
# can undo a kernel install:
#   upgrade       — the ordinary one
#   full-upgrade  — dist-upgrade, may remove held-back packages
#   autoremove    — the cleanup pass that reaps orphaned kernels
#
# The removal list is read from apt's own "Remv"/"Purg" lines. The human
# "The following packages will be REMOVED:" block must NOT be used on its
# own: in some apt versions the NEW-package list follows it in the same
# region, which made an older parser mistake "will be installed" for
# "will be removed" — and then held the very kernel apt wanted to install.
apt_would_remove() {   # $1 = upgrade|full-upgrade|autoremove -> pkg names
    local kind="$1" sim
    case "$kind" in
        upgrade)      sim=$(timeout 90 apt-get -s upgrade 2>/dev/null) ;;
        full-upgrade) sim=$(timeout 90 apt-get -s full-upgrade 2>/dev/null) ;;
        autoremove)   sim=$(timeout 90 apt-get -s autoremove 2>/dev/null) ;;
        *) return 1 ;;
    esac
    [[ -z "$sim" ]] && return 1
    printf '%s\n' "$sim" | awk '
        /^The following packages will be REMOVED:/ { f=1; next }
        /^The following/                           { f=0 }
        f && /^[ \t]+[^ \t]/ { gsub(/^[ \t]+/,""); if ($1 != "") print $1 }
        /^Remv[ \t]/ { print $2 }
        /^Purg[ \t]/ { print $2 }
    ' | sed 's/\[.*\]//' | awk 'NF' | sort -u
}

# Kernel packages apt wants to remove — the ones that must never be lost.
# The three simulations are expensive, so the answer is cached for the run.
_APT_REMOVAL_SET=0
_APT_REMOVAL=""
kernels_apt_would_remove() {   # -> pkg names (one per line)
    [[ "$_APT_REMOVAL_SET" -eq 1 ]] && { printf '%s' "$_APT_REMOVAL"; return 0; }
    # the simulation is `apt-get -s` — Debian/Ubuntu only
    if [[ "$PKG_MGR" != deb ]]; then
        _APT_REMOVAL_SET=1; _APT_REMOVAL=""; printf ''; return 0
    fi
    local kind p out=""
    for kind in upgrade full-upgrade autoremove; do
        while read -r p; do
            [[ -z "$p" ]] && continue
            case "$p" in
                linux-image*|linux-headers*) out="${out}${p}"$'\n' ;;
            esac
        done < <(apt_would_remove "$kind")
    done
    out=$(printf '%s' "$out" | awk 'NF' | sort -u)
    _APT_REMOVAL="$out"; _APT_REMOVAL_SET=1
    printf '%s' "$out"
}

# ---------- State files ----------
state_path() {
    local d
    for d in "$STATE_SYS" "$STATE_USR"; do
        [[ -r "$d/$1" ]] && { printf '%s/%s' "$d" "$1"; return 0; }
    done
    printf ''
}
state_read() {
    local p; p=$(state_path "$1")
    [[ -n "$p" ]] && cat "$p"
}
state_write() {   # name content
    [[ "$DRY_RUN" -eq 1 ]] && { printf "  ${C_DIM}[dry-run] would record state file: %s${C_RESET}\n" "$1"; return 0; }
    local n="$1" c="$2"
    if $SUDO mkdir -p "$STATE_SYS" 2>/dev/null \
       && printf '%s\n' "$c" | $SUDO tee "$STATE_SYS/$n" >/dev/null 2>&1; then
        return 0
    fi
    mkdir -p "$STATE_USR" && printf '%s\n' "$c" > "$STATE_USR/$n"
}
state_append() {  # name line
    local n="$1" line="$2"
    if $SUDO mkdir -p "$STATE_SYS" 2>/dev/null \
       && printf '%s\n' "$line" | $SUDO tee -a "$STATE_SYS/$n" >/dev/null 2>&1; then
        return 0
    fi
    mkdir -p "$STATE_USR" && printf '%s\n' "$line" >> "$STATE_USR/$n"
}
state_rm() {
    [[ "$DRY_RUN" -eq 1 ]] && return 0
    $SUDO rm -f "$STATE_SYS/$1" 2>/dev/null
    rm -f "$STATE_USR/$1" 2>/dev/null
}
kz_hist() { [[ "$DRY_RUN" -eq 1 ]] && return 0; state_append history.tsv "$(date +%s)	${COMMAND}	$*"; }

pending_get() { state_read pending.conf | grep "^$1=" | head -1 | cut -d= -f2-; }

# silence human display while collecting JSON fields
json_muffle()   { [[ "${JSON_OUT:-0}" -eq 1 ]] && { exec 5>&1 >/dev/null; return 0; }; return 1; }
json_unmuffle() { [[ "${JSON_OUT:-0}" -eq 1 ]] && exec 1>&5 5>&-; return 0; }

# Boot ledger: boot_id \t kernel_rel \t boot_epoch \t boot_sec (0=unknown)
LEDGER="$STATE_USR/boot-ledger.tsv"
record_boot() {
    mkdir -p "$STATE_USR" 2>/dev/null
    local bsec=0
    if [[ ! -f "$LEDGER" ]] || ! grep -qF "$BOOT_ID" "$LEDGER" 2>/dev/null; then
        bsec=$(systemd-analyze time 2>/dev/null | grep -oE '=[0-9.]+s' | head -1 | tr -d '=s')
        printf '%s\t%s\t%s\t%s\n' "$BOOT_ID" "$REL" "$BOOT_EPOCH" "${bsec:-0}" >> "$LEDGER" 2>/dev/null
    elif systemd-analyze time >/dev/null 2>&1; then
        bsec=$(systemd-analyze time 2>/dev/null | grep -oE '=[0-9.]+s' | head -1 | tr -d '=s')
        if [[ -n "$bsec" ]]; then
            local tmp; tmp=$(mktemp)
            awk -F'\t' -v id="$BOOT_ID" -v s="$bsec" 'BEGIN{OFS="\t"} $1==id && $4=="0" {$4=s} {print}' "$LEDGER" > "$tmp" && mv "$tmp" "$LEDGER"
        fi
    fi
}

# ---------- GRUB entry parsing (submenu-aware) ----------
read_grubcfg() {
    local f
    for f in "$(grub_cfg_path)" /boot/grub/grub.cfg /boot/grub2/grub.cfg; do
        [[ -r "$f" ]] || continue
        cat "$f" && return 0
        break
    done
    # never prompt during read-only passes; callers treat empty as "need root"
    if command -v sudo >/dev/null 2>&1; then
        sudo -n cat "$(grub_cfg_path)" 2>/dev/null || true
    fi
}
grub_entries() {   # $1=cfg -> "id<TAB>title" (submenu-aware, indent-tolerant)
    awk '
    function qtitle(s,  i, j, q) {
        q = sprintf("%c", 39)                       # single quote
        i = index(s, q); if (i) { s = substr(s, i+1); j = index(s, q); if (j) return substr(s, 1, j-1) }
        q = sprintf("%c", 34)                       # double quote
        i = index(s, q); if (i) { s = substr(s, i+1); j = index(s, q); if (j) return substr(s, 1, j-1) }
        return "?"
    }
    BEGIN { top = 0; depth = 0; in_sub = 0; subpos = -1; subcnt = 0 }
    {
        line = $0
        if (line ~ /^[ \t]*submenu[ \t]/ && depth == 0) {
            subpos = top; top++; in_sub = 1; subcnt = 0
        } else if (line ~ /^[ \t]*menuentry[ \t]/) {
            t = qtitle(line)
            # Prefer the real --id: menu positions shift whenever
            # grub-mkconfig regenerates (new kernel, os-prober entry), while
            # ids never do. grub.cfg carries either the literal
            # `$menuentry_id_option 'X'` or the expanded `--id 'X'`.
            id = ""
            p = index(line, "menuentry_id_option")
            if (!p) p = index(line, "--id")
            if (p) {
                rest = substr(line, p)
                q = sprintf("%c", 39)
                i = index(rest, q)
                if (i) { rest = substr(rest, i+1); j = index(rest, q); if (j) id = substr(rest, 1, j-1) }
            }
            if (id == "") {
                if (in_sub && depth >= 1) id = subpos ">" subcnt
                else                      id = sprintf("%d", top)
            }
            if (in_sub && depth >= 1) subcnt++
            else                      top++
            print id "\t" t
        }
        tmp = line
        o = gsub(/{/, "&", tmp); c = gsub(/}/, "&", tmp)
        depth += o - c
        if (depth <= 0) { depth = 0; in_sub = 0 }
    }' <<<"$1"
}
grub_entry_id_for() {   # $1=cfg, rest=tokens to match in titles
    local cfg="$1"; shift
    local tok id
    for tok in "$@"; do
        [[ -z "$tok" ]] && continue
        # 1) title ENDS with the token — "linux" must not grab "linux-lts"
        id=$(grub_entries "$cfg" | awk -F'\t' -v t="$tok" \
             'substr($2, length($2)-length(t)+1) == t { print $1; exit }')
        [[ -n "$id" ]] && { printf '%s' "$id"; return 0; }
        # 2) substring anywhere (version embedded mid-title)
        id=$(grub_entries "$cfg" | awk -F'\t' -v t="$tok" 'index($2,t){print $1; exit}')
        [[ -n "$id" ]] && { printf '%s' "$id"; return 0; }
    done
    return 1
}
entry_tokens() {   # release -> tokens that may appear in a GRUB title
    local rel="$1" pkgver=""
    pkgver=$(pkg_version "$(pkg_for_release "$rel")" 2>/dev/null)
    printf '%s %s' "$rel" "$pkgver"
}

# ---------- Core data ----------
CUR_PKG=""; CUR_VER=""; CUR_HELD=0; IN_REPO=0; UPDATE=0
gather_kernel_facts() {
    detect_meta
    CUR_PKG=$(pkg_for_release "$REL")
    CUR_VER=$(pkg_version "$CUR_PKG"); CUR_VER=${CUR_VER:-"$REL"}
    [[ -n "$CUR_PKG" ]] && CUR_HELD=$(pkg_state "$CUR_PKG") && [[ "$CUR_HELD" == h* ]] && CUR_HELD=1 || CUR_HELD=0
    [[ -n "$CUR_PKG" ]] && [[ "$(apt_candidate "$CUR_PKG" 2>/dev/null)" != "" ]] \
        && [[ "$(apt_candidate "$CUR_PKG")" != "(none)" ]] && IN_REPO=1
    [[ -n "$CUR_PKG" ]] && pkg_in_repo "$CUR_PKG" || IN_REPO=0
    UPDATE=0
    [[ -n "$META_CAND" ]] && ver_gt "$META_CAND" "$CUR_VER" && UPDATE=1
}

# The upstream/repo analysis is network-backed, so it is computed at most once
# per run and only when a section actually needs it.
KB_READY=0
ensure_best() {
    [[ "$KB_READY" -eq 1 ]] && return 0
    declare -f kb_recommend >/dev/null 2>&1 || return 0
    kb_recommend
    KB_READY=1
    return 0
}

# ============================================================================
# HELP
# ============================================================================
show_help() {
    cat << 'HELPEOF'

  ╔══════════════════════════════════════════════════════════════════╗
  ║   kernelz — Kernel Study · Source Build · Safe Upgrade · Recovery║
  ╚══════════════════════════════════════════════════════════════════╝

DESCRIPTION
  Answers "what kernel am I on, is there an update, and what could go
  wrong?" — then does the update with a safety net. After `kernelz upgrade`
  the GRUB *permanent* default stays on the last known good kernel and the
  new kernel boots exactly ONCE (grub-reboot). If it panics or fails, the
  next reboot falls back to the good kernel by itself. `kernelz verify`
  promotes the new kernel to the default once it proves healthy.
  `kernelz protect` guarantees `sudo apt upgrade` can never void/remove
  the installed kernels (meta-package, apt-mark hold/manual, removal
  simulation). `kernelz bench` records per-kernel, per-boot benchmark and
  boot-time data and compares kernels side by side.
  When the repos are too old for you: `kernelz build` finds the latest
  mainline on kernel.org, audits the FULL compile toolchain (names every
  missing package with the exact install line), checks disk/RAM, then
  compiles sha256-verified source and installs it behind the very same
  GRUB one-shot fallback net — a bad home-built kernel reboots itself
  back to the last known good one.

  THE "LATEST BEST KERNEL" RULE
  Every run compares the kernel you are on against the newest kernel that is
  worth trusting — NOT the very latest (a release that landed days ago is
  untested) and NOT the long-term branch (that is the safe fallback, not the
  goal). The verdict is built from the upstream release table (kernel.org),
  the age of each release, whether its series is long-term or end-of-life,
  and the number of people who actually tested it. The report then explains
  WHY an upgrade is worth it and WHAT the newer kernel fixes (CVE ids and
  notable fixes pulled from the upstream changelog).

USAGE
  ./kernelz                     Kernel snapshot + BEST-KERNEL verdict + risk study
  ./kernelz best                Just the best-kernel verdict and what it fixes
  ./kernelz study               Deep study: config hardening, CVE changelog,
                                CPU mitigations, taint, boot ledger
  ./kernelz upgrade             Install the best (tested) kernel + GRUB safety net
                                Debian/Ubuntu (apt) · Fedora/RHEL (dnf) · Arch (pacman)
  ./kernelz update              Alias for upgrade
  ./kernelz upgrade --newest    Take the very newest kernel instead of the tested one
  ./kernelz build               Compile the LATEST MAINLINE from source: toolchain
                                audit → sha256-verified download → bindeb-pkg →
                                install → same GRUB one-shot safety net
  ./kernelz build --lts         Target latest longterm instead of current stable
  ./kernelz build --ver=X.Y.Z   Pin an exact kernel version
  ./kernelz build --minimal     localmodconfig — only build modules you have
                                loaded (much faster, smaller, safer)
  ./kernelz build --git         Incremental mode: shallow git tags in one reused tree —
                                a point release rebuilds only what changed (minutes)
  ./kernelz build --apply       Execute (default is plan + build-script only)
  ./kernelz verify              Post-reboot: promote new kernel / report fallback
  ./kernelz recover             Force GRUB back to last known good kernel
  ./kernelz protect             Harden so `sudo apt upgrade` can't void the kernel
  ./kernelz bench               Benchmark this boot; save metrics for comparison
  ./kernelz bench --io          Include disk write/read benchmarks
  ./kernelz bench --full        Also run ./benchmarkz and diff vs other kernel
  ./kernelz bench show          Show all recorded benchmark runs
  ./kernelz bench compare A B   Compare averages of kernel A vs kernel B
  ./kernelz fix                 Package doctor: study errors/missing pkgs that
                                would break a kernel build/install, print fixes
  ./kernelz cleanup             Preview safe purge of old kernels
  ./kernelz history             Past kernelz actions

OPTIONS
  --to=VERSION|PKG   Upgrade to a specific kernel instead of repo candidate
  --settle=N         Days a release must have existed to count as "tested"
                     (default 14; lower = trust newer kernels sooner)
  --newest           (upgrade) take the very newest kernel, not the tested one
  --ver=X.Y.Z        (build) exact mainline version to compile
  --lts              (build) latest longterm series instead of current stable
  --minimal          (build) make localmodconfig after olddefconfig
  --git              (build) shallow-tag git tree, incremental rebuilds across point releases
  --jobs=N           (build) compile parallelism (default: nproc)
  --dir=PATH         (build) build location (default ~/linux-build, needs ~25-30G)
  --apply            (build) run the full pipeline instead of plan-only
  --io               Include disk benchmarks in `bench`
  --full             Include full benchmarkz run in `bench`
  --dry-run          Print what upgrade/protect would do, change nothing
  --yes              No confirmation prompt (cleanup/upgrade)
  --force            Allow downgrade with --to
  --json             Machine-readable verdict (status/study)
  --no-color         Plain output
  -h, --help         Show this help

HOW RECOVERY WORKS
  1. upgrade → apt installs new kernel, GRUB default pinned to known-good,
     next_entry set to the NEW kernel (boots once only)
  2. reboot  → new kernel either works (run `kernelz verify` → promoted to
     default) or fails (next reboot returns to known-good automatically)
  3. stuck?  → at boot hold Shift → GRUB menu → "Advanced options" → pick
     the previous kernel → log in → run `kernelz recover`

WHEN apt upgrade IS SAFE
  kernelz installs the linux-image-amd64 meta-package (so apt keeps pulling
  kernel updates), marks kernels manual (protects from autoremove), holds
  out-of-repo custom kernels, and simulates `apt-get upgrade` to prove no
  installed kernel would be removed.

ALTERNATIVE COMMANDS
  uname -r                          Current kernel release
  apt-cache policy linux-image-amd64 Candidate kernel version
  dpkg -l 'linux-image*'            Installed kernel packages
  grep ^menuentry /boot/grub/grub.cfg  Boot menu entries (sudo)
  sudo grub-reboot "title"          Boot an entry once
  sudo grub-set-default "title"     Set permanent default
  journalctl --list-boots           Recorded boots
  systemd-analyze time              This boot's duration

HELPEOF
    exit 0
}

# ============================================================================
# STATUS  (kernelz | kernelz check)
# ============================================================================
section_snapshot() {
    section "KERNEL SNAPSHOT"
    local arch up
    arch=$(uname -m)
    up=$(uptime -p 2>/dev/null || uptime | sed 's/^ *//')
    printf "  ${C_BOLD}Running:${C_RESET}      Linux %s (%s) — package %s %s%s\n" \
        "$REL" "$arch" "${CUR_PKG:-unknown}" "$CUR_VER" "$( [[ $CUR_HELD -eq 1 ]] && printf ' [HELD]' )"
    printf "  ${C_DIM}Built:${C_RESET}        %s\n" "$(uname -v)"
    printf "  ${C_DIM}Uptime:${C_RESET}       %s\n" "$up"
    printf "  ${C_DIM}Cmdline:${C_RESET}      %s\n" "$(cat /proc/cmdline 2>/dev/null)"
    add_json_field kernel_release "$REL"
    add_json_field kernel_package "${CUR_PKG:-}"
    add_json_field kernel_version "$CUR_VER"
    add_json_field kernel_held "$([[ $CUR_HELD -eq 1 ]] && echo true || echo false)" 1

    subsec "Installed kernels"
    local pkg ver stat mark
    while IFS=$'\t' read -r pkg ver stat; do
        mark=""
        [[ "$pkg" == "$CUR_PKG" ]] && mark=" ${C_BOLD}${C_GREEN}◀ running${C_RESET}"
        [[ "$stat" == h* ]] && mark="$mark ${C_MAGENTA}[held]${C_RESET}"
        printf "  %-32s %-16s %s%b\n" "$pkg" "$ver" "$stat" "$mark"
    done < <(installed_image_pkgs)

    subsec "Available in repositories"
    if [[ -n "$META_CAND" ]]; then
        add_json_field meta_package "$META_PKG"
        add_json_field apt_candidate "$META_CAND"
        if [[ $UPDATE -eq 1 ]]; then
            printf "  ${C_MAGENTA}${C_BOLD}UPDATE AVAILABLE${C_RESET}  %s → %s  (via %s)\n" "$CUR_VER" "$META_CAND" "$META_PKG"
            printf "  ${C_DIM}Next: %s upgrade   (safe, with GRUB fallback)${C_RESET}\n" "${0##*/}"
        elif ver_ge "$CUR_VER" "$META_CAND"; then
            printf "  ${C_GREEN}Up to date${C_RESET} — running %s ≥ repo candidate %s\n" "$CUR_VER" "$META_CAND"
            [[ $IN_REPO -eq 0 ]] && printf "  ${C_DIM}Note: %s is a custom kernel not tracked by %s; repo max is %s${C_RESET}\n" "$CUR_PKG" "$META_PKG" "$META_CAND"
        fi
        printf "  ${C_DIM}Headers:  ${HDR_PKG:-n/a} → ${HDR_CAND:-n/a}${C_RESET}\n"
        printf "  ${C_DIM}(this is apt's view — the BEST KERNEL section below is the tested one)${C_RESET}\n"
    else
        info "No kernel meta-package found in repositories"
    fi
    add_json_field update_available "$([[ $UPDATE -eq 1 ]] && echo true || echo false)" 1
}

section_grub() {
    section "BOOT LOADER (GRUB)"
    local mode gdefault cfg nentries gv
    gv=$(dpkg-query -W -f='${Version}' grub-efi-amd64 2>/dev/null || dpkg-query -W -f='${Version}' grub-pc 2>/dev/null || echo '?')
    [[ -d /sys/firmware/efi ]] && mode="UEFI (grub $gv)" || mode="BIOS/Legacy (grub $gv)"
    gdefault=$(grep -E '^GRUB_DEFAULT=' /etc/default/grub 2>/dev/null | cut -d= -f2- | tr -d '"')
    printf "  ${C_DIM}Mode:${C_RESET}    %s\n" "$mode"
    printf "  ${C_DIM}Default:${C_RESET} GRUB_DEFAULT=%s\n" "${gdefault:-<unset>}"
    add_json_field boot_mode "$([[ -d /sys/firmware/efi ]] && echo efi || echo bios)"
    add_json_field grub_default "${gdefault:-unset}"

    if grub-editenv /boot/grub/grubenv list 2>/dev/null | grep -qE '^(saved_entry|next_entry)='; then
        grub-editenv /boot/grub/grubenv list 2>/dev/null | grep -E '^(saved_entry|next_entry)=' \
            | while IFS= read -r l; do info "$l"; done
    fi

    cfg=$(read_grubcfg)
    if [[ -z "$cfg" ]]; then
        info "/boot/grub/grub.cfg needs root (mode 600) — run 'sudo ./kernelz' for per-kernel entry check"
        nentries=$(ls /boot/vmlinuz-* 2>/dev/null | wc -l)
        printf "  ${C_DIM}Kernels present in /boot:${C_RESET} %s\n" "$nentries"
        return 0
    fi
    nentries=$(grub_entries "$cfg" | wc -l)
    printf "  ${C_DIM}Menu entries:${C_RESET}     %s\n" "$nentries"
    local rel id
    while read -r rel; do
        [[ -z "$rel" ]] && continue
        read -r -a toks <<< "$(entry_tokens "$rel")"
        if id=$(grub_entry_id_for "$cfg" "${toks[@]}"); then
            ok "kernel $rel → entry $id"
        else
            critf "GrubEntry" "No GRUB menu entry for installed kernel $rel" "sudo update-grub"
        fi
    done < <(ls /boot/vmlinuz-* 2>/dev/null | sed 's|.*/vmlinuz-||')
}

# ============================================================================
# BEST KERNEL — what you run vs what you should be running
# ----------------------------------------------------------------------------
# The rule: NOT the very latest (it just landed, it is untested), but the
# newest kernel that has had time to bake — and not the long-term branch
# unless nothing else is on offer.
# ============================================================================
section_best() {
    ensure_best
    section "BEST KERNEL — what you run vs what you should run"
    if ! declare -f kb_recommend >/dev/null 2>&1; then
        info "kernelbest module unavailable — skipping the comparison"
        return 0
    fi
    if [[ -z "$KB_BEST_PKG" ]]; then
        info "no kernel images found in the repositories — nothing to compare against"
        add_json_field kernel_best_version ""
        return 0
    fi

    local kzl
    kzl() { printf "  ${C_DIM}%-15s${C_RESET} %s\n" "$1" "$2"; }

    # ---- what you are running ----
    local rser rup rdate rnote reol
    rser=$(kb_running_series)
    rup=$(kb_running_upstream)
    reol=$(kb_series_is_eol "$rser")
    kzl "Running" "${C_BOLD}$REL${C_RESET}${rser:+  (series $rser)}"
    if [[ -n "$rup" ]]; then
        rdate=$(kb_upstream_date "$rup") || rdate=""
        if [[ -n "$rdate" ]]; then
            kzl "Upstream build" "$rup · released $(kb_fmt_date "$rdate") · $(kb_fmt_age "$rdate") old"
        else
            kzl "Upstream build" "$rup · release date unknown"
        fi
    else
        kzl "Upstream build" "not an upstream release number — custom/local kernel"
    fi
    if [[ "$reol" == "1" ]]; then
        kzl "Series state" "${C_RED}${C_BOLD}END-OF-LIFE${C_RESET} — upstream no longer fixes series $rser"
        warnf "KernelEOL" "running series $rser is end-of-life upstream — no more security fixes will be published for it" \
            "move to a supported kernel: kernelz best (shows the newest tested one)"
    elif [[ -n "$rser" ]] && [[ "$(kb_series_is_lts "$rser")" == "1" ]]; then
        kzl "Series state" "long-term branch — supported for years, but not the newest"
    else
        kzl "Series state" "${C_GREEN}supported upstream${C_RESET}${rser:+ (series $rser)}"
    fi
    if [[ -n "$CUR_PKG" && $IN_REPO -eq 0 ]]; then
        kzl "Source" "${C_YELLOW}custom build${C_RESET} — your distro's security updates never reach it"
    elif [[ -n "$CUR_PKG" ]]; then
        kzl "Source" "distro package $CUR_PKG"
    fi
    printf "\n"

    # ---- upstream landscape ----
    if [[ "$KB_UPSTREAM_OK" -eq 1 ]]; then
        kzl "Upstream stable" "${C_BOLD}${KB_STABLE_VER:-?}${C_RESET} · released ${KB_STABLE_ISO:-?} · $(kb_fmt_age "$KB_STABLE_DATE") old"
        if [[ -n "$KB_LTS_LIST" ]]; then
            kzl "Long-term" "${C_DIM}${KB_LTS_LIST}${C_RESET}"
        fi
        printf "\n"
        # Does the distro package upstream's current stable branch at all?
        if [[ -n "$KB_STABLE_SER" ]]; then
            local i have=0
            for ((i = 0; i < ${#KB_C_SERIES[@]}; i++)); do
                [[ "${KB_C_SERIES[i]}" == "$KB_STABLE_SER" ]] && { have=1; break; }
            done
            if (( have == 0 )); then
                local sage; sage=$(kb_series_age_days "$KB_STABLE_SER" 2>/dev/null || echo 0)
                if (( sage >= KB_SETTLE_DAYS )); then
                    warnf "KernelGap" "your distro does not package upstream's current stable branch ($KB_STABLE_SER, open ${sage} days)" \
                        "compile it yourself: ${0##*/} build (same GRUB safety net)"
                else
                    info "your distro does not package upstream's current stable branch ($KB_STABLE_SER) yet — it opened ${sage} day(s) ago"
                fi
            fi
        fi
    else
        info "upstream release table unavailable (offline?) — using repository data only"
        printf "\n"
    fi

    # ---- what the repositories offer ----
    local rows=() i
    for ((i = 0; i < ${#KB_C_PKG[@]}; i++)); do
        rows+=("$(printf '%s\t%s\t%s\t%s\t%s\t%s' "${KB_C_TIER[i]}" "${KB_C_DATE[i]:-0}" "${KB_C_PKG[i]}" "${KB_C_VER[i]}" "${KB_C_SERIES[i]}" "${KB_C_NOTE[i]}")")
    done
    if [[ ${#rows[@]} -gt 0 ]]; then
        subsec "Kernels available in your repositories"
        printf "  ${C_DIM}%-5s %-30s %-14s %-6s %-6s %-11s %-9s %s${C_RESET}\n" \
            "tier" "package" "version" "series" "branch" "released" "age" "note"
        while IFS=$'\t' read -r t d pkg ver ser note; do
            local mark="" col="$C_DIM"
            [[ "$pkg" == "$KB_BEST_PKG" && "$ver" == "$KB_BEST_VER" ]] && { mark=" ${C_GREEN}${C_BOLD}★ recommended${C_RESET}"; col="$C_GREEN"; }
            [[ "$pkg" == "$KB_NEW_PKG" && "$ver" == "$KB_NEW_VER" ]] && [[ -z "$mark" ]] && mark=" ${C_YELLOW}(newest in repos)${C_RESET}"
            local age="unknown" released="unknown"
            if [[ "$d" =~ ^[0-9]+$ ]] && (( d > 0 )); then
                age=$(kb_fmt_age "$d"); released=$(kb_fmt_date "$d")
            fi
            printf "  %-5s ${col}%-30s %-14s %-6s %-6s %-11s %-9s${C_RESET} %-30s%b\n" \
                "$t" "$pkg" "$ver" "$ser" \
                "$( [[ "$(kb_series_is_lts "$ser")" == "1" ]] && echo "LTS" || echo "stable" )" \
                "$released" "$age" "$note" "$mark"
        done < <(printf '%s\n' "${rows[@]}" | sort -t$'\t' -k1,1n -k2,2nr | head -8)
        [[ ${#rows[@]} -gt 8 ]] && info "$(( ${#rows[@]} - 8 )) older candidate(s) not shown"
        printf "\n"
    fi

    # ---- the verdict ----
    local tierlbl
    tierlbl=$(kb_tier_label "$KB_BEST_TIER")
    printf "  ${C_BOLD}${C_BLUE}RECOMMENDED${C_RESET}  ${C_BOLD}${KB_BEST_VER}${C_RESET}  ${C_DIM}(${KB_BEST_PKG})${C_RESET}\n"
    if [[ -n "$KB_BEST_PKG" ]]; then
        printf "  ${C_BOLD}Will install${C_RESET}   ${C_BOLD}%s${C_RESET}  %s  ${C_DIM}(series %s)${C_RESET}\n" \
            "$KB_BEST_PKG" "$KB_BEST_VER" "$KB_BEST_SERIES"
    fi
    kzl "Why this one" "${C_BOLD}${tierlbl}${C_RESET} — series $KB_BEST_SERIES · branch open $(kb_series_age_days "$KB_BEST_SERIES" 2>/dev/null || echo '?')d"
    local bage; bage=$(kb_series_age_days "$KB_BEST_SERIES" 2>/dev/null || echo "")
    case "$KB_BEST_TIER" in
        1)
            printf "      ${C_DIM}the newest regular stable kernel your distro ships — the %s branch${C_RESET}\n" "$KB_BEST_SERIES"
            printf "      ${C_DIM}has been out %s days, so it has had time to be tested${C_RESET}\n" "$bage"
            ;;
        2)
            printf "      ${C_DIM}the newest regular stable kernel your distro ships, but the %s branch${C_RESET}\n" "$KB_BEST_SERIES"
            printf "      ${C_DIM}only opened %s days ago — it settles in about %d more day(s)${C_RESET}\n" \
                "$bage" "$(( KB_SETTLE_DAYS - ${bage:-0} ))"
            ;;
        3)
            printf "      ${C_DIM}your distro ships no regular stable kernel, so this long-term branch is${C_RESET}\n"
            printf "      ${C_DIM}the newest thing here with a real track record${C_RESET}\n"
            ;;
    esac
    if [[ -n "$KB_STABLE_VER" && -n "$KB_STABLE_SER" && "$KB_BEST_SERIES" != "$KB_STABLE_SER" ]]; then
        local sage; sage=$(kb_series_age_days "$KB_STABLE_SER" 2>/dev/null || echo 0)
        if (( sage < KB_SETTLE_DAYS )); then
            printf "      ${C_DIM}upstream's newer stable branch %s (%s) opened only %d day(s) ago —${C_RESET}\n" \
                "$KB_STABLE_SER" "$KB_STABLE_VER" "$sage"
            printf "      ${C_DIM}it settles in about %d more day(s)${C_RESET}\n" "$(( KB_SETTLE_DAYS - sage ))"
        else
            printf "      ${C_DIM}upstream's newer stable branch %s (%s) opened %d day(s) ago —${C_RESET}\n" \
                "$KB_STABLE_SER" "$KB_STABLE_VER" "$sage"
            printf "      ${C_DIM}it is settled, but your distro does not package it yet${C_RESET}\n"
        fi
    fi
    printf "\n"

    # ---- are we actually behind? ----
    if [[ -z "$KB_BEST_VER" ]]; then
        :
    elif [[ "$KB_BEST_VER" == "$CUR_VER" && "$KB_BEST_PKG" == "$CUR_PKG" ]]; then
        printf "  ${C_GREEN}${C_BOLD}You are running the recommended kernel${C_RESET} ${C_DIM}($CUR_VER)${C_RESET}\n\n"
    elif series_gt "$KB_BEST_SERIES" "$rser"; then
        printf "  ${C_MAGENTA}${C_BOLD}UPGRADE SUGGESTED${C_RESET}  %s → %s   ${C_DIM}(series %s, %s old, %s)${C_RESET}\n" \
            "$CUR_VER" "$KB_BEST_VER" "$KB_BEST_SERIES" "$(kb_fmt_age "$KB_BEST_DATE")" "$(kb_tier_label "$KB_BEST_TIER")"
        printf "  ${C_DIM}Next: %s upgrade   (safe — the new kernel boots once, GRUB falls back)${C_RESET}\n\n" "${0##*/}"
    elif [[ "$KB_BEST_SERIES" == "$rser" ]]; then
        if ver_gt "$KB_BEST_VER" "$CUR_VER"; then
            printf "  ${C_MAGENTA}${C_BOLD}UPGRADE SUGGESTED${C_RESET}  %s → %s   ${C_DIM}(same series, %s old)${C_RESET}\n" \
                "$CUR_VER" "$KB_BEST_VER" "$(kb_fmt_age "$KB_BEST_DATE")"
            printf "  ${C_DIM}Next: %s upgrade   (safe — the new kernel boots once, GRUB falls back)${C_RESET}\n\n" "${0##*/}"
        else
            printf "  ${C_GREEN}You are ahead of the recommended kernel${C_RESET} ${C_DIM}(running $CUR_VER, recommended $KB_BEST_VER)${C_RESET}\n\n"
        fi
    else
        # The repos' best tested kernel belongs to an OLDER branch than the
        # one in use — that is the long-term fallback, not a step forward.
        printf "  ${C_YELLOW}${C_BOLD}OLDER BRANCH AVAILABLE${C_RESET}  your distro's tested kernel is %s (series %s) —\n" \
            "$KB_BEST_VER" "$KB_BEST_SERIES"
        printf "  ${C_DIM}an older branch than the %s you run. That is the long-term fallback, not a step forward.${C_RESET}\n\n" "$rser"
    fi

    # ---- how to actually do it ----
    section_howto_upgrade

    # ---- JSON ----
    add_json_field kernel_best_package "$KB_BEST_PKG"
    add_json_field kernel_best_version "$KB_BEST_VER"
    add_json_field kernel_best_series "$KB_BEST_SERIES"
    add_json_field kernel_best_upstream "$KB_BEST_UP"
    add_json_field kernel_best_tier "$KB_BEST_TIER"
    add_json_field kernel_best_note "$KB_BEST_NOTE"
    add_json_field kernel_best_age_days "$(kb_age_days "$KB_BEST_DATE")" 1
    add_json_field kernel_newest_version "$KB_NEW_VER"
    add_json_field kernel_running_series "$rser"
    add_json_field kernel_running_upstream "$rup"
    add_json_field kernel_running_eol "$( [[ "$reol" == "1" ]] && echo true || echo false )" 1
    add_json_field kernel_upstream_stable "$KB_STABLE_VER"
    add_json_field kernel_upstream_stable_series "$KB_STABLE_SER"
    add_json_field kernel_upstream_stable_age_days "$(kb_age_days "$KB_STABLE_DATE")" 1
    add_json_field kernel_upstream_lts "$KB_LTS_LIST"
    add_json_field kernel_settle_days "$KB_SETTLE_DAYS" 1
}

# ============================================================================
# HOW TO UPGRADE — the exact commands, and what keeps apt from undoing it
# ============================================================================
section_howto_upgrade() {
    local cmd="${0##*/}"
    local path; path="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
    # sudo does not always inherit your PATH, so the copy-pasteable command
    # uses the absolute path; the short form is used when it resolves.
    local call="sudo $path"
    command -v "$cmd" >/dev/null 2>&1 && call="sudo $cmd"
    subsec "How to upgrade (copy-paste these)"

    # 1 — the upgrade itself
    printf "  ${C_BOLD}1.${C_RESET} install the tested kernel and arm the GRUB fallback:\n"
    printf "       ${C_CYAN}%s upgrade${C_RESET}\n" "$call"
    if [[ -n "$KB_BEST_PKG" ]]; then
        printf "       ${C_BOLD}→ will install:${C_RESET} %s %s   ${C_DIM}(series %s, %s old)${C_RESET}\n" \
            "$KB_BEST_PKG" "$KB_BEST_VER" "$KB_BEST_SERIES" "$(kb_fmt_age "$KB_BEST_DATE")"
        if [[ -n "$META_CAND" && "$KB_BEST_VER" != "$META_CAND" ]]; then
            printf "       ${C_DIM}→ NOT the repo's newest (%s) — that one is only %d day(s) old, still untested${C_RESET}\n" \
                "$META_CAND" "$(kb_age_days "$KB_NEW_DATE")"
        fi
    else
        printf "       ${C_DIM}(no recommended kernel found — the repos have nothing to install)${C_RESET}\n"
    fi
    printf "       ${C_DIM}the new kernel boots ONCE; if it fails, the next reboot lands back on %s${C_RESET}\n" "$REL"

    # 2 — reboot
    printf "  ${C_BOLD}2.${C_RESET} reboot into it:\n"
    printf "       ${C_CYAN}sudo reboot${C_RESET}\n"

    # 3 — promote it
    printf "  ${C_BOLD}3.${C_RESET} after the reboot, promote it to the permanent default:\n"
    printf "       ${C_CYAN}%s verify${C_RESET}   ${C_DIM}(only after the new kernel proved healthy)${C_RESET}\n" "$call"
    printf "       ${C_DIM}until this runs the new kernel boots ONLY ONCE — the next reboot goes${C_RESET}\n"
    printf "       ${C_DIM}back to %s. 'kernelz' will offer to promote it for you.${C_RESET}\n" "$REL"

    # 4 — the same steps without the wrapper
    printf "\n  ${C_BOLD}Doing it by hand instead?${C_RESET}\n"
    printf "       ${C_DIM}sudo apt-get install -y %s${C_RESET}\n" "${KB_BEST_PKG:-$META_PKG}"
    printf "       ${C_DIM}sudo update-grub && sudo grub-reboot \"Advanced options for ...\"${C_RESET}\n"
    printf "       ${C_DIM}(kernelz does this for you, and records the known-good kernel first)${C_RESET}\n"

    # 5 — keeping apt from undoing any of it
    printf "\n  ${C_BOLD}Keeping a later 'sudo apt upgrade' from undoing that:${C_RESET}\n"
    printf "       ${C_CYAN}%s protect${C_RESET}   ${C_DIM}(meta-package + apt-mark manual/hold + removal proof)${C_RESET}\n" "$call"
    printf "       ${C_DIM}%s upgrade already runs protect for you — you only need it${C_RESET}\n" "$cmd"
    printf "       ${C_DIM}when you install a kernel by hand.${C_RESET}\n"

    # what protect actually guarantees
    local removed
    printf "\n  ${C_DIM}What that buys you:${C_RESET}\n"
    if [[ "$PKG_MGR" == deb ]]; then
        removed=$(kernels_apt_would_remove)
        printf "       ${C_DIM}· the kernel meta-package stays installed, so apt keeps tracking kernels${C_RESET}\n"
        printf "       ${C_DIM}· every installed kernel is marked 'manual' — autoremove cannot reap it${C_RESET}\n"
        printf "       ${C_DIM}· out-of-repo kernels are 'hold' — upgrade/full-upgrade/autoremove skip them${C_RESET}\n"
        if [[ -n "$removed" ]]; then
            printf "       ${C_YELLOW}· apt currently plans to remove: %s — 'protect' holds these${C_RESET}\n" "$(tr '\n' ' ' <<< "$removed")"
        else
            printf "       ${C_GREEN}· simulation: apt's upgrade, full-upgrade and autoremove would remove NO kernel${C_RESET}\n"
        fi
    else
        removed=""
        printf "       ${C_DIM}· the kernel meta-package stays installed, so %s keeps tracking kernels${C_RESET}\n" "${PKG_UPGRADE_CMD##* }"
        printf "       ${C_DIM}· out-of-repo kernels are held (${PKG_MGR}: %s) — upgrades skip them${C_RESET}\n" \
            "$( [[ "$PKG_MGR" == pacman ]] && printf 'IgnorePkg' || printf 'versionlock' )"
        printf "       ${C_DIM}· 'protect' also proves the GRUB menu still boots every installed kernel${C_RESET}\n"
    fi
    printf "\n"
}

# ============================================================================
# WHY UPGRADE · WHAT IS FIXED
# ============================================================================
section_fixes() {
    ensure_best
    section "WHY UPGRADE · WHAT IS FIXED"
    if [[ -z "$KB_BEST_PKG" ]]; then
        info "no recommended kernel to compare against"
        return 0
    fi

    local rser rup reol reasons=()
    rser=$(kb_running_series)
    rup=$(kb_running_upstream)
    reol=$(kb_series_is_eol "$rser")

    subsec "Why you might want to upgrade"
    if [[ "$reol" == "1" ]]; then
        reasons+=("${C_RED}your series $rser is END-OF-LIFE upstream${C_RESET} — no more fixes will ever be published for it")
    fi
    if [[ -n "$CUR_PKG" && $IN_REPO -eq 0 ]]; then
        reasons+=("you run a custom kernel — your distro's security patches never reach it")
    fi
    if [[ -n "$KB_BEST_VER" && "$KB_BEST_VER" != "$CUR_VER" ]]; then
        if series_gt "$KB_BEST_SERIES" "$rser"; then
            reasons+=("a newer, already-tested kernel is available: ${C_BOLD}${KB_BEST_VER}${C_RESET} (series $KB_BEST_SERIES, out $(kb_fmt_age "$KB_BEST_DATE"))")
        elif [[ "$KB_BEST_SERIES" == "$rser" ]] && ver_gt "$KB_BEST_VER" "$CUR_VER"; then
            reasons+=("a newer patch of the same series is available: ${C_BOLD}${KB_BEST_VER}${C_RESET} (out $(kb_fmt_age "$KB_BEST_DATE"))")
        fi
    fi
    # behind inside your own series?
    local latest_in_series="${KB_SER_LATEST[$rser]:-}"
    if [[ -n "$rup" && -n "$latest_in_series" ]] && ver_gt "$latest_in_series" "$rup"; then
        reasons+=("you are behind inside series $rser: running $rup, upstream's last release of that series was $latest_in_series")
    fi
    # unmitigated CPU vulnerabilities
    local cvuln=0
    for f in /sys/devices/system/cpu/vulnerabilities/*; do
        [[ -r "$f" ]] || continue
        grep -q '^Vulnerable' "$f" 2>/dev/null && cvuln=$(( cvuln + 1 ))
    done
    (( cvuln > 0 )) && reasons+=("${cvuln} CPU vulnerability class(es) are unmitigated on this kernel — newer kernels add mitigations")

    if [[ ${#reasons[@]} -eq 0 ]]; then
        ok "no strong reason to move — you are on the recommended kernel"
    else
        local r
        for r in "${reasons[@]}"; do printf "    ${C_YELLOW}▸${C_RESET} %b\n" "$r"; done
    fi
    # the "neither branch is right" case: say what to do instead
    if [[ "$reol" == "1" && -n "$KB_STABLE_VER" ]]; then
        local sage; sage=$(kb_age_days "$KB_STABLE_DATE")
        printf "\n"
        if (( sage < KB_SETTLE_DAYS )); then
            printf "    ${C_CYAN}▸${C_RESET} upstream's current stable %s is only %d day(s) old — it will have settled in about %d day(s).\n" \
                "$KB_STABLE_VER" "$sage" "$(( KB_SETTLE_DAYS - sage ))"
            printf "    ${C_CYAN}▸${C_RESET} until then: %s build (compile it yourself, same GRUB safety net) or stay on a supported LTS.\n" "${0##*/}"
        else
            printf "    ${C_CYAN}▸${C_RESET} upstream's current stable %s has settled (%d days old) but your distro does not package it.\n" \
                "$KB_STABLE_VER" "$sage"
            printf "    ${C_CYAN}▸${C_RESET} %s build compiles it for you, behind the same GRUB safety net.\n" "${0##*/}"
        fi
    fi
    printf "\n"

    subsec "What the recommended kernel carries"
    if [[ -z "$KB_BEST_UP" ]]; then
        info "could not map ${KB_BEST_VER} to an upstream release — no changelog comparison possible"
        return 0
    fi
    local facts commits testers cves cl scope
    facts=$(kb_release_facts "$KB_BEST_UP") || facts="0|0|"
    commits="${facts%%|*}"; testers="${facts#*|}"; testers="${testers%%|*}"
    cves="${facts##*|}"
    scope=$(kb_changelog_is_series "$KB_BEST_UP")
    kvline() { printf "    ${C_DIM}%-14s${C_RESET} %s\n" "$1" "$2"; }
    if [[ "$scope" == "1" ]]; then
        kvline "upstream" "${KB_BEST_SERIES} branch ${C_DIM}(this build's ABI is $KB_BEST_UP — the exact upstream patch is not published)${C_RESET}"
    else
        kvline "upstream" "$KB_BEST_UP"
    fi
    kvline "commits" "$commits"
    kvline "tested by" "${testers} upstream tester(s) ${C_DIM}(the stable tree's own Tested-by roster)${C_RESET}"
    if [[ -n "$cves" ]]; then
        kvline "CVE fixes" ""
        printf '%s\n' "$cves" | tr ',' '\n' | while read -r c; do
            [[ -z "$c" ]] && continue
            printf "      ${C_RED}%s${C_RESET}\n" "$c"
        done
    else
        kvline "CVE fixes" "none referenced in its changelog"
    fi

    cl=$(kb_release_changelog "$KB_BEST_UP") || cl=""
    if [[ -n "$cl" ]]; then
        local highlights
        highlights=$(kb_highlights "$cl")
        if [[ -n "$highlights" ]]; then
            if [[ "$scope" == "1" ]]; then
                printf "\n    ${C_DIM}notable fixes in the %s branch:${C_RESET}\n" "$KB_BEST_SERIES"
            else
                printf "\n    ${C_DIM}notable fixes in this release:${C_RESET}\n"
            fi
            printf '%s\n' "$highlights" | head -8 | while IFS= read -r s; do
                printf "      ${C_GREEN}•${C_RESET} %s\n" "$s"
            done
        fi
    fi
    printf "\n"

    # If the repo also has a newer (but less settled) kernel, say what it adds.
    if [[ -n "$KB_NEW_VER" && "$KB_NEW_VER" != "$KB_BEST_VER" && -n "$KB_NEW_UP" ]]; then
        local nfacts ncves
        nfacts=$(kb_release_facts "$KB_NEW_UP") || nfacts="0|0|"
        ncves="${nfacts##*|}"
        printf "  ${C_YELLOW}${C_BOLD}NOTE${C_RESET}  the repos also carry ${C_BOLD}${KB_NEW_VER}${C_RESET}, which is newer but only"
        printf " %s day(s) old — not yet trusted.\n" "$(kb_age_days "$KB_NEW_DATE")"
        if [[ -n "$ncves" ]]; then
            printf "        ${C_DIM}it does carry: %s${C_RESET}\n" "$(printf '%s' "$ncves" | tr ',' ' ')"
            printf "        ${C_DIM}take it with --newest if you want those fixes now${C_RESET}\n"
        fi
        printf "\n"
    fi
    return 0
}

run_risk_checks() {
    section "UPDATE RISK STUDY"
    local bfree rfree bmount
    bfree=$(boot_free_kb); rfree=$(root_free_kb)
    bmount=$(df -Pk /boot 2>/dev/null | awk 'NR==2{print $6}')
    local bmb=${bfree:-0} rmb=${rfree:-0}
    bmb=$((bmb/1024)); rmb=$((rmb/1024))
    local bwhere="/boot"
    [[ "$bmount" == "/" ]] && bwhere="/boot (shares the root partition)"
    add_json_field boot_free_mb "$bmb" 1
    add_json_field root_free_mb "$rmb" 1
    if (( bmb < 250 )); then
        critf "BootSpace" "$bwhere only ${bmb}MB free — a kernel install may fail midway" "purge old kernels: sudo apt purge linux-image-<old> (kernelz cleanup shows candidates)"
    elif [[ "$bmount" == "/boot" && $bmb -lt 500 ]]; then
        warnf "BootSpace" "/boot low (${bmb}MB free)" "consider 'kernelz cleanup' before upgrading"
    else
        ok "$bwhere has ${bmb}MB free"
    fi
    if (( rmb < 2048 )); then
        warnf "RootSpace" "root filesystem low (${rmb}MB free)" "apt needs room for image+headers+initramfs"
    else
        ok "root filesystem has $(( rmb/1024 ))GB free"
    fi

    # Kernel meta package: without it `apt upgrade` stops tracking kernels
    if [[ -n "$META_PKG" ]] && [[ "$(pkg_state "$META_PKG")" != ii* ]]; then
        warnf "KernelMeta" "$META_PKG not installed — 'sudo apt upgrade' will NOT track kernel updates" "kernelz protect installs it"
    elif [[ -n "$META_PKG" ]]; then
        ok "$META_PKG installed — apt upgrade keeps pulling kernel updates"
    fi

    # Custom (out-of-repo) running kernel
    if [[ -n "$CUR_PKG" && $IN_REPO -eq 0 ]]; then
        warnf "CustomKernel" "$CUR_PKG is not from the repositories — no security updates via apt" "keep it held (kernelz protect) and plan migration to a repo kernel, or use kernelz study CVE list on repo kernels"
        if [[ $CUR_HELD -eq 1 ]]; then
            ok "$CUR_PKG is apt-mark held — 'apt upgrade' cannot touch/remove it"
        else
            critf "HoldMissing" "$CUR_PKG is NOT held — 'sudo apt upgrade' could replace or remove it" "kernelz protect (applies apt-mark hold + manual)"
        fi
    fi

    # initrd per kernel
    local rel
    while read -r rel; do
        [[ -z "$rel" ]] && continue
        if [[ -f "/boot/initrd.img-$rel" ]]; then ok "initrd present for $rel"
        else critf "Initrd" "Missing /boot/initrd.img-$rel — that kernel cannot boot root filesystem" "sudo apt-get install --reinstall linux-image-$rel"
        fi
    done < <(ls /boot/vmlinuz-* 2>/dev/null | sed 's|.*/vmlinuz-||')

    # Secure Boot vs custom modules
    local sb="unknown"
    if command -v mokutil >/dev/null 2>&1; then
        sb=$(mokutil --sb-state 2>/dev/null | awk '{print $1}')
    fi
    add_json_field secure_boot "$sb"
    if [[ "$sb" == "enabled" ]]; then
        if [[ $IN_REPO -eq 0 ]]; then
            critf "SecureBoot" "Secure Boot is ON with an unsigned/custom kernel — modules may be refused" "enroll key with mokutil, or disable Secure Boot in firmware, or boot a signed repo kernel"
        else
            ok "Secure Boot on, running a distro-signed kernel"
        fi
    else
        info "Secure Boot: $sb"
    fi

    # dkms modules need a rebuild per new kernel
    if command -v dkms >/dev/null 2>&1; then
        local dk
        dk=$(timeout 10 dkms status 2>/dev/null | head -5)
        if [[ -n "$dk" ]]; then
            warnf "Dkms" "dkms modules present — they rebuild on kernel install" "watch for build errors during kernelz upgrade; verify after boot: dkms status"
        fi
    fi

    # Pending upgrade from a previous run
    local pt pr
    pr=$(pending_get TARGET_REL)
    if [[ -n "$pr" ]]; then
        pt=$(pending_get TS)
        if [[ "$pr" == "$REL" ]]; then
            warnf "Pending" "New kernel $pr booted but was never verified/promoted" "run: kernelz verify"
        elif [[ "$BOOT_EPOCH" -gt "${pt:-0}" ]]; then
            critf "Pending" "Kernel $pr was installed but system is back on $REL — update failed" "run: kernelz verify (shows why), then kernelz recover or kernelz study"
        else
            info "Kernel $pr installed — waiting for reboot (GRUB armed with fallback)"
        fi
        add_json_field pending_kernel "$pr"
    else
        add_json_field pending_kernel ""
    fi

    # last boot errors (best-effort, no sudo prompt)
    local perr
    perr=$(journalctl -q -b -1 -p err --no-pager 2>/dev/null | wc -l)
    if [[ -n "$perr" ]] && (( perr > 0 )); then
        warnf "PriorBoot" "$perr error lines in the previous boot" "journalctl -b -1 -p err   (or ./bootz --boot -1)"
    fi
}

cmd_status() {
    gather_kernel_facts
    record_boot
    emit "\n  ${C_BOLD}${C_BLUE}╔═══════════════════════════════════════════════════════════════╗
  ║  KERNELZ — kernel study · upgrade · recovery · bench          ║
  ╚═══════════════════════════════════════════════════════════════╝${C_RESET}\n"
    emit "  ${C_DIM}v%s · %s · %s${C_RESET}\n" "$SCRIPT_VERSION" "$TIMESTAMP" "$HOSTNAME_SHORT"

    json_muffle
    section_snapshot
    section_best
    section_grub
    run_risk_checks
    section_fixes
    json_unmuffle

    if declare -f run_comparison_finalize >/dev/null 2>&1 && [[ "$JSON_OUT" -eq 0 ]]; then
        run_comparison_finalize 2>/dev/null || true
    fi

    # The whole point of the tool: check, then OFFER to do it. The old
    # kernel stays installed and bootable either way.
    offer_pending
    offer_upgrade
    emit_verdict
}

# ============================================================================
# OFFER PENDING — finish or roll back an upgrade that is half-done
# ----------------------------------------------------------------------------
# After `kernelz upgrade` the new kernel boots exactly ONCE and GRUB's
# permanent default still points at the old one. So the story is only
# finished once the new kernel is promoted. If the new kernel died, the
# machine came back on the old one by itself — the job is to say so and
# clean up.
# ============================================================================
offer_pending() {
    [[ "$JSON_OUT" -eq 1 ]] && return 0
    [[ "$COMMAND" != "status" && "$COMMAND" != "check" ]] && return 0
    local pr pts prev
    pr=$(pending_get TARGET_REL)
    [[ -z "$pr" ]] && return 0
    pts=$(pending_get TS); prev=$(pending_get PREV_REL)

    # ---- case 1: the new kernel booted and is running right now ----
    if [[ "$pr" == "$REL" ]]; then
        section "PENDING — the new kernel is running"
        printf "  ${C_GREEN}${C_BOLD}%s booted successfully${C_RESET} ${C_DIM}(installed %s)${C_RESET}\n" \
            "$REL" "$(date -d "@${pts:-0}" '+%Y-%m-%d %H:%M' 2>/dev/null || echo '?')"
        printf "  ${C_DIM}GRUB's permanent default still points at %s — until the new kernel is${C_RESET}\n" "$prev"
        printf "  ${C_DIM}promoted, the next reboot goes back to it.${C_RESET}\n\n"

        local cmd="${0##*/}"
        local path; path="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
        local call="sudo $path"
        command -v "$cmd" >/dev/null 2>&1 && call="sudo $cmd"

        if [[ ! -t 0 ]]; then
            printf "  ${C_DIM}→ promote it now:  ${C_BOLD}%s verify${C_RESET}\n\n" "$call"
            return 0
        fi
        if (( ASSUME_YES == 1 )); then
            printf "  ${C_GREEN}→${C_RESET} --yes given: promoting it.\n\n"
            cmd_verify
            return 0
        fi
        printf "  ${C_GREEN}→${C_RESET} make %s the permanent default?  ${C_DIM}[y/N]${C_RESET} " "$REL"
        local a; read -r a || a=""
        printf "\n"
        if [[ "${a,,}" == y* ]]; then
            cmd_verify
        else
            info "not promoting — '$call verify' when you are satisfied with this kernel"
            printf "  ${C_DIM}the old kernel stays the default until then${C_RESET}\n\n"
        fi
        return 0
    fi

    # ---- case 2: the new kernel is gone and we are back on the old one ----
    if [[ "$BOOT_EPOCH" -gt "${pts:-0}" ]]; then
        section "PENDING — the upgrade did not stick"
        printf "  ${C_RED}${C_BOLD}%s was installed but the system came back on %s${C_RESET}\n" "$pr" "$REL"
        printf "  ${C_DIM}the GRUB fallback worked exactly as designed — you are safe on the old kernel.${C_RESET}\n"
        printf "  ${C_DIM}previous boot errors (the likely cause):${C_RESET}\n"
        journalctl -q -b -1 -p err --no-pager 2>/dev/null | tail -8 | sed 's/^/      /' \
            || info "journalctl not readable without sudo"
        printf "\n"
        local cmd="${0##*/}"
        local path; path="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
        local call="sudo $path"
        command -v "$cmd" >/dev/null 2>&1 && call="sudo $cmd"
        printf "  ${C_DIM}→${C_RESET} what to do:\n"
        printf "       ${C_BOLD}%s verify${C_RESET}    ${C_DIM}diagnose the failed boot (full analysis)${C_RESET}\n" "$call"
        printf "       ${C_BOLD}%s recover${C_RESET}   ${C_DIM}pin GRUB to %s and clear the pending record${C_RESET}\n" "$call" "$REL"
        printf "       ${C_DIM}%s stays installed, so you can retry any time${C_RESET}\n\n" "$REL"
    fi
    return 0
}

# ============================================================================
# OFFER — "you are behind; want me to upgrade it?"
# ============================================================================
offer_upgrade() {
    [[ "$JSON_OUT" -eq 1 ]] && return 0
    [[ "$COMMAND" != "status" && "$COMMAND" != "check" ]] && return 0
    [[ -z "$KB_BEST_VER" ]] && return 0

    # Decide whether an upgrade is actually warranted.
    local rser reol
    rser=$(kb_running_series)
    reol=$(kb_series_is_eol "$rser")
    local newer=0
    if [[ "$KB_BEST_PKG" == "$CUR_PKG" && "$KB_BEST_VER" == "$CUR_VER" ]]; then
        newer=0                                   # already on it
    elif [[ "$KB_BEST_SERIES" == "$rser" ]]; then
        ver_gt "$KB_BEST_VER" "$CUR_VER" && newer=1
    elif series_gt "$KB_BEST_SERIES" "$rser"; then
        newer=1
    fi

    # Nothing to offer when we are on the best kernel, or when the only
    # option is an older branch (that is a downgrade, not an upgrade).
    if (( newer == 0 )); then
        if [[ "$reol" == "1" && -n "$KB_STABLE_VER" ]]; then
            local sage; sage=$(kb_age_days "$KB_STABLE_DATE")
            if (( sage >= KB_SETTLE_DAYS )); then
                section "RECOMMENDED ACTION"
                printf "  ${C_YELLOW}▸${C_RESET} your series %s is end-of-life, but upstream's current stable %s\n" "$rser" "$KB_STABLE_VER"
                printf "    ${C_DIM}has settled. Your distro does not package it — compile it yourself:${C_RESET}\n"
                printf "      ${C_CYAN}sudo %s build --apply${C_RESET}\n" "${0##*/}"
            fi
        fi
        return 0
    fi

    section "RECOMMENDED ACTION"
    printf "  ${C_MAGENTA}${C_BOLD}UPGRADE AVAILABLE${C_RESET}  %s → %s   ${C_DIM}(%s, %s old)${C_RESET}\n" \
        "$CUR_VER" "$KB_BEST_VER" "$KB_BEST_SERIES" "$(kb_fmt_age "$KB_BEST_DATE")"
    printf "  ${C_DIM}The old kernel stays installed and bootable — if the new one fails,${C_RESET}\n"
    printf "  ${C_DIM}the next reboot lands back on %s automatically.${C_RESET}\n" "$REL"
    printf "\n"

    # Automatic path only for a real terminal; never in a pipe or a cron job.
    local cmd="${0##*/}"
    local path; path="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
    local call="sudo $path"
    command -v "$cmd" >/dev/null 2>&1 && call="sudo $cmd"

    if (( ASSUME_YES == 1 )); then
        printf "  ${C_GREEN}→${C_RESET} --yes given: upgrading now.\n"
        printf "  ${C_DIM}%s upgrade${C_RESET}\n\n" "$call"
        cmd_upgrade
        return 0
    fi
    if [[ ! -t 0 ]]; then
        printf "  ${C_DIM}→${C_RESET} upgrade when ready:  ${C_BOLD}%s upgrade${C_RESET}\n" "$call"
        printf "\n"
        return 0
    fi

    if (( DRY_RUN == 1 )); then
        printf "  ${C_DIM}→${C_RESET} ${C_BOLD}%s upgrade --dry-run${C_RESET}  ${C_DIM}(preview — change nothing)${C_RESET}\n" "$call"
        printf "\n"
        return 0
    fi

    printf "  ${C_GREEN}→${C_RESET} upgrade now?  ${C_DIM}[y/N]${C_RESET} "
    local a; read -r a || a=""
    if [[ "${a,,}" == y* ]]; then
        printf "\n"
        cmd_upgrade
    else
        printf "\n"
        info "not upgrading — run '$call upgrade' whenever you are ready"
        printf "  ${C_DIM}nothing was changed; the current kernel stays exactly as it is${C_RESET}\n\n"
    fi
    return 0
}

# ============================================================================
# STUDY  (deeper dive)
# ============================================================================
study_hardening() {
    section "HARDENING STUDY — /boot/config-$REL"
    local cfg="/boot/config-$REL"
    if [[ ! -r "$cfg" ]]; then
        info "no readable kernel config for $REL"
        return 0
    fi
    local opt
    for opt in CONFIG_RANDOMIZE_BASE CONFIG_RANDOMIZE_MEMORY CONFIG_STACKPROTECTOR_STRONG \
               CONFIG_HARDENED_USERCOPY CONFIG_FORTIFY_SOURCE CONFIG_INIT_ON_ALLOC_DEFAULT_ON \
               CONFIG_STRICT_KERNEL_RWX CONFIG_MODULE_SIG CONFIG_DEBUG_SET_MODULE_RONX; do
        if grep -qE "^${opt}=y" "$cfg"; then ok "$opt=y"
        elif grep -qE "^${opt}=m" "$cfg"; then info "$opt=m"
        else warnf "KernelConfig" "$opt is not enabled" "cosmetic for study: prefer kernels built with $opt=y"
        fi
    done
}

study_cpu_vulns() {
    section "CPU MITIGATION STATUS"
    local dir=/sys/devices/system/cpu/vulnerabilities f vuln=0 mit=0 name val
    [[ -d $dir ]] || { info "sysfs vulnerabilities not exposed"; return 0; }
    for f in "$dir"/*; do
        [[ -e "$f" ]] || continue
        name=${f##*/}; val=$(cat "$f" 2>/dev/null)
        case "$val" in
            "Mitigation"*) mit=$((mit+1));  printf "  ${C_YELLOW}!${C_RESET} %-32s %s\n" "$name" "$val" ;;
            "Not affected"*)                printf "  ${C_GREEN}✓${C_RESET} %-32s %s\n" "$name" "$val" ;;
            "Vulnerable"*)   vuln=$((vuln+1)); printf "  ${C_RED}✗${C_RESET} %-32s ${C_BOLD}%s${C_RESET}\n" "$name" "$val" ;;
            *)                              printf "  ${C_DIM}·${C_RESET} %-32s %s\n" "$name" "$val" ;;
        esac
    done
    (( vuln > 0 )) && critf "CpuVuln" "$vuln CPU vulnerabilit$([[ $vuln -eq 1 ]] && echo y || echo ies) unmitigated — new kernels usually add mitigations" "kernelz upgrade; check 'cat /sys/devices/system/cpu/vulnerabilities/*'"
    add_json_field cpu_vulnerable "$vuln" 1
    info "$mit mitigated via software, $vuln vulnerable"
}

study_changelog() {
    section "UPDATE DIGEST — changelog & CVEs ($META_PKG → $META_CAND)"
    [[ -z "$META_PKG" ]] && { info "no repo kernel meta-package"; return 0; }
    local cl
    cl=$(timeout 30 apt-get changelog "$META_PKG" 2>/dev/null)
    if [[ -z "$cl" ]]; then
        warnf "Changelog" "Could not fetch changelog (offline?)" "apt-get changelog $META_PKG"
        return 0
    fi
    local cves
    cves=$(grep -Eo 'CVE-[0-9]{4}-[0-9]{4,7}' <<< "$cl" | sort -u)
    local n; n=$( [[ -n "$cves" ]] && printf '%s\n' "$cves" | wc -l || echo 0 )
    info "changelog mentions $n unique CVE id(s) in available history"
    if [[ -n "$cves" ]]; then
        printf '%s\n' "$cves" | tail -12 | sed 's/^/      /'
    fi
    subsec "most recent changelog entries"
    printf '%s\n' "$cl" | head -25 | sed 's/^/      /'
}

study_boots() {
    section "BOOT LEDGER (per-kernel boot history)"
    if [[ -r "$LEDGER" ]]; then
        printf "  ${C_DIM}boot                            kernel                    boot-time${C_RESET}\n"
        sort -t$'\t' -k3,3nr "$LEDGER" | head -12 | while IFS=$'\t' read -r id rel ep sec; do
            local tag=""
            [[ "$rel" == "$REL" ]] && tag=" ${C_GREEN}◀ current${C_RESET}"
            printf "  %-31s %-25s %s%b\n" "${id:0:8}… ($(date -d "@$ep" '+%m-%d %H:%M' 2>/dev/null || echo "$ep"))" "$rel" "$([[ "$sec" != "0" && -n "$sec" ]] && printf '%ss' "$sec" || printf '?')" "$tag"
        done
        local nrel
        nrel=$(cut -f2 "$LEDGER" | sort -u | tr '\n' ' ')
        info "kernels seen across boots: $nrel"
    else
        info "no ledger yet — it records automatically on every kernelz run"
    fi
}

cmd_study() {
    gather_kernel_facts
    record_boot
    json_muffle
    section_snapshot
    section_best
    section_grub
    run_risk_checks
    section_fixes
    section "KERNEL IDENTITY"
    printf "  %s\n" "$(uname -a)"
    [[ -r /proc/version ]] && printf "  ${C_DIM}%s${C_RESET}\n" "$(cat /proc/version)"
    local taint; taint=$(cat /proc/sys/kernel/tainted 2>/dev/null || echo 0)
    if [[ "$taint" != "0" ]]; then
        warnf "Tainted" "kernel taint value $taint (out-of-tree or unsigned modules)" "expected for custom kernels like $REL; not a boot risk"
    else
        ok "kernel untainted"
    fi
    add_json_field tainted "$taint" 1
    info "loaded modules: $(lsmod 2>/dev/null | awk 'NR>1' | wc -l) · module trees: $(ls -d /lib/modules/* 2>/dev/null | wc -l)"
    study_hardening
    study_cpu_vulns
    study_changelog
    study_boots
    json_unmuffle
    if declare -f run_comparison_finalize >/dev/null 2>&1 && [[ "$JSON_OUT" -eq 0 ]]; then
        run_comparison_finalize 2>/dev/null || true
    fi
    emit_verdict
}

