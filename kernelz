    printf "  pending:   %s\n" "${pr:-none}"
    [[ -r "$BENCH" ]] && printf "  bench rows:%s (kernels: %s)\n" "$(wc -l < "$BENCH")" "$(cut -f2 "$BENCH" | sort -u | tr '\n' ' ')"
    emit_verdict
}

# ============================================================================
# FIX — package doctor: what's missing/broken that would wreck a kernel
# install, and the exact commands to repair it
# ============================================================================
declare -A FIX_RECS=()
fix_rec() {   # pkg "reason"
    local p="$1" why="$2"
    [[ -z "$p" ]] && return 0
    if [[ -n "${FIX_RECS[$p]:-}" ]]; then
        FIX_RECS[$p]="${FIX_RECS[$p]} · $why"
    else
        FIX_RECS[$p]="$why"
    fi
}
apt_exists() { [[ "$(apt-cache policy "$1" 2>/dev/null | awk '/Candidate:/{print $2}')" =~ ^[0-9] ]]; }
owner_pkg_of() {   # file -> owning package or empty
    dpkg -S "$1" 2>/dev/null | cut -d: -f1 | tr -d ' '
}
fw_to_pkg() {
    case "$1" in
        iwlwifi*|iwl-*)                 printf 'firmware-iwlwifi' ;;
        amdgpu/*)                       printf 'firmware-amd-graphics' ;;
        nvidia/*|nouveau/*|i915/*)      printf 'firmware-misc-nonfree' ;;
        brcm/*)                         printf 'firmware-brcm80211' ;;
        rtl*|rtw89/*|rtl8*)             printf 'firmware-realtek' ;;
        mediatek/*|mt76*)               printf 'firmware-misc-nonfree' ;;
        *)                              printf '' ;;
    esac
}

cmd_fix() {
    gather_kernel_facts
    json_muffle
    local broken=0
    section "PACKAGE DOCTOR — kernel toolchain integrity"

    # ── 1. dpkg / apt database health ───────────────────────────────────
    subsec "dpkg & apt state"
    local audit
    audit=$(dpkg --audit 2>/dev/null)
    if [[ -n "$audit" ]]; then
        broken=1
        critf "DpkgBroken" "dpkg reports unfinished installs — kernel postinst (initramfs/grub hooks) WILL fail" "sudo dpkg --configure -a && sudo apt-get -f install -y   (kernelz fix --apply does this)"
        printf '%s\n' "$audit" | head -4 | sed 's/^/      /'
    else
        ok "dpkg database clean (no half-installed/half-configured packages)"
    fi
    local aptchk="" aptc_rc=0
    aptchk=$(apt-get check 2>&1) || aptc_rc=$?
    if [[ $aptc_rc -eq 0 ]]; then
        ok "apt dependency graph satisfiable"
    elif grep -qi "lock\|root" <<< "$aptchk"; then
        if sudo -n apt-get check >/dev/null 2>&1; then
            ok "apt dependency graph satisfiable (verified via sudo)"
        else
            info "apt-get check needs root (dpkg lock) — run 'sudo kernelz fix' to verify the dependency graph"
        fi
    else
        broken=1
        critf "AptDeps" "apt-get check found unmet dependencies — upgrades may refuse the kernel" "sudo apt-get -f install -y; then inspect: apt-get check"
        printf '%s\n' "$aptchk" | grep -E "^E:" | head -3 | sed 's/^/      /'
    fi
    add_json_field dpkg_broken "$([[ -n "$audit" ]] && echo true || echo false)" 1

    # ── 2. packages the kernel pipeline REQUIRES ────────────────────────
    subsec "kernel-critical packages"
    local bootpkg
    if [[ -d /sys/firmware/efi ]]; then bootpkg="grub-efi-amd64"; else bootpkg="grub-pc"; fi
    local p st
    for p in linux-base initramfs-tools "$bootpkg" kmod e2fsprogs apt-utils; do
        st=$(pkg_state "$p")
        case "$st" in
            ii*|hi*) ok "$p installed" ;;
            *) broken=1; critf "PkgMissing" "$p is NOT installed — required for kernel install/boot pipeline" "sudo apt install $p"
               apt_exists "$p" && fix_rec "$p" "kernel-critical" ;;
        esac
    done
    local why
    for p in dkms linux-headers-amd64 apt-listchanges; do
        case "$p" in
            dkms)               why="third-party modules (GPU/WiFi) rebuild through it on every kernel" ;;
            linux-headers-amd64) why="module builds need the headers matching the newest kernel" ;;
            apt-listchanges)    why="shows changelog/CVE notes before upgrades" ;;
        esac
        st=$(pkg_state "$p")
        case "$st" in
            ii*|hi*) ok "$p installed (recommended)" ;;
            *) warnf "PkgRecommended" "$p missing — $why" "sudo apt install $p"
               apt_exists "$p" && fix_rec "$p" "$why" ;;
        esac
    done
    # meta package for tracking kernel updates
    [[ -n "$META_PKG" ]] && [[ "$(pkg_state "$META_PKG")" != ii* ]] && {
        fix_rec "$META_PKG" "keeps 'apt upgrade' tracking new kernels"
        warnf "PkgMissing" "$META_PKG not installed — plain 'sudo apt upgrade' won't pull kernel updates" "kernelz protect --yes, or sudo apt install $META_PKG"
    }

    # ── 3. tools kernelz & the boot chain depend on ─────────────────────
    subsec "required binaries"
    local b bin owner
    for b in mkinitramfs update-grub grub-mkconfig depmod modprobe lsinitramfs; do
        if command -v "$b" >/dev/null 2>&1; then
            bin=$(command -v "$b")
            owner=$(owner_pkg_of "$bin")
            [[ -z "$owner" ]] && owner=$(basename "$bin")
            [[ "$b" == "update-grub" || "$b" == "mkinitramfs" || "$b" == "depmod" ]] && \
                info "$b → $bin ${C_DIM}($owner)${C_RESET}"
        else
            broken=1
            critf "BinMissing" "$b not found — kernel/initramfs/grub steps cannot run" "dpkg -S or: sudo apt install $(case $b in mkinitramfs|lsinitramfs) echo initramfs-tools;; update-grub|grub-mkconfig) echo "$bootpkg";; depmod|modprobe) echo kmod;; esac)"
            case "$b" in
                mkinitramfs|lsinitramfs) fix_rec "initramfs-tools" "$b missing" ;;
                update-grub|grub-mkconfig) fix_rec "$bootpkg" "$b missing" ;;
                depmod|modprobe) fix_rec "kmod" "$b missing" ;;
            esac
        fi
    done

    # ── 4. study THIS BOOT'S kernel log: module & firmware failures ─────
    subsec "kernel log errors/warnings affecting the kernel stack"
    local klog=""
    klog=$(journalctl -k -b --no-pager -q 2>/dev/null) || true
    [[ -z "$klog" ]] && klog=$(dmesg 2>/dev/null) || true
    [[ -z "$klog" ]] && klog=$(sudo -n dmesg 2>/dev/null) || true
    if [[ -z "$klog" ]]; then
        info "kernel log unreadable without sudo — run: sudo kernelz fix  (for log study)"
    else
        local fwmiss
        fwmiss=$(grep -ioE 'Direct firmware load for [^ ]+ failed' <<<"$klog" | sed -E 's/.*for (.*) failed/\1/' | sort -u)
        if [[ -z "$fwmiss" ]]; then
            ok "no firmware-load failures this boot"
        else
            local fw pkg
            while IFS= read -r fw; do
                [[ -z "$fw" ]] && continue
                pkg=$(fw_to_pkg "$fw")
                if [[ -n "$pkg" ]]; then
                    warnf "Firmware" "firmware '$fw' failed to load" "sudo apt install $pkg"
                    printf "  ${C_YELLOW}!${C_RESET} %s → ${C_BOLD}sudo apt install %s${C_RESET}\n" "$fw" "$pkg"
                    fix_rec "$pkg" "firmware $fw"
                else
                    warnf "Firmware" "firmware '$fw' failed to load (no known package)" "apt-cache search '${fw%%/*}'"
                fi
            done <<< "$fwmiss"
        fi
        local modmiss nmod=0
        modmiss=$(grep -ioE 'Module [a-zA-Z0-9_-]+ not found' <<<"$klog" | awk '{print $2}' | sort -u)
        for m in $modmiss; do
            nmod=$((nmod+1))
            warnf "KernelModule" "kernel could not load module '$m' this boot" "find it: apt-file search $m.ko (sudo apt install apt-file) — or run ./driverz"
        done
        (( nmod == 0 )) && ok "no missing-module errors this boot"
    fi

    # ── 5. failed services that often mean missing packages ─────────────
    if command -v systemctl >/dev/null 2>&1; then
        subsec "failed units → owning packages"
        local units unit frag owner u_err=0
        units=$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}')
        if [[ -z "$units" ]]; then
            ok "no failed systemd units"
        else
            while IFS= read -r unit; do
                [[ -z "$unit" ]] && continue
                frag=$(systemctl show -p FragmentPath --value "$unit" 2>/dev/null)
                owner=""
                [[ -n "$frag" && -f "$frag" ]] && owner=$(owner_pkg_of "$frag")
                if [[ -n "$owner" && "$owner" != "systemd" ]]; then
                    warnf "FailedUnit" "$unit failed (package $owner)" "journalctl -u $unit -b; if missing files: sudo apt install --reinstall $owner"
                    u_err=1
                else
                    warnf "FailedUnit" "$unit failed" "journalctl -u $unit -b   (or ./bootz)"
                fi
            done <<< "$units"
            add_json_field failed_units "$(printf '%s\n' $units | wc -w)" 1
        fi
    fi

    # ── 6. delegate hardware-level gaps to driverz (if installed here) ──
    if [[ -x "$SCRIPT_DIR/driverz" ]]; then
        subsec "hardware driver/firmware gaps (via ./driverz --json)"
        local dj drecs
        dj=$(timeout 60 "$SCRIPT_DIR/driverz" --json 2>/dev/null)
        if [[ -n "$dj" ]]; then
            drecs=$(printf '%s' "$dj" | awk -F'"recommended_packages":"' '{print $2}' | cut -d'"' -f1 | xargs)
            local r
            for r in $drecs; do
                fix_rec "$r" "hardware need reported by driverz"
                printf "  ${C_YELLOW}!${C_RESET} driverz recommends: ${C_BOLD}sudo apt install %s${C_RESET}\n" "$r"
            done
            [[ -z "$drecs" ]] && ok "driverz found no missing driver/firmware packages"
        else
            info "driverz produced no JSON (run './driverz' to see why)"
        fi
    fi

    # ── 7. copy-paste fixes ──────────────────────────────────────────────
    local fixpkgs=()
    for p in $(printf '%s\n' "${!FIX_RECS[@]}" | sort); do apt_exists "$p" && fixpkgs+=("$p"); done
    section "FIX PLAN"
    if (( broken )); then
        [[ -n "$audit" ]] && emit "  ${C_BOLD}1.${C_RESET} dpkg state needs repair first (will run: sudo dpkg --configure -a)\n"
        (( broken )) && emit "  ${C_BOLD}•${C_RESET} or run it all: ${C_CYAN}kernelz fix --apply${C_RESET}\n"
    fi
    if [[ ${#FIX_RECS[@]} -gt 0 ]]; then
        emit "  ${C_BOLD}Missing/needed packages:${C_RESET}\n"
        for p in $(printf '%s\n' "${!FIX_RECS[@]}" | sort); do
            printf "    ${C_GREEN}%-28s${C_RESET} %s\n" "$p" "${FIX_RECS[$p]}"
        done
        if [[ ${#fixpkgs[@]} -gt 0 ]]; then
            printf "\n  ${C_BOLD}one-liner:${C_RESET} ${C_CYAN}sudo apt install -y %s${C_RESET}\n" "${fixpkgs[*]}"
        fi
        if [[ "$APPLY_FIX" -eq 1 ]]; then
            heading "── applying ──"
            [[ -n "$audit" ]] && run_cmd dpkg --configure -a
            run_cmd apt-get -f install -y
            ((${#fixpkgs[@]})) && run_cmd apt-get install -y "${fixpkgs[@]}"
            kz_hist "fix applied pkgs=${fixpkgs[*]:-none}"
        else
            emit "  ${C_DIM}(analysis-only — apply with: kernelz fix --apply)${C_RESET}\n"
        fi
    else
        ok "nothing missing — your kernel toolchain is complete"
    fi
    add_json_field fix_needed "$([[ ${#FIX_RECS[@]} -gt 0 || $broken -eq 1 ]] && echo true || echo false)" 1
    json_unmuffle
    emit_verdict
}

