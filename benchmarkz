#!/usr/bin/env bash

# shellcheck source=.helpz_log.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.helpz_log.sh"
#
# benchmarkz — System-wide benchmarks and speed tests using Linux commands.
# Works with stock tools; uses advanced tools (sysbench, stress-ng, etc.) if available.
#

set -euo pipefail

# ─── Configuration ───────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$SCRIPT_DIR/lib/run_comparison.sh" ]]; then source "$SCRIPT_DIR/lib/run_comparison.sh"; fi
SCRIPT_VERSION="1.0.0"
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S %Z')
HOSTNAME_SHORT=$(hostname -s 2>/dev/null || echo "host")

# ─── Colors ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

has_cmd() { command -v "$1" &>/dev/null; }

# ─── Help ────────────────────────────────────────────────────────────────────
show_help() {
    cat << 'HELPEOF'

  ╔══════════════════════════════════════════════════════════════════╗
  ║          benchmarkz — System-Wide Benchmark Suite             ║
  ╚══════════════════════════════════════════════════════════════════╝

DESCRIPTION
  Runs system-wide benchmarks using stock Linux tools (and advanced
  tools if available). Tests CPU, memory, disk, network, and system
  performance. Reports ratings: excellent/good/moderate/slow.

USAGE
  ./benchmarkz                  Run all benchmarks
  ./benchmarkz 2>&1 | tee bench.txt   Save results to file

OPTIONS
  -h, --help    Show this help message and exit

WHAT IT TESTS
  CPU:       Shell arithmetic, bc math, OpenSSL crypto, compression, forks
  Memory:    RAM copy speed, tmpfs random access latency
  Disk:      Sequential write/read (dd), random 4K IOPS, file metadata ops
  Network:   Localhost throughput (nc), DNS resolution, ping, download speed
  System:    Context switches/sec, hardware interrupts/sec

ALTERNATIVE BENCHMARK COMMANDS
  sysbench cpu run                       CPU benchmark (apt install sysbench)
  sysbench memory run                    Memory benchmark
  stress-ng --cpu 0 -t 30s              CPU stress test
  fio --name=test --ioengine=libaio --rw=randread --bs=4k --size=1G
                                         Advanced disk I/O benchmark (apt install fio)
  iperf3 -s / iperf3 -c <host>          Network throughput test
  dd if=/dev/zero of=test.bin bs=1M count=1024 conv=fdatasync
                                         Simple sequential write test
  openssl speed aes-256-cbc sha256       Crypto performance
  hdparm -Tt /dev/sda                    Disk read speed (cached + buffered)

RESULT → INVESTIGATION COMMANDS
  Slow CPU scores              →  top -bn1 | head -20  or  ps aux --sort=-%cpu | head
  Slow disk I/O                →  iostat -dx 2  or  iotop
  Low memory bandwidth         →  free -h  and  cat /proc/meminfo | grep -i avail
  Slow network                 →  mtr --report google.com  or  iperf3 -c <server>
  High context switches        →  vmstat 1 5  or  pidstat -w 1
  Slow DNS resolution          →  dig google.com @8.8.8.8  and  cat /etc/resolv.conf

HELPEOF
    exit 0
}

# Check for help flag
case "${1:-}" in
    -h|--help) show_help ;;
    --ai)       AI_VERDICT=1 ;;
    --no-ai)    AI_VERDICT=0 ;;
esac

if declare -f run_comparison_init >/dev/null 2>&1; then run_comparison_init "benchmarkz" 2>/dev/null; fi

# ---------- AI hook (opt-in via --ai) ----------
if [[ "${AI_VERDICT:-}" == "1" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    # shellcheck source=lib/ai.sh
    source "$SCRIPT_DIR/lib/ai.sh" 2>/dev/null || true
fi

section() {
    echo ""
    echo -e "${BLUE}${BOLD}══════════════════════════════════════════════════════════════════${NC}"
    echo -e "${BLUE}${BOLD}  $1${NC}"
    echo -e "${BLUE}${BOLD}══════════════════════════════════════════════════════════════════${NC}"
}

subsection() {
    echo ""
    echo -e "${CYAN}${BOLD}── $1 ${NC}"
}

result() {
    local label="$1" value="$2" unit="$3" rating="$4"
    local color
    case "$rating" in
        fast|excellent) color="$GREEN" ;;
        good|moderate)  color="$YELLOW" ;;
        slow|poor)      color="$RED" ;;
        *)              color="$DIM" ;;
    esac
    printf "  %-35s ${color}${BOLD}%-15s${NC} %-8s ${DIM}[%s]${NC}\n" "$label" "$value" "$unit" "$rating"
}

# ─── Results storage ─────────────────────────────────────────────────────────
declare -a BENCH_NAMES BENCH_VALUES BENCH_UNITS BENCH_RATINGS

store_result() {
    BENCH_NAMES+=("$1")
    BENCH_VALUES+=("$2")
    BENCH_UNITS+=("$3")
    BENCH_RATINGS+=("$4")
}

# ═══════════════════════════════════════════════════════════════════════════════
#  BANNER
# ═══════════════════════════════════════════════════════════════════════════════
if [[ ${JSON_OUT:-0} -eq 0 ]]; then
    printf "${BOLD}${MAGENTA}"
    cat << 'BANNER'
   ╔═══════════════════════════════════════════════════════════════╗
   ║  BENCHMARK.SH — System-Wide Benchmark Suite                   ║
   ║  CPU · Memory · Disk · Network · Syscalls                     ║
   ╚═══════════════════════════════════════════════════════════════╝
BANNER
    printf "${NC}\n"
    printf "${DIM}  v${SCRIPT_VERSION} — %s on %s${NC}\n\n" \
        "$TIMESTAMP" "$HOSTNAME_SHORT"
fi
echo -e "  Hostname : ${BOLD}$(hostname)${NC}"
echo -e "  Kernel   : ${BOLD}$(uname -r)${NC}"
echo -e "  CPU      : ${BOLD}$(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | xargs || uname -p)${NC}"
echo -e "  Cores    : ${BOLD}$(nproc 2>/dev/null || echo '?')${NC}"
echo -e "  RAM      : ${BOLD}$(free -h 2>/dev/null | awk '/^Mem:/{print $2}' || echo '?')${NC}"
echo -e "  Disk     : ${BOLD}$(df -h / 2>/dev/null | awk 'NR==2{print $2 " total, " $4 " avail"}' || echo '?')${NC}"
echo ""

# Temp directory for benchmark files
BENCH_DIR=$(mktemp -d /tmp/benchmark.XXXXXX)
trap 'rm -rf "$BENCH_DIR"' EXIT

# ═══════════════════════════════════════════════════════════════════════════════
#  1. CPU BENCHMARKS
# ═══════════════════════════════════════════════════════════════════════════════
section "1. CPU BENCHMARKS"

# ─── 1.1 Single-core: Shell arithmetic ───────────────────────────────────
subsection "1.1 Single-Core — Shell Arithmetic (1M iterations)"
start_ns=$(date +%s%N)
total=0
for ((i = 1; i <= 1000000; i++)); do
    total=$((total + i * 3 - i / 2))
done
end_ns=$(date +%s%N)
elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
elapsed_s=$(echo "scale=2; $elapsed_ms / 1000" | bc 2>/dev/null || echo "$((elapsed_ms / 1000))")

if [[ $elapsed_ms -lt 2000 ]]; then
    rating="excellent"
elif [[ $elapsed_ms -lt 5000 ]]; then
    rating="good"
elif [[ $elapsed_ms -lt 10000 ]]; then
    rating="moderate"
else
    rating="slow"
fi
result "Shell loop (1M ops)" "$elapsed_s" "sec" "$rating"
store_result "CPU: Shell 1M ops" "$elapsed_s" "sec" "$rating"

# ─── 1.2 Single-core: bc math (Pi calculation) ──────────────────────────
subsection "1.2 Single-Core — Math (Pi to 1000 digits via bc)"
if has_cmd bc; then
    start_ns=$(date +%s%N)
    echo "scale=1000; 4*a(1)" | bc -l &>/dev/null
    end_ns=$(date +%s%N)
    elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
    elapsed_s=$(echo "scale=2; $elapsed_ms / 1000" | bc 2>/dev/null || echo "$((elapsed_ms / 1000))")

    if [[ $elapsed_ms -lt 500 ]]; then
        rating="excellent"
    elif [[ $elapsed_ms -lt 2000 ]]; then
        rating="good"
    elif [[ $elapsed_ms -lt 5000 ]]; then
        rating="moderate"
    else
        rating="slow"
    fi
    result "bc Pi (1000 digits)" "$elapsed_s" "sec" "$rating"
    store_result "CPU: bc Pi 1000" "$elapsed_s" "sec" "$rating"
else
    echo -e "  ${DIM}bc not available — skipping${NC}"
fi

# ─── 1.3 OpenSSL crypto benchmark ───────────────────────────────────────
subsection "1.3 OpenSSL — Cryptographic Operations"
if has_cmd openssl; then
    echo ""
    # AES-256-CBC
    aes_result=$(openssl speed -seconds 1 aes-256-cbc 2>/dev/null | grep 'aes-256-cbc' | tail -1 || true)
    if [[ -n "$aes_result" ]]; then
        aes_speed=$(echo "$aes_result" | awk '{print $(NF-1)}')
        aes_unit=$(echo "$aes_result" | awk '{print $NF}')
        echo -e "  AES-256-CBC  : ${BOLD}$aes_speed $aes_unit${NC}"
        store_result "Crypto: AES-256-CBC" "$aes_speed" "$aes_unit" "info"
    fi

    # SHA256
    sha_result=$(openssl speed -seconds 1 sha256 2>/dev/null | grep 'sha256' | tail -1 || true)
    if [[ -n "$sha_result" ]]; then
        sha_speed=$(echo "$sha_result" | awk '{print $(NF-1)}')
        sha_unit=$(echo "$sha_result" | awk '{print $NF}')
        echo -e "  SHA256       : ${BOLD}$sha_speed $sha_unit${NC}"
        store_result "Crypto: SHA256" "$sha_speed" "$sha_unit" "info"
    fi

    # RSA 2048 sign
    rsa_result=$(openssl speed -seconds 1 rsa2048 2>/dev/null | grep 'rsa 2048' | head -1 || true)
    if [[ -n "$rsa_result" ]]; then
        rsa_signs=$(echo "$rsa_result" | awk '{print $4}')
        echo -e "  RSA-2048 sign: ${BOLD}$rsa_signs signs/sec${NC}"
        store_result "Crypto: RSA-2048" "$rsa_signs" "signs/s" "info"
    fi
else
    echo -e "  ${DIM}openssl not available — skipping${NC}"
fi

# ─── 1.4 Compression benchmark ──────────────────────────────────────────
subsection "1.4 Compression — gzip/bzip2/zstd Speed"

# Generate test data (10MB of mixed content)
dd if=/dev/urandom bs=1M count=5 of="$BENCH_DIR/random.bin" 2>/dev/null
dd if=/dev/zero bs=1M count=5 of="$BENCH_DIR/zeros.bin" 2>/dev/null
cat "$BENCH_DIR/random.bin" "$BENCH_DIR/zeros.bin" > "$BENCH_DIR/testdata.bin"
test_size=$(stat -c%s "$BENCH_DIR/testdata.bin" 2>/dev/null || echo "10485760")
test_size_mb=$(echo "scale=1; $test_size / 1048576" | bc 2>/dev/null || echo "10")

# gzip
if has_cmd gzip; then
    start_ns=$(date +%s%N)
    gzip -c "$BENCH_DIR/testdata.bin" > "$BENCH_DIR/test.gz" 2>/dev/null
    end_ns=$(date +%s%N)
    elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
    elapsed_s=$(echo "scale=2; $elapsed_ms / 1000" | bc 2>/dev/null || echo "$((elapsed_ms / 1000))")
    throughput=$(echo "scale=1; $test_size_mb * 1000 / $elapsed_ms" | bc 2>/dev/null || echo "?")

    if [[ $elapsed_ms -lt 500 ]]; then
        rating="excellent"
    elif [[ $elapsed_ms -lt 1500 ]]; then
        rating="good"
    elif [[ $elapsed_ms -lt 3000 ]]; then
        rating="moderate"
    else
        rating="slow"
    fi
    result "gzip compress (${test_size_mb}MB)" "$elapsed_s (${throughput} MB/s)" "" "$rating"
    store_result "Compress: gzip" "$throughput" "MB/s" "$rating"
fi

# bzip2
if has_cmd bzip2; then
    start_ns=$(date +%s%N)
    bzip2 -c "$BENCH_DIR/testdata.bin" > "$BENCH_DIR/test.bz2" 2>/dev/null
    end_ns=$(date +%s%N)
    elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
    elapsed_s=$(echo "scale=2; $elapsed_ms / 1000" | bc 2>/dev/null || echo "$((elapsed_ms / 1000))")
    throughput=$(echo "scale=1; $test_size_mb * 1000 / $elapsed_ms" | bc 2>/dev/null || echo "?")

    if [[ $elapsed_ms -lt 1000 ]]; then
        rating="excellent"
    elif [[ $elapsed_ms -lt 3000 ]]; then
        rating="good"
    elif [[ $elapsed_ms -lt 6000 ]]; then
        rating="moderate"
    else
        rating="slow"
    fi
    result "bzip2 compress (${test_size_mb}MB)" "$elapsed_s (${throughput} MB/s)" "" "$rating"
    store_result "Compress: bzip2" "$throughput" "MB/s" "$rating"
fi

# zstd
if has_cmd zstd; then
    start_ns=$(date +%s%N)
    zstd -c -q "$BENCH_DIR/testdata.bin" -o "$BENCH_DIR/test.zst" 2>/dev/null
    end_ns=$(date +%s%N)
    elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
    elapsed_s=$(echo "scale=2; $elapsed_ms / 1000" | bc 2>/dev/null || echo "$((elapsed_ms / 1000))")
    throughput=$(echo "scale=1; $test_size_mb * 1000 / $elapsed_ms" | bc 2>/dev/null || echo "?")

    if [[ $elapsed_ms -lt 300 ]]; then
        rating="excellent"
    elif [[ $elapsed_ms -lt 1000 ]]; then
        rating="good"
    elif [[ $elapsed_ms -lt 2000 ]]; then
        rating="moderate"
    else
        rating="slow"
    fi
    result "zstd compress (${test_size_mb}MB)" "$elapsed_s (${throughput} MB/s)" "" "$rating"
    store_result "Compress: zstd" "$throughput" "MB/s" "$rating"
fi

# ─── 1.5 Process creation ───────────────────────────────────────────────
subsection "1.5 Process Creation — Fork 500 /bin/true processes"
start_ns=$(date +%s%N)
for ((i = 0; i < 500; i++)); do
    /bin/true
done
end_ns=$(date +%s%N)
elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
elapsed_s=$(echo "scale=2; $elapsed_ms / 1000" | bc 2>/dev/null || echo "$((elapsed_ms / 1000))")
per_sec=$(echo "scale=0; 500 * 1000 / $elapsed_ms" | bc 2>/dev/null || echo "?")

if [[ $elapsed_ms -lt 2000 ]]; then
    rating="excellent"
elif [[ $elapsed_ms -lt 5000 ]]; then
    rating="good"
elif [[ $elapsed_ms -lt 10000 ]]; then
    rating="moderate"
else
    rating="slow"
fi
result "500 forks (/bin/true)" "$elapsed_s ($per_sec/sec)" "" "$rating"
store_result "CPU: 500 forks" "$elapsed_s" "sec" "$rating"

# ─── 1.6 Pipe throughput ────────────────────────────────────────────────
subsection "1.6 Pipe Throughput — dd through pipe"
pipe_result=$(dd if=/dev/zero bs=1M count=500 2>/dev/null | pv -f > /dev/null 2>&1 | tail -1 || true)
if [[ -n "$pipe_result" ]] && has_cmd pv; then
    echo -e "  Pipe speed (500MB zero→pipe→null): ${BOLD}$pipe_result${NC}"
    store_result "Pipe: 500MB throughput" "$pipe_result" "" "info"
else
    # Fallback without pv
    start_ns=$(date +%s%N)
    dd if=/dev/zero bs=1M count=500 2>/dev/null | cat > /dev/null
    end_ns=$(date +%s%N)
    elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
    throughput=$(echo "scale=0; 500 * 1000 / ${elapsed_ms:-1}" | bc 2>/dev/null || echo "?")

    if [[ $throughput -gt 5000 ]] 2>/dev/null; then
        rating="excellent"
    elif [[ $throughput -gt 2000 ]] 2>/dev/null; then
        rating="good"
    elif [[ $throughput -gt 500 ]] 2>/dev/null; then
        rating="moderate"
    else
        rating="slow"
    fi
    result "Pipe 500MB (zero|cat→null)" "$throughput" "MB/s" "$rating"
    store_result "Pipe: 500MB" "$throughput" "MB/s" "$rating"
fi

# ═══════════════════════════════════════════════════════════════════════════════
#  2. MEMORY BENCHMARKS
# ═══════════════════════════════════════════════════════════════════════════════
section "2. MEMORY BENCHMARKS"

# ─── 2.1 Memory copy (dd RAM-to-RAM) ────────────────────────────────────
subsection "2.1 Memory Copy — RAM-to-RAM (dd /dev/zero to /dev/null)"
for size in 100 500 1000; do
    start_ns=$(date +%s%N)
    dd if=/dev/zero of=/dev/null bs=1M count=$size 2>/dev/null
    end_ns=$(date +%s%N)
    elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
    [[ $elapsed_ms -eq 0 ]] && elapsed_ms=1
    throughput=$(echo "scale=0; $size * 1000 / $elapsed_ms" | bc 2>/dev/null || echo "?")

    if [[ $throughput -gt 10000 ]] 2>/dev/null; then
        rating="excellent"
    elif [[ $throughput -gt 5000 ]] 2>/dev/null; then
        rating="good"
    elif [[ $throughput -gt 1000 ]] 2>/dev/null; then
        rating="moderate"
    else
        rating="slow"
    fi
    result "RAM copy ${size}MB" "$throughput" "MB/s" "$rating"
    store_result "RAM: copy ${size}MB" "$throughput" "MB/s" "$rating"
done

# ─── 2.2 Memory latency (tmpfs random read) ─────────────────────────────
subsection "2.2 Memory Latency — tmpfs Random Access"
dd if=/dev/urandom bs=1M count=50 of="$BENCH_DIR/ramtest.bin" 2>/dev/null

start_ns=$(date +%s%N)
for ((i = 0; i < 100; i++)); do
    dd if="$BENCH_DIR/ramtest.bin" of=/dev/null bs=4k count=100 skip=$((RANDOM % 10000)) 2>/dev/null
done
end_ns=$(date +%s%N)
elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
elapsed_s=$(echo "scale=2; $elapsed_ms / 1000" | bc 2>/dev/null || echo "$((elapsed_ms / 1000))")

if [[ $elapsed_ms -lt 500 ]]; then
    rating="excellent"
elif [[ $elapsed_ms -lt 1500 ]]; then
    rating="good"
elif [[ $elapsed_ms -lt 3000 ]]; then
    rating="moderate"
else
    rating="slow"
fi
result "tmpfs 100x 4k random reads" "$elapsed_s" "sec" "$rating"
store_result "RAM: tmpfs latency" "$elapsed_s" "sec" "$rating"

# ─── 2.3 System memory info ─────────────────────────────────────────────
subsection "2.3 Memory Configuration"
echo ""
if has_cmd free; then
    echo -e "  ${BOLD}$(free -h | head -1)${NC}"
    echo -e "  $(free -h | grep '^Mem:')"
    echo -e "  $(free -h | grep '^Swap:')"
fi

# Memory speed from DMI (needs root)
if [[ -r /sys/devices/virtual/dmi/id/product_name ]]; then
    product=$(cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null || true)
    [[ -n "$product" ]] && echo -e "  Platform   : ${BOLD}$product${NC}"
fi

# ═══════════════════════════════════════════════════════════════════════════════
#  3. DISK BENCHMARKS
# ═══════════════════════════════════════════════════════════════════════════════
section "3. DISK BENCHMARKS"

# Determine test location (use /tmp if it's on disk, not tmpfs)
if mount | grep -q 'tmpfs on /tmp'; then
    DISK_TEST_DIR="$BENCH_DIR"
    echo -e "  ${YELLOW}Note: /tmp is tmpfs — testing on RAM disk. For real disk benchmark, set DISK_TEST_DIR.${NC}"
else
    DISK_TEST_DIR="${DISK_TEST_DIR:-$BENCH_DIR}"
fi

# ─── 3.1 Sequential write ───────────────────────────────────────────────
subsection "3.1 Sequential Write — dd 256MB"
sync
start_ns=$(date +%s%N)
dd if=/dev/zero of="$DISK_TEST_DIR/seq_write.bin" bs=1M count=256 conv=fdatasync 2>/dev/null
end_ns=$(date +%s%N)
elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
[[ $elapsed_ms -eq 0 ]] && elapsed_ms=1
write_speed=$(echo "scale=1; 256 * 1000 / $elapsed_ms" | bc 2>/dev/null || echo "?")

if [[ $(echo "$write_speed > 500" | bc 2>/dev/null || echo 0) -eq 1 ]]; then
    rating="excellent"
elif [[ $(echo "$write_speed > 200" | bc 2>/dev/null || echo 0) -eq 1 ]]; then
    rating="good"
elif [[ $(echo "$write_speed > 50" | bc 2>/dev/null || echo 0) -eq 1 ]]; then
    rating="moderate"
else
    rating="slow"
fi
result "Sequential write (256MB)" "$write_speed" "MB/s" "$rating"
store_result "Disk: seq write" "$write_speed" "MB/s" "$rating"
rm -f "$DISK_TEST_DIR/seq_write.bin"

# ─── 3.2 Sequential read ────────────────────────────────────────────────
subsection "3.2 Sequential Read — dd 256MB"
# Create test file first
dd if=/dev/zero of="$DISK_TEST_DIR/seq_read.bin" bs=1M count=256 2>/dev/null
sync
echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true

start_ns=$(date +%s%N)
dd if="$DISK_TEST_DIR/seq_read.bin" of=/dev/null bs=1M 2>/dev/null
end_ns=$(date +%s%N)
elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
[[ $elapsed_ms -eq 0 ]] && elapsed_ms=1
read_speed=$(echo "scale=1; 256 * 1000 / $elapsed_ms" | bc 2>/dev/null || echo "?")

if [[ $(echo "$read_speed > 500" | bc 2>/dev/null || echo 0) -eq 1 ]]; then
    rating="excellent"
elif [[ $(echo "$read_speed > 200" | bc 2>/dev/null || echo 0) -eq 1 ]]; then
    rating="good"
elif [[ $(echo "$read_speed > 50" | bc 2>/dev/null || echo 0) -eq 1 ]]; then
    rating="moderate"
else
    rating="slow"
fi
result "Sequential read (256MB)" "$read_speed" "MB/s" "$rating"
store_result "Disk: seq read" "$read_speed" "MB/s" "$rating"
rm -f "$DISK_TEST_DIR/seq_read.bin"

# ─── 3.3 Random I/O (small blocks) ─────────────────────────────────────
subsection "3.3 Random I/O — 1000x 4K writes"
start_ns=$(date +%s%N)
for ((i = 0; i < 1000; i++)); do
    dd if=/dev/zero of="$DISK_TEST_DIR/rand_$$" bs=4k count=1 conv=notrunc oflag=append 2>/dev/null
done
end_ns=$(date +%s%N)
elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
iops=$(echo "scale=0; 1000 * 1000 / ${elapsed_ms:-1}" | bc 2>/dev/null || echo "?")

if [[ $iops -gt 5000 ]] 2>/dev/null; then
    rating="excellent"
elif [[ $iops -gt 2000 ]] 2>/dev/null; then
    rating="good"
elif [[ $iops -gt 500 ]] 2>/dev/null; then
    rating="moderate"
else
    rating="slow"
fi
result "4K random writes (1000)" "$iops" "IOPS" "$rating"
store_result "Disk: 4K IOPS" "$iops" "IOPS" "$rating"
rm -f "$DISK_TEST_DIR/rand_$$"

# ─── 3.4 File creation/deletion ─────────────────────────────────────────
subsection "3.4 File Metadata — Create/Delete 1000 small files"
mkdir -p "$DISK_TEST_DIR/filetest"
start_ns=$(date +%s%N)
for ((i = 0; i < 1000; i++)); do
    echo "test" > "$DISK_TEST_DIR/filetest/file_$i"
done
mid_ns=$(date +%s%N)
for ((i = 0; i < 1000; i++)); do
    rm -f "$DISK_TEST_DIR/filetest/file_$i"
done
end_ns=$(date +%s%N)
rmdir "$DISK_TEST_DIR/filetest" 2>/dev/null || true

create_ms=$(( (mid_ns - start_ns) / 1000000 ))
delete_ms=$(( (end_ns - mid_ns) / 1000000 ))
total_meta_ms=$((create_ms + delete_ms))

create_s=$(echo "scale=2; $create_ms / 1000" | bc 2>/dev/null || echo "$((create_ms / 1000))")
delete_s=$(echo "scale=2; $delete_ms / 1000" | bc 2>/dev/null || echo "$((delete_ms / 1000))")

if [[ $total_meta_ms -lt 1000 ]]; then
    rating="excellent"
elif [[ $total_meta_ms -lt 3000 ]]; then
    rating="good"
elif [[ $total_meta_ms -lt 6000 ]]; then
    rating="moderate"
else
    rating="slow"
fi
result "Create 1000 files" "$create_s" "sec" "$rating"
result "Delete 1000 files" "$delete_s" "sec" ""
store_result "Disk: file create" "$create_s" "sec" "$rating"

# ─── 3.5 Disk info ──────────────────────────────────────────────────────
subsection "3.5 Storage Configuration"
echo ""
if has_cmd lsblk; then
    echo -e "  ${BOLD}Block Devices:${NC}"
    lsblk -d -o NAME,SIZE,ROTA,TYPE,MODEL 2>/dev/null | head -10 || true
    echo ""
    # Check for SSD vs HDD
    rotational=$(lsblk -d -n -o ROTA,TYPE 2>/dev/null | grep 'disk' | awk '{print $1}' | head -1)
    if [[ "$rotational" == "0" ]]; then
        echo -e "  Drive type : ${GREEN}SSD (non-rotational)${NC}"
    elif [[ "$rotational" == "1" ]]; then
        echo -e "  Drive type : ${YELLOW}HDD (rotational)${NC}"
    fi
fi

if has_cmd df; then
    echo ""
    echo -e "  ${BOLD}Filesystem Usage:${NC}"
    df -h --output=source,size,used,avail,pcent,target 2>/dev/null | grep -vE '(tmpfs|devtmpfs|overlay)' | head -8 || \
        df -h 2>/dev/null | head -8 || true
fi

# ═══════════════════════════════════════════════════════════════════════════════
#  4. NETWORK BENCHMARKS
# ═══════════════════════════════════════════════════════════════════════════════
section "4. NETWORK BENCHMARKS"

# ─── 4.1 Localhost throughput ───────────────────────────────────────────
subsection "4.1 Localhost Throughput — nc pipe test"
if has_cmd nc || has_cmd ncat; then
    NC_CMD=$(command -v nc 2>/dev/null || command -v ncat 2>/dev/null)
    port=$((10000 + RANDOM % 50000))

    # Start receiver
    $NC_CMD -l $port > /dev/null &
    receiver_pid=$!
    sleep 0.2

    # Send 100MB
    start_ns=$(date +%s%N)
    dd if=/dev/zero bs=1M count=100 2>/dev/null | $NC_CMD localhost $port 2>/dev/null
    end_ns=$(date +%s%N)

    kill $receiver_pid 2>/dev/null || true
    wait $receiver_pid 2>/dev/null || true

    elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
    [[ $elapsed_ms -eq 0 ]] && elapsed_ms=1
    lo_speed=$(echo "scale=1; 100 * 1000 / $elapsed_ms" | bc 2>/dev/null || echo "?")

    if [[ $(echo "$lo_speed > 5000" | bc 2>/dev/null || echo 0) -eq 1 ]]; then
        rating="excellent"
    elif [[ $(echo "$lo_speed > 1000" | bc 2>/dev/null || echo 0) -eq 1 ]]; then
        rating="good"
    elif [[ $(echo "$lo_speed > 200" | bc 2>/dev/null || echo 0) -eq 1 ]]; then
        rating="moderate"
    else
        rating="slow"
    fi
    result "Localhost (100MB via nc)" "$lo_speed" "MB/s" "$rating"
    store_result "Net: localhost" "$lo_speed" "MB/s" "$rating"
else
    echo -e "  ${DIM}nc/ncat not available — skipping${NC}"
fi

# ─── 4.2 DNS resolution ─────────────────────────────────────────────────
subsection "4.2 DNS Resolution — 20 lookups"
if has_cmd dig; then
    start_ns=$(date +%s%N)
    for domain in google.com github.com cloudflare.com amazon.com microsoft.com \
                  apple.com mozilla.org wikipedia.org reddit.com stackoverflow.com \
                  google.com github.com cloudflare.com amazon.com microsoft.com \
                  apple.com mozilla.org wikipedia.org reddit.com stackoverflow.com; do
        dig +short +time=2 "$domain" &>/dev/null || true
    done
    end_ns=$(date +%s%N)
    elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
    avg_ms=$((elapsed_ms / 20))

    if [[ $avg_ms -lt 20 ]]; then
        rating="excellent"
    elif [[ $avg_ms -lt 50 ]]; then
        rating="good"
    elif [[ $avg_ms -lt 100 ]]; then
        rating="moderate"
    else
        rating="slow"
    fi
    result "DNS (20 lookups, avg)" "$avg_ms" "ms/lookup" "$rating"
    store_result "Net: DNS avg" "$avg_ms" "ms" "$rating"
elif has_cmd host; then
    start_ns=$(date +%s%N)
    for ((i = 0; i < 20; i++)); do
        host google.com &>/dev/null || true
    done
    end_ns=$(date +%s%N)
    elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
    avg_ms=$((elapsed_ms / 20))
    result "DNS (20x host google.com, avg)" "$avg_ms" "ms/lookup" "info"
    store_result "Net: DNS avg" "$avg_ms" "ms" "info"
else
    echo -e "  ${DIM}dig/host not available — skipping${NC}"
fi

# ─── 4.3 Latency (ping) ─────────────────────────────────────────────────
subsection "4.3 Network Latency — ping to major endpoints"
declare -a PING_TARGETS=("8.8.8.8" "1.1.1.1" "1.0.0.1")
declare -a PING_NAMES=("Google DNS" "Cloudflare" "Cloudflare #2")

for idx in "${!PING_TARGETS[@]}"; do
    target="${PING_TARGETS[$idx]}"
    name="${PING_NAMES[$idx]}"
    ping_result=$(ping -c 5 -W 2 "$target" 2>/dev/null | grep 'rtt\|round-trip' || true)
    if [[ -n "$ping_result" ]]; then
        avg_lat=$(echo "$ping_result" | awk -F'/' '{print $5}')
        echo -e "  $name ($target): ${BOLD}${avg_lat} ms${NC} avg"
        store_result "Ping: $name" "$avg_lat" "ms" "info"
    else
        echo -e "  $name ($target): ${DIM}unreachable${NC}"
    fi
done

# ─── 4.4 Download speed ─────────────────────────────────────────────────
subsection "4.4 Download Speed — curl to Cloudflare"
if has_cmd curl; then
    # Use Cloudflare's speed test endpoint (10MB)
    dl_result=$(curl -o /dev/null -w '%{speed_download}' -s --max-time 10 \
        'https://speed.cloudflare.com/__down?bytes=10000000' 2>/dev/null || true)
    if [[ -n "$dl_result" ]] && [[ "$dl_result" != "0" ]]; then
        dl_mbps=$(echo "scale=1; $dl_result * 8 / 1000000" | bc 2>/dev/null || echo "?")
        dl_mbs=$(echo "scale=1; $dl_result / 1000000" | bc 2>/dev/null || echo "?")

        if [[ $(echo "$dl_mbps > 100" | bc 2>/dev/null || echo 0) -eq 1 ]]; then
            rating="excellent"
        elif [[ $(echo "$dl_mbps > 30" | bc 2>/dev/null || echo 0) -eq 1 ]]; then
            rating="good"
        elif [[ $(echo "$dl_mbps > 5" | bc 2>/dev/null || echo 0) -eq 1 ]]; then
            rating="moderate"
        else
            rating="slow"
        fi
        result "Download (Cloudflare 10MB)" "$dl_mbps" "Mbps" "$rating"
        store_result "Net: download" "$dl_mbps" "Mbps" "$rating"
    else
        echo -e "  ${DIM}Download test failed or no internet${NC}"
    fi
fi

# ═══════════════════════════════════════════════════════════════════════════════
#  5. SYSTEM BENCHMARKS
# ═══════════════════════════════════════════════════════════════════════════════
section "5. SYSTEM BENCHMARKS"

# ─── 5.1 Context switches ───────────────────────────────────────────────
subsection "5.1 Context Switches (10-second sample)"
if [[ -r /proc/stat ]]; then
    cs_start=$(awk '/^ctxt/{print $2}' /proc/stat)
    sleep 2
    cs_end=$(awk '/^ctxt/{print $2}' /proc/stat)
    cs_delta=$((cs_end - cs_start))
    cs_per_sec=$((cs_delta / 2))

    if [[ $cs_per_sec -gt 100000 ]]; then
        rating="excellent"
    elif [[ $cs_per_sec -gt 50000 ]]; then
        rating="good"
    elif [[ $cs_per_sec -gt 10000 ]]; then
        rating="moderate"
    else
        rating="slow"
    fi
    result "Context switches" "$cs_per_sec" "/sec" "$rating"
    store_result "Sys: ctx switches" "$cs_per_sec" "/sec" "$rating"
fi

# ─── 5.2 Interrupts ─────────────────────────────────────────────────────
subsection "5.2 Interrupts (10-second sample)"
if [[ -r /proc/stat ]]; then
    irq_start=$(awk '/^intr/{print $2}' /proc/stat)
    sleep 2
    irq_end=$(awk '/^intr/{print $2}' /proc/stat)
    irq_delta=$((irq_end - irq_start))
    irq_per_sec=$((irq_delta / 2))
    result "Hardware interrupts" "$irq_per_sec" "/sec" "info"
    store_result "Sys: interrupts" "$irq_per_sec" "/sec" "info"
fi

# ─── 5.3 Fork bomb (safe) — process throughput ─────────────────────────
subsection "5.3 Process Throughput — 1000 bash -c true"
start_ns=$(date +%s%N)
for ((i = 0; i < 1000; i++)); do
    bash -c true
done
end_ns=$(date +%s%N)
elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
per_sec=$(echo "scale=0; 1000 * 1000 / ${elapsed_ms:-1}" | bc 2>/dev/null || echo "?")

if [[ $per_sec -gt 1000 ]] 2>/dev/null; then
    rating="excellent"
elif [[ $per_sec -gt 500 ]] 2>/dev/null; then
    rating="good"
elif [[ $per_sec -gt 200 ]] 2>/dev/null; then
    rating="moderate"
else
    rating="slow"
fi
result "bash -c true (1000)" "$per_sec" "procs/s" "$rating"
store_result "Sys: bash forks" "$per_sec" "/sec" "$rating"

# ─── 5.4 sysbench (if available) ────────────────────────────────────────
subsection "5.4 Advanced Benchmarks (optional tools)"
if has_cmd sysbench; then
    echo ""
    echo -e "  ${GREEN}sysbench detected — running CPU benchmark${NC}"
    sysbench cpu --cpu-max-prime=10000 --threads=1 run 2>/dev/null | grep -E 'events per second|total number' || true
    store_result "sysbench: available" "yes" "" "info"
else
    echo -e "  ${DIM}sysbench not installed — install for advanced CPU/thread benchmarks${NC}"
    echo -e "  ${DIM}  sudo apt install sysbench${NC}"
fi

if has_cmd stress-ng; then
    echo ""
    echo -e "  ${GREEN}stress-ng detected — running quick stress test (5s)${NC}"
    stress-ng --cpu 1 --timeout 5 --metrics-brief 2>&1 | grep -E 'bogo ops|cpu' | head -3 || true
    store_result "stress-ng: available" "yes" "" "info"
else
    echo -e "  ${DIM}stress-ng not installed — install for stress/load testing${NC}"
    echo -e "  ${DIM}  sudo apt install stress-ng${NC}"
fi

if has_cmd iperf3; then
    echo ""
    echo -e "  ${GREEN}iperf3 detected — localhost bandwidth test${NC}"
    iperf3 -s -D 2>/dev/null
    sleep 0.5
    iperf3 -c 127.0.0.1 -t 3 2>/dev/null | grep -E 'Bits Per Second|transfer' || true
    killall iperf3 2>/dev/null || true
    store_result "iperf3: available" "yes" "" "info"
else
    echo -e "  ${DIM}iperf3 not installed — install for network bandwidth testing${NC}"
    echo -e "  ${DIM}  sudo apt install iperf3${NC}"
fi

if has_cmd fio; then
    echo ""
    echo -e "  ${GREEN}fio detected — running quick I/O test${NC}"
    fio --name=quick --ioengine=libaio --filesize=16M --numjobs=1 --time_based \
        --runtime=3 --group_reporting --bs=4k --rw=randread --directory="$BENCH_DIR" \
        2>/dev/null | grep -E 'read:|iops|bw=' | head -3 || true
    store_result "fio: available" "yes" "" "info"
else
    echo -e "  ${DIM}fio not installed — install for advanced I/O benchmarking${NC}"
    echo -e "  ${DIM}  sudo apt install fio${NC}"
fi

# ═══════════════════════════════════════════════════════════════════════════════
#  SUMMARY
# ═══════════════════════════════════════════════════════════════════════════════
section "BENCHMARK SUMMARY"

echo ""
printf "  ${BOLD}%-35s %-15s %-8s %-12s${NC}\n" "TEST" "VALUE" "UNIT" "RATING"
echo -e "  ───────────────────────────────── ───────────── ──────── ────────────"

for ((i = 0; i < ${#BENCH_NAMES[@]}; i++)); do
    name="${BENCH_NAMES[$i]}"
    value="${BENCH_VALUES[$i]}"
    unit="${BENCH_UNITS[$i]}"
    rating="${BENCH_RATINGS[$i]}"

    color=""
    case "$rating" in
        fast|excellent) color="$GREEN" ;;
        good|moderate)  color="$YELLOW" ;;
        slow|poor)      color="$RED" ;;
        *)              color="$DIM" ;;
    esac

    printf "  %-35s " "$name"
    echo -ne "${color}${BOLD}${value}${NC}"
    # Pad value column
    pad=$((15 - ${#value}))
    for ((p = 0; p < pad; p++)); do echo -n " "; done
    printf " %-8s " "$unit"
    echo -e "${color}${rating}${NC}"
done

echo ""

# ─── Overall Score ───────────────────────────────────────────────────────
excellent_count=0
good_count=0
moderate_count=0
slow_count=0

for r in "${BENCH_RATINGS[@]}"; do
    case "$r" in
        excellent|fast) ((excellent_count += 1)) ;;
        good)           ((good_count += 1)) ;;
        moderate)       ((moderate_count += 1)) ;;
        slow|poor)      ((slow_count += 1)) ;;
    esac
done

total=$((excellent_count + good_count + moderate_count + slow_count))

# ─── Bar Chart: rating distribution ──────────────────────────────────────────
if [[ $total -gt 0 ]]; then
    echo -e "  ${BOLD}Rating distribution${NC}"
    rating_labels=("Excellent" "Good" "Moderate" "Slow")
    rating_counts=("$excellent_count" "$good_count" "$moderate_count" "$slow_count")
    rating_colors=("$GREEN" "$YELLOW" "$BLUE" "$RED")
    for ((ri = 0; ri < 4; ri++)); do
        rc="${rating_counts[$ri]}"
        pct=$(( rc * 100 / total ))
        arc=$(( rc * 30 / total ))
        if [[ $rc -gt 0 ]] && [[ $arc -eq 0 ]]; then arc=1; fi
        bar=""
        for ((b = 0; b < arc; b++)); do bar+="█"; done
        for ((b = arc; b < 30; b++)); do bar+=" "; done
        printf "  ${rating_colors[$ri]}%-10s %s${NC} ${BOLD}%3d${NC} ${DIM}(%d%%)${NC}\n" \
            "${rating_labels[$ri]}" "$bar" "$rc" "$pct"
    done
fi
echo -e "  ${DIM}Total rated: $total${NC}"
echo ""

if [[ $slow_count -eq 0 ]] && [[ $excellent_count -gt $((total / 2)) ]]; then
    echo -e "  ${GREEN}${BOLD}✓  System performance is excellent${NC}"
elif [[ $slow_count -le 2 ]]; then
    echo -e "  ${YELLOW}${BOLD}~  System performance is good with minor bottlenecks${NC}"
elif [[ $slow_count -le 5 ]]; then
    echo -e "  ${YELLOW}${BOLD}⚠  System has notable performance issues${NC}"
else
    echo -e "  ${RED}${BOLD}✗  System has significant performance problems${NC}"
fi

echo ""
echo -e "  ${BOLD}Recommendations:${NC}"
if [[ -n "${slow_count:-0}" ]] && [[ $slow_count -gt 0 ]]; then
    echo -e "    • Check disk health — slow I/O often indicates failing hardware"
    echo -e "    • Review running processes — high CPU/memory usage degrades benchmarks"
    echo -e "    • Check thermals — thermal throttling reduces CPU performance"
    echo -e "    • Consider SSD upgrade if disk benchmarks are slow"
fi
echo -e "    • Install ${DIM}sysbench stress-ng fio iperf3${NC} for deeper benchmarks"
echo -e "    • Re-run periodically to track performance changes over time"
echo ""
echo -e "  ${BOLD}Completed at: $(date '+%Y-%m-%d %H:%M:%S %Z')${NC}"
echo ""

# ---------- Run Comparison Finalize ----------
if declare -f run_comparison_finalize >/dev/null 2>&1; then run_comparison_finalize 2>/dev/null; fi

