if [[ "${AI_VERDICT:-}" == "1" ]]; then
    _TZ_SUMMARY="procs=${PROCS_SHOWN:-0} threads_total=${TOTAL_THREADS:-0} critical=${CRITICAL:-0} warnings=${WARNINGS:-0} focus_pid=${FOCUS_PID:-none}"
    ai_emit_verdict "top_issue" "$_TZ_SUMMARY" 2>/dev/null || true
fi
