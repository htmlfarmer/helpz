        "${RISK:-0}" "${TOTAL_PTS:-0}" "${#FINDINGS[@]}" "$EXV" "${REPORT//\\/\\\\}" >&4
    printf ',"issues":[' >&4
    _first=1
    for i in "${!FINDINGS[@]}"; do
