    □  Sanitise history                     : HISTCONTROL=ignorespace;  history -d <n>
    □  Rotate leaked secrets                : any token seen in process env / history
    □  Move secrets out of source tree      : .env, *.key, *.pem should be gitignored
    □  Enable PAM quality                   : install libpam-pwquality, set minlen=14
    □  Remove world-readable private keys   : chmod o-rwx <path>
EOF
echo

# comparison replay (must run before final printf of report path)
