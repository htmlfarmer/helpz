# ===========================================================================
# 11. REMEDIATION
# ===========================================================================
printf "${C_BOLD}  ── 11. REMEDIATION ──${C_RESET}\n"
cat <<'EOF'
    □  Lock accounts with no password        : passwd -l <user>
    □  Upgrade weak hashes                  : Debian: libpam-pwquality + chage
