#!/usr/bin/env bash

# shellcheck source=.helpz_log.sh
. "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/.helpz_log.sh"
# secretz — Secrets, Passwords & Credential Auditor
#
# Looks for problems with passwords, keys, certificates, and credential
# stores — across the system (/etc/shadow, PAM), per-user (~/.ssh, ~/.aws,
# ~/.config/gh, ~/.docker, ~/.kube, ~/.netrc), application (.env, *.key,
# *.pem, config.json), and process environment.
#
# Sections:
#   1.  System password hashes      — /etc/shadow algorithms, empty, locked
#   2.  Account anomalies           — UID 0 dupes, no-password, password-in-passwd
#   3.  /etc/login.defs & PAM       — aging, minlen, complexity, remember
#   4.  SSH private keys            — weak keys, bad perms, encrypted?
#   5.  TLS/SSL keys & certs        — expiring, weak RSA, world-readable
#   6.  Cloud credentials           — AWS, GCP, Azure, Docker, GH, Kube
#   7.  App secrets on disk         — .env, settings.py, *.pem, kube configs
#   8.  Shell & DB history          — bash_history / mysql_history / etc.
#   9.  Process environment         — running processes exposing secrets
#  10.  Verdict + remediation
#
# Usage:
#   ./secretz                       # scan everything
#   ./secretz --code ~/myrepo       # scan a CODE directory/repo for leaked secrets
#   ./secretz --gate [staged|tracked]  # guard the current git repo (also via global hooks: helpz guard)
#   ./secretz --user root           # focus on one user
#   ./secretz --section ssh         # run one section only
#   ./secretz --no-color
#   ./secretz --json
#   ./secretz --ai                  # ask local AI for a top-issue verdict (silent if unreachable)

set +o pipefail
set +e

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/common.sh" 2>/dev/null || true
C_RESET="${C_RESET:-}"; C_BOLD="${C_BOLD:-}"; C_DIM="${C_DIM:-}"
C_RED="${C_RED:-}"; C_GREEN="${C_GREEN:-}"; C_YELLOW="${C_YELLOW:-}"
C_CYAN="${C_CYAN:-}"

# ---------- Args ----------
USER_FOCUS=""
SECTION=""
CODE_DIR=""
JSON_OUT=0
NO_COLOR=0
# In JSON mode the report is printed to stderr and stdout carries only the
# JSON object, so `secretz --json | jq` always works.
JSON_STDOUT=0
OUTDIR="${SCRIPT_DIR}/$(basename "${BASH_SOURCE[0]}")-reports"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --user)     USER_FOCUS="$2"; shift 2 ;;
        --section)  SECTION="$2"; shift 2 ;;
        --code)     CODE_DIR="$2"; shift 2 ;;
        --gate)     case "${2:-staged}" in staged|tracked) GATE_MODE="$2"; shift ;; *) GATE_MODE=staged ;; esac; shift ;;
        --outdir)   OUTDIR="$2"; shift 2 ;;
        --json)
            JSON_OUT=1
            JSON_STDOUT=1
            shift
            # JSON mode: the report goes to stderr, stdout carries only the
            # JSON object. fd 4 is opened here so it is this tool's own real
            # stdout, never inherited from a parent shell. --code mode is
            # excluded further down because it emits its own JSON on stdout.
            [[ -n "${CODE_DIR:-}" ]] || exec 4>&1 1>&2
 _JSON_FD4=1
            ;;
        --no-color) NO_COLOR=1; shift ;;
        --ai)       AI_VERDICT=1; shift ;;
        --no-ai)    AI_VERDICT=0; shift ;;
        -h|--help)  sed -n '2,30p' "$0"; exit 0 ;;
        --) shift; break ;;
        -*) printf "Unknown flag: %s\n" "$1" >&2; exit 2 ;;
        *) printf "Unknown arg: %s\n" "$1" >&2; exit 2 ;;
    esac
done

# In JSON mode the human-readable report goes to stderr and stdout carries
# only the JSON object, so `secretz --json | jq` always works. --code mode
# already emits its own JSON on stdout, so it is left alone.
if [[ "$JSON_STDOUT" -eq 1 && -z "${CODE_DIR:-}" ]]; then
    # The split already happened in the --json arm; nothing more to do.
    :
fi

if [[ $NO_COLOR -eq 1 ]]; then
    C_RESET=""; C_BOLD=""; C_DIM=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_CYAN=""
fi

# ---------- --gate: guard mode (works in ANY git repo/directory) ----------
if [[ -n "${GATE_MODE:-}" ]]; then
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        printf 'secretz --gate: %s is not inside a git repo — nothing to check\n' "$PWD" >&2; exit 0
    fi
    [[ -f "$SCRIPT_DIR/lib/guard.sh" ]] && source "$SCRIPT_DIR/lib/guard.sh" || {
        printf 'secretz --gate: missing lib/guard.sh next to secretz\n' >&2; exit 1; }
    [[ "${SECRET_GUARD_OK:-0}" == "1" ]] && { printf 'guard: BYPASSED via SECRET_GUARD_OK=1 — this commit is unchecked\n' >&2; exit 0; }
    guard_gate "$GATE_MODE" && { printf 'guard: ✓ clean — no secrets, no personal paths (%s mode)\n' "$GATE_MODE"; exit 0; } || exit 1
fi

# ---------- AI hook (opt-in via --ai) ----------
if [[ "${AI_VERDICT:-}" == "1" ]]; then
    # shellcheck source=lib/ai.sh
    source "$SCRIPT_DIR/lib/ai.sh" 2>/dev/null || true
fi

# Source run comparison helper
if [[ -f "$SCRIPT_DIR/lib/run_comparison.sh" ]]; then
  source "$SCRIPT_DIR/lib/run_comparison.sh"
fi

# Only the section filter
in_section() {
    [[ -z "$SECTION" || "$SECTION" == "$1" ]]
}

mkdir -p "$OUTDIR" 2>/dev/null || true
TS=$(date '+%Y%m%d-%H%M%S')
REPORT="$OUTDIR/all-${TS}.txt"
if [[ $JSON_OUT -eq 0 ]]; then
    exec > >(tee "$REPORT") 2>&1
fi

# ===========================================================================
# 0. CODE-REPO SECRET SCAN (--code DIR) — standalone mode, then exit
# ===========================================================================
if [[ -n "$CODE_DIR" ]]; then
    [[ -d "$CODE_DIR" ]] || { printf 'secretz: no such directory: %s\n' "$CODE_DIR" >&2; exit 2; }
    CODE_CRIT=0; CODE_WARN=0; CODE_INFO=0; SHOWN=0

    shannon() {   # bits/char entropy of $1
        awk -v s="$1" 'BEGIN{
            n=length(s); if(n==0){print "0.00"; exit}
            for(i=1;i<=n;i++){c=substr(s,i,1); f[c]++}
            e=0; for(k in f){p=f[k]/n; e-=p*log(p)/log(2)}
            printf "%.2f", e
        }'
    }
    redact_secret() {   # keep first 6 + last 2 chars of long tokens
        awk '{ if (length($0) > 40) { printf "%s…%s", substr($0,1,6), substr($0,length($0)-1) } else printf "%s", $0 }'
    }
    code_class() {
        case "$1" in
            *-reports/*|*_reports/*|*/.git/*|.git/*|*/.security-runs/*|.trustz/*|__pycache__/*) printf hygiene; return ;;
        esac
        # The credential DETECTORS themselves contain credential-shaped strings
        # by design (regex patterns, entropy heuristics). Flagging them would
        # block every publish and hide real findings — they are hygiene.
        case "$1" in
            secretz|*/secretz|lib/guard.sh|*/lib/guard.sh) printf hygiene; return ;;
        esac
        # The credential DETECTORS themselves contain credential-shaped strings
        # by design (regex patterns, entropy heuristics). Flagging them would
        # block every publish and hide real findings — they are hygiene.
        case "$1" in
            secretz|*/secretz|lib/guard.sh|*/lib/guard.sh) printf hygiene; return ;;
        esac
        # root-level tool artifacts (comparison reports like "powerz.txt")
        case "$1" in */*) ;; *.txt|*.last) printf hygiene; return ;; esac
        printf code
    }
    CODE_HYG=0
    PLACEHOLDER_RE='(EXAMPLE|CHANGE[_-]?ME|PLACEHOLDER|YOUR[_-]|dummy|sample|template|xxxx|yyyy|<[^>]*>|\$\{|\$[A-Z_]+|<your|readme|example|scram-sha|bcrypt|argon2|md5sum|sha-?[0-9]{2,}[-"])'

    printf "${C_BOLD}  ── 0. CODE-REPO SECRET SCAN ──${C_RESET}\n"
    printf "  ${C_DIM}target:${C_RESET} %s\n\n" "$CODE_DIR"

    mapfile -t CODE_FILES < <(find "$CODE_DIR" \
        \( -path '*/.git/*' -o -path '*/node_modules/*' -o -path '*/__pycache__/*' -o -path '*/.venv/*' -o -path '*/venv/*' \) -prune -o \
        -type f -size -2M -print 2>/dev/null)
    printf "  ${C_DIM}files walked: %d${C_RESET}\n" "${#CODE_FILES[@]}"

    SEC_GREP='-----BEGIN [A-Z ]*PRIVATE KEY-----|-----BEGIN RSA |-----BEGIN OPENSSH|-----BEGIN EC PRIVATE|-----BEGIN DSA|BEGIN PGP MESSAGE|BEGIN PGP PRIVATE|AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{30,}|gho_[A-Za-z0-9]{30,}|ghs_[A-Za-z0-9]{30,}|ghu_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{50,}|glpat-[A-Za-z0-9_-]{18,}|xox[bpoas]-[A-Za-z0-9-]{10,}|sk-ant-[A-Za-z0-9-]{20,}|sk-cp-[A-Za-z0-9-]{30,}|sk-[A-Za-z0-9]{32,}|AIza[0-9A-Za-z_-]{30,}|SG\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}|npm_[A-Za-z0-9]{30,}|dckr_pat_[A-Za-z0-9_-]{16,}|dop_v1_[a-f0-9]{40,}|shpat_[a-f0-9]{32,}|ya29\.[0-9A-Za-z_-]{20,}|whsec_[A-Za-z0-9]{16,}|sk_live_[A-Za-z0-9]{16,}|rk_live_[A-Za-z0-9]{16,}|GOCSPX-[A-Za-z0-9_-]{16,}|hf_[A-Za-z0-9]{30,}|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}|[a-z][a-z0-9+.-]{2,10}://[^/[:space:]:@]+:[^/[:space:]@]{6,}@|Basic[[:space:]]+[A-Za-z0-9+/=]{16,}|Buffer\.from\(["'"'"'][A-Za-z0-9_.+-]{2,30}:[^"'"'"'[:space:]]{8,}["'"'"']\)|b64decode\(["'"'"'][A-Za-z0-9+/]{20,}={0,2}["'"'"']\)|Bearer [A-Za-z0-9._~-]{40,}|(api[_-]?key|apikey|secret|token|client[_-]?secret|access[_-]?key|auth|password|passwd|pwd)[A-Za-z0-9_-]*["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9+_./=:-]{12,}|(password|passwd|pwd|secret|token)[a-z0-9_ -]{0,25}[[:space:]](was|is)[[:space:]]+["'"'"']?[A-Za-z0-9!@#$%^&*_+=.~-]{10,}'

    for f in "${CODE_FILES[@]}"; do
        base=$(basename "$f")
        # filename heuristics (WARN unless clearly a template)
        case "$base" in
            .env|.env.*|*.env|id_rsa|id_dsa|*.pem|*.key|*.p12|*.pfx|credentials.json|service-account*.json|*.kdbx)
                case "$base" in
                    *.example|*.sample|*.template|*.pub|*example*|*sample*)
                        CODE_INFO=$((CODE_INFO+1)) ;;
                    *)
                        CODE_WARN=$((CODE_WARN+1))
                        [[ $JSON_OUT -eq 0 && $SHOWN -lt 25 ]] && { printf "  ${C_YELLOW}!${C_RESET} filename looks secret-bearing: %s\n" "${f#"$CODE_DIR"/}"; SHOWN=$((SHOWN+1)); } ;;
                esac ;;
        esac
        # content heuristics
        while IFS= read -r hit; do
            line="${hit%%:*}"; rest="${hit#*:}"
            rest=$(sed -E 's/^[[:space:]]+//' <<< "$rest")
            [[ "$rest" == *SEC_GREP* || "$rest" == *"SEC_GREP='-----BEGIN"* || "$rest" == *"GUARD_SECRET_RE='-----BEGIN"* || "$rest" == *"HIST_PATTERNS='"* ]] && continue   # this suite's own pattern lines (cut to 240c may truncate the full var)
            # known live-token shapes or private-key blocks -> CRITICAL
            if grep -qE 'PRIVATE KEY|AKIA[0-9A-Z]{16}|ghp_|gho_|ghs_|github_pat_|glpat-|xox[bpoas]-|sk-ant-|sk-cp-|npm_[A-Za-z0-9]{30}|dckr_pat_|AIza[0-9A-Za-z_-]{30}|SG\.|whsec_|sk_live_|rk_live_|GOCSPX-|hf_[A-Za-z0-9]{30,}|eyJ[A-Za-z0-9_-]{10,}\.eyJ|://[^/[:space:]:@]+:[^/[:space:]@]{6,}@|[Bb]asic[[:space:]]+["'"'"']?[A-Za-z0-9+/=]{16,}|Buffer\.from\(["'"'"'][A-Za-z0-9_.-]{2,30}:[^"'"'"' ]{8,}["'"'"']' <<< "$rest"; then
                if grep -qiE "$PLACEHOLDER_RE" <<< "$rest"; then
                    CODE_INFO=$((CODE_INFO+1))
                elif [[ "$(code_class "${f#"$CODE_DIR"/}")" == hygiene ]]; then
                    CODE_HYG=$((CODE_HYG+1))
                else
                    CODE_CRIT=$((CODE_CRIT+1))
                    [[ $JSON_OUT -eq 0 && $SHOWN -lt 25 ]] && { printf "  ${C_RED}✗${C_RESET} %s:%s → %s\n" "${f#"$CODE_DIR"/}" "$line" "$(redact_secret <<< "$rest" | head -c 110)"; SHOWN=$((SHOWN+1)); }
                fi
            else
                val=$(sed -E 's/.*[=:][[:space:]]*//; s/^["'"'"']//; s/["'"'"',;].*$//' <<< "$rest" | head -c 200)
                e=$(shannon "$val"); el=${#val}
                if grep -qiE "$PLACEHOLDER_RE" <<< "$rest"; then
                    CODE_INFO=$((CODE_INFO+1))
                elif [[ $el -ge 14 ]] && awk -v x="$e" 'BEGIN{exit !(x>=3.7)}'; then
                    if [[ "$(code_class "${f#"$CODE_DIR"/}")" == hygiene ]]; then
                        CODE_HYG=$((CODE_HYG+1))
                        continue
                    fi
                    CODE_CRIT=$((CODE_CRIT+1))
                    [[ $JSON_OUT -eq 0 && $SHOWN -lt 25 ]] && { printf "  ${C_RED}✗${C_RESET} high-entropy credential (%s bits/char): %s:%s → %s\n" "$e" "${f#"$CODE_DIR"/}" "$line" "$(redact_secret <<< "$rest" | head -c 110)"; SHOWN=$((SHOWN+1)); }
                elif [[ $el -ge 10 ]]; then
                    CODE_WARN=$((CODE_WARN+1))
                    [[ $JSON_OUT -eq 0 && $SHOWN -lt 25 ]] && { printf "  ${C_YELLOW}!${C_RESET} possible credential: %s:%s → %s\n" "${f#"$CODE_DIR"/}" "$line" "$(redact_secret <<< "$rest" | head -c 110)"; SHOWN=$((SHOWN+1)); }
                else
                    CODE_INFO=$((CODE_INFO+1))
                fi
            fi
        done < <(grep -IinE -e "$SEC_GREP" -- "$f" 2>/dev/null | cut -c1-240 | head -30)
    done

    (( SHOWN >= 25 )) && printf "  ${C_DIM}… truncated at 25 findings — full list via --json or the report file${C_RESET}\n"
    echo
    [[ $CODE_HYG -gt 0 ]] && printf "  ${C_DIM}(+%d hits inside local report/log dirs — gitignored, not a publish risk; still scrub locally)${C_RESET}\n" "$CODE_HYG"
    printf "  ${C_DIM}summary:${C_RESET} ${C_RED}%d critical${C_RESET} · ${C_YELLOW}%d warn${C_RESET} · %d info(placeholder/template)\n" "$CODE_CRIT" "$CODE_WARN" "$CODE_INFO"
    if [[ $JSON_OUT -eq 1 ]]; then
        exec 1>&4
        printf '{"scan":"code","dir":"%s","files":%d,"critical":%d,"warn":%d,"info":%d}\n' \
            "$CODE_DIR" "${#CODE_FILES[@]}" "$CODE_CRIT" "$CODE_WARN" "$CODE_INFO"
    else
        if (( CODE_CRIT > 0 )); then
            printf "  ${C_RED}${C_BOLD}NOT GitHub-ready${C_RESET}: rotate anything real, then purge history (git filter-repo) before publishing.\n"
        elif (( CODE_WARN > 0 )); then
            printf "  ${C_YELLOW}Review the warnings${C_RESET} — filenames may be templates; confirm before publishing.\n"
        else
            printf "  ${C_GREEN}${C_BOLD}CLEAN${C_RESET}: no credential patterns found — safe to publish from a secrets standpoint.\n"
        fi
        printf "  ${C_DIM}Report: %s${C_RESET}\n" "$REPORT"
        exec 1>&2
    fi
    exit $(( CODE_CRIT > 0 ? 2 : CODE_WARN > 0 ? 1 : 0 ))
fi

# Initialize run comparison (skip for JSON mode)
if [[ "$JSON_OUT" != "1" ]]; then
    run_comparison_init "secretz"
fi

have() { command -v "$1" >/dev/null 2>&1; }
hr_size() {
    awk -v b="$1" 'BEGIN {
        if (b >= 1073741824) printf "%.2fGB", b/1073741824
        else if (b >= 1048576) printf "%.2fMB", b/1048576
        else if (b >= 1024)    printf "%.1fKB", b/1024
        else                    printf "%dB", b
    }'
}

# ---------- Banner ----------
printf "${C_BOLD}${C_CYAN}"
cat <<'BANNER'
╔═══════════════════════════════════════════════════════════════╗
║  SECRETZ  —  Passwords, Keys & Credential Auditor           ║
║  Shadow · SSH · TLS · Cloud · App · History · Process env   ║
╚═══════════════════════════════════════════════════════════════╝
BANNER
printf "${C_RESET}\n"
printf "${C_DIM}Time: %s   Report: %s${C_RESET}\n\n" "$(date '+%Y-%m-%d %H:%M:%S %Z')" "$REPORT"

SCORE=100
declare -a FINDINGS=()
declare -a SCORES=()

note() { FINDINGS+=("$1"); SCORES+=("$2"); }
penalty() { SCORE=$((SCORE - $1)); }
emph() {
    # emph "label" "value" [color]
    local lbl="$1" val="$2" color="${3:-$C_DIM}"
    printf "    ${color}%-30s${C_RESET} %s\n" "$lbl" "$val"
}

# ===========================================================================
# 1. SYSTEM PASSWORD HASHES (/etc/shadow)
# ===========================================================================
if in_section 1; then
    printf "${C_BOLD}  ── 1. SYSTEM PASSWORD HASHES (/etc/shadow) ──${C_RESET}\n"
    if [[ -r /etc/shadow ]]; then
        TOTAL=$(wc -l < /etc/shadow)
        LOCKED=$(awk -F: '$2 ~ /^[!*]/ {n++} END {print n+0}' /etc/shadow)
        EMPTY=$(awk -F: '$2 == "" {n++} END {print n+0}' /etc/shadow)
        NDIGEST=$(awk -F: '$2 ~ /^!/ {n++} END {print n+0}' /etc/shadow)
        UNKNOWN=$(awk -F: '$2 != "" && $2 !~ /^[\$!*]/ && $2 !~ /^[!*]/ {n++} END {print n+0}' /etc/shadow)

        # Hash algorithm distribution
        printf "    ${C_DIM}Hash algorithms:${C_RESET}\n"
        awk -F: '{
            h = $2
            algo = "(empty)"
            if (h == "")        algo = "(empty/no password)"
            else if (h ~ /^!/)  algo = "locked (!)"
            else if (h ~ /^\*/) algo = "locked (*)"
            else if (h ~ /^\$1\$/)  algo = "MD5 (\$1) — WEAK"
            else if (h ~ /^\$2[axyb]\$/) algo = "bcrypt (\$2)"
            else if (h ~ /^\$5\$/)  algo = "SHA-256 (\$5)"
            else if (h ~ /^\$6\$/)  algo = "SHA-512 (\$6)"
            else if (h ~ /^\$y\$/)  algo = "yescrypt (\$y)"
            else if (length(h) <= 13 && h !~ /\$/) algo = "DES — WEAK"
            else algo = "(unknown)"
            n[algo]++
        } END {
            for (a in n) printf "        %-22s %d\n", a, n[a]
        }' /etc/shadow | sort -k2 -nr

        WEAK_HASH=$(awk -F: '($2 ~ /^\$1\$/) || (length($2) <= 13 && $2 !~ /\$/ && $2 !~ /^[!*]/ && $2 != "") {n++} END {print n+0}' /etc/shadow)
        DES_HASH=$(awk -F: 'length($2) > 0 && length($2) <= 13 && $2 !~ /\$/ && $2 !~ /^[!*]/ {n++} END {print n+0}' /etc/shadow)

        emph "Total entries:"        "$TOTAL"
        emph "Locked accounts:"      "$LOCKED"
        emph "No-password entries:"  "$EMPTY  $([[ $EMPTY -gt 0 ]] && echo "${C_RED}!!${C_RESET}" || echo "${C_GREEN}ok${C_RESET}")"
        emph "Weak hashes (MD5/DES):" "$WEAK_HASH  $([[ $WEAK_HASH -gt 0 ]] && echo "${C_RED}weak${C_RESET}" || echo "${C_GREEN}ok${C_RESET}")"

        if [[ $EMPTY -gt 0 ]]; then
            printf "    ${C_RED}✗${C_RESET} ${C_RED}Accounts with no password:${C_RESET}\n"
            awk -F: '$2 == "" {print "        "$1}' /etc/shadow
            note "empty passwords" $(( EMPTY * 10 ))
        fi
        if [[ $WEAK_HASH -gt 0 ]]; then
            printf "    ${C_RED}✗${C_RESET} ${C_RED}Weak hashes (MD5/DES):${C_RESET}\n"
            awk -F: '($2 ~ /^\$1\$/) || (length($2) > 0 && length($2) <= 13 && $2 !~ /\$/ && $2 !~ /^[!*]/) {print "        "$1}' /etc/shadow | head -n 5
            (( WEAK_HASH > 5 )) && printf "        ${C_DIM}... and %d more${C_RESET}\n" $((WEAK_HASH - 5))
            note "weak hashes (MD5/DES)" $(( WEAK_HASH * 5 ))
        fi
        # Duplicate hashes (same password for multiple users)
        DUPES=$(awk -F: '$2 ~ /^\$/ {print $2}' /etc/shadow | sort | uniq -d | wc -l)
        if [[ $DUPES -gt 0 ]]; then
            printf "    ${C_YELLOW}!${C_RESET} ${C_YELLOW}%d duplicate password hash(es) — same password across users${C_RESET}\n" "$DUPES"
            note "$DUPES duplicate hash(es)" $(( DUPES * 3 ))
        fi
        # Password aging
        AGELESS=$(awk -F: '$5 == "" || $5 == "99999" {n++} END {print n+0}' /etc/shadow)
        if [[ $AGELESS -gt 0 ]]; then
            printf "    ${C_YELLOW}!${C_RESET} ${C_YELLOW}%d account(s) without password aging policy${C_RESET}\n" "$AGELESS"
            note "$AGELESS accounts without aging" $(( AGELESS * 2 ))
        fi
        OLDEST=$(awk -F: '$3 != "" {print $3, $1}' /etc/shadow | sort -n | head -1)
        if [[ -n "$OLDEST" ]]; then
            days="${OLDEST%% *}"
            user="${OLDEST##* }"
            if [[ "$days" =~ ^[0-9]+$ ]] && (( days > 365 )); then
                printf "    ${C_YELLOW}!${C_RESET} ${C_YELLOW}Oldest password: %s (%d days)${C_RESET}\n" "$user" "$days"
                (( days > 730 )) && note "$user password $days days old" 5
            fi
        fi
    else
        printf "    ${C_DIM}(/etc/shadow not readable — need root)${C_RESET}\n"
    fi
    echo
fi

# ===========================================================================
# 2. ACCOUNT ANOMALIES
# ===========================================================================
if in_section 2; then
    printf "${C_BOLD}  ── 2. ACCOUNT ANOMALIES ──${C_RESET}\n"
    if [[ -r /etc/passwd ]]; then
        # UID 0 accounts (should be only 'root')
        printf "    ${C_DIM}UID 0 (root-equivalent) accounts:${C_RESET}\n"
        awk -F: '$3 == 0 {print "        "$1" (uid "$3")"}' /etc/passwd
        UID0_COUNT=$(awk -F: '$3 == 0' /etc/passwd | wc -l)
        if [[ $UID0_COUNT -gt 1 ]]; then
            printf "    ${C_RED}✗${C_RESET} ${C_RED}Multiple UID-0 accounts: %d (should be 1)${C_RESET}\n" "$UID0_COUNT"
            note "multiple UID-0 accounts" $(( (UID0_COUNT - 1) * 10 ))
        fi

        # Passwords in /etc/passwd (legacy)
        PWDPWD=$(awk -F: 'NF > 1 && $2 != "" && $2 != "x" && $2 != "*" && $2 !~ /^!/ {n++} END {print n+0}' /etc/passwd)
        if [[ $PWDPWD -gt 0 ]]; then
            printf "    ${C_RED}✗${C_RESET} ${C_RED}%d account(s) have password hash directly in /etc/passwd (should be 'x' or shadowed)${C_RESET}\n" "$PWDPWD"
            note "$PWDPWD legacy /etc/passwd passwords" $(( PWDPWD * 10 ))
        fi

        # System accounts with login shells
        SYS_SHELLS=$(awk -F: '$3 < 1000 && $3 >= 100 && $7 ~ /(bash|sh|zsh|fish)$/ {print $1}' /etc/passwd)
        SYS_SHELLS_C=$(echo -n "$SYS_SHELLS" | grep -c . 2>/dev/null || true)
        if [[ $SYS_SHELLS_C -gt 0 ]]; then
            printf "    ${C_YELLOW}!${C_RESET} ${C_YELLOW}%d system account(s) have a login shell${C_RESET}\n" "$SYS_SHELLS_C"
            echo "$SYS_SHELLS" | head -n 5 | sed 's/^/        /'
            (( SYS_SHELLS_C > 5 )) && printf "        ${C_DIM}... and %d more${C_RESET}\n" $((SYS_SHELLS_C - 5))
            note "$SYS_SHELLS_C system accounts with shell" $(( SYS_SHELLS_C * 2 ))
        fi

        # Home directories without ownership
        ORPHAN_HOMES=$(awk -F: '$6 != "" && $6 != "/" {print $3 ":" $6}' /etc/passwd | while IFS=: read -r uid home; do
            owner=$(stat -c '%u' "$home" 2>/dev/null)
            [[ -n "$owner" && "$owner" != "$uid" ]] && echo "$home owned by uid $owner (expect $uid)"
        done)
        ORPHAN_HOMES_C=$(echo -n "$ORPHAN_HOMES" | grep -c . 2>/dev/null || true)
        if [[ $ORPHAN_HOMES_C -gt 0 ]]; then
            printf "    ${C_YELLOW}!${C_RESET} ${C_YELLOW}%d home dir(s) with wrong ownership${C_RESET}\n" "$ORPHAN_HOMES_C"
            echo "$ORPHAN_HOMES" | head -n 5 | sed 's/^/        /'
            note "$ORPHAN_HOMES_C mis-owned home dir(s)" $(( ORPHAN_HOMES_C * 3 ))
        fi
    fi
    echo
fi

# ===========================================================================
# 3. LOGIN.DEFS & PAM
# ===========================================================================
if in_section 3; then
    printf "${C_BOLD}  ── 3. PASSWORD POLICY (login.defs / PAM) ──${C_RESET}\n"
    # login.defs
    if [[ -r /etc/login.defs ]]; then
        echo "    ${C_DIM}/etc/login.defs:${C_RESET}"
        for k in PASS_MAX_DAYS PASS_MIN_DAYS PASS_MIN_LEN PASS_WARN_AGE PASS_CREATE_HOME; do
            v=$(grep -E "^${k}\b" /etc/login.defs | awk '{print $2}')
            case "$k" in
                PASS_MAX_DAYS)
                    [[ -z "$v" || "$v" -gt 365 ]] && { printf "      ${C_RED}✗${C_RESET} ${C_DIM}%-22s${C_RESET} ${C_RED}%s (no limit or > 365 days)${C_RESET}\n" "$k" "${v:-unset}"; note "PASS_MAX_DAYS=${v:-unset}" 5; } || \
                        printf "      ${C_GREEN}✓${C_RESET} ${C_DIM}%-22s${C_RESET} %s\n" "$k" "$v"
                    ;;
                PASS_MIN_DAYS)
                    [[ -z "$v" || "$v" -eq 0 ]] && printf "      ${C_YELLOW}!${C_RESET} ${C_DIM}%-22s${C_RESET} ${C_YELLOW}%s (allows immediate change)${C_RESET}\n" "$k" "${v:-0}" || \
                        printf "      ${C_GREEN}✓${C_RESET} ${C_DIM}%-22s${C_RESET} %s\n" "$k" "$v"
                    ;;
                PASS_MIN_LEN)
                    [[ -z "$v" || "$v" -lt 12 ]] && { printf "      ${C_RED}✗${C_RESET} ${C_DIM}%-22s${C_RESET} ${C_RED}%s (should be ≥ 12)${C_RESET}\n" "$k" "${v:-unset}"; note "PASS_MIN_LEN=${v:-unset}" 5; } || \
                        printf "      ${C_GREEN}✓${C_RESET} ${C_DIM}%-22s${C_RESET} %s\n" "$k" "$v"
                    ;;
                PASS_WARN_AGE)
                    [[ -z "$v" || "$v" -lt 7 ]] && printf "      ${C_YELLOW}!${C_RESET} ${C_DIM}%-22s${C_RESET} ${C_YELLOW}%s (recommend ≥ 7)${C_RESET}\n" "$k" "${v:-unset}" || \
                        printf "      ${C_GREEN}✓${C_RESET} ${C_DIM}%-22s${C_RESET} %s\n" "$k" "$v"
                    ;;
                *) printf "      ${C_DIM}%-22s${C_RESET} ${C_DIM}%s${C_RESET}\n" "$k" "${v:-unset}" ;;
            esac
        done
    fi

    # PAM quality (pwquality / cracklib)
    PWQ_CONF=""
    for f in /etc/security/pwquality.conf /etc/pam.d/common-password; do
        [[ -r "$f" ]] && PWQ_CONF="$PWQ_CONF $f"
    done
    if [[ -n "$PWQ_CONF" ]]; then
        echo "    ${C_DIM}PAM quality:${C_RESET}"
        if [[ -r /etc/security/pwquality.conf ]]; then
            for k in minlen dcredit ucredit lcredit ocredit enforce_for_root dict remember; do
                v=$(grep -E "^${k}\b" /etc/security/pwquality.conf | head -1 | awk '{print $2}')
                [[ -n "$v" ]] && printf "      ${C_DIM}%-22s${C_RESET} %s\n" "$k" "$v"
            done
            if ! grep -qE "^enforce_for_root" /etc/security/pwquality.conf; then
                printf "      ${C_YELLOW}!${C_RESET} ${C_YELLOW}enforce_for_root not set — root can bypass password policy${C_RESET}\n"
                note "PAM root bypass" 5
            fi
        fi
    fi
    echo
fi

# ===========================================================================
# 4. SSH PRIVATE KEYS
# ===========================================================================
if in_section 4; then
    printf "${C_BOLD}  ── 4. SSH PRIVATE KEYS ──${C_RESET}\n"
    SH_KEYS=$(find /home /root -xdev -maxdepth 6 -type f \( -name 'id_rsa' -o -name 'id_dsa' -o -name 'id_ecdsa' -o -name 'id_ed25519' -o -name '*.pem' \) 2>/dev/null | head -50)
    [[ -z "$USER_FOCUS" ]] || SH_KEYS=$(echo "$SH_KEYS" | grep "/$USER_FOCUS/" || echo "")

    KEY_COUNT=$(echo -n "$SH_KEYS" | grep -c . 2>/dev/null || true)
    if [[ $KEY_COUNT -eq 0 ]]; then
        printf "    ${C_DIM}(no SSH private keys found)${C_RESET}\n"
    else
        printf "    Found ${C_BOLD}%d${C_RESET} SSH private key(s):\n" "$KEY_COUNT"
        while IFS= read -r k; do
            [[ -z "$k" ]] && continue
            REL="${k#/}"
            MODE=$(stat -c '%a' "$k" 2>/dev/null)
            OWNER=$(stat -c '%U' "$k" 2>/dev/null)
            SIZE=$(stat -c '%s' "$k" 2>/dev/null)
            KIND=$(basename "$k")
            SEV="${C_DIM}"
            FIX=""
            # DSA = weak
            if [[ "$KIND" == "id_dsa" ]]; then
                SEV="${C_RED}✗${C_RESET}"
                printf "    %b ${C_RED}%-50s${C_RESET}  mode=%s owner=%s ${C_RED}DSA (deprecated)${C_RESET}\n" \
                       "$SEV" "$REL" "$MODE" "$OWNER"
                note "DSA key: $REL" 10
                continue
            fi
            # Mode check: 600 or 400 are safe. Anything else (644, 755, etc.) is bad.
            if [[ "$MODE" != "600" && "$MODE" != "400" && "$MODE" != "700" ]]; then
                if [[ "${MODE:2:1}" -ge 4 ]]; then
                    SEV="${C_RED}✗${C_RESET}"
                    note "weak perms on $REL" 8
                elif [[ "${MODE:2:1}" -ge 1 ]]; then
                    SEV="${C_YELLOW}!${C_RESET}"
                    note "weak perms on $REL" 3
                fi
            fi
            # RSA size check
            if [[ "$KIND" == "id_rsa" ]]; then
                if have ssh-keygen; then
                    bits=$(ssh-keygen -l -f "$k" 2>/dev/null | awk '{print $1}')
                    if [[ "$bits" =~ ^[0-9]+$ ]] && (( bits < 2048 )); then
                        SEV="${C_RED}✗${C_RESET}"
                        printf "    %b ${C_RED}%-50s${C_RESET}  mode=%s owner=%s ${C_RED}RSA %s bits (WEAK)${C_RESET}\n" \
                               "$SEV" "$REL" "$MODE" "$OWNER" "$bits"
                        note "weak RSA ($bits bits): $REL" 8
                        continue
                    fi
                fi
            fi
            # passphrase/encryption heuristic (avoids embedding full PEM literals)
            ENC="no"
            if grep -qE 'Proc-Type: 4,ENCRYPTED|DEK-Info' "$k" 2>/dev/null; then ENC="yes"; fi
            case "$KIND" in
                id_ed25519|id_ecdsa)
                    # openssh-format encryption cannot be grepped safely; trust ssh-keygen -p -e
                    if have ssh-keygen && ssh-keygen -y -f "$k" >/dev/null 2>&1; then ENC="no"; else ENC="?"; fi ;;
            esac

            printf "    %b %-50s mode=%-4s owner=%-10s enc=%s\n" \
                   "${SEV:-${C_GREEN}✓${C_RESET}}" "$REL" "$MODE" "$OWNER" "$ENC"
            if [[ "$ENC" == "no" ]]; then
                SEV="${C_YELLOW}!${C_RESET}"
                note "unencrypted private key: $REL" 6
            fi
            if [[ -n "$SEV" && "$SEV" != "${C_GREEN}✓${C_RESET}" ]]; then :; fi
        done <<< "$SH_KEYS"
        if have ssh-keygen && [[ -n "$SH_KEYS" ]]; then
            note "add passphrases to any unencrypted keys: ssh-keygen -p -f <key>" 0
        fi
    fi
    echo
fi

# ===========================================================================
# 5. TLS / SSL KEYS & CERTIFICATES
# ===========================================================================
if in_section 5; then
    printf "${C_BOLD}  ── 5. TLS/SSL KEYS & CERTIFICATES ──${C_RESET}\n"
    CERTS=$(find /etc/ssl /etc/letsencrypt /etc/nginx /etc/apache2 /etc/haproxy /etc/cups -xdev -maxdepth 5 \
            -type f \( -name '*.key' -o -name '*.pem' -o -name 'privkey*' -o -name 'fullchain*' -o -name 'cert.pem' \) 2>/dev/null | head -80)
    if [[ -z "$CERTS" ]]; then
        printf "    ${C_DIM}(no TLS key/cert files found in standard locations)${C_RESET}\n"
    else
        while IFS= read -r c; do
            [[ -z "$c" ]] && continue
            M=$(stat -c '%a' "$c" 2>/dev/null); OWN=$(stat -c '%U' "$c" 2>/dev/null)
            if [[ "$c" == *key* || "$c" == *privkey* ]]; then
                if [[ "${M:5:3}" != "000" && "${M:2:1}" != "0" ]]; then
                    printf "    ${C_RED}✗${C_RESET} world/group-readable private key: %-45s mode=%s\n" "$c" "$M"
                    note "TLS key readable (mode $M): $c" 8
                elif have openssl; then
                    BITS=$(openssl rsa -in "$c" -noout -text 2>/dev/null | grep -oE 'Private-Key: \([0-9]+ bit' | grep -oE '[0-9]+' | head -1)
                    if [[ "$BITS" =~ ^[0-9]+$ ]] && (( BITS < 2048 )); then
                        printf "    ${C_RED}✗${C_RESET} weak %s-bit RSA key: %s\n" "$BITS" "$c"
                        note "weak RSA TLS key ($BITS): $c" 7
                    fi
                fi
            fi
            if have openssl && [[ "$c" == *.pem || "$c" == *cert* || "$c" == *fullchain* ]]; then
                EXP=$(openssl x509 -in "$c" -noout -enddate 2>/dev/null | cut -d= -f2)
                if [[ -n "$EXP" ]]; then
                    EPOCH=$(date -d "$EXP" +%s 2>/dev/null || echo 0)
                    DAYS=$(( (EPOCH - $(date +%s)) / 86400 ))
                    if (( EPOCH > 0 && DAYS < 14 )); then
                        printf "    ${C_YELLOW}!${C_RESET} cert expiring in %sd: %s\n" "$DAYS" "$c"
                        note "cert expires ${DAYS}d: $c" $(( DAYS < 0 ? 9 : 4 ))
                    fi
                fi
            fi
        done <<< "$CERTS"
        printf "    ${C_DIM}checked %d TLS-related file(s)${C_RESET}\n" "$(echo -n "$CERTS" | grep -c .)"
    fi
    echo
fi

# ===========================================================================
# 6. CLOUD / SERVICE CREDENTIALS
# ===========================================================================
if in_section 6; then
    printf "${C_BOLD}  ── 6. CLOUD & SERVICE CREDENTIALS ──${C_RESET}\n"
    check_cred() {   # file "label"
        local f="$1" lbl="$2"
        if [[ -r "$f" ]]; then
            M=$(stat -c '%a' "$f" 2>/dev/null)
            if [[ "${M:5:3}" != "000" && "${M:5:3}" != "600" && "${M:5:3}" != "400" ]]; then
                printf "    ${C_YELLOW}!${C_RESET} %s at %s is mode=%s (should be 600)\n" "$lbl" "$f" "$M"
                note "$lbl loose perms: $f" 5
            else
                printf "    ${C_GREEN}✓${C_RESET} %s: %s (mode %s)\n" "$lbl" "$f" "$M"
            fi
        fi
    }
    for uhome in /home/* /root; do
        [[ -d "$uhome" ]] || continue
        [[ -z "$USER_FOCUS" ]] || [[ "$(basename "$uhome")" == "$USER_FOCUS" || "$uhome" == "/root" ]] || continue
        check_cred "$uhome/.aws/credentials" "AWS"
        check_cred "$uhome/.config/gcloud/credentials.db" "GCP"
        check_cred "$uhome/.config/gcloud/application_default_credentials.json" "GCP ADC"
        check_cred "$uhome/.azure/accessTokens.json" "Azure"
        check_cred "$uhome/.docker/config.json" "Docker registry auth"
        check_cred "$uhome/.kube/config" "Kubernetes"
        check_cred "$uhome/.netrc" ".netrc"
        check_cred "$uhome/config.json" "gh CLI"
        check_cred "$uhome/.config/gh/hosts.yml" "gh hosts"
        # token-bearing files with obvious markers
        if have grep; then
            HITS=$(grep -rlE "ghp_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|xox[bap]-" "$uhome" --include='*' -d skip 2>/dev/null | head -5)
            for h in $HITS; do
                case "$h" in *-reports/*|*/.security-logs/*|*secretz*) continue ;; esac
                printf "    ${C_RED}✗${C_RESET} live-token pattern found in: %s ${C_DIM}(rotate it!)${C_RESET}\n" "$h"
                note "live token file: $h" 10
            done
        fi
    done
    echo
fi

# ===========================================================================
# 7. APP SECRETS ON DISK  (.env etc.)
# ===========================================================================
if in_section 7; then
    printf "${C_BOLD}  ── 7. APPLICATION SECRETS (.env, configs) ──${C_RESET}\n"
    APP_SECRETS=$(find /home /root /var/www /srv /opt -xdev -maxdepth 6 -type f \
        \( -name '.env' -o -name '.env.production' -o -name 'settings_secret*' -o -name 'config.local.*' -o -name '*.secret' \) 2>/dev/null | head -40)
    [[ -z "$USER_FOCUS" ]] || APP_SECRETS=$(echo "$APP_SECRETS" | grep "/$USER_FOCUS/" || echo "")
    if [[ -z "$APP_SECRETS" ]]; then
        printf "    ${C_GREEN}✓${C_RESET} no .env-style files found\n"
    else
        while IFS= read -r f; do
            [[ -z "$f" ]] && continue
            M=$(stat -c '%a' "$f")
            N=$(grep -cE '^(.*_(PASSWORD|SECRET|TOKEN|KEY)=.)|(DB_|AWS_|API_)' "$f" 2>/dev/null || true); N=${N:-0}
            if [[ "$M" != "600" && "$M" != "400" ]]; then
                printf "    ${C_YELLOW}!${C_RESET} %s (${N} secret-looking lines) mode=%s — tighten: chmod 600\n" "$f" "$M"
                note "world/group-readable .env: $f" 4
            else
                printf "    ${C_GREEN}✓${C_RESET} %s (${N} secret lines, mode 600)\n" "$f"
            fi
        done <<< "$APP_SECRETS"
    fi
    echo
fi

# ===========================================================================
# 8. SHELL & DB HISTORY
# ===========================================================================
if in_section 8; then
    printf "${C_BOLD}  ── 8. SHELL / DB HISTORY LEAKS ──${C_RESET}\n"
    HIST_PATTERNS='(password|passwd|api[_-]?key|secret|token|BEGIN.*PRIVATE KEY|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|sk-[A-Za-z0-9]{32}|xox[bpoas]-|mysql.*-p|psql.*-W|sshpass.*-p|curl.*-u.*:)'
    redact() {
        while IFS= read -r l; do
            sed -E 's/([A-Za-z0-9+_\/.:-]{12})[A-Za-z0-9+_\/.:-]*/\1…REDACTED/g' <<< "$l"
        done
    }
    for uhome in /home/* /root; do
        [[ -d "$uhome" ]] || continue
        for hf in "$uhome/.bash_history" "$uhome/.zsh_history" "$uhome/.mysql_history" "$uhome/.psql_history"; do
            [[ -r "$hf" ]] || continue
            HITS=$(grep -ciE "$HIST_PATTERNS" "$hf" 2>/dev/null || true); HITS=${HITS:-0}
            if (( HITS > 0 )); then
                printf "    ${C_YELLOW}!${C_RESET} %s — %d risky line(s):\n" "$hf" "$HITS"
                grep -niE "$HIST_PATTERNS" "$hf" 2>/dev/null | head -n 3 | redact | sed 's/^/        /'
                note "secrets in $hf" 5
            fi
        done
    done
    printf "    ${C_DIM}tip: prefix sensitive commands with a space (HISTCONTROL=ignorespace)${C_RESET}\n"
    echo
fi

# ===========================================================================
# 9. PROCESS ENVIRONMENT
# ===========================================================================
if in_section 9; then
    printf "${C_BOLD}  ── 9. RUNNING PROCESS ENVIRONMENTS ──${C_RESET}\n"
    ENV_PATTERNS='(PASSWORD|SECRET|TOKEN|API[_-]?KEY|ACCESS[_-]?KEY|AWS_[A-Z]+_(SECRET|ACCESS))'
    PFOUND=0
    for pid in $(pgrep -u "$(id -un)" 2>/dev/null | head -100); do
        env_file="/proc/$pid/environ"
        [[ -r "$env_file" ]] || continue
        if tr '\0' '\n' < "$env_file" 2>/dev/null | grep -qiE "$ENV_PATTERNS"; then
            PFOUND=$((PFOUND+1))
            CMD=$(ps -p "$pid" -o comm= 2>/dev/null)
            printf "    ${C_YELLOW}!${C_RESET} pid %s (%s) env contains secret-named vars:\n" "$pid" "$CMD"
            tr '\0' '\n' < "$env_file" | grep -iE "$ENV_PATTERNS" | sed -E 's/=.{1,6}$/=…REDACTED/' | head -n 3 | sed 's/^/        /'
            note "secret in env of pid $pid ($CMD)" 4
        fi
    done
    (( PFOUND == 0 )) && printf "    ${C_GREEN}✓${C_RESET} no secret-named variables in readable process environments\n"
    if [[ $EUID -ne 0 ]]; then
        printf "    ${C_DIM}note: other users'/system processes need sudo for full coverage${C_RESET}\n"
    fi
    echo
fi

